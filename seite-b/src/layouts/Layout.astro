---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Manfred Weber GmbH & CoKG – Wir bauen für Sie!",
  description = "Meisterhafter Hochbau, Tiefbau und Sanierungsbau. Für Ihr Bauvorhaben sperren wir Brücken und bringen Ihre Leistung auf den Punkt."
} = Astro.props;

import '../styles/global.css';
---

<!doctype html>
<html lang="de" class="lenis">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/cropped-Button-32x32.png" />
    
    <!-- Preconnect & Google Fonts: Schibsted Grotesk + Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Schibsted+Grotesk:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400;1,700&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-white text-theme-dark overflow-x-hidden selection:bg-theme-dark selection:text-white">
    <slot />

    <!-- Lenis Smooth Scroll & GSAP Integration -->
    <script>
      import Lenis from 'lenis';
      import { gsap } from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';

      gsap.registerPlugin(ScrollTrigger);

      const lenis = new Lenis({
        duration: 1.2,
        easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
        smoothWheel: true,
        touchMultiplier: 1.5,
      });

      (window as any).lenis = lenis;

      lenis.on('scroll', ScrollTrigger.update);

      gsap.ticker.add((time) => {
        lenis.raf(time * 1000);
      });

      gsap.ticker.lagSmoothing(0);
    </script>
  </body>
</html>
