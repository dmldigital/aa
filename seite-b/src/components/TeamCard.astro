---
// TeamCard.astro: Desktop-Karte. Ruhezustand mit Namensschild, bei Hover/Fokus weiches Überblenden zur Info-Fläche.
interface Props {
  member: {
    code: string;
    name: string;
    role: string;
    shortRole?: string;
    image: string;
    qualification: string;
    department: string;
    experience?: string;
    quote: string;
  };
  compact?: boolean;
}

const { member, compact = false } = Astro.props;
---

<article
  class:list={[
    'team-card group relative overflow-hidden bg-ink border border-hairline theme-dark',
    compact ? 'flex-1 min-h-0' : 'aspect-[4/5] w-full',
  ]}
  tabindex="0"
  aria-label={`${member.name}, ${member.role}`}
  data-reveal
>
  <!-- Foto -->
  <div class="absolute inset-0 overflow-hidden">
    <img
      src={member.image}
      alt={member.name}
      class:list={['team-photo w-full h-full object-cover', compact ? 'team-photo-compact object-[center_10%]' : 'object-top']}
      loading="lazy"
      decoding="async"
    />
  </div>

  <!-- Ruhezustand: Namensschild -->
  <div class="team-tag absolute inset-x-0 bottom-0 z-[5] pointer-events-none bg-gradient-to-t from-ink/90 via-ink/45 to-transparent p-4 pt-14 flex flex-col justify-end">
    <span class="eyebrow !text-[11px] text-weber-light mb-1">{member.code}</span>
    <h3 class="text-[18px] font-medium tracking-[-0.01em] text-white m-0 leading-tight">{member.name}</h3>
    <p class="text-sm text-white/75 m-0 mt-0.5 leading-snug">{member.shortRole ?? member.role}</p>
  </div>

  <!-- Info-Fläche: weiches Überblenden -->
  <div class:list={['team-info absolute inset-0 z-20 bg-ink/[0.96] text-white flex flex-col justify-between', compact ? 'p-4' : 'p-5']}>
    <div class="team-info-inner">
      <div class="flex items-center justify-between gap-2 mb-2.5">
        <span class="eyebrow !text-[11px] text-weber-light">{member.code}</span>
        {!compact && (
          <span class="eyebrow !text-[11px] !tracking-[0.1em] text-white/60 text-right">{member.department}</span>
        )}
      </div>
      <h3 class:list={['font-medium tracking-[-0.015em] text-white m-0 leading-tight', compact ? 'text-[18px]' : 'text-[21px]']}>{member.name}</h3>
      <div class="text-sm font-medium text-weber-light mt-1 leading-snug">{member.role}</div>
      {!compact && (
        <>
          <div class="w-full h-px bg-hairline-dark my-3"></div>
          <p class="text-sm text-white/80 leading-[1.5] m-0 mb-2.5">{member.qualification}</p>
        </>
      )}
      <p class:list={['text-sm text-white/65 leading-[1.5] m-0', compact ? 'mt-2 line-clamp-2' : '']}>„{member.quote}“</p>
    </div>
    {!compact && member.experience && (
      <div class="pt-2.5 border-t border-hairline-dark eyebrow !text-[11px] text-white/60">{member.experience}</div>
    )}
  </div>
</article>

<style>
  .team-photo {
    transform: scale(1.35) translateY(-4%);
    transition: transform 1.4s var(--ease);
  }
  .team-photo-compact {
    transform: scale(1.05);
  }
  .team-card:hover .team-photo,
  .team-card:focus-visible .team-photo {
    transform: scale(1.4) translateY(-4%);
  }
  .team-card:hover .team-photo-compact,
  .team-card:focus-visible .team-photo-compact {
    transform: scale(1.1);
  }

  .team-tag {
    transition: opacity 0.6s var(--ease);
  }
  .team-info {
    opacity: 0;
    transition: opacity 0.6s var(--ease);
  }
  .team-info-inner {
    transform: translate3d(0, 10px, 0);
    transition: transform 0.9s var(--ease);
  }

  .team-card:hover .team-info,
  .team-card:focus-visible .team-info {
    opacity: 1;
  }
  .team-card:hover .team-info-inner,
  .team-card:focus-visible .team-info-inner {
    transform: none;
  }
  .team-card:hover .team-tag,
  .team-card:focus-visible .team-tag {
    opacity: 0;
  }
</style>
