---
// Hero.astro: Hintergrundvideo DJI_0144, Überschrift, Textbox mit Haupt-Button.
// Ein- und Ausblenden sowie die schwache Parallaxe steuert src/scripts/motion.ts.
---

<section class="section-hero theme-dark relative min-h-[850px] h-[100svh] lg:min-h-0 flex items-end pb-[70px] lg:pb-[clamp(1.5rem,8vh,5.625rem)] overflow-hidden bg-ink" data-hero>

  <!-- Hintergrund: Video, ruhige Verläufe -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none" aria-hidden="true">
    <video
      autoplay
      muted
      loop
      playsinline
      preload="auto"
      poster="/videos/DJI_0144_poster.webp"
      class="absolute inset-0 w-full h-full object-cover z-[1] scale-[1.08]"
      id="hero-bg-video"
      data-hero-video
    >
      <source src="/videos/DJI_0144.mp4" type="video/mp4" />
      <source src="https://mw-bauen.de/wp-content/uploads/2025/02/DJI_0144.mp4" type="video/mp4" />
    </video>
    <div class="absolute inset-0 z-[2] bg-gradient-to-t from-ink/95 via-ink/40 to-ink/50"></div>
    <div class="absolute inset-0 z-[3] bg-[radial-gradient(ellipse_at_center,_transparent_45%,_rgba(21,23,26,0.45)_100%)]"></div>
  </div>

  <div class="max-w-[1440px] mx-auto px-5 sm:px-8 relative z-10 w-full">
    <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-10 lg:gap-[clamp(1rem,2vw,2rem)]">

      <!-- Überschrift -->
      <div class="max-w-[820px] lg:min-w-0 lg:flex-1">
        <h1 class="h-hero text-white m-0" data-lines data-hero-title>
          Träume verwirklichen,
          <span class="block text-weber-light">Werte schaffen.</span>
        </h1>
      </div>

      <!-- Textbox mit Haupt-Button -->
      <div class="w-full lg:w-[clamp(28rem,42vw,38rem)] lg:flex-none flex flex-col sm:flex-row items-stretch self-start lg:self-end shadow-[0_30px_60px_-30px_rgba(0,0,0,0.6)]" data-reveal data-hero-box>
        <div class="flex-1 bg-paper text-text p-6 sm:p-8 lg:p-[clamp(16px,3.15vh,34px)_clamp(16px,2.8vw,40px)] flex items-center min-h-[118px] lg:min-h-[clamp(5.5rem,15vh,7.375rem)]">
          <p class="m-0 text-base lg:text-[clamp(0.9375rem,1.05vw,1.0625rem)] leading-[1.6]">
            Für Ihr Bauvorhaben sperren wir Brücken und bringen Ihre gewünschte Leistung auf den Punkt genau dorthin wo Sie möchten. Uns ist kein Weg zu weit und kein Platz zu klein.
          </p>
        </div>
        <div class="w-full sm:w-[211px] sm:min-w-[211px] flex items-stretch shrink-0">
          <a href="#leistungen" class="btn w-full min-h-[64px] sm:min-h-[118px] lg:min-h-[clamp(5.5rem,15vh,7.375rem)] px-6">
            Unsere Leistungen
          </a>
        </div>
      </div>

    </div>
  </div>
</section>
