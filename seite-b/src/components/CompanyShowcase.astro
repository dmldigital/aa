---
// CompanyShowcase.astro: dunkles 5-Spalten-Raster mit Text, Video, Kennzahlen und CTA,
// darunter ein Panorama-Video (DJI_0145).
const stats = [
  { label: 'Expert Architects', value: '25', unit: '+' },
  { label: 'Client Retention', value: '99', unit: '%' },
  null,
  { label: 'Completed Projects', value: '500', unit: '+' },
  { label: 'Eigener Fuhrpark', value: '100', unit: '%' },
];
---

<section class="section-why-us theme-dark w-full xl:min-h-[100svh] bg-ink bg-grain text-white flex flex-col overflow-x-clip border-t border-hairline-dark" id="unternehmen">

  <div class="w-full xl:flex-1 flex flex-col border-b border-hairline-dark">

    <!-- Reihe 1 -->
    <div class="grid grid-cols-1 xl:grid-cols-5 xl:flex-1 border-b border-hairline-dark min-h-0">

      <!-- Spalte 1 und 2: Überschrift -->
      <div class="col-span-1 xl:col-span-2 min-h-[280px] xl:min-h-0 p-6 sm:p-8 xl:p-12 border-b xl:border-b-0 xl:border-r border-hairline-dark flex flex-col justify-between gap-10">
        <div>
          <div class="eyebrow text-white/60 mb-4" data-reveal>Warum Weber</div>
          <h2 class="h-cell text-white m-0 max-w-[16ch] sm:max-w-none" data-lines>
            Wo strukturelle Präzision auf meisterhafte Ausführung trifft
          </h2>
        </div>
        <p class="copy text-white/70 m-0 max-w-[520px]" data-reveal>
          Über 25 Jahre Meistererfahrung im Hoch-, Tief- und Sanierungsbau. Mit eigenem Fuhrpark schaffen wir Werte, die Generationen überdauern.
        </p>
      </div>

      <!-- Spalte 3: Leitmotiv -->
      <div class="col-span-1 min-h-[200px] xl:min-h-0 p-6 sm:p-8 border-b xl:border-b-0 xl:border-r border-hairline-dark flex flex-col justify-between gap-6" data-reveal>
        <div class="eyebrow text-white/60">Unser Leitmotiv</div>
        <div class="text-[clamp(1.125rem,1rem+0.4vw,1.375rem)] font-normal text-white leading-[1.35] tracking-[-0.01em]">
          „Kein Weg zu weit, kein Platz zu klein.“
        </div>
        <div class="text-sm text-white/60">
          Fundierte Baukompetenz &amp; Verlässlichkeit.
        </div>
      </div>

      <!-- Spalte 4: Video (DJI_0100) -->
      <div
        class="video-tile col-span-1 relative overflow-hidden group cursor-pointer bg-ink border-b xl:border-b-0 xl:border-r border-hairline-dark h-[260px] sm:h-[340px] xl:h-full"
        data-video-tile
      >
        <div class="tile-media absolute inset-0">
          <video
            playsinline
            muted
            loop
            preload="metadata"
            poster="/videos/DJI_0100_poster.webp"
            class="w-full h-full object-cover object-center"
            aria-label="Fuhrpark und Krane auf der Baustelle"
          >
            <source src="/videos/DJI_0100.mp4" type="video/mp4" />
            <source src="https://mw-bauen.de/wp-content/uploads/2025/02/DJI_0100.mp4" type="video/mp4" />
          </video>
        </div>
        <div class="absolute inset-0 bg-gradient-to-t from-ink/70 via-transparent to-ink/25 pointer-events-none"></div>

        <button type="button" class="tile-play absolute inset-0 z-10 flex items-center justify-center bg-transparent border-0 cursor-pointer" aria-label="Video abspielen" data-video-toggle>
          <span class="w-14 h-14 rounded-full bg-white/95 text-ink shadow-[0_18px_36px_-16px_rgba(0,0,0,0.6)] flex items-center justify-center transition-transform duration-500 ease-mw group-hover:scale-105">
            <svg class="w-5 h-5 fill-current translate-x-0.5" viewBox="0 0 24 24" aria-hidden="true"><polygon points="5 3 19 12 5 21 5 3" /></svg>
          </span>
        </button>

        <div class="tile-badge absolute top-3 left-3 z-10 px-2.5 py-1.5 bg-ink/80 backdrop-blur-sm text-white eyebrow !text-[11px] pointer-events-none flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-weber-light"></span>
          Fuhrpark &amp; Krane
        </div>
      </div>

      <!-- Spalte 5: Versprechen -->
      <div class="col-span-1 min-h-[200px] xl:min-h-0 p-6 sm:p-8 flex flex-col justify-between gap-6" data-reveal>
        <div class="eyebrow text-white/60">Unser Versprechen</div>
        <p class="copy text-white/80 m-0">
          Persönliche Betreuung durch die Geschäftsführung und höchste Ausführungsqualität auf jeder Baustelle.
        </p>
        <div class="text-sm font-medium text-weber-light">
          100% Inhabergeführt
        </div>
      </div>

    </div>

    <!-- Reihe 2: Kennzahlen und CTA -->
    <div class="grid grid-cols-2 xl:grid-cols-5 h-auto xl:h-[190px]">
      {stats.map((s, i) => s ? (
        <div class={`col-span-1 min-h-[132px] p-5 sm:p-6 xl:p-8 flex flex-col justify-center border-hairline-dark ${i < 3 ? 'border-b xl:border-b-0' : ''} ${i === 0 || i === 3 ? 'border-r' : ''} ${i < 4 ? 'xl:border-r' : ''}`} data-reveal>
          <div class="text-[15px] text-white/70 mb-1.5">{s.label}</div>
          <div class="text-[clamp(2.5rem,3.6vw,3.5rem)] font-normal leading-none tracking-[-0.02em] text-white">
            {s.value}<span class="text-white/55">{s.unit}</span>
          </div>
        </div>
      ) : (
        <a
          href="#kontakt"
          class="cta-tile group col-span-2 xl:col-span-1 min-h-[132px] xl:min-h-0 p-6 xl:p-8 xl:border-r border-hairline-dark relative flex flex-col items-start justify-between bg-stone text-ink no-underline transition-colors duration-500 ease-mw hover:bg-paper border-b xl:border-b-0"
          style="--focus: var(--red);"
        >
          <span class="red-rule !bg-weber-red"></span>
          <span class="text-[clamp(1.25rem,1.1rem+0.5vw,1.5rem)] font-normal leading-[1.2] tracking-[-0.015em]">
            Sprechen wir über Ihr Vorhaben
          </span>
          <span class="flex items-center gap-2 text-sm font-medium">
            Kontakt aufnehmen
            <svg class="w-4 h-4 stroke-current fill-none stroke-[1.75] transition-transform duration-500 ease-mw group-hover:translate-x-1" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
          </span>
        </a>
      ))}
    </div>

  </div>

  <!-- Panorama-Streifen (DJI_0145) -->
  <div
    class="video-tile w-full h-[28vh] min-h-[200px] max-h-[280px] xl:h-[35vh] xl:min-h-[220px] xl:max-h-[350px] relative overflow-hidden bg-ink cursor-pointer group shrink-0"
    data-video-tile
    data-media
  >
    <span class="media-curtain" aria-hidden="true"></span>
    <div class="media-zoom">
      <div class="tile-media absolute inset-0">
        <video
          playsinline
          muted
          loop
          preload="metadata"
          poster="/videos/DJI_0145_poster.webp"
          class="w-full h-full object-cover object-center"
          aria-label="Großbaustellen-Panorama"
        >
          <source src="/videos/DJI_0145.mp4" type="video/mp4" />
          <source src="https://mw-bauen.de/wp-content/uploads/2025/02/DJI_0145.mp4" type="video/mp4" />
        </video>
      </div>
    </div>
    <div class="absolute inset-0 bg-gradient-to-t from-ink/55 via-transparent to-ink/20 pointer-events-none z-[5]"></div>

    <button type="button" class="tile-play absolute inset-0 z-10 flex items-center justify-center bg-transparent border-0 cursor-pointer" aria-label="Video abspielen" data-video-toggle>
      <span class="w-14 h-14 sm:w-16 sm:h-16 rounded-full bg-white/95 text-ink shadow-[0_20px_40px_-16px_rgba(0,0,0,0.6)] flex items-center justify-center transition-transform duration-500 ease-mw group-hover:scale-105">
        <svg class="w-6 h-6 fill-current translate-x-0.5" viewBox="0 0 24 24" aria-hidden="true"><polygon points="5 3 19 12 5 21 5 3" /></svg>
      </span>
    </button>

    <div class="tile-badge absolute top-4 left-4 sm:left-6 z-10 px-3 py-1.5 bg-ink/80 backdrop-blur-sm text-white eyebrow !text-[11px] pointer-events-none flex items-center gap-2">
      <span class="w-1.5 h-1.5 rounded-full bg-weber-light"></span>
      Großbaustellen-Panorama
    </div>
  </div>

</section>
