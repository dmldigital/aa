---
// ServicesList.astro: vier Leistungs-Karten. Desktop: Raster, Handy: Sticky-Stapel.
const services = [
  {
    badge: "Neubau & Tiefbau",
    title: "Hoch- & Tiefbau",
    description: "Erstellung von Ein- und Mehrfamilienhäusern, Wohnanlagen und Tiefgaragen sowie Erdarbeiten, Kanalbau und Entwässerung.",
    image: "/portfolio_0.jpg",
    link: "#kontakt"
  },
  {
    badge: "Werterhalt",
    title: "Sanierungsbau",
    description: "Professionelle Feuchtigkeits- und Betonsanierung sowie strukturelle Reparaturen von Fundamenten, Trägern und Stützwänden.",
    image: "/portfolio_3.jpg",
    link: "#kontakt"
  },
  {
    badge: "Bestand & Modernisierung",
    title: "Umbau & Renovierung",
    description: "Maßgeschneiderte Gebäudeerweiterungen, Grundrissänderungen und umfassende Renovierungsmaßnahmen im privaten und gewerblichen Bestand.",
    image: "/portfolio_1.jpg",
    link: "#kontakt"
  },
  {
    badge: "Schlüsselfertig",
    title: "Gewerbe & Hallenbau",
    description: "Termingerechte Realisierung gewerblicher Objekte, Industriehallen und schlüsselfertiger Wohnbauten aus meisterhafter Hand.",
    image: "/portfolio_2.jpg",
    link: "#kontakt"
  }
];
---

<section id="leistungen" class="section-services relative z-20 py-20 sm:py-28 bg-white text-text overflow-visible md:overflow-hidden">
  <div class="max-w-[1440px] mx-auto px-5 sm:px-8">

    <!-- Überschrift Tablet/Desktop -->
    <div class="mb-12 sm:mb-16 hidden md:block max-w-[760px]">
      <div class="eyebrow text-weber-red mb-4" data-reveal>Unsere Leistungen</div>
      <h2 class="h-section text-ink m-0" data-lines>
        Meisterhafte Bauleistungen &amp; Fachkompetenz
      </h2>
    </div>

    <!-- Handy: übereinanderlegende Leistungs-Flächen, gesteuert durch Scrollen -->
    <div class="md:hidden" data-mobile-services-track>
      <div class="service-mobile-sticky">
        <div class="mb-8">
          <div class="eyebrow text-weber-red mb-3">Unsere Leistungen</div>
          <h2 class="h-section text-ink m-0">
            Meisterhafte Bauleistungen &amp; Fachkompetenz
          </h2>
        </div>
        <div class="service-mobile-stage relative w-full overflow-hidden bg-white" data-mobile-services-stage>
        {services.map((item, index) => (
          <article
            class={`service-mobile-slide absolute inset-0 overflow-hidden bg-white text-text ${index === 0 ? 'is-revealed' : ''}`}
            style={`z-index: ${index + 1};`}
            aria-hidden={index === 0 ? "false" : "true"}
            inert={index !== 0}
          >
            <a
              href={item.link}
              class="group flex h-full flex-col no-underline text-inherit cursor-pointer"
              tabindex={index === 0 ? 0 : -1}
            >
              <div class="relative w-full h-[210px] overflow-hidden bg-ink">
                <div class="absolute top-3 left-3 z-30 px-2.5 py-1.5 bg-ink/85 backdrop-blur-sm text-white eyebrow !text-[11px] select-none">
                  {item.badge}
                </div>
                <img
                  src={item.image}
                  alt={item.title}
                  class="w-full h-full object-cover object-center transition-transform duration-[1100ms] ease-mw group-hover:scale-[1.04]"
                  loading={index === 0 ? "eager" : "lazy"}
                  decoding="async"
                />
                <div class="absolute bottom-3 right-3 z-30 w-10 h-10 bg-white text-ink flex items-center justify-center transition-colors duration-500 ease-mw group-hover:bg-weber-red group-hover:text-white">
                  <svg class="w-4 h-4 stroke-current fill-none stroke-[1.75]" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M7 17L17 7M7 7h10v10" />
                  </svg>
                </div>
              </div>
              <div class="pt-5 flex flex-col flex-1">
                <h3 class="h-card text-ink mb-2 m-0">{item.title}</h3>
                <p class="copy text-muted m-0">{item.description}</p>
              </div>
            </a>
          </article>
        ))}
        </div>
      </div>
      <div class="service-mobile-steps" aria-hidden="true">
        {services.slice(1).map((_, index) => (
          <div class="service-mobile-step" data-service-step={index + 1}></div>
        ))}
      </div>
    </div>

    <!-- Karten-Raster Tablet/Desktop -->
    <div class="hidden md:grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-x-6 gap-y-12" data-service-desktop>
      {services.map((item) => (
        <a
          href={item.link}
          class="group flex flex-col no-underline text-inherit cursor-pointer"
        >
          <div class="relative w-full h-[220px] sm:h-[240px] overflow-hidden bg-ink" data-media>
            <span class="media-curtain" aria-hidden="true"></span>
            <div class="media-zoom">
              <img
                src={item.image}
                alt={item.title}
                class="w-full h-full object-cover object-center transition-transform duration-[1100ms] ease-mw group-hover:scale-[1.04]"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="absolute inset-0 bg-gradient-to-t from-ink/40 via-transparent to-ink/10 pointer-events-none z-[5]"></div>

            <div class="absolute top-3 left-3 z-30 px-2.5 py-1.5 bg-ink/85 backdrop-blur-sm text-white eyebrow !text-[11px] select-none">
              {item.badge}
            </div>

            <div class="absolute bottom-3 right-3 z-30 w-10 h-10 bg-white text-ink flex items-center justify-center transition-colors duration-500 ease-mw group-hover:bg-weber-red group-hover:text-white">
              <svg class="w-4 h-4 stroke-current fill-none stroke-[1.75] transition-transform duration-500 ease-mw group-hover:translate-x-0.5 group-hover:-translate-y-0.5" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M7 17L17 7M7 7h10v10" />
              </svg>
            </div>
          </div>

          <div class="pt-5 flex flex-col flex-1" data-reveal>
            <h3 class="h-card text-ink group-hover:text-weber-red transition-colors duration-500 ease-mw mb-2 m-0">
              {item.title}
            </h3>
            <p class="copy text-muted m-0">
              {item.description}
            </p>
          </div>
        </a>
      ))}
    </div>

  </div>
</section>

<style>
  .service-mobile-sticky {
    display: flex;
    height: min(76svh, 660px);
    min-height: 520px;
    flex-direction: column;
    position: sticky;
    top: max(88px, calc((100svh - min(76svh, 660px)) / 2));
    background: white;
  }

  .service-mobile-stage {
    min-height: 0;
    flex: 1 1 0%;
  }

  .service-mobile-step {
    height: 72svh;
  }

  .service-mobile-slide {
    transform: translateY(100%);
    transition: transform 900ms var(--ease);
    will-change: transform;
  }

  .service-mobile-slide.is-revealed {
    transform: translateY(0);
  }

  @media (max-height: 700px) {
    .service-mobile-sticky {
      height: min(80svh, 560px);
      min-height: 460px;
      top: max(88px, calc((100svh - min(80svh, 560px)) / 2));
    }
  }
</style>
