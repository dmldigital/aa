---
// AboutIntro.astro - Exact Foundix Section 2 Architecture with Exact Weber Brand Red #e41e13 & Cropped Height
---

<section class="section bg-white overflow-hidden" id="ueber-uns">
  
  <!-- 1. Marquee Ticker (Foundix .wrap-text-slip) -->
  <div class="wrap-text-slip h-[98px] py-[30px] border-b border-black/10 bg-white flex items-center overflow-hidden">
    <div class="animate-slip flex items-center space-x-10 whitespace-nowrap">
      
      <!-- Set 1 -->
      <div class="text-slip flex items-center space-x-10">
        <span class="item-text-slip font-heading font-medium text-[16px] uppercase tracking-[1.5px] text-[#111111]">
          Hochbau &amp; Tiefbau
        </span>
        <span class="inline-block w-2 h-2 rounded-full bg-[#e41e13]"></span>
        
        <span class="item-text-slip font-heading font-medium text-[16px] uppercase tracking-[1.5px] text-[#111111]">
          Sanierungsbau &amp; Renovierung
        </span>
        <span class="inline-block w-2 h-2 rounded-full bg-[#e41e13]"></span>

        <span class="item-text-slip font-heading font-medium text-[16px] uppercase tracking-[1.5px] text-[#111111]">
          Handwerkliche Perfektion
        </span>
        <span class="inline-block w-2 h-2 rounded-full bg-[#e41e13]"></span>

        <span class="item-text-slip font-heading font-medium text-[16px] uppercase tracking-[1.5px] text-[#111111]">
          Termintreue &amp; Preisstabilität
        </span>
        <span class="inline-block w-2 h-2 rounded-full bg-[#e41e13]"></span>

        <span class="item-text-slip font-heading font-medium text-[16px] uppercase tracking-[1.5px] text-[#111111]">
          Wir bauen für Sie!
        </span>
        <span class="inline-block w-2 h-2 rounded-full bg-[#e41e13]"></span>

        <span class="item-text-slip font-heading font-medium text-[16px] uppercase tracking-[1.5px] text-[#111111]">
          Kein Weg zu weit, kein Platz zu klein
        </span>
        <span class="inline-block w-2 h-2 rounded-full bg-[#e41e13]"></span>
      </div>

      <!-- Set 2 (Identical for seamless loop) -->
      <div class="text-slip flex items-center space-x-10">
        <span class="item-text-slip font-heading font-medium text-[16px] uppercase tracking-[1.5px] text-[#111111]">
          Hochbau &amp; Tiefbau
        </span>
        <span class="inline-block w-2 h-2 rounded-full bg-[#e41e13]"></span>
        
        <span class="item-text-slip font-heading font-medium text-[16px] uppercase tracking-[1.5px] text-[#111111]">
          Sanierungsbau &amp; Renovierung
        </span>
        <span class="inline-block w-2 h-2 rounded-full bg-[#e41e13]"></span>

        <span class="item-text-slip font-heading font-medium text-[16px] uppercase tracking-[1.5px] text-[#111111]">
          Handwerkliche Perfektion
        </span>
        <span class="inline-block w-2 h-2 rounded-full bg-[#e41e13]"></span>

        <span class="item-text-slip font-heading font-medium text-[16px] uppercase tracking-[1.5px] text-[#111111]">
          Termintreue &amp; Preisstabilität
        </span>
        <span class="inline-block w-2 h-2 rounded-full bg-[#e41e13]"></span>

        <span class="item-text-slip font-heading font-medium text-[16px] uppercase tracking-[1.5px] text-[#111111]">
          Wir bauen für Sie!
        </span>
        <span class="inline-block w-2 h-2 rounded-full bg-[#e41e13]"></span>

        <span class="item-text-slip font-heading font-medium text-[16px] uppercase tracking-[1.5px] text-[#111111]">
          Kein Weg zu weit, kein Platz zu klein
        </span>
        <span class="inline-block w-2 h-2 rounded-full bg-[#e41e13]"></span>
      </div>

    </div>
  </div>

  <!-- 2. Intro Columns & Centered Rolling Counter (Foundix .about-home) -->
  <div class="container max-w-[1440px] mx-auto px-5 sm:px-8 pt-16 sm:pt-20 pb-16">
    <div class="about-home grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-start mb-16 lg:mb-20">
      
      <!-- Col 1: Introduction (Foundix .abh_col max-w-[440px]) -->
      <div class="abh_col lg:col-span-5 max-w-[440px]">
        <div class="abh_title font-heading text-[13px] font-medium uppercase tracking-[1.4px] text-[#111111] mb-6">
          Ein Wort zum Thema „Bauen“
        </div>
        <p class="abh_des text-[15px] font-body text-[#555555] leading-[26px] m-0">
          Der Wunsch nach Verwirklichung von Träumen und Visionen in Bauwerken ist so alt wie die Menschheit selbst. Viele Überlegungen, Planungen und Berechnungen sind im Vorfeld notwendig, ob im privaten oder gewerblichen Wohnungsbau oder für öffentliche Bauten.
        </p>
      </div>

      <!-- Col 2: Main Task (Foundix .abh_col._02 max-w-[400px]) -->
      <div class="abh_col _02 lg:col-span-5 max-w-[400px]">
        <div class="abh_title font-heading text-[13px] font-medium uppercase tracking-[1.4px] text-[#111111] mb-6">
          Unser Bestreben
        </div>
        <p class="abh_des text-[15px] font-body text-[#555555] leading-[26px] m-0">
          Unser Bestreben ist es, als kompetenter Partner am Bau Ihre individuellen Vorstellungen in handwerklicher Perfektion umzusetzen. Termintreue und Preisstabilität sind für uns genauso wichtig wie ein hoher Qualitätsstandard und zufriedene Kunden.
        </p>
      </div>

      <!-- Col 3: Centered Rolling Counter (Foundix .wrap-counter-home) -->
      <div class="wrap-counter-home lg:col-span-2 flex flex-col items-center justify-center text-center pt-2 lg:pt-0">
        <div class="wcu_counter flex flex-col items-center">
          <!-- Digits -->
          <div class="counter-number-wrap h-[76px] overflow-hidden flex font-heading text-[72px] lg:text-[76px] font-medium leading-[76px] text-[#111111]">
            <!-- Tens Digit (scrolls to 2) -->
            <div class="counter-number-item _1 flex flex-col transition-transform duration-1000 ease-out" id="counter-digit-1">
              <div>0</div><div>1</div><div>2</div><div>3</div><div>4</div>
              <div>5</div><div>6</div><div>7</div><div>8</div><div>9</div>
            </div>
            <!-- Ones Digit (scrolls to 5) -->
            <div class="counter-number-item _2 flex flex-col transition-transform duration-1000 ease-out" id="counter-digit-2">
              <div>0</div><div>1</div><div>2</div><div>3</div><div>4</div>
              <div>5</div><div>6</div><div>7</div><div>8</div><div>9</div>
            </div>
          </div>

          <!-- Small Weber Red Plus below digits (#e41e13) -->
          <div class="text-[22px] font-medium text-[#e41e13] my-1 leading-none">+</div>

          <!-- Centered 3-line description (Foundix original) -->
          <div class="text-counter font-heading text-[11px] font-medium uppercase tracking-[2px] text-[#111111] leading-[1.4] text-center">
            Jahre<br/>
            <span class="text-[#e41e13]">Meisterhafte</span><br/>
            Bau-Erfahrung
          </div>
        </div>
      </div>

    </div>

    <!-- 3. Curtain Image & Weber Red Quote Box (Foundix .abh_tes with cropped 440px height) -->
    <div class="abh_tes flex flex-col lg:flex-row items-stretch gap-5 lg:gap-5">
      
      <!-- Left: Interactive Video with Poster & Play Button (Plays on hover/click) -->
      <div 
        class="abh_tes_image group flex-1 h-[420px] lg:h-[440px] min-h-[420px] lg:min-h-[440px] max-h-[440px] overflow-hidden relative bg-[#111111] cursor-pointer"
        id="video-showcase-container"
      >
        <div class="box-image overlay_lr relative w-full h-full overflow-hidden" id="curtain-container">
          <!-- Overlays for GSAP Curtain Reveal (Rot-Schwarz) -->
          <div class="overlay_dark absolute inset-0 bg-[#111111] z-20 pointer-events-none" id="curtain-dark"></div>
          <div class="overlay_light absolute inset-0 bg-[#e41e13] z-10 pointer-events-none" id="curtain-light"></div>
          
          <!-- Video Element with Poster (DJI_0165) -->
          <video 
            id="intro-video"
            playsinline 
            muted 
            loop 
            preload="metadata"
            poster="/videos/DJI_0165_poster.jpg"
            class="w-full h-full object-cover object-center transition-transform duration-700 ease-out group-hover:scale-105"
          >
            <source src="/videos/DJI_0165.mp4" type="video/mp4" />
            <source src="https://mw-bauen.de/wp-content/uploads/2025/02/DJI_0165.mp4" type="video/mp4" />
          </video>

          <!-- Subtle Dark Gradient Scrim -->
          <div class="absolute inset-0 bg-black/25 pointer-events-none z-[5] group-hover:bg-black/10 transition-colors duration-300"></div>

          <!-- Elegant Play Button in Center (Fades on hover/playback) -->
          <div 
            id="video-play-btn"
            class="absolute inset-0 z-10 flex items-center justify-center pointer-events-none transition-all duration-400 ease-out"
          >
            <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-full bg-white/95 text-[#111111] shadow-2xl backdrop-blur-md flex items-center justify-center transform transition-all duration-300 group-hover:scale-110 group-hover:bg-[#e41e13] group-hover:text-white">
              <svg class="w-6 h-6 sm:w-7 sm:h-7 fill-current translate-x-0.5 transition-colors" viewBox="0 0 24 24">
                <polygon points="5 3 19 12 5 21 5 3" />
              </svg>
            </div>
          </div>

          <!-- Video Playing Indicator Badge (Top Left) -->
          <div 
            id="video-badge"
            class="absolute top-4 left-4 z-10 px-3 py-1 bg-black/70 backdrop-blur-sm text-white text-[10px] font-heading font-semibold uppercase tracking-wider rounded-sm opacity-0 transition-opacity duration-300 flex items-center gap-2 pointer-events-none"
          >
            <span class="w-2 h-2 rounded-full bg-[#e41e13] animate-pulse"></span>
            Projekt-Einblick
          </div>
        </div>
      </div>

      <!-- Right: Weber Red Quote Box (Foundix .abh_tes_box 495px x 440px in #e41e13) -->
      <div class="abh_tes_box w-full lg:w-[495px] lg:min-w-[495px] h-auto lg:h-[440px] min-h-[420px] lg:min-h-[440px] max-h-[440px] bg-[#e41e13] text-white p-8 sm:p-10 lg:p-[45px_40px_35px] flex flex-col justify-between shrink-0 shadow-xl">
        
        <!-- Quote Text -->
        <div class="abh_text font-heading font-medium text-[20px] sm:text-[22px] leading-[32px] text-white">
          „Für Ihr Bauvorhaben sperren wir Brücken und bringen Ihre gewünschte Leistung auf den Punkt genau dorthin wo Sie möchten.“
        </div>

        <!-- Founder / CEO Info (Foundix .abh_if) -->
        <div class="abh_if flex items-center gap-4 my-6">
          <img 
            src="/team/marco-intro.png" 
            alt="Manfred Weber" 
            class="abh_img w-12 h-12 rounded-full object-cover grayscale brightness-90 border border-white/30 shrink-0"
          />
          <div class="abh_ceo">
            <div class="abh_name font-heading font-medium text-[13px] uppercase tracking-[1.4px] text-white">
              Manfred Weber
            </div>
            <div class="abh_position font-body text-[12px] text-white/80 mt-0.5">
              Geschäftsführer &amp; Gründer, Manfred Weber GmbH &amp; CoKG
            </div>
          </div>
        </div>

        <!-- Solid White Button in Quote Box -->
        <div class="w-full">
          <a 
            href="#ueber-uns" 
            class="button-style-1 light-variant w-full h-[52px] !bg-white !text-[#e41e13] font-heading font-medium text-[12px] uppercase tracking-[1.2px] flex items-center justify-center select-none shadow-md"
          >
            <div class="before_button_hover">
              <div class="bg_before_button_hover"></div>
            </div>
            <span class="wrap_textbutton">
              Mehr über uns
            </span>
          </a>
        </div>

      </div>

    </div>

  </div>
</section>

<!-- GSAP ScrollTrigger Script for Section 2 -->
<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  window.addEventListener('DOMContentLoaded', () => {

    // 1. Counter Animation: Scroll digits to "2" and "5"
    ScrollTrigger.create({
      trigger: '.counter-number-wrap',
      start: 'top 85%',
      once: true,
      onEnter: () => {
        gsap.to('#counter-digit-1', {
          y: -152,
          duration: 1.8,
          ease: 'power3.out'
        });
        gsap.to('#counter-digit-2', {
          y: -380,
          duration: 2.2,
          ease: 'power3.out'
        });
      }
    });

    // 2. Curtain Reveal Animation for .box-image
    const curtainTl = gsap.timeline({
      scrollTrigger: {
        trigger: '#curtain-container',
        start: 'top 80%',
        once: true
      }
    });

    curtainTl
      .to('#curtain-dark', {
        xPercent: 101,
        duration: 1.0,
        ease: 'power3.inOut'
      })
      .to('#curtain-light', {
        xPercent: 101,
        duration: 1.0,
        ease: 'power3.inOut'
      }, '-=0.8')
      .to('#intro-video', {
        scale: 1.0,
        duration: 1.4,
        ease: 'power2.out'
      }, '-=1.0');

    // 3. Interactive Video Hover & Click Playback
    const videoContainer = document.getElementById('video-showcase-container');
    const video = document.getElementById('intro-video') as HTMLVideoElement | null;
    const playBtn = document.getElementById('video-play-btn');
    const badge = document.getElementById('video-badge');

    if (videoContainer && video) {
      const playVideo = () => {
        video.play().then(() => {
          if (playBtn) {
            playBtn.classList.add('opacity-0', 'scale-90');
          }
          if (badge) {
            badge.classList.remove('opacity-0');
          }
        }).catch(() => {});
      };

      const pauseVideo = () => {
        video.pause();
        if (playBtn) {
          playBtn.classList.remove('opacity-0', 'scale-90');
        }
        if (badge) {
          badge.classList.add('opacity-0');
        }
      };

      // Play on hover
      videoContainer.addEventListener('mouseenter', playVideo);
      videoContainer.addEventListener('mouseleave', pauseVideo);

      // Toggle on click
      videoContainer.addEventListener('click', () => {
        if (video.paused) {
          playVideo();
        } else {
          pauseVideo();
        }
      });
    }
  });
</script>
