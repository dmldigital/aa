        <div>
          <div class="flex items-center gap-3 mb-5">
            <img 
              src="/schriftzug.png" 
              alt="Manfred Weber Logo" 
              class="h-10 sm:h-12 w-auto object-contain filter drop-shadow-[0_2px_8px_rgba(0,0,0,0.85)]"
            />
            <div class="flex flex-col text-left">
              <span class="font-heading font-bold text-lg sm:text-xl tracking-[1.5px] uppercase text-white">MANFRED WEBER</span>
              <span class="font-heading font-semibold text-[10px] tracking-[2.5px] uppercase text-[#e41e13]">GMBH &amp; CO. KG</span>
            </div>
          </div>

          <h2 class="font-body font-normal text-2xl sm:text-3xl lg:text-[32px] leading-[1.2] text-white m-0 mb-4">
            Bereit für Ihr nächstes Bauvorhaben?
          </h2>
          <p class="font-body text-[14px] text-white/70 leading-relaxed m-0 max-w-[480px]">
            Ob anspruchsvoller Hochbau, fundierter Tiefbau oder nachhaltige Sanierung: Wir stehen für meisterhafte Handwerksqualität, absolute Termintreue und persönliche Betreuung.
          </p>
        </div>

        <!-- Slogan Tag -->
        <div class="pt-6 mt-6 border-t border-white/10 flex items-center gap-3">
          <span class="w-2 h-2 rounded-full bg-[#e41e13] animate-pulse"></span>
          <span class="font-heading text-xs uppercase tracking-[2px] text-white/60">
            „Kein Weg zu weit, kein Platz zu klein.“
          </span>
        </div>
      </div>

      <!-- Col 3: Media 1 - Drone Video (DJI_0204.mp4) -->
      <div 
        class="col-span-1 relative self-start overflow-hidden group cursor-pointer footer-anthracite-panel border-b md:border-b-0 md:border-r border-white/10 aspect-video min-h-0 lg:aspect-auto lg:self-stretch lg:min-h-[320px]"
        id="footer-video-box"
      >
        <video 
          id="footer-drone-video"
          playsinline 
          muted 
          loop 
          preload="metadata"
          poster="/videos/DJI_0204_poster.jpg"
          class="absolute inset-0 w-full h-full object-cover object-center transition-transform duration-700 ease-out group-hover:scale-105 lg:static"
        >
          <source src="/videos/DJI_0204.mp4" type="video/mp4" />
          <source src="https://mw-bauen.de/wp-content/uploads/2025/02/DJI_0204.mp4" type="video/mp4" />
        </video>

        <!-- Scrim -->
        <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-black/30 pointer-events-none group-hover:opacity-60 transition-opacity z-[5]"></div>

        <!-- Centered Play Button -->
        <div 
          id="footer-play-btn"
          class="absolute inset-0 z-10 flex items-center justify-center pointer-events-none transition-all duration-300 ease-out"
        >
          <div class="w-12 h-12 sm:w-14 sm:h-14 rounded-full bg-white/90 text-[#111111] shadow-xl backdrop-blur-sm flex items-center justify-center transform transition-all duration-300 group-hover:scale-110 group-hover:bg-[#e41e13] group-hover:text-white">
            <svg class="w-5 h-5 fill-current translate-x-0.5" viewBox="0 0 24 24">
              <polygon points="5 3 19 12 5 21 5 3" />
            </svg>
          </div>
        </div>

        <!-- Badge -->
        <div class="absolute top-3 left-3 z-10 px-2.5 py-1 footer-anthracite-badge backdrop-blur-sm text-white text-[10px] font-body uppercase tracking-wider rounded-sm pointer-events-none flex items-center gap-1.5">
          <span class="w-1.5 h-1.5 rounded-full bg-[#e41e13] animate-pulse"></span>
          <span>Drohnen-Überblick</span>
        </div>
      </div>

      <!-- Col 4: Media 2 - Photo (portfolio_4.jpg: Kran-Großbaustelle) -->
      <div class="hidden md:block col-span-1 relative overflow-hidden group cursor-pointer footer-anthracite-panel border-b md:border-b-0 md:border-r border-white/10 min-h-[260px] lg:min-h-[320px]">
        <img 
          src="/portfolio_4.jpg" 
          alt="Manfred Weber Großbaustelle & Krane"
          class="w-full h-full object-cover object-center transition-transform duration-700 ease-out group-hover:scale-105"
        />

        <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-black/20 pointer-events-none group-hover:opacity-60 transition-opacity z-[5]"></div>

        <!-- Badge -->
        <div class="absolute top-3 left-3 z-10 px-2.5 py-1 footer-anthracite-badge backdrop-blur-sm text-white text-[10px] font-body uppercase tracking-wider rounded-sm pointer-events-none flex items-center gap-1.5">
          <span class="w-1.5 h-1.5 rounded-full bg-[#e41e13]"></span>
          <span>Großbaustelle &amp; Krane</span>
        </div>

        <!-- Corner Arrow Button -->
        <div class="absolute bottom-3 right-3 z-10 w-9 h-9 bg-white text-[#111111] flex items-center justify-center shadow-md transition-all duration-300 group-hover:bg-[#e41e13] group-hover:text-white">
          <svg class="w-4 h-4 stroke-current fill-none stroke-2 transform transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" viewBox="0 0 24 24">
            <path d="M7 17L17 7M7 7h10v10" />
          </svg>
        </div>
      </div>

      <!-- Col 5: Media 3 - Photo (portfolio_5.jpg: Fundament & Betonbau) -->
      <div class="hidden md:block lg:hidden col-span-1 relative overflow-hidden group cursor-pointer footer-anthracite-panel min-h-[260px] lg:min-h-[320px]">
        <img 
          src="/portfolio_5.jpg" 
          alt="Manfred Weber Fundament- & Betonbau"
          class="w-full h-full object-cover object-center transition-transform duration-700 ease-out group-hover:scale-105"
        />

        <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-black/20 pointer-events-none group-hover:opacity-60 transition-opacity z-[5]"></div>

        <!-- Badge -->
        <div class="absolute top-3 left-3 z-10 px-2.5 py-1 footer-anthracite-badge backdrop-blur-sm text-white text-[10px] font-body uppercase tracking-wider rounded-sm pointer-events-none flex items-center gap-1.5">
          <span class="w-1.5 h-1.5 rounded-full bg-[#e41e13]"></span>
          <span>Fundament &amp; Betonbau</span>
        </div>

        <!-- Corner Arrow Button -->
