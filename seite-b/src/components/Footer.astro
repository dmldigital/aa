---
// Footer.astro: Anthrazit-Raster mit Intro, Video, Fotos, Navigation, Standort, Bürozeiten und Kontakt-Kachel.
const navLinks = [
  { label: 'Startseite', href: '/' },
  { label: 'Unsere Leistungen', href: '#leistungen' },
  { label: 'Über uns & Werte', href: '#ueber-uns' },
  { label: 'Fuhrpark & Einblicke', href: '#unternehmen' },
  { label: 'Unser Team', href: '#team' },
];
---

<footer class="footer theme-dark w-full bg-ink bg-grain text-white border-t border-hairline-dark overflow-hidden" id="kontakt">

  <div class="max-w-[1440px] mx-auto px-5 sm:px-8 w-full">

    <!-- Reihe 1: Intro und Medien -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 border-l border-b border-hairline-dark">

      <div class="lg:col-span-2 py-10 sm:py-12 lg:py-14 pr-6 sm:pr-10 lg:pr-14 pl-5 sm:pl-8 border-b md:border-b-0 md:border-r border-hairline-dark flex flex-col justify-between min-h-[320px]">
        <div>
          <div class="flex items-center gap-3 mb-8" data-reveal>
            <img
              src="/schriftzug.png"
              alt=""
              class="h-10 sm:h-12 w-auto object-contain"
              width="68"
              height="48"
            />
            <div class="flex flex-col leading-tight text-left">
              <span class="text-lg sm:text-xl font-medium text-white">Manfred Weber</span>
              <span class="eyebrow !text-[11px] !tracking-[0.16em] text-weber-light">GmbH &amp; Co. KG</span>
            </div>
          </div>

          <h2 class="h-cell text-white m-0 mb-5" data-lines>
            Bereit für Ihr nächstes Bauvorhaben?
          </h2>
          <p class="copy text-white/70 m-0 max-w-[480px]" data-reveal>
            Ob anspruchsvoller Hochbau, fundierter Tiefbau oder nachhaltige Sanierung: Wir stehen für meisterhafte Handwerksqualität, absolute Termintreue und persönliche Betreuung.
          </p>
        </div>

        <div class="pt-6 mt-8 border-t border-hairline-dark flex items-center gap-3">
          <span class="w-[5px] h-[5px] rounded-full bg-weber-light shrink-0" aria-hidden="true"></span>
          <span class="text-[15px] text-white/70">
            „Kein Weg zu weit, kein Platz zu klein.“
          </span>
        </div>
      </div>

      <!-- Drohnen-Video (DJI_0204) -->
      <div
        class="video-tile group col-span-1 relative self-start overflow-hidden cursor-pointer bg-ink border-b md:border-b-0 md:border-r border-hairline-dark aspect-video min-h-0 lg:aspect-auto lg:self-stretch lg:min-h-[320px]"
        data-video-tile
        data-media
      >
        <span class="media-curtain" aria-hidden="true"></span>
        <div class="media-zoom">
          <div class="tile-media absolute inset-0">
            <video
              playsinline
              muted
              loop
              preload="metadata"
              poster="/videos/DJI_0204_poster.webp"
              class="absolute inset-0 w-full h-full object-cover object-center"
              aria-label="Drohnenüberblick über die Baustelle"
            >
              <source src="/videos/DJI_0204.mp4" type="video/mp4" />
              <source src="https://mw-bauen.de/wp-content/uploads/2025/02/DJI_0204.mp4" type="video/mp4" />
            </video>
          </div>
        </div>
        <div class="absolute inset-0 bg-gradient-to-t from-ink/70 via-transparent to-ink/25 pointer-events-none z-[5]"></div>

        <button type="button" class="tile-play absolute inset-0 z-10 flex items-center justify-center bg-transparent border-0 cursor-pointer" aria-label="Video abspielen" data-video-toggle>
          <span class="w-14 h-14 rounded-full bg-white/95 text-ink shadow-[0_18px_36px_-16px_rgba(0,0,0,0.6)] flex items-center justify-center transition-transform duration-500 ease-mw group-hover:scale-105">
            <svg class="w-5 h-5 fill-current translate-x-0.5" viewBox="0 0 24 24" aria-hidden="true"><polygon points="5 3 19 12 5 21 5 3" /></svg>
          </span>
        </button>

        <div class="tile-badge absolute top-3 left-3 z-10 px-2.5 py-1.5 bg-ink/80 backdrop-blur-sm text-white eyebrow !text-[11px] pointer-events-none flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-weber-light"></span>
          Drohnen-Überblick
        </div>
      </div>

      <!-- Foto 1 -->
      <div class="hidden md:block col-span-1 relative overflow-hidden group bg-ink border-hairline-dark md:border-r lg:border-r min-h-[260px] lg:min-h-[320px]" data-media>
        <span class="media-curtain" aria-hidden="true"></span>
        <div class="media-zoom">
          <img
            src="/portfolio_4.jpg"
            alt="Großbaustelle mit Kränen"
            class="w-full h-full object-cover object-center transition-transform duration-[1100ms] ease-mw group-hover:scale-[1.04]"
            loading="lazy"
            decoding="async"
          />
        </div>
        <div class="absolute inset-0 bg-gradient-to-t from-ink/60 via-transparent to-ink/15 pointer-events-none z-[5]"></div>
        <div class="absolute top-3 left-3 z-10 px-2.5 py-1.5 bg-ink/80 backdrop-blur-sm text-white eyebrow !text-[11px] pointer-events-none flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-weber-light"></span>
          Großbaustelle &amp; Krane
        </div>
      </div>

      <!-- Foto 2 (nur Tablet) -->
      <div class="hidden md:block lg:hidden col-span-1 relative overflow-hidden group bg-ink min-h-[260px]" data-media>
        <span class="media-curtain" aria-hidden="true"></span>
        <div class="media-zoom">
          <img
            src="/portfolio_5.jpg"
            alt="Fundament- und Betonbau"
            class="w-full h-full object-cover object-center transition-transform duration-[1100ms] ease-mw group-hover:scale-[1.04]"
            loading="lazy"
            decoding="async"
          />
        </div>
        <div class="absolute inset-0 bg-gradient-to-t from-ink/60 via-transparent to-ink/15 pointer-events-none z-[5]"></div>
        <div class="absolute top-3 left-3 z-10 px-2.5 py-1.5 bg-ink/80 backdrop-blur-sm text-white eyebrow !text-[11px] pointer-events-none flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-weber-light"></span>
          Fundament &amp; Betonbau
        </div>
      </div>

    </div>

    <!-- Reihe 2: Navigation, Standort, Bürozeiten, Kontakt -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 border-l border-b border-hairline-dark">

      <div class="py-8 lg:py-10 pr-6 sm:pr-8 lg:pr-10 pl-5 sm:pl-8 border-b lg:border-b-0 sm:border-r border-hairline-dark min-h-[240px]">
        <div class="eyebrow text-white/60 mb-5">Navigation</div>
        <ul role="list" class="space-y-3 m-0 p-0 list-none text-[15px]">
          {navLinks.map((l) => (
            <li><a href={l.href} class="text-white/80 hover:text-white transition-colors duration-500 ease-mw">{l.label}</a></li>
          ))}
        </ul>
      </div>

      <div class="p-6 sm:p-8 lg:p-10 border-b lg:border-b-0 lg:border-r border-hairline-dark flex flex-col justify-between gap-6 min-h-[240px]">
        <div>
          <div class="eyebrow text-white/60 mb-5">Standort</div>
          <div class="text-[17px] font-medium text-white mb-2">Manfred Weber GmbH &amp; Co. KG</div>
          <address class="not-italic text-[15px] text-white/70 leading-relaxed">
            Jahnstraße 9<br />
            67273 Weisenheim am Berg<br />
            Deutschland
          </address>
        </div>
        <div class="eyebrow !text-[11px] text-weber-light pt-3 border-t border-hairline-dark">
          Region Rhein-Neckar &amp; Pfalz
        </div>
      </div>

      <div class="p-6 sm:p-8 lg:p-10 border-b sm:border-b-0 sm:border-r border-hairline-dark flex flex-col justify-between gap-6 min-h-[240px]">
        <div>
          <div class="eyebrow text-white/60 mb-5">Bürozeiten</div>
          <dl class="space-y-2.5 text-[15px] text-white/80 leading-snug m-0">
            <div class="flex justify-between gap-4">
              <dt class="text-white/60">Mo bis Do</dt>
              <dd class="m-0">07:00–17:00 Uhr</dd>
            </div>
            <div class="flex justify-between gap-4">
              <dt class="text-white/60">Freitag</dt>
              <dd class="m-0">07:00–15:30 Uhr</dd>
            </div>
            <div class="flex justify-between gap-4">
              <dt class="text-white/60">Sa &amp; So</dt>
              <dd class="m-0 text-white/60">Geschlossen</dd>
            </div>
          </dl>
        </div>
        <div class="text-[15px] text-white/70 pt-3 border-t border-hairline-dark">
          E-Mail: <a href="mailto:info@mw-bauen.de" class="text-white underline underline-offset-4 decoration-white/40 hover:decoration-white transition-colors duration-500 ease-mw">info@mw-bauen.de</a>
        </div>
      </div>

      <!-- Kontakt-Kachel: Stein mit feiner roter Linie -->
      <div class="p-6 sm:p-8 lg:p-10 flex flex-col justify-between gap-6 bg-stone text-ink min-h-[240px]" style="--focus: var(--red);">
        <div>
          <span class="red-rule !bg-weber-red mb-5"></span>
          <div class="eyebrow text-ink/70 mb-4">Projektanfrage &amp; Direktkontakt</div>
          <p class="text-[17px] leading-snug m-0 mb-4 text-ink">
            Lassen Sie uns über Ihr Bauvorhaben sprechen.
          </p>
          <a href="tel:+4963538060" class="block text-[clamp(1.5rem,1.9vw,1.75rem)] font-medium tracking-[-0.02em] leading-tight text-ink no-underline whitespace-nowrap hover:text-weber-red transition-colors duration-500 ease-mw">
            0 63 53 / 80 60
          </a>
          <span class="text-[15px] text-ink/70 mt-1 block">
            Telefax: 0 63 53 / 50 80 402
          </span>
        </div>
        <div class="pt-4 border-t border-ink/15 flex items-center justify-between gap-4">
          <a href="mailto:info@mw-bauen.de?subject=Projektanfrage" class="text-[15px] font-medium text-ink no-underline underline-offset-4 hover:underline">
            Jetzt anfragen
          </a>
          <a href="tel:+4963538060" aria-label="Manfred Weber anrufen" class="w-11 h-11 bg-ink text-white flex items-center justify-center transition-colors duration-500 ease-mw hover:bg-weber-red">
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M6.62 10.79a15.053 15.053 0 006.59 6.59l2.2-2.2a1 1 0 011.11-.21c1.12.45 2.33.69 3.48.69a1 1 0 011 1v3.5a1 1 0 01-1 1C10.61 21 3 13.39 3 4a1 1 0 011-1h3.5a1 1 0 011 1c0 1.15.24 2.36.69 3.48a1 1 0 01-.21 1.11l-2.36 2.2z"/>
            </svg>
          </a>
        </div>
      </div>

    </div>

  </div>

  <!-- Fußzeile -->
  <div class="max-w-[1440px] mx-auto px-5 sm:px-8 py-7 sm:py-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-sm text-white/70">
    <div>
      &copy; {new Date().getFullYear()} Manfred Weber GmbH &amp; Co. KG. Alle Rechte vorbehalten.
    </div>

    <div class="hidden md:block eyebrow !text-[11px] text-white/55">
      Handwerkliche Perfektion seit über 25 Jahren
    </div>

    <div class="flex items-center gap-6">
      <a href="https://mw-bauen.de/impressum/" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors duration-500 ease-mw">Impressum</a>
      <a href="https://mw-bauen.de/datenschutz/" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors duration-500 ease-mw">Datenschutz</a>
      <button
        type="button"
        data-scroll-top
        class="hover:text-white transition-colors duration-500 ease-mw flex items-center gap-1.5 cursor-pointer"
        aria-label="Nach oben scrollen"
      >
        <span>Nach oben</span>
        <svg class="w-3.5 h-3.5 stroke-current stroke-2 fill-none" viewBox="0 0 24 24" aria-hidden="true">
          <polyline points="18 15 12 9 6 15"></polyline>
        </svg>
      </button>
    </div>
  </div>

</footer>
