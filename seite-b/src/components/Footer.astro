      <!-- Quadrat 1 (SCHWARZ): Navigation Links (pl-0 for flush alignment) -->
      <div class="py-6 sm:py-8 lg:py-9 pr-6 sm:pr-8 lg:pr-9 pl-5 sm:pl-6 lg:pl-8 border-b lg:border-b-0 sm:border-r border-white/10 flex flex-col justify-between footer-anthracite-panel min-h-[220px]">
        <div>
