---
// Footer.astro - Architectural Foundix "Why Choose Us" Grid Architecture
// Footer grid with the drone video, one project photo, contact information, and interactive elements.
// full Weber contact info, navigation, opening hours, and interactive elements.
---

<footer class="footer-foundix footer-anthracite-panel w-full text-white border-t border-white/10 select-none overflow-hidden" id="kontakt">
  
  <!-- Container aligned to exact normal website width (1440px) -->
  <div class="max-w-[1440px] mx-auto px-5 sm:px-8 w-full">
    
    <!-- ===================================================================
         ROW 1: 5-COLUMN ARCHITECTURAL GRID (Intro & 3 Media Squares)
         =================================================================== -->
