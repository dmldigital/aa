</footer>

<!-- Video hover/click playback -->
<script>
  const videoBox = document.getElementById('footer-video-box');
  const video = document.getElementById('footer-drone-video') as HTMLVideoElement | null;
  const playBtn = document.getElementById('footer-play-btn');

  if (videoBox && video) {
    const play = () => {
      video.play().then(() => {
        if (playBtn) playBtn.classList.add('opacity-0', 'scale-90');
      }).catch(() => {});
    };

    const pause = () => {
      video.pause();
      if (playBtn) playBtn.classList.remove('opacity-0', 'scale-90');
    };

    videoBox.addEventListener('mouseenter', play);
    videoBox.addEventListener('mouseleave', pause);
    videoBox.addEventListener('click', () => {
      if (video.paused) play();
      else pause();
    });
  }
</script>

<style>
  .footer-foundix,
  .footer-anthracite-panel {
    background-color: #17191c;
    background-image: url('/footer-grain.svg');
    background-size: 180px 180px;
    background-repeat: repeat;
  }

  .footer-anthracite-badge {
    background-color: rgba(23, 25, 28, 0.9);
    background-image: url('/footer-grain.svg');
    background-size: 140px 140px;
  }
</style>
