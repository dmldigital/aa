<!-- GSAP ScrollTrigger Script for Team Section Entrance -->
<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  window.addEventListener('DOMContentLoaded', () => {
    ScrollTrigger.create({
      trigger: '#team',
      start: 'top 85%',
      once: true,
      onEnter: () => {
        gsap.fromTo('.foundix-team-card, .group\\/calea, .group\\/atilla',
          { y: 25, opacity: 0 },
          { y: 0, opacity: 1, duration: 0.6, stagger: 0.05, ease: 'power3.out' }
        );
      }
    });

    const mobileTeam = document.querySelector('[data-team-mobile]');
    const teamDialog = mobileTeam?.querySelector('[data-team-dialog]');
    if (mobileTeam && teamDialog) {
      mobileTeam.addEventListener('click', (event) => {
        const trigger = event.target.closest('[data-team-open]');
        if (trigger) {
          const fields = {
            name: trigger.dataset.teamName,
            role: trigger.dataset.teamRole,
            image: trigger.dataset.teamImage,
            code: trigger.dataset.teamCode,
            department: trigger.dataset.teamDepartment,
            qualification: trigger.dataset.teamQualification,
            quote: trigger.dataset.teamQuote,
            experience: trigger.dataset.teamExperience,
          };
          mobileTeam.querySelector('[data-team-dialog-image]').src = fields.image;
          mobileTeam.querySelector('[data-team-dialog-image]').alt = fields.name;
          mobileTeam.querySelector('[data-team-dialog-code]').textContent = fields.code;
          mobileTeam.querySelector('[data-team-dialog-department]').textContent = fields.department;
          mobileTeam.querySelector('[data-team-dialog-name]').textContent = fields.name;
          mobileTeam.querySelector('[data-team-dialog-role]').textContent = fields.role;
          mobileTeam.querySelector('[data-team-dialog-qualification]').textContent = fields.qualification;
          mobileTeam.querySelector('[data-team-dialog-quote]').textContent = fields.quote;
          const experience = mobileTeam.querySelector('[data-team-dialog-experience]');
          experience.hidden = !fields.experience;
          experience.textContent = fields.experience ? `${fields.experience} Erfahrung` : '';
          teamDialog.showModal();
          return;
        }

        if (event.target.closest('[data-team-dialog-close]')) teamDialog.close();
      });

      teamDialog.addEventListener('click', (event) => {
        if (event.target === teamDialog) teamDialog.close();
      });
    }
  });
</script>

