    role: "Geschäftsleitung der kaufmännischen Abteilung",
    shortRole: "Geschäftsleitung Kaufmännisch",
    image: "/team/michelle.png",
    qualification: "Finanzen & Buchhaltung • Strategische Unternehmensplanung",
    department: "FINANZEN & LEITUNG",
    experience: "12+ Jahre",
    quote: "Zuverlässige kaufmännische Abwicklung schafft Vertrauen und Planungssicherheit."
  },
  {
    code: "MW-AS-03",
    name: "Melissa Weber",
