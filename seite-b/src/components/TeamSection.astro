  {
    code: "MW-BT-06",
    name: "Andreas Finkenstein",
    role: "Bautechnik & Fachplanung",
    shortRole: "Bautechnik & Fachplanung",
    image: "/team/andreas.png",
    qualification: "Staatlich geprüfter Hochbautechniker • Schwerpunkt Hochbau",
    department: "HOCHBAUTECHNIK",
    experience: "18+ Jahre",
    quote: "Fundierte Ausführungsplanung schützt vor Überraschungen am Bau."
  },
  {
    code: "MW-BL-07",
    name: "Fabian May",
    role: "Bauleiter",
    shortRole: "Bauleitung Hochbau",
    image: "/team/fabian.png",
    qualification: "Staatlich geprüfter Hochbautechniker • Maurergeselle",
    department: "BAULEITUNG",
    experience: "10+ Jahre",
    quote: "Auf der Baustelle zählt jede Minute und jeder Millimeter. Wir behalten den Überblick."
  },
  {
