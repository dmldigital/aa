const teamMembers = [...row1Members, ...row2Members, ...dogs];
---

<section class="section-team w-full bg-paper text-text py-20 sm:py-28 border-t border-hairline" id="team">
  <div class="max-w-[1440px] mx-auto px-5 sm:px-8 w-full">

    <div class="mb-10 sm:mb-14 max-w-[760px]">
      <div class="eyebrow text-weber-red mb-4" data-reveal>Ihr Projekt, unser Team</div>
      <h2 class="h-section text-ink m-0" data-lines>
        Meisterhafte Kompetenz am Bau
      </h2>
    </div>

    <!-- Handy/Tablet: zwei Spalten, Dialog beim Antippen -->
    <div class="xl:hidden mb-8" data-team-mobile>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-3 sm:gap-4">
        {teamMembers.map((member, index) => (
          <button
            type="button"
            class="mobile-team-card group relative aspect-[4/5] overflow-hidden bg-ink p-0 text-left border-0 cursor-pointer max-md:[&:last-child:nth-child(odd)]:col-span-2 max-md:[&:last-child:nth-child(odd)]:aspect-[8/5]"
            aria-label={`Profil ${member.name} öffnen`}
            data-team-open
            data-team-name={member.name}
            data-team-role={member.role}
            data-team-image={member.image}
            data-team-code={member.code}
            data-team-department={member.department}
            data-team-qualification={member.qualification}
            data-team-quote={member.quote}
            data-team-experience={member.experience || ""}
            data-reveal
          >
            <img
              src={member.image}
              alt=""
              class="h-full w-full object-cover object-top transition-transform duration-[1200ms] ease-mw group-active:scale-[1.03]"
              loading={index < 2 ? "eager" : "lazy"}
              decoding="async"
            />
            <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-ink/90 via-ink/45 to-transparent px-3 pb-3 pt-12 text-white">
              <span class="block truncate eyebrow !text-[11px] text-weber-light">{member.code}</span>
              <span class="block text-base font-medium leading-tight tracking-[-0.01em]">{member.name}</span>
            </div>
            <span class="absolute right-2 top-2 flex h-8 w-8 items-center justify-center bg-ink/55 backdrop-blur-sm text-white" aria-hidden="true">
              <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 5v14M5 12h14" />
              </svg>
            </span>
          </button>
        ))}
      </div>

      <dialog class="mobile-team-dialog theme-dark" data-team-dialog aria-labelledby="team-dialog-name">
        <div class="team-dialog-panel bg-ink-2 bg-grain" data-lenis-prevent>
          <button type="button" class="team-dialog-close" data-team-dialog-close aria-label="Profil schließen">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="m6 6 12 12M18 6 6 18" />
            </svg>
          </button>
          <img class="team-dialog-image" data-team-dialog-image src="" alt="" />
          <div class="p-6 sm:p-8">
            <div class="mb-1 eyebrow !text-[11px] text-weber-light" data-team-dialog-code></div>
            <div class="mb-3 eyebrow !text-[11px] text-white/60" data-team-dialog-department></div>
            <h3 id="team-dialog-name" class="mb-1 mt-0 text-[28px] sm:text-[32px] font-medium leading-tight tracking-[-0.02em] text-white" data-team-dialog-name></h3>
            <p class="mb-5 mt-0 text-base font-medium text-white/80" data-team-dialog-role></p>
            <span class="red-rule mb-5"></span>
            <p class="mb-5 mt-0 copy text-white/80" data-team-dialog-qualification></p>
            <blockquote class="m-0 border-l-2 border-weber-light pl-4 text-base leading-relaxed text-white">
              „<span data-team-dialog-quote></span>“
            </blockquote>
            <div class="mt-5 eyebrow !text-[11px] text-white/60" data-team-dialog-experience hidden></div>
          </div>
        </div>
      </dialog>
    </div>

    <!-- Desktop: Bild-Akkordeon. Ein Streifen ist geöffnet (Porträt links, Text rechts), die übrigen sind schmal. -->
    <div class="hidden xl:block" data-team-acc data-reveal>
      <ul class="tm-list" role="list">
        {[...row1Members, ...row2Members, ...dogs].map((member, i) => (
          <li
            class="tm"
            data-tm
            data-active={i === 0 ? 'true' : 'false'}
            tabindex="0"
            aria-label={`${member.name}, ${member.role}`}
          >
            <div class="tm-media">
              <img src={member.image} alt={member.name} loading="lazy" decoding="async" />
            </div>
            <div class="tm-strip" aria-hidden="true">
              <span class="tm-strip-name">{member.name}</span>
            </div>
            <div class="tm-panel theme-dark">
              <span class="eyebrow tm-code">{member.code}</span>
              <h3 class="tm-name">{member.name}</h3>
              <p class="tm-role">{member.role}</p>
              <span class="tm-rule" aria-hidden="true"></span>
              <p class="tm-qual">{member.qualification}</p>
              <p class="tm-quote">„{member.quote}“</p>
              <span class="tm-foot">
                <span class="eyebrow tm-dep">{member.department}</span>
                {member.experience && <span class="tm-exp">{member.experience}</span>}
              </span>
            </div>
          </li>
        ))}
      </ul>
    </div>

  </div>
</section>

<style>
  /* Akkordeon: die Breite wandert über flex-grow, ruhig und ohne Überschwingen */
  .tm-list {
    display: flex;
    gap: 8px;
    height: clamp(470px, 34vw, 480px);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .tm {
    position: relative;
    flex: 1 1 0;
    min-width: 0;
    overflow: hidden;
    background: var(--ink);
    cursor: pointer;
    outline-offset: 3px;
    transition: flex-grow 1s var(--ease);
  }
  .tm[data-active='true'] {
    flex-grow: 11;
  }
  .tm:focus-visible {
    outline: 2px solid var(--red);
  }

  .tm-media {
    position: absolute;
    inset: 0;
    transition: right 1s var(--ease);
  }
  .tm[data-active='true'] .tm-media {
    right: min(340px, 54%);
  }
  .tm-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 14%;
    filter: grayscale(1) brightness(0.7);
    transform: scale(1.2);
    transition: filter 1s var(--ease), transform 1.4s var(--ease);
  }
  .tm[data-active='true'] .tm-media img {
    filter: none;
    transform: scale(1.02);
  }
  .tm:not([data-active='true']):hover .tm-media img {
    filter: grayscale(0.4) brightness(0.9);
  }

  /* Schmaler Zustand: Name senkrecht am unteren Rand */
  .tm-strip {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding-bottom: 20px;
    background: linear-gradient(0deg, rgb(21 23 26 / 0.9), rgb(21 23 26 / 0) 60%);
    pointer-events: none;
    transition: opacity 0.5s var(--ease);
  }
  .tm-strip-name {
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.01em;
    color: rgb(255 255 255 / 0.92);
    white-space: nowrap;
  }
  .tm[data-active='true'] .tm-strip {
    opacity: 0;
  }

  /* Geöffneter Zustand: Textfläche rechts */
  .tm-panel {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: min(340px, 54%);
    display: flex;
    flex-direction: column;
    padding: 26px 26px 22px;
    background-color: var(--ink-2);
    background-image: var(--grain);
    background-size: 180px 180px;
    color: #fff;
    opacity: 0;
    transform: translate3d(28px, 0, 0);
    pointer-events: none;
    transition: opacity 0.45s var(--ease), transform 0.5s var(--ease);
  }
  .tm[data-active='true'] .tm-panel {
    opacity: 1;
    transform: none;
    pointer-events: auto;
    transition: opacity 0.8s var(--ease) 0.35s, transform 1s var(--ease) 0.3s;
  }
  .tm-code {
    font-size: 11px !important;
    color: var(--red-on-dark);
  }
  .tm-name {
    margin: 10px 0 0;
    font-size: clamp(22px, 1.9vw, 26px);
    font-weight: 500;
    line-height: 1.12;
    letter-spacing: -0.015em;
    color: #fff;
  }
  .tm-role {
    margin: 6px 0 0;
    font-size: 14px;
    font-weight: 500;
    line-height: 1.4;
    color: var(--red-on-dark);
  }
  .tm-rule {
    display: block;
    width: 100%;
    height: 1px;
    margin: 16px 0;
    background: var(--hairline-dark);
  }
  .tm-qual {
    margin: 0;
    font-size: 14px;
    line-height: 1.5;
    color: rgb(255 255 255 / 0.82);
  }
  .tm-quote {
    margin: 14px 0 0;
    font-size: 14px;
    line-height: 1.55;
    color: rgb(255 255 255 / 0.62);
    display: -webkit-box;
    -webkit-line-clamp: 5;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .tm-foot {
    margin-top: auto;
    padding-top: 14px;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    border-top: 1px solid var(--hairline-dark);
  }
  .tm-dep,
  .tm-exp {
    font-size: 11px !important;
    letter-spacing: 0.1em;
    color: rgb(255 255 255 / 0.6);
  }

  @media (max-width: 1399px) {
    .tm-panel { padding: 22px 22px 18px; }
    .tm-role, .tm-qual, .tm-quote { font-size: 13.5px; }
    .tm-rule { margin: 12px 0; }
    .tm-quote { margin-top: 12px; -webkit-line-clamp: 4; }
  }

  @media (prefers-reduced-motion: reduce) {
    .tm, .tm-media, .tm-media img, .tm-strip, .tm-panel { transition: none !important; }
  }

  .mobile-team-card:focus-visible {
    outline: 2px solid var(--red);
    outline-offset: 2px;
  }

  .mobile-team-dialog {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    color: white;
    background: transparent;
    overflow: auto;
  }

  .mobile-team-dialog:not([open]) {
    display: none;
  }

  .mobile-team-dialog::backdrop {
    background-color: rgb(21 23 26 / 82%);
    background-image: var(--grain);
    background-size: 180px 180px;
    backdrop-filter: blur(4px);
    animation: team-dialog-fade 0.6s var(--ease) both;
  }

  .team-dialog-panel {
    position: relative;
    width: min(100% - 32px, 560px);
    max-height: calc(100% - 32px);
    margin: 16px auto;
    overflow: auto;
    box-shadow: 0 30px 80px rgb(0 0 0 / 35%);
    animation: team-dialog-in 0.8s var(--ease) both;
  }

  .team-dialog-image {
    display: block;
    width: 100%;
    height: min(43svh, 360px);
    min-height: 220px;
    object-fit: cover;
    object-position: top;
  }

  .team-dialog-close {
    position: absolute;
    z-index: 2;
    top: 12px;
    right: 12px;
    display: grid;
    width: 44px;
    height: 44px;
    place-items: center;
    border: 1px solid rgb(255 255 255 / 30%);
    background: rgb(21 23 26 / 70%);
    color: white;
    cursor: pointer;
    transition: background-color 0.5s var(--ease);
  }
  .team-dialog-close:hover {
    background: rgb(21 23 26 / 95%);
  }

  .team-dialog-close svg {
    width: 18px;
    height: 18px;
  }

  @keyframes team-dialog-in {
    from { opacity: 0; transform: translate3d(0, 24px, 0); }
    to { opacity: 1; transform: none; }
  }
  @keyframes team-dialog-fade {
    from { opacity: 0; }
    to { opacity: 1; }
  }
</style>

<script>
  // Akkordeon: Hover (Maus), Fokus (Tastatur) und Klick öffnen einen Streifen; der zuletzt gewählte bleibt offen
  const acc = document.querySelector<HTMLElement>('[data-team-acc]');
  if (acc) {
    const items = [...acc.querySelectorAll<HTMLElement>('[data-tm]')];
    let timer = 0;
    const open = (el: HTMLElement) => items.forEach((i) => (i.dataset.active = String(i === el)));
    items.forEach((el) => {
      el.addEventListener('pointerenter', (e) => {
        if (e.pointerType === 'touch') return;
        window.clearTimeout(timer);
        timer = window.setTimeout(() => open(el), 70);
      });
      el.addEventListener('pointerleave', () => window.clearTimeout(timer));
      el.addEventListener('focus', () => open(el));
      el.addEventListener('click', () => open(el));
    });
  }
</script>
