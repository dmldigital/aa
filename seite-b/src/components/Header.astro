---
// Header.astro - Manfred Weber
---

<!-- ==========================================================================
     MAIN HEADER: Desktop 100% Originalzustand (Kein Hintergrund, exakte Vorlage)
     Mobil: Kleineres Logo auf weißem Header,
            rotes Hamburger-Quadrat & animiertes Menü
     ========================================================================== -->
<header 
  id="main-header" 
  class="main-header-smart fixed top-0 inset-x-0 z-[999] bg-transparent pt-4 pb-6 transition-all duration-300 ease-out"
>
  <div class="max-w-[1440px] mx-auto px-5 sm:px-8 flex items-center justify-between w-full">
    
    <!-- DESKTOP LOGO: 100% Originalzustand -->
    <a 
      href="/" 
      class="site-logo hidden lg:flex items-center gap-4 transition-transform hover:scale-[1.02] duration-300 select-none py-1 group"
    >
      <img 
        src="/schriftzug.png" 
        alt="Manfred Weber" 
        class="h-[56px] sm:h-[60px] w-auto object-contain"
      />
      <div class="flex flex-col text-left leading-tight">
        <span class="font-heading font-bold text-[22px] tracking-[1.8px] uppercase text-white">MANFRED WEBER</span>
        <span class="font-heading font-semibold text-[11px] tracking-[3px] uppercase text-[#e41e13]">BAUUNTERNEHMEN</span>
      </div>
    </a>

    <!-- MOBILE LOGO: Schrift & Logo kleiner, passend zum weißen Header -->
    <a 
      href="/" 
      class="site-logo flex lg:hidden items-center transition-transform hover:scale-[1.02] duration-300 select-none py-1 group"
    >
      <div class="flex items-center gap-2.5">
        <img 
          src="/schriftzug.png" 
          alt="Manfred Weber" 
          class="h-[38px] w-auto object-contain"
        />
        <div class="flex flex-col text-left leading-tight">
          <span id="mobile-header-title" class="font-heading font-bold text-[14px] tracking-[1.8px] uppercase text-white">MANFRED WEBER</span>
          <span class="font-heading font-semibold text-[8px] tracking-[2.8px] uppercase text-[#e41e13]">BAUUNTERNEHMEN</span>
        </div>
      </div>
    </a>

    <!-- DESKTOP MENÜLEISTE: 100% Originalzustand (Weißes Menü + Bündiger roter Button, kein 4-Dot, keine Dropdowns) -->
    <div class="hidden lg:flex items-stretch h-[60px] shadow-2xl">
      <!-- White Menu Box with borders -->
      <div class="flex items-stretch bg-white border border-r-0 border-black/10">
        <ul role="list" class="flex items-center space-x-8 m-0 px-8 list-none my-auto">
          <li>
            <a href="/" class="font-heading text-[15px] font-medium tracking-normal text-[#111111] border-b-2 border-[#e41e13] pb-0.5">Home</a>
          </li>
          <li>
            <a href="#leistungen" class="font-heading text-[15px] font-medium tracking-normal text-[#555555] hover:text-[#e41e13] transition-colors">Leistungen</a>
          </li>
          <li>
            <a href="#impressionen" class="font-heading text-[15px] font-medium tracking-normal text-[#555555] hover:text-[#e41e13] transition-colors">Impressionen</a>
          </li>
          <li>
            <a href="#ueber-uns" class="font-heading text-[15px] font-medium tracking-normal text-[#555555] hover:text-[#e41e13] transition-colors">Unternehmen</a>
          </li>
          <li>
            <a href="#kontakt" class="font-heading text-[15px] font-medium tracking-normal text-[#555555] hover:text-[#e41e13] transition-colors">Kontakt</a>
          </li>
        </ul>
      </div>

      <!-- Flush Red Button: Exakt h-[60px], bündig neben dem Menü, ohne weißen Hintergrund und ohne Rahmen -->
      <a 
        href="#kontakt" 
        class="button-style-1 h-[60px] min-h-[60px] px-8 !bg-[#e41e13] text-white !rounded-none flex items-center justify-center font-heading font-medium text-[13px] uppercase tracking-[1.2px] !border-none cursor-pointer"
      >
        <div class="before_button_hover">
          <div class="bg_before_button_hover"></div>
        </div>
        <span class="wrap_textbutton">
          Angebot anfragen
        </span>
      </a>
    </div>

    <!-- MOBILER HAMBURGER-TOGGLE: Rotes quadratisches Quadrat mit weißem Burgersymbol -->
    <button 
      id="mobile-drawer-toggle"
      type="button" 
      aria-label="Menü öffnen" 
      class="lg:hidden w-[46px] h-[46px] sm:w-[52px] sm:h-[52px] bg-[#e41e13] hover:bg-[#c51910] text-white shadow-xl flex flex-col items-center justify-center gap-1.5 transition-colors cursor-pointer select-none" 
    >
      <span class="w-5 h-[2px] bg-white rounded-full transition-all duration-300"></span>
      <span class="w-5 h-[2px] bg-white rounded-full transition-all duration-300"></span>
      <span class="w-5 h-[2px] bg-white rounded-full transition-all duration-300"></span>
    </button>
  </div>
</header>


<!-- ==========================================================================
     MOBILES OFF-CANVAS MENÜ (Wunderschön animiert mit GSAP Stagger)
     ========================================================================== -->
<div 
  id="architectural-drawer" 
  class="fixed inset-0 z-[1000] pointer-events-none lg:hidden"
  aria-hidden="true"
>
  <!-- Backdrop (click to close) -->
  <div 
    id="drawer-backdrop" 
    class="absolute inset-0 bg-black/75 backdrop-blur-md opacity-0 cursor-pointer pointer-events-none"
  ></div>

  <!-- Off-Canvas Panel (slides in from right) -->
  <div 
    id="drawer-panel" 
    class="absolute top-0 right-0 bottom-0 w-full sm:w-[480px] bg-[#111111] text-white border-l border-white/10 shadow-2xl flex flex-col justify-between p-7 sm:p-10 transform translate-x-full pointer-events-auto overflow-y-auto"
  >
    <!-- Drawer Top: Logo & Close Button -->
    <div id="drawer-header-content" class="flex items-center justify-between pb-6 border-b border-white/10">
      <div class="flex flex-col items-start">
        <div class="flex items-center gap-2.5 sm:gap-3">
          <img 
            src="/schriftzug.png" 
            alt="Manfred Weber Logo" 
            class="h-[34px] sm:h-[38px] w-auto object-contain"
          />
          <div class="flex flex-col text-left leading-tight">
            <span class="font-heading font-bold text-sm sm:text-base tracking-[1.6px] uppercase text-white">MANFRED WEBER</span>
            <span class="font-heading font-semibold text-[8px] sm:text-[9px] tracking-[2.6px] uppercase text-[#e41e13]">BAUUNTERNEHMEN</span>
          </div>
        </div>
      </div>

      <!-- Close Button with rotating hover effect -->
      <button 
        id="drawer-close-btn"
        type="button" 
        class="w-10 h-10 rounded-full border border-white/20 flex items-center justify-center text-white/80 hover:text-white hover:border-[#e41e13] hover:bg-[#e41e13] transition-all duration-300 group cursor-pointer"
        aria-label="Menü schließen"
      >
        <svg class="w-4 h-4 stroke-current stroke-2 transform transition-transform duration-300 group-hover:rotate-90" viewBox="0 0 24 24">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <!-- Drawer Navigation (Numbered links with GSAP Stagger) -->
    <nav class="py-6 my-auto space-y-2">
      <div class="text-[10px] font-mono text-[#e41e13] uppercase tracking-[2.5px] mb-3 font-bold flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-[#e41e13]"></span>
        <span>Navigation</span>
      </div>
      
      <div class="space-y-1">
        <div class="drawer-nav-item">
          <a href="/" class="drawer-nav-link group flex items-center justify-between py-2.5 border-b border-white/5 hover:border-white/20 transition-colors no-underline">
            <span class="font-heading text-lg sm:text-xl uppercase tracking-tight text-white group-hover:text-[#e41e13] group-hover:translate-x-2 transition-all duration-300">
              Startseite
            </span>
            <span class="font-mono text-xs text-white/30 group-hover:text-[#e41e13] transition-colors">01</span>
          </a>
        </div>

        <div class="drawer-nav-item">
          <a href="#leistungen" class="drawer-nav-link group flex items-center justify-between py-2.5 border-b border-white/5 hover:border-white/20 transition-colors no-underline">
            <span class="font-heading text-lg sm:text-xl uppercase tracking-tight text-white group-hover:text-[#e41e13] group-hover:translate-x-2 transition-all duration-300">
              Leistungen &amp; Kompetenzen
            </span>
            <span class="font-mono text-xs text-white/30 group-hover:text-[#e41e13] transition-colors">02</span>
          </a>
        </div>

        <div class="drawer-nav-item">
          <a href="#impressionen" class="drawer-nav-link group flex items-center justify-between py-2.5 border-b border-white/5 hover:border-white/20 transition-colors no-underline">
            <span class="font-heading text-lg sm:text-xl uppercase tracking-tight text-white group-hover:text-[#e41e13] group-hover:translate-x-2 transition-all duration-300">
              Impressionen &amp; Projekte
            </span>
            <span class="font-mono text-xs text-white/30 group-hover:text-[#e41e13] transition-colors">03</span>
          </a>
        </div>

        <div class="drawer-nav-item">
          <a href="#ueber-uns" class="drawer-nav-link group flex items-center justify-between py-2.5 border-b border-white/5 hover:border-white/20 transition-colors no-underline">
            <span class="font-heading text-lg sm:text-xl uppercase tracking-tight text-white group-hover:text-[#e41e13] group-hover:translate-x-2 transition-all duration-300">
              Unternehmen &amp; Werte
            </span>
            <span class="font-mono text-xs text-white/30 group-hover:text-[#e41e13] transition-colors">04</span>
          </a>
        </div>

        <div class="drawer-nav-item">
          <a href="#unternehmen" class="drawer-nav-link group flex items-center justify-between py-2.5 border-b border-white/5 hover:border-white/20 transition-colors no-underline">
            <span class="font-heading text-lg sm:text-xl uppercase tracking-tight text-white group-hover:text-[#e41e13] group-hover:translate-x-2 transition-all duration-300">
              Fuhrpark &amp; Krane
            </span>
            <span class="font-mono text-xs text-white/30 group-hover:text-[#e41e13] transition-colors">05</span>
          </a>
        </div>

        <div class="drawer-nav-item">
          <a href="#team" class="drawer-nav-link group flex items-center justify-between py-2.5 border-b border-white/5 hover:border-white/20 transition-colors no-underline">
            <span class="font-heading text-lg sm:text-xl uppercase tracking-tight text-white group-hover:text-[#e41e13] group-hover:translate-x-2 transition-all duration-300">
              Unser Team
            </span>
            <span class="font-mono text-xs text-white/30 group-hover:text-[#e41e13] transition-colors">06</span>
          </a>
        </div>

        <div class="drawer-nav-item">
          <a href="#kontakt" class="drawer-nav-link group flex items-center justify-between py-2.5 border-b border-white/5 hover:border-white/20 transition-colors no-underline">
            <span class="font-heading text-lg sm:text-xl uppercase tracking-tight text-white group-hover:text-[#e41e13] group-hover:translate-x-2 transition-all duration-300">
              Kontakt &amp; Standort
            </span>
            <span class="font-mono text-xs text-white/30 group-hover:text-[#e41e13] transition-colors">07</span>
          </a>
        </div>
      </div>
    </nav>

    <!-- Drawer Bottom: Contact Info & CTA Button -->
    <div id="drawer-bottom-content" class="pt-6 border-t border-white/10 space-y-4">
      <div class="grid grid-cols-2 gap-4 text-xs font-body text-white/70">
        <div>
          <div class="text-[10px] font-mono text-[#e41e13] uppercase tracking-widest mb-1 font-bold">Direktkontakt</div>
          <a href="tel:+4963538060" class="text-white hover:text-[#e41e13] transition-colors block font-medium">0 63 53 / 80 60</a>
          <a href="mailto:info@mw-bauen.de" class="text-white/60 hover:text-white transition-colors block mt-0.5">info@mw-bauen.de</a>
        </div>
        <div>
          <div class="text-[10px] font-mono text-[#e41e13] uppercase tracking-widest mb-1 font-bold">Standort</div>
          <address class="not-italic text-white/60 leading-snug">
            Jahnstraße 9<br />
            67273 Weisenheim a.B.
          </address>
        </div>
      </div>

      <a 
        href="#kontakt" 
        class="drawer-nav-link button-style-1 w-full h-[50px] !bg-[#e41e13] text-white flex items-center justify-center font-heading font-medium text-[12px] uppercase tracking-[1.5px] shadow-lg"
      >
        <div class="before_button_hover">
          <div class="bg_before_button_hover"></div>
        </div>
        <span class="wrap_textbutton">
          Angebot anfordern
        </span>
      </a>
    </div>

  </div>
</div>


<!-- Script for Sticky Header & Animated Drawer Controller -->
<script>
  import { gsap } from 'gsap';

  // 1. SMART STICKY HEADER (Mobil weiß, Desktop transparent)
  let lastScrollY = window.scrollY;
  const header = document.getElementById('main-header');

  window.addEventListener('scroll', () => {
    const currentScrollY = window.scrollY;
    
    if (header) {
      header.classList.toggle('is-scrolled', currentScrollY > 100);
      if (currentScrollY > 100) {
        if (currentScrollY > lastScrollY && currentScrollY - lastScrollY > 5) {
          header.classList.add('-translate-y-full');
        } else if (lastScrollY - currentScrollY > 5) {
          header.classList.remove('-translate-y-full');
        }
      } else {
        header.classList.remove('-translate-y-full');
      }
    }

    lastScrollY = currentScrollY;
  }, { passive: true });

  // Set the correct appearance when the page is restored at a scrolled position.
  header?.classList.toggle('is-scrolled', window.scrollY > 100);

  // 2. GSAP ANIMATED DRAWER CONTROLLER (Nur Mobil)
  const drawer = document.getElementById('architectural-drawer');
  const backdrop = document.getElementById('drawer-backdrop');
  const panel = document.getElementById('drawer-panel');
  const openMobileBtn = document.getElementById('mobile-drawer-toggle');
  const closeBtn = document.getElementById('drawer-close-btn');
  const drawerLinks = document.querySelectorAll('.drawer-nav-link');

  let drawerTl = gsap.timeline({
    paused: true,
    onReverseComplete: () => {
      if (drawer) {
        drawer.classList.remove('pointer-events-auto');
        drawer.classList.add('pointer-events-none');
        drawer.setAttribute('aria-hidden', 'true');
      }
      document.body.style.overflow = '';
    }
  });

  if (backdrop && panel) {
    drawerTl
      .to(backdrop, {
        opacity: 1,
        duration: 0.35,
        ease: 'power2.out',
        pointerEvents: 'auto'
      })
      .to(panel, {
        x: '0%',
        duration: 0.45,
        ease: 'power3.out'
      }, '-=0.25')
      .fromTo('#drawer-header-content', {
        opacity: 0,
        y: -15
      }, {
        opacity: 1,
        y: 0,
        duration: 0.3,
        ease: 'power2.out'
      }, '-=0.25')
      .fromTo('.drawer-nav-item', {
        opacity: 0,
        x: 35
      }, {
        opacity: 1,
        x: 0,
        duration: 0.4,
        stagger: 0.05,
        ease: 'power3.out'
      }, '-=0.2')
      .fromTo('#drawer-bottom-content', {
        opacity: 0,
        y: 20
      }, {
        opacity: 1,
        y: 0,
        duration: 0.35,
        ease: 'power2.out'
      }, '-=0.25');
  }

  const openDrawer = () => {
    if (!drawer) return;
    drawer.classList.remove('pointer-events-none');
    drawer.classList.add('pointer-events-auto');
    drawer.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
    drawerTl.play();
  };

  const closeDrawer = () => {
    drawerTl.reverse();
  };

  openMobileBtn?.addEventListener('click', openDrawer);
  closeBtn?.addEventListener('click', closeDrawer);
  backdrop?.addEventListener('click', closeDrawer);

  drawerLinks.forEach(link => {
    link.addEventListener('click', closeDrawer);
  });

  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeDrawer();
  });
</script>

<style>
  @media (max-width: 1023px) {
    #main-header.is-scrolled {
      background-color: #fff;
    }

    #main-header.is-scrolled #mobile-header-title {
      color: #111;
      text-shadow: none;
    }
  }
</style>
