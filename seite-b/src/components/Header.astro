---
// Header mit fünf Varianten zum Vergleich (Umschalter unten links, Wahl bleibt gespeichert, auch per ?header=1 bis 5).
// Verhalten (Ein- und Ausblenden beim Scrollen, Drawer) steckt in src/scripts/motion.ts.

const navItems = [
  { label: 'Leistungen & Kompetenzen', short: 'Leistungen', href: '#leistungen' },
  { label: 'Unternehmen & Werte', short: 'Unternehmen', href: '#ueber-uns' },
  { label: 'Fuhrpark & Krane', short: 'Fuhrpark', href: '#unternehmen' },
  { label: 'Unser Team', short: 'Team', href: '#team' },
  { label: 'Kontakt & Standort', short: 'Kontakt', href: '#kontakt' },
];
const navA = navItems.slice(0, 3);
const navB = navItems.slice(3);
const variants = ['Klar', 'Zentriert', 'Schwebend', 'Info-Leiste', 'Menü groß'];
const phoneIcon = '<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg>';
---

<script is:inline>
  (function () {
    var v = '1';
    try {
      var q = new URLSearchParams(location.search).get('header');
      v = q || localStorage.getItem('mw-hv') || '1';
    } catch (e) {}
    if (!/^[1-5]$/.test(v)) v = '1';
    document.documentElement.dataset.hv = v;
  })();
</script>

<header id="main-header" class="main-header theme-dark" data-header>
  <!-- Info-Leiste (nur Variante 4, Desktop) -->
  <div class="hv-top">
    <div class="hv-wrap hv-top-in">
      <span>Mo bis Do 07:00–17:00 Uhr · Fr 07:00–15:30 Uhr</span>
      <span class="hv-top-links">
        <a href="tel:+4963538060">0 63 53 / 80 60</a>
        <a href="mailto:info@mw-bauen.de">info@mw-bauen.de</a>
      </span>
    </div>
  </div>

  <div class="hv-bar">
    <div class="hv-wrap hv-bar-in">
      <a href="/" class="hv-logo" aria-label="Manfred Weber Bauunternehmen, Startseite">
        <img src="/schriftzug.png" alt="" width="80" height="56" />
        <span class="hv-logo-text">
          <span class="hv-logo-name">Manfred Weber</span>
          <span class="hv-logo-sub">Bauunternehmen</span>
        </span>
      </a>

      <nav class="hv-nav hv-nav-a" aria-label="Hauptmenü">
        <ul role="list">
          {navA.map((n) => <li><a href={n.href}>{n.short}</a></li>)}
        </ul>
      </nav>

      <div class="hv-right">
        <nav class="hv-nav hv-nav-b" aria-label="Weitere Menüpunkte">
          <ul role="list">
            {navB.map((n) => <li><a href={n.href}>{n.short}</a></li>)}
          </ul>
        </nav>

        <div class="hv-actions">
          <a class="hv-phone" href="tel:+4963538060" aria-label="Anrufen: 0 63 53 / 80 60">
            <span set:html={phoneIcon} />
            <span class="hv-phone-text">0 63 53 / 80 60</span>
          </a>
          <a class="btn hv-cta" href="#kontakt">Angebot anfragen</a>
          <button
            type="button"
            class="hv-burger"
            data-drawer-open
            aria-label="Menü öffnen"
            aria-expanded="false"
            aria-controls="drawer"
          >
            <span class="hv-burger-label">Menü</span>
            <span class="hv-burger-lines" aria-hidden="true"><i></i><i></i></span>
          </button>
        </div>
      </div>
    </div>
  </div>
</header>

<!-- Untere Aktionsleiste (nur Variante 4, Handy) -->
<div class="hv-dock">
  <a href="tel:+4963538060" class="hv-dock-call"><span set:html={phoneIcon} />Anrufen</a>
  <a href="#kontakt" class="hv-dock-cta">Angebot anfragen</a>
</div>

<!-- Umschalter für den Vergleich (nach der Entscheidung entfernen) -->
<div class="hv-switch" role="group" aria-label="Header-Variante wählen" data-hv-switch>
  <span class="hv-switch-t">Header</span>
  {variants.map((n, i) => <button type="button" data-hv-set={i + 1} aria-label={`Variante ${i + 1}: ${n}`} aria-pressed="false">{i + 1}</button>)}
  <span class="hv-switch-n" data-hv-name aria-live="polite"></span>
</div>

<!-- Drawer (Handy/Tablet) -->
<div id="drawer" class="theme-dark" data-drawer aria-hidden="true">
  <div class="drawer-backdrop" data-drawer-close></div>

  <div
    class="drawer-panel absolute top-0 right-0 bottom-0 w-full sm:w-[440px] bg-ink bg-grain text-white border-l border-hairline-dark flex flex-col p-7 sm:p-10 overflow-y-auto"
    role="dialog"
    aria-modal="true"
    aria-label="Menü"
    data-lenis-prevent
  >
    <div class="drawer-item flex items-center justify-between pb-6 border-b border-hairline-dark" style="--i:0">
      <span class="flex items-center gap-3">
        <img src="/schriftzug.png" alt="" class="h-[34px] w-auto object-contain" width="60" height="34" />
        <span class="flex flex-col leading-tight">
          <span class="text-base font-medium">Manfred Weber</span>
          <span class="eyebrow !text-[11px] !tracking-[0.16em] text-weber-light">Bauunternehmen</span>
        </span>
      </span>
      <button
        type="button"
        data-drawer-close
        aria-label="Menü schließen"
        class="w-11 h-11 border border-white/20 flex items-center justify-center text-white/80 cursor-pointer transition-colors duration-500 ease-mw hover:text-white hover:border-white/50"
      >
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
          <path d="M18 6 6 18M6 6l12 12" />
        </svg>
      </button>
    </div>

    <nav class="py-7 my-auto" aria-label="Menü">
      <ul role="list" class="m-0 p-0 list-none">
        <li class="drawer-item" style="--i:1">
          <a href="/" class="group flex items-baseline justify-between py-3.5 border-b border-hairline-dark no-underline" data-drawer-link>
            <span class="text-[22px] font-normal tracking-[-0.01em] text-white transition-transform duration-500 ease-mw group-hover:translate-x-1.5">Startseite</span>
            <span class="text-[13px] tabular-nums text-white/50">01</span>
          </a>
        </li>
        {navItems.map((n, i) => (
          <li class="drawer-item" style={`--i:${i + 2}`}>
            <a href={n.href} class="group flex items-baseline justify-between py-3.5 border-b border-hairline-dark no-underline" data-drawer-link>
              <span class="text-[22px] font-normal tracking-[-0.01em] text-white transition-transform duration-500 ease-mw group-hover:translate-x-1.5">{n.label}</span>
              <span class="text-[13px] tabular-nums text-white/50">{String(i + 2).padStart(2, '0')}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="drawer-item pt-6 border-t border-hairline-dark space-y-5" style="--i:7">
      <div class="grid grid-cols-2 gap-5 text-[15px] leading-snug">
        <div>
          <div class="eyebrow text-weber-light mb-2">Direktkontakt</div>
          <a href="tel:+4963538060" class="block text-white font-medium">0 63 53 / 80 60</a>
          <a href="mailto:info@mw-bauen.de" class="block text-white/70 mt-1 hover:text-white transition-colors duration-500 ease-mw">info@mw-bauen.de</a>
        </div>
        <div>
          <div class="eyebrow text-weber-light mb-2">Standort</div>
          <address class="not-italic text-white/70">
            Jahnstraße 9<br />
            67273 Weisenheim am Berg
          </address>
        </div>
      </div>
      <a href="#kontakt" class="btn w-full" data-drawer-link>Angebot anfordern</a>
    </div>
  </div>
</div>

<style>
  #drawer {
    position: fixed;
    inset: 0;
    z-index: 1000;
    visibility: hidden;
    pointer-events: none;
    transition: visibility 0s linear 0.8s;
  }
  #drawer.is-open {
    visibility: visible;
    pointer-events: auto;
    transition-delay: 0s;
  }

  .drawer-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(21, 23, 26, 0.55);
    -webkit-backdrop-filter: blur(4px);
    backdrop-filter: blur(4px);
    opacity: 0;
    cursor: pointer;
    transition: opacity 0.7s var(--ease);
  }
  #drawer.is-open .drawer-backdrop {
    opacity: 1;
  }

  .drawer-panel {
    transform: translate3d(100%, 0, 0);
    transition: transform 0.8s var(--ease);
  }
  #drawer.is-open .drawer-panel {
    transform: none;
  }

  .drawer-item {
    opacity: 0;
    transform: translate3d(0, 14px, 0);
    transition:
      opacity 0.8s var(--ease),
      transform 0.8s var(--ease);
    transition-delay: 0s;
  }
  #drawer.is-open .drawer-item {
    opacity: 1;
    transform: none;
    transition-delay: calc(var(--i, 0) * 70ms + 180ms);
  }
</style>

<style is:global>
  /* ==========================================================================
     HEADER-VARIANTEN (html[data-hv="1" bis "5"])
     ========================================================================== */
  html[data-hv] .main-header { padding: 0; }
  html[data-hv] .main-header.is-scrolled { padding: 0; }

  .hv-wrap { width: 100%; max-width: 1440px; margin-inline: auto; padding-inline: clamp(20px, 3vw, 40px); }
  .hv-top, .hv-dock { display: none; }
  .hv-bar-in { display: flex; align-items: center; gap: 24px; height: var(--hv-h, 68px); transition: height 0.7s var(--ease); }
  .main-header { --hv-h: 68px; }
  @media (min-width: 1024px) { .main-header { --hv-h: 84px; } }
  .main-header.is-scrolled { --hv-h: 60px; }

  /* Logo */
  .hv-logo { display: flex; align-items: center; gap: 12px; flex: none; text-decoration: none; color: #fff; }
  .hv-logo img { height: 34px; width: auto; object-fit: contain; transition: height 0.7s var(--ease); }
  @media (min-width: 1024px) { .hv-logo img { height: 44px; } .main-header.is-scrolled .hv-logo img { height: 36px; } }
  .hv-logo-text { display: flex; flex-direction: column; line-height: 1.15; }
  .hv-logo-name { font-size: 17px; font-weight: 500; letter-spacing: 0.005em; }
  .hv-logo-sub { font-size: 10.5px; font-weight: 500; letter-spacing: 0.18em; text-transform: uppercase; color: var(--red-on-dark); }
  @media (min-width: 1024px) { .hv-logo-name { font-size: 19px; } }

  /* Navigation */
  .hv-nav { display: none; }
  .hv-nav ul { display: flex; align-items: center; gap: clamp(20px, 2.2vw, 36px); margin: 0; padding: 0; list-style: none; }
  .hv-nav a { position: relative; display: block; padding: 8px 0; font-size: 14.5px; font-weight: 500; color: rgb(255 255 255 / 0.9); text-decoration: none; transition: color 0.5s var(--ease); }
  .hv-nav a::after { content: ''; position: absolute; left: 0; right: 0; bottom: 2px; height: 1px; background: var(--red-on-dark); transform: scaleX(0); transform-origin: left; transition: transform 0.6s var(--ease); }
  .hv-nav a:hover::after, .hv-nav a:focus-visible::after { transform: scaleX(1); }
  @media (min-width: 1024px) { .hv-nav { display: block; } }

  .hv-right { display: flex; align-items: center; gap: clamp(20px, 2.2vw, 36px); margin-left: auto; }
  .hv-actions { display: flex; align-items: center; gap: 18px; }
  .hv-phone { display: none; align-items: center; gap: 10px; font-size: 14.5px; font-weight: 500; color: #fff; text-decoration: none; white-space: nowrap; }
  .hv-phone:hover { color: var(--red-on-dark); }
  .hv-cta { display: none; min-height: 44px; height: 44px; padding: 0 22px; font-size: 14px; }
  @media (min-width: 1024px) { .hv-cta { display: inline-flex; } }

  /* Burger */
  .hv-burger { display: inline-flex; align-items: center; justify-content: center; gap: 12px; width: 44px; height: 44px; padding: 0; margin-right: -8px; color: #fff; background: none; border: 0; cursor: pointer; }
  .hv-burger-label { display: none; font-size: 14px; font-weight: 500; }
  .hv-burger-lines { display: flex; flex-direction: column; gap: 6px; width: 24px; }
  .hv-burger-lines i { display: block; height: 1.5px; background: currentColor; transition: transform 0.6s var(--ease), width 0.6s var(--ease); }
  .hv-burger-lines i:last-child { width: 62%; align-self: flex-end; }
  .hv-burger:hover .hv-burger-lines i:last-child { width: 100%; }
  @media (min-width: 1024px) { .hv-burger { display: none; } }

  /* Umschalter */
  .hv-switch { position: fixed; z-index: 1500; left: 12px; bottom: 12px; display: flex; align-items: center; gap: 4px; padding: 5px 10px 5px 12px; border-radius: 999px; background: rgb(21 23 26 / 0.86); border: 1px solid rgb(255 255 255 / 0.14); -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px); color: #fff; font-size: 12px; box-shadow: 0 10px 30px -12px rgb(0 0 0 / 0.5); }
  .hv-switch-t { margin-right: 4px; color: rgb(255 255 255 / 0.6); letter-spacing: 0.08em; text-transform: uppercase; font-size: 10.5px; }
  .hv-switch button { width: 26px; height: 26px; border-radius: 50%; border: 0; background: transparent; color: rgb(255 255 255 / 0.75); font: inherit; font-weight: 500; cursor: pointer; transition: background 0.4s, color 0.4s; }
  .hv-switch button:hover { background: rgb(255 255 255 / 0.14); }
  .hv-switch button[aria-pressed="true"] { background: #fff; color: var(--ink); }
  .hv-switch-n { margin-left: 6px; min-width: 5.5rem; color: rgb(255 255 255 / 0.85); }
  @media (max-width: 520px) { .hv-switch-n { display: none; } }
  html.is-locked .hv-switch { opacity: 0; pointer-events: none; }

  /* --------------------------------------------------------------------------
     1 Klar: transparent über dem Hero, dunkle Leiste erst beim Scrollen
     -------------------------------------------------------------------------- */
  html[data-hv="1"] .hv-nav-a { margin-left: auto; }
  html[data-hv="1"] .hv-right { margin-left: clamp(20px, 2.2vw, 36px); }
  @media (min-width: 1280px) { html[data-hv="1"] .hv-phone { display: inline-flex; } }
  @media (min-width: 1024px) { html[data-hv="1"] .hv-actions { gap: 26px; } }

  /* --------------------------------------------------------------------------
     2 Zentriert: Logo in der Mitte, Menü links und rechts, feine Linie
     -------------------------------------------------------------------------- */
  html[data-hv="2"] .hv-bar { border-bottom: 1px solid rgb(255 255 255 / 0.14); }
  html[data-hv="2"] .hv-bar-in { display: grid; grid-template-columns: 1fr auto 1fr; }
  html[data-hv="2"] .hv-logo { grid-column: 2; grid-row: 1; justify-self: center; }
  html[data-hv="2"] .hv-nav-a { grid-column: 1; grid-row: 1; justify-self: start; }
  html[data-hv="2"] .hv-right { grid-column: 3; grid-row: 1; justify-self: end; margin-left: 0; }
  html[data-hv="2"] .hv-phone { display: inline-flex; }
  html[data-hv="2"] .hv-phone-text { display: none; }
  html[data-hv="2"] .hv-phone { width: 44px; height: 44px; justify-content: center; margin-right: -10px; }
  html[data-hv="2"] .hv-burger { grid-column: 1; grid-row: 1; justify-self: start; margin-right: 0; margin-left: -10px; }
  @media (max-width: 1023px) {
    html[data-hv="2"] .hv-right, html[data-hv="2"] .hv-actions { display: contents; }
    html[data-hv="2"] .hv-burger { order: 0; }
    html[data-hv="2"] .hv-phone { grid-column: 3; grid-row: 1; justify-self: end; }
    html[data-hv="2"] .hv-logo-sub { display: none; }
  }
  @media (min-width: 1024px) {
    html[data-hv="2"] .hv-phone { display: none; }
    html[data-hv="2"] .hv-logo { flex-direction: column; gap: 6px; text-align: center; }
    html[data-hv="2"] .hv-logo-text { align-items: center; }
    html[data-hv="2"] .hv-logo img { height: 34px; }
    html[data-hv="2"] .hv-bar-in { height: 92px; }
    html[data-hv="2"] .main-header.is-scrolled .hv-bar-in { height: 64px; }
    html[data-hv="2"] .main-header.is-scrolled .hv-logo { flex-direction: row; gap: 12px; }
    html[data-hv="2"] .main-header.is-scrolled .hv-logo-sub { display: none; }
    html[data-hv="2"] .main-header.is-scrolled .hv-logo img { height: 30px; }
  }

  /* --------------------------------------------------------------------------
     3 Schwebend: abgerundete Glas-Insel, mit Abstand zum Rand
     -------------------------------------------------------------------------- */
  html[data-hv="3"] .main-header { padding: 12px clamp(10px, 2vw, 24px); }
  html[data-hv="3"] .main-header.is-scrolled { padding: 8px clamp(10px, 2vw, 24px); }
  html[data-hv="3"] .main-header::before { display: none; }
  html[data-hv="3"] .hv-bar { max-width: 1280px; margin-inline: auto; border-radius: 16px; border: 1px solid rgb(255 255 255 / 0.16); background: rgb(21 23 26 / 0.46); -webkit-backdrop-filter: blur(18px) saturate(1.3); backdrop-filter: blur(18px) saturate(1.3); box-shadow: 0 22px 44px -26px rgb(0 0 0 / 0.7); transition: background-color 0.7s var(--ease); }
  html[data-hv="3"] .main-header.is-scrolled .hv-bar { background: rgb(21 23 26 / 0.86); }
  html[data-hv="3"] .hv-bar-in { padding-inline: 20px; height: 64px; }
  html[data-hv="3"] .main-header.is-scrolled .hv-bar-in { height: 56px; }
  html[data-hv="3"] .hv-nav-a { margin-left: auto; }
  html[data-hv="3"] .hv-right { margin-left: clamp(20px, 2.2vw, 36px); }
  html[data-hv="3"] .hv-cta { border-radius: 10px; min-height: 40px; height: 40px; padding: 0 18px; }
  html[data-hv="3"] .hv-logo img { height: 32px; }
  html[data-hv="3"] .hv-burger { margin-right: -6px; }

  /* --------------------------------------------------------------------------
     4 Info-Leiste: schmale Kontaktzeile oben, helle Hauptleiste, seriös
     -------------------------------------------------------------------------- */
  html[data-hv="4"] .main-header::before { display: none; }
  html[data-hv="4"] .hv-bar { background: var(--paper); border-bottom: 1px solid var(--hairline); box-shadow: 0 10px 30px -22px rgb(0 0 0 / 0.5); }
  html[data-hv="4"] .hv-bar-in { height: 64px; }
  @media (min-width: 1024px) { html[data-hv="4"] .hv-bar-in { height: 76px; } html[data-hv="4"] .main-header.is-scrolled .hv-bar-in { height: 62px; } }
  html[data-hv="4"] .hv-logo, html[data-hv="4"] .hv-nav a, html[data-hv="4"] .hv-burger { color: var(--text); }
  html[data-hv="4"] .hv-logo-sub { color: var(--red); }
  html[data-hv="4"] .hv-nav a:hover { color: var(--red); }
  html[data-hv="4"] .hv-nav a::after { background: var(--red); }
  html[data-hv="4"] .hv-nav-a { margin-left: auto; }
  html[data-hv="4"] .hv-right { margin-left: clamp(20px, 2.2vw, 36px); }
  @media (min-width: 1024px) {
    html[data-hv="4"] .hv-top { display: block; height: 34px; overflow: hidden; background: #0f1113; color: rgb(255 255 255 / 0.72); font-size: 12.5px; transition: height 0.7s var(--ease); }
    html[data-hv="4"] .main-header.is-scrolled .hv-top { height: 0; }
    html[data-hv="4"] .hv-top-in { display: flex; align-items: center; justify-content: space-between; height: 34px; }
    html[data-hv="4"] .hv-top-links { display: flex; gap: 24px; }
    html[data-hv="4"] .hv-top a { color: #fff; text-decoration: none; }
    html[data-hv="4"] .hv-top a:hover { color: var(--red-on-dark); }
  }
  @media (max-width: 1023px) {
    html[data-hv="4"] .hv-dock { position: fixed; z-index: 990; left: 0; right: 0; bottom: 0; display: grid; grid-template-columns: 1fr 1.4fr; padding-bottom: env(safe-area-inset-bottom); background: var(--ink); box-shadow: 0 -12px 30px -18px rgb(0 0 0 / 0.5); }
    html[data-hv="4"] .hv-dock a { display: flex; align-items: center; justify-content: center; gap: 10px; height: 54px; font-size: 15px; font-weight: 500; color: #fff; text-decoration: none; }
    html[data-hv="4"] .hv-dock-cta { background: var(--red); }
    html[data-hv="4"] body { padding-bottom: calc(54px + env(safe-area-inset-bottom)); }
    html[data-hv="4"] .hv-switch { bottom: calc(66px + env(safe-area-inset-bottom)); }
    html.is-locked[data-hv="4"] .hv-dock { display: none; }
  }

  /* --------------------------------------------------------------------------
     5 Menü groß: fast leere Leiste, Vollbild-Menü im Redaktionsstil (auch am Desktop)
     -------------------------------------------------------------------------- */
  html[data-hv="5"] .hv-nav, html[data-hv="5"] .hv-cta { display: none; }
  html[data-hv="5"] .hv-right { margin-left: auto; }
  html[data-hv="5"] .main-header { --hv-h: 64px; }
  @media (min-width: 1024px) { html[data-hv="5"] .main-header { --hv-h: 76px; } html[data-hv="5"] .main-header.is-scrolled { --hv-h: 60px; } html[data-hv="5"] .hv-phone { display: inline-flex; } }
  html[data-hv="5"] .hv-actions { gap: 28px; }
  html[data-hv="5"] .hv-burger { display: inline-flex; width: auto; height: 44px; margin-right: 0; padding: 0 18px 0 20px; border: 1px solid rgb(255 255 255 / 0.4); border-radius: 999px; transition: background-color 0.5s var(--ease), color 0.5s var(--ease); }
  html[data-hv="5"] .hv-burger:hover { background: #fff; color: var(--ink); }
  html[data-hv="5"] .hv-burger-label { display: inline; }
  html[data-hv="5"] #drawer .drawer-panel { width: 100% !important; border: 0; transform: none; clip-path: inset(0 0 100% 0); transition: clip-path 0.9s var(--ease); padding: clamp(22px, 4vw, 56px); }
  html[data-hv="5"] #drawer.is-open .drawer-panel { clip-path: inset(0 0 0 0); }
  html[data-hv="5"] #drawer .drawer-panel > * { width: 100%; max-width: 1100px; margin-inline: auto; }
  html[data-hv="5"] #drawer nav a > span:first-child { font-size: clamp(24px, min(4.6vw, 6.4vh), 60px); line-height: 1.12; font-weight: 400; letter-spacing: -0.02em; }
  html[data-hv="5"] #drawer nav a { padding-block: clamp(6px, 1.3vh, 16px); }
  html[data-hv="5"] #drawer .drawer-backdrop { display: none; }

  /* Menü am Desktop nur in Variante 5 */
  @media (min-width: 1024px) { html:not([data-hv="5"]) #drawer { display: none; } }

  @media (prefers-reduced-motion: reduce) {
    .hv-bar-in, .hv-logo img, .hv-nav a::after, .hv-burger-lines i { transition: none; }
  }
</style>

<script>
  // Umschalter: Variante setzen, merken und in die Adresse schreiben
  const root = document.documentElement;
  const names = ['Klar', 'Zentriert', 'Schwebend', 'Info-Leiste', 'Menü groß'];
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-hv-set]');
  const label = document.querySelector<HTMLElement>('[data-hv-name]');
  const show = () => {
    const v = Number(root.dataset.hv || '1');
    buttons.forEach((b) => b.setAttribute('aria-pressed', String(Number(b.dataset.hvSet) === v)));
    if (label) label.textContent = names[v - 1] || '';
  };
  buttons.forEach((b) =>
    b.addEventListener('click', () => {
      const v = b.dataset.hvSet!;
      root.dataset.hv = v;
      try { localStorage.setItem('mw-hv', v); } catch {}
      const u = new URL(location.href);
      u.searchParams.set('header', v);
      history.replaceState(null, '', u);
      show();
    }),
  );
  show();
</script>
