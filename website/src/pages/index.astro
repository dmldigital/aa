---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import PoolReveal from '../components/PoolReveal.astro';
---

<Base
  title="Pool ohne Beton in 48 Stunden | Poolbau Koch aus Ahlen (NRW)"
  description="Keramik- und Fiberglaspools, eingebaut ohne Beton in 48 Stunden. Über 30 Jahre Erfahrung, bis zu 40 Jahre Garantie. Kostenlose Beratung vor Ort – Poolbau Koch, Ahlen."
>
  <Header />
  <main id="inhalt">
    <Hero />
    <PoolReveal />
    <section id="ablauf" class="section">
      <div class="container">
        <p class="muted">Weitere Sektionen folgen.</p>
      </div>
    </section>
  </main>
</Base>
