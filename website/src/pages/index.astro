---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import BentoSection from '../components/BentoSection.astro';
import StickySection from '../components/StickySection.astro';
import PartnerSection from '../components/PartnerSection.astro';
import LeistungenSection from '../components/LeistungenSection.astro';
import FaqSection from '../components/FaqSection.astro';
import Footer from '../components/Footer.astro';
---

<Base
  title="Pool ohne Beton in 48 Stunden | Poolbau Koch aus Ahlen (NRW)"
  description="Keramik- und Fiberglaspools, eingebaut ohne Beton in 48 Stunden. Über 30 Jahre Erfahrung, bis zu 40 Jahre Garantie. Kostenlose Beratung vor Ort. Poolbau Koch, Ahlen."
>
  <Header />
  <main id="inhalt">
    <Hero />
    <BentoSection />
    <PartnerSection />
    <StickySection />
    <LeistungenSection />
    <FaqSection />
  </main>
  <Footer />
</Base>
