---
/*
  Pool-Konfigurator „Pool-Studio“ – Prototyp (Start, Hersteller, Becken). Wireframe: /konfigurator-wireframe/.
  Daten: src/konfigurator/katalog.json (aus dem alten Konfigurator übernommen), Bilder: public/konfig/img/.
  Logik + Animationen: src/konfigurator/app.ts (Motion).
*/
import '../styles/global.css';
import katalog from '../konfigurator/katalog.json';
import { url } from '../lib/url';

const steps = ['Hersteller', 'Becken', 'Farbe & LED', 'Abdeckung', 'Technik', 'Wärme & Licht', 'Kontakt'];
const startImg = url('konfig/img/' + (katalog.models.find((m) => m.man === 'waterrows')?.img ?? ''));
---

<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="robots" content="noindex" />
  <meta name="theme-color" content="#EFEFEF" />
  <title>Pool-Konfigurator | Poolbau Koch</title>
  <meta name="description" content="Planen Sie Ihren Wunschpool Schritt für Schritt – Hersteller, Becken, Farbe, Abdeckung, Technik und Licht. Ihre Konfiguration kommt als PDF per E-Mail." />
</head>
<body>
  <div class="kf" id="kf" data-view="start">
    <header class="kf-top">
      <a class="kf-logo" href={url('')} aria-label="Zur Startseite von Poolbau Koch"><img src={url('brand/logo-temp.png')} alt="Poolbau Koch" width="256" height="53" /></a>
      <nav class="kf-progress" aria-label="Fortschritt">
        <ol>
          {steps.map((s, i) => (
            <li data-pstep={i + 1}><button type="button" data-goto={i + 1} disabled><i>{i + 1}</i><span>{s}</span></button></li>
          ))}
        </ol>
        <div class="kf-pline"><div class="kf-pfill" data-pfill></div></div>
      </nav>
      <div class="kf-mstep" aria-hidden="true"><b data-mstep>1</b>/7</div>
      <button type="button" class="kf-cart" data-cart aria-expanded="false">Ihr Pool <span class="kf-badge" data-badge>0</span></button>
      <a class="kf-tel" href="tel:+491774509500">0177 450 95 00</a>
      <div class="kf-mbar"><div class="kf-pfill" data-pfill></div></div>
    </header>

    <!-- Start -->
    <section class="kf-start" data-start aria-labelledby="kf-start-title">
      <div class="kf-start-media"><img src={startImg} alt="" data-start-img /></div>
      <div class="kf-start-text">
        <p class="kf-eyebrow"><span class="dot"></span>Pool-Studio · Katalogmodelle 2026</p>
        <h1 id="kf-start-title" class="kf-h1" data-rise>Ihr Traumpool.<br />In 5 Minuten geplant.</h1>
        <p class="kf-lead" data-rise>Wählen Sie Hersteller, Becken, Farbe, Abdeckung und Technik. Ihre fertige Konfiguration bekommen Sie als PDF per E-Mail – wir melden uns zur persönlichen Beratung.</p>
        <div class="kf-start-cta" data-rise>
          <button type="button" class="btn-pill is-navy kf-btn-lg" data-begin>Pool konfigurieren <span aria-hidden="true">→</span></button>
          <span class="kf-muted">ca. 5 Minuten · unverbindlich</span>
        </div>
        <ul class="kf-facts" data-rise>
          <li><b>{katalog.models.length}</b><span>Becken aus den Katalogen 2026</span></li>
          <li><b>{katalog.manufacturers.length}</b><span>Hersteller</span></li>
          <li><b>PDF</b><span>Ihre Konfiguration per E-Mail</span></li>
        </ul>
      </div>
    </section>

    <!-- Studio -->
    <main class="kf-studio" data-studio hidden>
      <div class="kf-stage" data-stage>
        <div class="kf-photo"><img data-layer="a" alt="" /><img data-layer="b" alt="" /></div>
        <div class="kf-shade"></div>
        <div class="kf-stage-info" data-stage-info></div>
        <div class="kf-chips" data-chips></div>
      </div>
      <section class="kf-panel" aria-live="polite">
        <div class="kf-panel-scroll" data-scroll>
          <div class="kf-panel-head" data-head></div>
          <div class="kf-panel-body" data-body></div>
        </div>
        <div class="kf-panel-foot">
          <button type="button" class="kf-back" data-back>← Zurück</button>
          <span class="kf-hint" data-hint></span>
          <button type="button" class="btn-pill is-navy kf-next" data-next>Weiter →</button>
        </div>
      </section>
    </main>

    <aside class="kf-cart-pop" data-cart-pop hidden>
      <p class="kf-eyebrow"><span class="dot"></span>Ihr Pool</p>
      <ul data-cart-list></ul>
    </aside>
  </div>

  <script type="application/json" id="kf-data" set:html={JSON.stringify({ ...katalog, base: url('konfig/img/') })} />
  <script>
    import '../konfigurator/app';
  </script>

  <style is:global>
    html, body { height: 100%; }
    body { margin: 0; background: var(--bg); color: var(--ink); overflow: hidden; }
    .kf { position: relative; height: 100dvh; display: flex; flex-direction: column; }
    .kf [hidden] { display: none !important; }
    .kf .dot { width: 0.35rem; height: 0.35rem; border-radius: 50%; background: var(--pk-teal); flex: none; }
    .kf-eyebrow { display: inline-flex; align-items: center; gap: 0.6rem; margin: 0; font-size: var(--fs-small); font-weight: 500; text-transform: uppercase; letter-spacing: 0.02em; }
    .kf-muted { font-size: var(--fs-small); color: var(--ink-muted); }

    /* Kopfleiste */
    .kf-top { position: relative; z-index: 20; flex: none; display: flex; align-items: center; gap: 1.5rem; height: 4.75rem; padding: 0 1.5rem; }
    .kf-logo img { display: block; width: 10.5rem; height: auto; }
    .kf-progress { position: relative; flex: 1; max-width: 62rem; margin: 0 auto; opacity: 0; transition: opacity 0.5s; }
    .kf[data-view="studio"] .kf-progress { opacity: 1; }
    .kf-progress ol { display: flex; justify-content: space-between; margin: 0; padding: 0; list-style: none; }
    .kf-progress button { all: unset; display: flex; align-items: center; gap: 0.5rem; font-size: 0.8125rem; color: #8e8c87; cursor: default; white-space: nowrap; }
    .kf-progress button:not(:disabled) { cursor: pointer; }
    .kf-progress button:not(:disabled):hover span { color: var(--ink); }
    .kf-progress i { font-style: normal; display: grid; place-items: center; width: 1.5rem; height: 1.5rem; border-radius: 50%; border: 1px solid #c9c8c3; font-size: 0.7rem; transition: all 0.4s; }
    .kf-progress li.is-done button { color: var(--ink); }
    .kf-progress li.is-done i { background: var(--ink); border-color: var(--ink); color: #fff; }
    .kf-progress li.is-current button { color: var(--pk-navy); font-weight: 500; }
    .kf-progress li.is-current i { background: var(--pk-navy); border-color: var(--pk-navy); color: #fff; box-shadow: 0 0 0 4px #004a8022; }
    .kf-pline { position: absolute; left: 0; right: 0; bottom: -0.9rem; height: 3px; border-radius: 3px; background: #dcdbd6; overflow: hidden; }
    .kf-pfill { height: 100%; width: 0; border-radius: 3px; background: var(--pk-navy); }
    .kf-mstep, .kf-mbar { display: none; }
    .kf-cart { all: unset; display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.45rem 0.6rem 0.45rem 1rem; border-radius: 999px; background: #fff; font-size: var(--fs-small); font-weight: 500; cursor: pointer; opacity: 0; pointer-events: none; transition: opacity 0.5s; box-shadow: 0 2px 14px rgb(0 0 0 / 0.06); }
    .kf[data-view="studio"] .kf-cart { opacity: 1; pointer-events: auto; }
    .kf-badge { display: grid; place-items: center; min-width: 1.5rem; height: 1.5rem; padding: 0 0.35rem; border-radius: 999px; background: var(--pk-navy); color: #fff; font-size: 0.75rem; }
    .kf-tel { font-size: var(--fs-small); color: var(--ink-muted); white-space: nowrap; }
    .kf-cart-pop { position: absolute; z-index: 30; top: 4.5rem; right: 1.5rem; width: 20rem; padding: 1.25rem; border-radius: 0.5rem; background: #fff; box-shadow: 0 20px 40px -18px rgb(0 0 0 / 0.3); }
    .kf-cart-pop ul { margin: 0.75rem 0 0; padding: 0; list-style: none; }
    .kf-cart-pop li { display: flex; justify-content: space-between; gap: 1rem; padding: 0.6rem 0; border-top: 1px solid #eee; font-size: var(--fs-small); }
    .kf-cart-pop li span:first-child { color: var(--ink-muted); }
    .kf-cart-pop .empty { color: var(--ink-muted); border: 0; }

    /* Start */
    .kf-start { position: relative; flex: 1; display: grid; grid-template-columns: 1fr 1.25fr; gap: 1rem; padding: 0 1rem 1rem; min-height: 0; }
    .kf-start-media { order: 2; position: relative; border-radius: 0.5rem; overflow: hidden; view-transition-name: kf-stage; }
    .kf-start-media img { width: 100%; height: 100%; object-fit: cover; animation: kf-kenburns 14s ease-out both; }
    @keyframes kf-kenburns { from { scale: 1.12; } to { scale: 1; } }
    .kf-start-text { display: flex; flex-direction: column; justify-content: center; gap: 1.5rem; padding: 2rem 2.5rem 2rem 1.5rem; }
    .kf-h1 { margin: 0; font-size: clamp(2.6rem, 4.6vw, 4.875rem); line-height: 1; font-weight: 300; letter-spacing: -0.01em; }
    .kf-lead { margin: 0; max-width: 44ch; color: var(--ink-muted); }
    .kf-start-cta { display: flex; align-items: center; gap: 1.25rem; flex-wrap: wrap; }
    .kf-btn-lg { padding: 0.9rem 1.9rem; font-size: 1rem; gap: 0.5rem; }
    .kf-facts { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.75rem; margin: 1rem 0 0; padding: 0; list-style: none; }
    .kf-facts li { display: flex; flex-direction: column; gap: 0.25rem; padding: 1rem; border-radius: 0.5rem; background: #fff; }
    .kf-facts b { font-size: 1.75rem; font-weight: 400; line-height: 1; }
    .kf-facts span { font-size: 0.8125rem; color: var(--ink-muted); }

    /* Studio */
    .kf-studio { flex: 1; display: grid; grid-template-columns: 1.45fr 1fr; gap: 1rem; padding: 1.25rem 1rem 1rem; min-height: 0; }
    .kf-stage { position: relative; border-radius: 0.5rem; overflow: hidden; background: #dfe6e7; view-transition-name: kf-stage; }
    .kf-photo, .kf-photo img { position: absolute; inset: 0; width: 100%; height: 100%; }
    .kf-photo { pointer-events: none; }
    .kf-photo img { object-fit: cover; opacity: 0; }
    .kf-shade { position: absolute; inset: 0; z-index: 3; pointer-events: none; background: linear-gradient(0deg, rgb(0 0 0 / 0.55) 0%, rgb(0 0 0 / 0.12) 40%, rgb(0 0 0 / 0) 65%); }
    .kf-stage-info { position: absolute; z-index: 4; left: 1.5rem; right: 1.5rem; bottom: 1.5rem; color: #fff; }
    .kf-chips { position: absolute; z-index: 4; left: 1.5rem; top: 1.5rem; display: flex; flex-wrap: wrap; gap: 0.5rem; max-width: calc(100% - 3rem); }
    .kf-chip { display: inline-flex; align-items: center; gap: 0.4rem; height: 2rem; padding: 0 0.9rem; border-radius: 999px; background: rgb(255 255 255 / 0.9); color: var(--ink); font-size: 0.8125rem; font-weight: 500; -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px); white-space: nowrap; }
    .kf-chip small { color: var(--ink-muted); font-weight: 400; }

    /* Bühne: Marke */
    .kf-brand { display: grid; gap: 0.75rem; max-width: 36rem; }
    .kf-brand-logo { display: grid; place-items: center; width: 11rem; height: 4.5rem; padding: 0.6rem 1rem; border-radius: 0.5rem; background: #fff; }
    .kf-brand-logo img { max-width: 100%; max-height: 3.3rem; object-fit: contain; }
    .kf-brand h2 { margin: 0; font-size: 2.75rem; line-height: 1.05; font-weight: 400; }
    .kf-brand ul { display: grid; gap: 0.35rem; margin: 0; padding: 0; list-style: none; font-size: 0.95rem; opacity: 0.95; }
    .kf-brand li::before { content: '—'; margin-right: 0.5rem; opacity: 0.7; }
    .kf-tag { display: inline-flex; width: fit-content; padding: 0.25rem 0.7rem; border-radius: 999px; background: rgb(255 255 255 / 0.18); font-size: 0.75rem; font-weight: 500; text-transform: uppercase; letter-spacing: 0.04em; -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px); }

    /* Bühne: Becken (Maßkarte) */
    .kf-plan { display: grid; grid-template-columns: 1fr auto; gap: 1.25rem; align-items: end; padding: 1.25rem; border-radius: 0.5rem; background: rgb(255 255 255 / 0.92); color: var(--ink); -webkit-backdrop-filter: blur(14px); backdrop-filter: blur(14px); }
    .kf-plan-title { display: flex; align-items: baseline; gap: 0.75rem; flex-wrap: wrap; margin: 0 0 0.25rem; }
    .kf-plan-title h2 { margin: 0; font-size: 2rem; font-weight: 400; line-height: 1.1; }
    .kf-plan-title span { color: var(--ink-muted); font-size: var(--fs-small); }
    .kf-plan-nums { display: flex; gap: 1.5rem; margin: 0.5rem 0 0.25rem; }
    .kf-plan-nums div { display: flex; flex-direction: column; }
    .kf-plan-nums b { font-size: 1.6rem; font-weight: 400; font-variant-numeric: tabular-nums; }
    .kf-plan-nums small { font-size: 0.75rem; color: var(--ink-muted); text-transform: uppercase; letter-spacing: 0.04em; }
    .kf-plan-desc { margin: 0.35rem 0 0; font-size: var(--fs-small); color: var(--ink-muted); max-width: 46ch; }
    .kf-plan svg { display: block; width: 19rem; height: auto; overflow: visible; }
    .kf-compare { all: unset; justify-self: start; margin-top: 0.6rem; font-size: 0.8125rem; font-weight: 500; color: var(--pk-navy); cursor: pointer; }
    .kf-compare:hover { text-decoration: underline; }
    .kf-legend { display: flex; gap: 1rem; font-size: 0.75rem; color: var(--ink-muted); margin-top: 0.4rem; }
    .kf-legend i { display: inline-block; width: 0.8rem; height: 0.8rem; border-radius: 3px; margin-right: 0.35rem; vertical-align: -1px; }

    /* Panel */
    .kf-panel { position: relative; display: flex; flex-direction: column; min-height: 0; border-radius: 0.5rem; background: #f7f7f5; }
    .kf-panel-scroll { flex: 1; overflow-y: auto; overscroll-behavior: contain; padding: 2rem 2rem 1rem; scrollbar-width: thin; }
    .kf-panel-head { display: grid; gap: 0.6rem; margin-bottom: 1.5rem; }
    .kf-panel-head h1 { margin: 0; font-size: 2.25rem; line-height: 1.1; font-weight: 400; }
    .kf-panel-head p { margin: 0; color: var(--ink-muted); max-width: 48ch; }
    .kf-panel-foot { flex: none; display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 1rem 2rem 1.25rem; border-top: 1px solid #e6e6e2; }
    .kf-back { all: unset; padding: 0.5rem 1.2rem; border-radius: 999px; border: 1px solid #d5d5d0; background: #fff; font-size: var(--fs-small); font-weight: 500; cursor: pointer; transition: transform 0.25s; }
    .kf-back:hover { transform: translate(0, 2px); }
    .kf-next { padding: 0.65rem 1.6rem; font-size: 0.95rem; }
    .kf-next[aria-disabled="true"] { opacity: 0.35; cursor: not-allowed; }
    .kf-hint { flex: 1; text-align: right; font-size: 0.8125rem; color: var(--ink-muted); }

    /* Optionen */
    .kf-opts { display: grid; gap: 0.75rem; margin: 0; padding: 0; list-style: none; }
    .kf-opts.is-models { grid-template-columns: 1fr 1fr; }
    .kf-opt { all: unset; box-sizing: border-box; position: relative; display: block; width: 100%; padding: 0.75rem; border-radius: 0.5rem; background: #fff; cursor: pointer; outline: 1.5px solid transparent; transition: outline-color 0.25s, box-shadow 0.35s, transform 0.35s cubic-bezier(0.3, 1.25, 0.5, 1); }
    .kf-opt:hover { box-shadow: 0 14px 30px -20px rgb(0 0 0 / 0.35); transform: translateY(-2px); }
    .kf-opt:focus-visible { outline-color: var(--pk-teal); }
    .kf-opt[aria-checked="true"] { outline-color: var(--pk-navy); box-shadow: 0 16px 34px -20px #004a80aa; }
    .kf-tick { position: absolute; top: 0.6rem; right: 0.6rem; display: grid; place-items: center; width: 1.6rem; height: 1.6rem; border-radius: 50%; background: var(--pk-navy); color: #fff; font-size: 0.8rem; scale: 0; }
    .kf-opt[aria-checked="true"] .kf-tick { scale: 1; }
    .kf-opt-brand { display: grid; grid-template-columns: 9.5rem 1fr; gap: 1.1rem; align-items: center; padding: 1rem; }
    .kf-opt-brand .logo { display: grid; place-items: center; height: 5.5rem; padding: 0.75rem; border-radius: 0.375rem; background: #f3f3f1; }
    .kf-opt-brand .logo img { max-width: 100%; max-height: 100%; object-fit: contain; }
    .kf-opt-brand h3 { margin: 0.2rem 0 0.25rem; font-size: 1.25rem; font-weight: 500; }
    .kf-opt-brand p { margin: 0; font-size: var(--fs-small); color: var(--ink-muted); }
    .kf-opt-brand .meta { display: flex; gap: 0.75rem; margin-top: 0.5rem; font-size: 0.75rem; color: var(--ink-muted); }
    .kf-kicker { font-size: 0.7rem; font-weight: 500; text-transform: uppercase; letter-spacing: 0.06em; color: var(--pk-teal); }
    .kf-opt-model .thumb { aspect-ratio: 16 / 9; border-radius: 0.375rem; overflow: hidden; background: #eceae6; }
    .kf-opt-model .thumb img { width: 100%; height: 100%; object-fit: cover; transition: scale 0.6s ease; }
    .kf-opt-model:hover .thumb img { scale: 1.06; }
    .kf-opt-model h3 { margin: 0.6rem 0 0.15rem; font-size: 1rem; font-weight: 500; }
    .kf-opt-model p { margin: 0; font-size: 0.8125rem; color: var(--ink-muted); }
    .kf-filter { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; margin-bottom: 1.1rem; }
    .kf-fchip { all: unset; padding: 0.4rem 0.95rem; border-radius: 999px; background: #fff; border: 1px solid #deded9; font-size: 0.8125rem; cursor: pointer; transition: all 0.25s; }
    .kf-fchip:hover { border-color: #b9b8b2; }
    .kf-fchip[aria-pressed="true"] { background: var(--ink); border-color: var(--ink); color: #fff; }
    .kf-count { margin-left: auto; font-size: 0.8125rem; color: var(--ink-muted); }
    .kf-soon { padding: 1.5rem; border-radius: 0.5rem; background: #fff; }
    .kf-soon h3 { margin: 0 0 0.4rem; font-weight: 500; }
    .kf-soon p { margin: 0; color: var(--ink-muted); }

    /* Flug-Chip */
    .kf-fly { position: fixed; z-index: 50; pointer-events: none; }

    ::view-transition-old(kf-stage), ::view-transition-new(kf-stage) { animation-duration: 0.7s; animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1); }
    ::view-transition-old(root), ::view-transition-new(root) { animation-duration: 0.45s; }

    /* Handy */
    @media (max-width: 900px) {
      .kf-top { height: 3.75rem; gap: 0.75rem; padding: 0 1rem; }
      .kf-logo img { width: 8.5rem; }
      .kf-progress, .kf-tel { display: none; }
      .kf-mstep { display: block; margin-left: auto; font-size: 0.8125rem; color: var(--ink-muted); opacity: 0; transition: opacity 0.4s; }
      .kf-mstep b { color: var(--pk-navy); font-size: 1rem; font-weight: 500; }
      .kf[data-view="studio"] .kf-mstep { opacity: 1; }
      .kf-cart { padding: 0.35rem 0.45rem 0.35rem 0.8rem; font-size: 0.8125rem; }
      .kf-mbar { display: block; position: absolute; left: 0; right: 0; bottom: 0; height: 3px; background: #dcdbd6; opacity: 0; transition: opacity 0.4s; }
      .kf[data-view="studio"] .kf-mbar { opacity: 1; }
      .kf-cart-pop { top: 3.5rem; right: 0.75rem; left: 0.75rem; width: auto; }

      .kf-start { grid-template-columns: 1fr; grid-template-rows: 42% 1fr; padding: 0 0.75rem 0.75rem; }
      .kf-start-media { order: 0; }
      .kf-start-text { justify-content: flex-start; gap: 1rem; padding: 1.25rem 0.5rem 0; overflow-y: auto; }
      .kf-h1 { font-size: 2.4rem; }
      .kf-lead { font-size: 0.95rem; }
      .kf-facts { gap: 0.5rem; margin-top: 0; }
      .kf-facts li { padding: 0.75rem; } .kf-facts b { font-size: 1.3rem; } .kf-facts span { font-size: 0.72rem; }
      .kf-start-cta .kf-muted { display: none; }
      .kf-start-cta .btn-pill { width: 100%; }

      .kf-studio { grid-template-columns: 1fr; grid-template-rows: 38% 1fr; gap: 0; padding: 0; }
      .kf-stage { border-radius: 0; }
      .kf-stage-info { left: 1rem; right: 1rem; bottom: 1.6rem; }
      .kf-chips { left: 1rem; top: 1rem; }
      .kf-panel { margin-top: -1rem; border-radius: 1.1rem 1.1rem 0 0; box-shadow: 0 -12px 30px -20px rgb(0 0 0 / 0.4); }
      .kf-panel::before { content: ''; position: absolute; top: 0.5rem; left: 50%; width: 2.75rem; height: 0.3rem; margin-left: -1.375rem; border-radius: 1rem; background: #d3d2cd; }
      .kf-panel-scroll { margin-top: 1.1rem; padding: 0.4rem 1rem 1rem; }
      .kf-panel-head { margin-bottom: 1rem; gap: 0.4rem; }
      .kf-panel-head h1 { font-size: 1.6rem; }
      .kf-panel-head p { font-size: 0.9rem; }
      .kf-panel-foot { padding: 0.75rem 1rem calc(0.75rem + env(safe-area-inset-bottom)); background: #fff; }
      .kf-hint { display: none; }
      .kf-next { flex: 1; }
      .kf-opts.is-models { grid-template-columns: 1fr; }
      .kf-opt-model { display: grid; grid-template-columns: 7.5rem 1fr; gap: 0.85rem; align-items: center; }
      .kf-opt-model h3 { margin-top: 0; }
      .kf-opt-brand { grid-template-columns: 6.5rem 1fr; gap: 0.85rem; padding: 0.85rem; }
      .kf-opt-brand .logo { height: 4.25rem; }
      .kf-opt-brand ul { display: none; }
      .kf-brand h2 { font-size: 1.7rem; }
