---
/*
  Pool-Konfigurator „Pool-Studio“ – Seite mit Header/Footer der Website; der Konfigurator selbst ist immer
  100vh hoch (Kopfleiste der Website liegt darüber). Wireframe: /konfigurator-wireframe/.
  Daten: src/konfigurator/katalog.json, Regeln: summary.ts, PDF: pdf.ts, Logik/Animationen: app.ts (Motion).
  Versand: Cloudflare Pages Function functions/api/konfiguration.ts (auf GitHub Pages → Testmodus).
*/
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import katalog from '../konfigurator/katalog.json';
import { url } from '../lib/url';

const steps = ['Hersteller', 'Becken', 'Farbe & LED', 'Abdeckung', 'Technik', 'Wärme & Licht', 'Kontakt'];
const startImg = url('konfig/img/' + (katalog.models.find((m) => m.man === 'waterrows')?.img ?? ''));
---

<Base
  title="Pool-Konfigurator | Poolbau Koch"
  description="Planen Sie Ihren Wunschpool Schritt für Schritt: Hersteller, Becken, Farbe, Abdeckung, Technik und Licht. Ihre Konfiguration kommt als PDF per E-Mail."
>
  <Header />
  <main id="inhalt">
    <section class="kf" id="kf" data-view="start" aria-label="Pool-Konfigurator">
      <div class="kf-bar">
        <nav class="kf-progress" aria-label="Fortschritt">
          <ol>
            {steps.map((s, i) => (
              <li data-pstep={i + 1}><button type="button" data-goto={i + 1} disabled><i>{i + 1}</i><span>{s}</span></button></li>
            ))}
          </ol>
          <div class="kf-pline"><div class="kf-pfill" data-pfill></div></div>
        </nav>
        <div class="kf-mstep" aria-hidden="true">Schritt <b data-mstep>1</b>/7</div>
        <button type="button" class="kf-cart" data-cart aria-expanded="false">Ihr Pool <span class="kf-badge" data-badge>0</span></button>
        <div class="kf-mbar"><div class="kf-pfill" data-pfill></div></div>
      </div>

      <div class="kf-start" data-start>
        <div class="kf-start-media"><img src={startImg} alt="" data-start-img /></div>
        <div class="kf-start-text">
          <p class="kf-eyebrow"><span class="dot"></span>Pool-Studio · Katalogmodelle 2026</p>
          <h1 class="kf-h1" data-rise>Ihr Traumpool.<br />In 5 Minuten geplant.</h1>
          <p class="kf-lead" data-rise>Wählen Sie Hersteller, Becken, Farbe, Abdeckung und Technik. Ihre fertige Konfiguration bekommen Sie als PDF per E-Mail. Auf Wunsch melden wir uns zur persönlichen Beratung.</p>
          <div class="kf-start-cta" data-rise>
            <button type="button" class="btn-pill is-navy kf-btn-lg" data-begin>Pool konfigurieren <span aria-hidden="true">→</span></button>
            <span class="kf-muted">ca. 5 Minuten · unverbindlich</span>
          </div>
          <ul class="kf-facts" data-rise>
            <li><b>{katalog.models.length}</b><span>Becken aus den Katalogen 2026</span></li>
            <li><b>{katalog.manufacturers.length}</b><span>Hersteller</span></li>
            <li><b>PDF</b><span>Ihre Konfiguration per E-Mail</span></li>
          </ul>
        </div>
      </div>

      <div class="kf-studio" data-studio hidden>
        <div class="kf-stage" data-stage>
          <div class="kf-photo"><img data-layer="a" alt="" /><img data-layer="b" alt="" /></div>
          <div class="kf-night" aria-hidden="true"><i></i></div>
          <div class="kf-shade"></div>
          <div class="kf-stage-info" data-stage-info></div>
          <div class="kf-chips" data-chips></div>
          <button type="button" class="kf-daynight" data-daynight hidden>Nacht</button>
        </div>
        <section class="kf-panel" aria-live="polite">
          <div class="kf-panel-scroll" data-scroll data-lenis-prevent>
            <div class="kf-panel-head" data-head></div>
            <div class="kf-panel-body" data-body></div>
          </div>
          <div class="kf-panel-foot" data-foot>
            <button type="button" class="kf-back" data-back>← Zurück</button>
            <span class="kf-hint" data-hint></span>
            <button type="button" class="btn-pill is-navy kf-next" data-next>Weiter →</button>
          </div>
        </section>
      </div>

      <aside class="kf-cart-pop" data-cart-pop hidden data-lenis-prevent>
        <p class="kf-eyebrow"><span class="dot"></span>Ihr Pool</p>
        <ul data-cart-list></ul>
      </aside>
    </section>
  </main>
  <Footer />

  <script type="application/json" id="kf-data" set:html={JSON.stringify({ ...katalog, base: url('konfig/img/'), pdfBase: url('konfig/pdf/'), logo: url('brand/logo-temp.png'), api: url('api/konfiguration'), privacy: 'https://poolbau-kochgmbh.de/datenschutz' })} />
  <script>
    import '../konfigurator/app';
  </script>

  <style is:global>
    .kf { --kf-top: 6.6rem; position: relative; height: 100vh; height: 100svh; min-height: 36rem; display: flex; flex-direction: column; padding-top: var(--kf-top); box-sizing: border-box; }
    .kf [hidden] { display: none !important; }
    .kf .dot { width: 0.35rem; height: 0.35rem; border-radius: 50%; background: var(--pk-teal); flex: none; }
    .kf-eyebrow { display: inline-flex; align-items: center; gap: 0.6rem; margin: 0; font-size: var(--fs-small); font-weight: 500; text-transform: uppercase; letter-spacing: 0.02em; }
    .kf-muted { font-size: var(--fs-small); color: var(--ink-muted); }

    /* Leiste: Fortschritt + Ihr Pool */
    .kf-bar { position: relative; z-index: 5; flex: none; display: flex; align-items: center; gap: 1.5rem; height: 3.25rem; padding: 0 2.5rem; }
    .kf-progress { position: relative; flex: 1; opacity: 0; transition: opacity 0.6s; }
    .kf[data-view="studio"] .kf-progress, .kf[data-view="done"] .kf-progress { opacity: 1; }
    .kf-progress ol { display: flex; justify-content: space-between; margin: 0; padding: 0; list-style: none; }
    .kf-progress button { all: unset; display: flex; align-items: center; gap: 0.5rem; font-size: 0.8125rem; color: #8e8c87; cursor: default; white-space: nowrap; }
    .kf-progress button:not(:disabled) { cursor: pointer; }
    .kf-progress button:not(:disabled):hover span { color: var(--ink); }
    .kf-progress i { font-style: normal; display: grid; place-items: center; width: 1.5rem; height: 1.5rem; border-radius: 50%; border: 1px solid #c9c8c3; font-size: 0.7rem; transition: all 0.5s cubic-bezier(0.22, 1, 0.36, 1); }
    .kf-progress li.is-done button { color: var(--ink); }
    .kf-progress li.is-done i { background: var(--ink); border-color: var(--ink); color: #fff; }
    .kf-progress li.is-current button { color: var(--pk-navy); font-weight: 500; }
    .kf-progress li.is-current i { background: var(--pk-navy); border-color: var(--pk-navy); color: #fff; box-shadow: 0 0 0 4px #004a8022; }
    .kf-pline { position: absolute; left: 0; right: 0; bottom: -0.8rem; height: 3px; border-radius: 3px; background: #dcdbd6; overflow: hidden; }
    .kf-pfill { height: 100%; width: 0; border-radius: 3px; background: var(--pk-navy); }
    .kf-mstep, .kf-mbar { display: none; }
    .kf-cart { all: unset; flex: none; display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.45rem 0.6rem 0.45rem 1rem; border-radius: 999px; background: #fff; font-size: var(--fs-small); font-weight: 500; cursor: pointer; opacity: 0; pointer-events: none; transition: opacity 0.6s; box-shadow: 0 2px 14px rgb(0 0 0 / 0.06); }
    .kf[data-view="studio"] .kf-cart, .kf[data-view="done"] .kf-cart { opacity: 1; pointer-events: auto; }
    .kf-badge { display: grid; place-items: center; min-width: 1.5rem; height: 1.5rem; padding: 0 0.35rem; border-radius: 999px; background: var(--pk-navy); color: #fff; font-size: 0.75rem; }
    .kf-cart-pop { position: absolute; z-index: 30; top: calc(var(--kf-top) + 3.25rem); right: 2.5rem; width: 22rem; max-height: 60vh; overflow: auto; padding: 1.25rem; border-radius: 0.5rem; background: #fff; box-shadow: 0 20px 40px -18px rgb(0 0 0 / 0.3); }
    .kf-cart-pop ul { margin: 0.75rem 0 0; padding: 0; list-style: none; }
    .kf-cart-pop li { display: grid; grid-template-columns: 7rem 1fr; gap: 0.75rem; padding: 0.6rem 0; border-top: 1px solid #eee; font-size: var(--fs-small); }
    .kf-cart-pop li span:first-child { color: var(--ink-muted); }
    .kf-cart-pop .empty { display: block; color: var(--ink-muted); border: 0; }

    /* Start */
    .kf-start { position: relative; flex: 1; display: grid; grid-template-columns: 1fr 1.25fr; gap: 1rem; padding: 0 2.5rem 1.5rem; min-height: 0; }
    .kf-start-media { order: 2; position: relative; border-radius: 0.5rem; overflow: hidden; view-transition-name: kf-stage; }
    .kf-start-media img { width: 100%; height: 100%; object-fit: cover; animation: kf-kenburns 16s cubic-bezier(0.16, 1, 0.3, 1) both; }
    @keyframes kf-kenburns { from { scale: 1.14; } to { scale: 1; } }
    .kf-start-text { display: flex; flex-direction: column; justify-content: center; gap: 1.5rem; padding: 1rem 2.5rem 1rem 0; }
    .kf-h1 { margin: 0; font-size: clamp(2.6rem, 4.6vw, 4.875rem); line-height: 1; font-weight: 300; letter-spacing: -0.01em; }
    .kf-lead { margin: 0; max-width: 44ch; color: var(--ink-muted); }
    .kf-start-cta { display: flex; align-items: center; gap: 1.25rem; flex-wrap: wrap; }
    .kf-btn-lg { padding: 0.9rem 1.9rem; font-size: 1rem; gap: 0.5rem; }
    .kf-facts { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.75rem; margin: 1rem 0 0; padding: 0; list-style: none; }
    .kf-facts li { display: flex; flex-direction: column; gap: 0.25rem; padding: 1rem; border-radius: 0.5rem; background: #fff; }
    .kf-facts b { font-size: 1.75rem; font-weight: 400; line-height: 1; }
    .kf-facts span { font-size: 0.8125rem; color: var(--ink-muted); }

    /* Studio */
    .kf-studio { flex: 1; display: grid; grid-template-columns: 1.45fr 1fr; gap: 1rem; padding: 1.25rem 2.5rem 1.5rem; min-height: 0; }
    .kf-stage { position: relative; border-radius: 0.5rem; overflow: hidden; background: #dfe6e7; view-transition-name: kf-stage; }
    .kf-photo { position: absolute; inset: 0; pointer-events: none; transition: filter 1.2s cubic-bezier(0.22, 1, 0.36, 1); }
    .kf-photo img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; will-change: transform, opacity; transform-origin: 50% 50%; }
    .kf-stage.is-dim .kf-photo { filter: brightness(0.62) saturate(0.9); }
    .kf-shade { position: absolute; inset: 0; z-index: 3; pointer-events: none; background: linear-gradient(0deg, rgb(0 0 0 / 0.55) 0%, rgb(0 0 0 / 0.12) 40%, rgb(0 0 0 / 0) 65%); }
    .kf-stage-info { position: absolute; z-index: 4; left: 1.5rem; right: 1.5rem; bottom: 1.5rem; color: #fff; }
    .kf-chips { position: absolute; z-index: 4; left: 1.5rem; top: 1.5rem; display: flex; flex-wrap: wrap; gap: 0.5rem; max-width: calc(100% - 9rem); }
    .kf-chip { display: inline-flex; align-items: center; gap: 0.4rem; height: 2rem; padding: 0 0.9rem; border-radius: 999px; background: rgb(255 255 255 / 0.9); color: var(--ink); font-size: 0.8125rem; font-weight: 500; -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px); white-space: nowrap; }
    .kf-fly { position: fixed; z-index: 1100; pointer-events: none; }

    /* Nachtmodus (LED / Licht) */
    .kf-night { position: absolute; inset: 0; z-index: 2; pointer-events: none; opacity: 0; transition: opacity 1.4s cubic-bezier(0.22, 1, 0.36, 1); background: radial-gradient(120% 90% at 50% 60%, rgb(4 20 34 / 0.35), rgb(2 10 20 / 0.82)); }
    .kf-night i { position: absolute; inset: 14% 10% 26%; border-radius: 1rem; box-shadow: inset 0 0 0 2px rgb(125 240 255 / 0.9), 0 0 40px 6px rgb(90 220 255 / 0.45), inset 0 0 60px rgb(90 220 255 / 0.35); opacity: 0; transition: opacity 1.6s 0.3s; }
    .kf-stage.is-night .kf-night { opacity: 1; }
    .kf-stage.is-night.has-led .kf-night i { opacity: 1; animation: kf-glow 3.2s ease-in-out infinite; }
    .kf-stage.is-night.has-rgb .kf-night i { opacity: 1; animation: kf-rgb 8s linear infinite; }
    @keyframes kf-glow { 50% { box-shadow: inset 0 0 0 2px rgb(125 240 255 / 0.6), 0 0 26px 3px rgb(90 220 255 / 0.3), inset 0 0 40px rgb(90 220 255 / 0.2); } }
    @keyframes kf-rgb { to { filter: hue-rotate(360deg); } }
    .kf-daynight { all: unset; position: absolute; z-index: 5; right: 1.5rem; top: 1.5rem; display: inline-flex; gap: 0.4rem; align-items: center; padding: 0.45rem 1rem; border-radius: 999px; background: rgb(255 255 255 / 0.9); font-size: 0.8125rem; font-weight: 500; cursor: pointer; -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px); }

    /* Bühne: Marke */
    .kf-brand { display: grid; gap: 0.75rem; max-width: 36rem; }
    .kf-brand-logo { display: flex; align-items: center; height: 4.25rem; }
    .kf-brand-logo img { max-width: 13rem; max-height: 100%; object-fit: contain; filter: brightness(0) invert(1) drop-shadow(0 2px 12px rgb(0 0 0 / 0.25)); }
    .kf-brand h2 { margin: 0; font-size: 2.75rem; line-height: 1.05; font-weight: 400; }
    .kf-brand ul { display: grid; gap: 0.35rem; margin: 0; padding: 0; list-style: none; font-size: 0.95rem; opacity: 0.95; }
    .kf-brand li::before { content: ''; display: inline-block; width: 0.75rem; height: 1px; margin: 0 0.5rem 0.3em 0; background: currentColor; opacity: 0.7; }
    .kf-tag { display: inline-flex; width: fit-content; padding: 0.25rem 0.7rem; border-radius: 999px; background: rgb(255 255 255 / 0.18); font-size: 0.75rem; font-weight: 500; text-transform: uppercase; letter-spacing: 0.04em; -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px); }

    /* Bühne: Karten (Maß, Farbe, Produkt, Zusammenfassung) */
    .kf-card { padding: 1.25rem; border-radius: 0.5rem; background: rgb(255 255 255 / 0.93); color: var(--ink); -webkit-backdrop-filter: blur(14px); backdrop-filter: blur(14px); }
    .kf-plan { display: grid; grid-template-columns: 1fr auto; gap: 1.25rem; align-items: end; }
    .kf-plan-title { display: flex; align-items: baseline; gap: 0.75rem; flex-wrap: wrap; margin: 0 0 0.25rem; }
    .kf-plan-title h2 { margin: 0; font-size: 2rem; font-weight: 400; line-height: 1.1; }
    .kf-plan-title span { color: var(--ink-muted); font-size: var(--fs-small); }
    .kf-plan-nums { display: flex; gap: 1.5rem; margin: 0.5rem 0 0.25rem; }
    .kf-plan-nums div { display: flex; flex-direction: column; }
    .kf-plan-nums b { font-size: 1.6rem; font-weight: 400; font-variant-numeric: tabular-nums; }
    .kf-plan-nums small { font-size: 0.75rem; color: var(--ink-muted); text-transform: uppercase; letter-spacing: 0.04em; }
    .kf-plan-desc { margin: 0.35rem 0 0; font-size: var(--fs-small); color: var(--ink-muted); max-width: 46ch; }
    .kf-plan svg { display: block; width: 19rem; height: auto; overflow: visible; }
    .kf-link { all: unset; justify-self: start; margin-top: 0.6rem; font-size: 0.8125rem; font-weight: 500; color: var(--pk-navy); cursor: pointer; }
    .kf-link:hover { text-decoration: underline; }
    .kf-legend { display: flex; gap: 1rem; font-size: 0.75rem; color: var(--ink-muted); margin-top: 0.4rem; }
    .kf-legend i { display: inline-block; width: 0.8rem; height: 0.8rem; border-radius: 3px; margin-right: 0.35rem; vertical-align: -1px; }
    .kf-product { display: grid; grid-template-columns: 13rem 1fr; gap: 1.25rem; align-items: center; max-width: 42rem; }
    .kf-product-img { height: 9.5rem; border-radius: 0.375rem; background: #fff; display: grid; place-items: center; overflow: hidden; }
    .kf-product-img img { width: 100%; height: 100%; object-fit: contain; }
    .kf-product-img.is-cover img { object-fit: cover; }
    .kf-product h2 { margin: 0.2rem 0 0.35rem; font-size: 1.6rem; font-weight: 400; line-height: 1.15; }
    .kf-product p { margin: 0; font-size: var(--fs-small); color: var(--ink-muted); }
    .kf-badge-inline { display: inline-flex; margin-top: 0.6rem; padding: 0.25rem 0.7rem; border-radius: 999px; background: #e9f4f3; color: #146c6b; font-size: 0.75rem; font-weight: 500; }
    .kf-season { margin-top: 0.9rem; }
    .kf-season-bar { position: relative; display: grid; grid-template-columns: repeat(12, 1fr); gap: 3px; }
    .kf-season-bar span { height: 0.6rem; border-radius: 3px; background: #e3e2de; }
    .kf-season-bar span.on { background: linear-gradient(90deg, #ffb347, #ffcc70); }
    .kf-season-lbl { display: grid; grid-template-columns: repeat(12, 1fr); margin-top: 0.3rem; font-size: 0.65rem; color: var(--ink-muted); text-align: center; }
    .kf-sum { max-height: calc(100% - 3rem); overflow: auto; }
    .kf-sum h2 { margin: 0 0 0.6rem; font-size: 1.6rem; font-weight: 400; }
    .kf-sum ul { margin: 0; padding: 0; list-style: none; }
    .kf-sum li { display: grid; grid-template-columns: 7.5rem 1fr auto; gap: 0.75rem; align-items: baseline; padding: 0.5rem 0; border-top: 1px solid #e9e9e6; font-size: var(--fs-small); }
    .kf-sum li span:first-child { color: var(--ink-muted); }
    .kf-sum li small { display: block; color: var(--ink-muted); font-size: 0.75rem; }

    /* Panel */
    .kf-panel { position: relative; display: flex; flex-direction: column; min-height: 0; border-radius: 0.5rem; background: #f7f7f5; }
    .kf-panel-scroll { flex: 1; overflow-y: auto; overscroll-behavior: contain; padding: 2rem 2rem 1rem; scrollbar-width: thin; }
    .kf-panel-head { display: grid; gap: 0.6rem; margin-bottom: 1.5rem; }
    .kf-panel-head h1 { margin: 0; font-size: 2.25rem; line-height: 1.1; font-weight: 400; }
    .kf-panel-head p { margin: 0; color: var(--ink-muted); max-width: 48ch; }
    .kf-panel-foot { flex: none; display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 1rem 2rem 1.25rem; border-top: 1px solid #e6e6e2; }
    .kf-back { all: unset; padding: 0.5rem 1.2rem; border-radius: 999px; border: 1px solid #d5d5d0; background: #fff; font-size: var(--fs-small); font-weight: 500; cursor: pointer; transition: transform 0.25s; }
    .kf-back:hover { transform: translate(0, 2px); }
    .kf-next { padding: 0.65rem 1.6rem; font-size: 0.95rem; }
    .kf-next[aria-disabled="true"] { opacity: 0.35; cursor: not-allowed; }
    .kf-next[aria-busy="true"] { opacity: 0.7; cursor: progress; }
    .kf-hint { flex: 1; text-align: right; font-size: 0.8125rem; color: var(--ink-muted); }
    .kf-section-t { margin: 1.5rem 0 0.75rem; font-size: 0.8125rem; font-weight: 500; text-transform: uppercase; letter-spacing: 0.04em; color: var(--ink-muted); }
    .kf-note { display: flex; gap: 0.75rem; margin-bottom: 1rem; padding: 0.85rem 1rem; border-radius: 0.5rem; background: #e9f4f3; font-size: var(--fs-small); color: #1c4f4e; }

    /* Optionen */
    .kf-opts { display: grid; gap: 0.75rem; margin: 0; padding: 0; list-style: none; }
    .kf-opts.is-2 { grid-template-columns: 1fr 1fr; }
    .kf-opt { all: unset; box-sizing: border-box; position: relative; display: block; width: 100%; padding: 0.75rem; border-radius: 0.5rem; background: #fff; cursor: pointer; outline: 1.5px solid transparent; transition: outline-color 0.4s, box-shadow 0.6s cubic-bezier(0.22, 1, 0.36, 1), transform 0.6s cubic-bezier(0.22, 1, 0.36, 1); }
    .kf-opt:hover { box-shadow: 0 14px 30px -20px rgb(0 0 0 / 0.35); transform: translateY(-2px); }
    .kf-opt:focus-visible { outline-color: var(--pk-teal); }
    .kf-opt[aria-checked="true"] { outline-color: var(--pk-navy); box-shadow: 0 16px 34px -20px #004a80aa; }
    .kf-tick { position: absolute; top: 0.6rem; right: 0.6rem; z-index: 2; display: grid; place-items: center; width: 1.6rem; height: 1.6rem; border-radius: 50%; background: var(--pk-navy); color: #fff; font-size: 0.8rem; scale: 0; }
    .kf-opt[aria-checked="true"] .kf-tick { scale: 1; }
    .kf-opt h3 { margin: 0.6rem 0 0.15rem; font-size: 1rem; font-weight: 500; }
    /* Nutzerwunsch: alle Auswahlkarten gleich groß – gleiche Zeilenhöhe im Raster, Texte auf 2 Zeilen,
       Badges unten bündig; ausführliche Infos im Info-Fenster */
    .kf-opts.is-2 { grid-auto-rows: 1fr; }
    .kf-item { position: relative; display: grid; }
    .kf-opt:not(.kf-opt-brand) { display: flex; flex-direction: column; height: 100%; }
    .kf-opt .kf-media { flex: none; }
    .kf-opt-body { display: block; }
    .kf-opt-body h3, .kf-opt-body p { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; }
    .kf-opt-foot { display: flex; flex-wrap: wrap; align-items: center; gap: 0.35rem; margin-top: auto; padding-top: 0.6rem; padding-right: 2rem; min-height: 1.6rem; }
    .kf-opt-foot .kf-badge-inline, .kf-sheet-badges .kf-badge-inline { margin-top: 0; }
    .kf-chip-s { display: inline-flex; padding: 0.25rem 0.65rem; border-radius: 999px; background: #f1f0ed; color: var(--ink-muted); font-size: 0.7rem; font-weight: 500; }
    /* Info-Knopf „i“ (bläuliche Glas-Optik wie der Scroll-Hinweis) */
    .kf-info {
      all: unset; box-sizing: border-box; position: absolute; right: 0.6rem; bottom: 0.6rem; z-index: 3; display: grid; place-items: center;
      width: 1.6rem; height: 1.6rem; border-radius: 50%; cursor: pointer; -webkit-tap-highlight-color: transparent;
      background-color: rgb(0 74 128 / 0.08); box-shadow: inset 0 0 0 1px rgb(0 74 128 / 0.06);
      transition: background-color 0.4s, scale 0.5s cubic-bezier(0.16, 1, 0.3, 1), translate 0.6s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .kf-info:hover { background-color: rgb(0 74 128 / 0.16); scale: 1.08; }
    .kf-info:focus-visible { outline: 2px solid var(--pk-teal); outline-offset: 2px; }
    .kf-item:has(.kf-opt:hover) .kf-info, .kf-item:has(.kf-info:hover) .kf-info { translate: 0 -2px; }
    .kf-item:has(.kf-info:hover) .kf-opt { box-shadow: 0 14px 30px -20px rgb(0 0 0 / 0.35); transform: translateY(-2px); }
    .kf-info svg, .kf-more-pill svg, .kf-mini-chev svg { width: 0.62rem; height: auto; margin-top: 0.1rem; fill: none; stroke: var(--pk-navy); stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; transition: stroke 0.4s, rotate 0.6s cubic-bezier(0.16, 1, 0.3, 1); }
    .kf-mini-chev { display: inline-grid; place-items: center; width: 1.2rem; height: 1.2rem; border-radius: 50%; background-color: rgb(0 74 128 / 0.08); }
    .kf-mini-chev svg { width: 0.5rem; }
    .kf-i { width: 0.42rem; height: auto; fill: var(--pk-navy); stroke: var(--pk-navy); stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
    .kf-i path { fill: none; }
    .kf-tip { align-items: flex-start; background: rgb(0 74 128 / 0.06); color: var(--ink); }
    .kf-tip .dot { margin-top: 0.5rem; }
    .kf-tip b { font-weight: 500; color: var(--pk-navy); }
    .kf-pickcard { max-width: 30rem; }
    .kf-pickcard h2 { margin: 0.25rem 0 0.35rem; font-size: 1.6rem; font-weight: 400; line-height: 1.15; }
    .kf-pickcard p { margin: 0; font-size: var(--fs-small); color: var(--ink-muted); }
    .kf-pickcard .kf-pickcard-hint { display: flex; align-items: center; gap: 0.45rem; margin-top: 0.7rem; color: var(--pk-navy); font-weight: 500; }

    /* Info-Fenster: Desktop Karte in der Mitte, Handy Blatt von unten */
    .kf-sheet-wrap { position: fixed; inset: 0; z-index: 1000; display: grid; place-items: center; padding: 1.5rem; }
    .kf-sheet-wrap[hidden] { display: none; }
    .kf-sheet-bg { position: absolute; inset: 0; background: rgb(21 21 21 / 0.35); -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px); }
    .kf-sheet { position: relative; width: min(34rem, 100%); max-height: calc(100svh - 3rem); overflow: auto; overscroll-behavior: contain; border-radius: 0.5rem; background: #fff; box-shadow: 0 30px 60px -30px rgb(0 0 0 / 0.5); }
    .kf-sheet-img { height: 15rem; overflow: hidden; background: #f1f0ed; }
    .kf-sheet-img img { display: block; width: 100%; height: 100%; object-fit: cover; }
    .kf-sheet-img.is-contain { background: #fff; border-bottom: 1px solid #eeede9; }
    .kf-sheet-img.is-contain img { object-fit: contain; padding: 1rem; box-sizing: border-box; }
    .kf-sheet-body { display: grid; gap: 0.65rem; padding: 1.4rem 1.5rem 1.5rem; }
    .kf-sheet-body h2 { margin: 0; font-size: 1.75rem; font-weight: 400; line-height: 1.15; }
    .kf-sheet-badges { display: flex; flex-wrap: wrap; gap: 0.4rem; }
    .kf-sheet-text { display: grid; gap: 0.7rem; font-size: 0.9rem; color: var(--ink-muted); }
    .kf-sheet-text p { margin: 0; }
    .kf-sheet-text ul { display: grid; gap: 0.4rem; margin: 0; padding: 0; list-style: none; }
    .kf-sheet-text li { display: flex; gap: 0.6rem; }
    .kf-sheet-text li::before { content: ''; flex: none; width: 0.35rem; height: 0.35rem; margin-top: 0.55em; border-radius: 50%; background: var(--pk-teal); }
    .kf-sheet-facts { display: grid; grid-template-columns: repeat(auto-fit, minmax(5.5rem, 1fr)); gap: 0.75rem; margin: 0; padding: 0.85rem 1rem; border-radius: 0.5rem; background: #f7f7f5; }
    .kf-sheet-facts .is-wide { grid-column: 1 / -1; }
    .kf-sheet-facts dt { font-size: 0.68rem; text-transform: uppercase; letter-spacing: 0.04em; color: var(--ink-muted); }
    .kf-sheet-facts dd { margin: 0.1rem 0 0; font-size: 1.05rem; color: var(--ink); }
    .kf-sheet-warn { padding: 0.6rem 0.8rem; border-radius: 0.5rem; background: #fff4e0; color: #7a4d00; font-size: 0.8125rem; }
    .kf-sheet-actions { display: flex; justify-content: flex-end; gap: 0.6rem; margin-top: 0.5rem; }
    .kf-sheet-actions .btn-pill { padding: 0.6rem 1.5rem; cursor: pointer; }
    .kf-sheet .kf-sheet-x { top: 0.75rem; right: 0.75rem; background-color: rgb(255 255 255 / 0.85); }
    .kf-opt p { margin: 0; font-size: 0.8125rem; color: var(--ink-muted); }
    .kf-opt .kf-badge-inline { margin-top: 0.5rem; }
    .kf-media { aspect-ratio: 16 / 10; border-radius: 0.375rem; overflow: hidden; background: #f1f0ed; }
    .kf-media img { width: 100%; height: 100%; object-fit: cover; transition: scale 0.9s cubic-bezier(0.22, 1, 0.36, 1), filter 0.6s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.6s cubic-bezier(0.22, 1, 0.36, 1); }
    .kf-media.is-product img { object-fit: contain; padding: 0.5rem; box-sizing: border-box; background: #fff; }
    .kf-media.is-empty { display: grid; place-items: center; color: #c4c3bd; }
    .kf-media.is-empty svg { width: 2.25rem; height: 2.25rem; fill: none; stroke: currentColor; stroke-width: 1.2; stroke-linecap: round; }
    .kf-opt:hover .kf-media img { scale: 1.06; }
    .kf-opt-brand { display: grid; grid-template-columns: 9.5rem 1fr; gap: 1.1rem; align-items: center; padding: 1rem; }
    .kf-opt-brand .logo { display: grid; place-items: center; height: 5.5rem; padding: 0.25rem 0.5rem; }
    .kf-opt-brand .logo img { max-width: 100%; max-height: 100%; object-fit: contain; transition: filter 0.6s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.6s cubic-bezier(0.22, 1, 0.36, 1); }
    .kf-opt-brand h3 { margin: 0.2rem 0 0.25rem; font-size: 1.25rem; }
    .kf-opt-brand .meta { display: flex; gap: 0.75rem; margin-top: 0.5rem; font-size: 0.75rem; color: var(--ink-muted); }
    /* Hover (Nutzerwunsch): die übrigen Logos/Bilder werden grau und treten zurück */
    .kf-opts:has(.kf-opt:hover) .kf-opt:not(:hover) .logo img,
    .kf-opts:has(.kf-opt:hover) .kf-opt:not(:hover) .kf-media img,
    .kf-opts.is-brands:has(.kf-brand-card:hover) .kf-brand-card:not(:hover) .logo img,
    .kf-gal:has(.kf-gal-item:hover) .kf-gal-item:not(:hover) img { filter: grayscale(1); opacity: 0.45; }

    /* Hersteller: Becken aufklappen (Nutzerwunsch) – Chevron-Pille in der Sprache des Scroll-Hinweises, leicht bläulich */
    .kf-brand-card { position: relative; }
    .kf-brand-card .kf-opt-brand { padding-right: 3.25rem; }
    .kf-brand-card:hover .kf-opt { box-shadow: 0 14px 30px -20px rgb(0 0 0 / 0.35); transform: translateY(-2px); }
    .kf-brand-card:hover .kf-opt[aria-checked="true"] { box-shadow: 0 16px 34px -20px #004a80aa; }
    .kf-more { all: unset; position: absolute; right: 0.6rem; bottom: 0.6rem; z-index: 3; display: grid; place-items: center; cursor: pointer; -webkit-tap-highlight-color: transparent; transition: translate 0.6s cubic-bezier(0.22, 1, 0.36, 1); }
    .kf-brand-card:hover .kf-more { translate: 0 -2px; }
    .kf-more-pill {
      display: grid; place-items: center; width: 1.6rem; height: 1.6rem; border-radius: 50%;
      background-color: rgb(0 74 128 / 0.08); box-shadow: inset 0 0 0 1px rgb(0 74 128 / 0.06);
      transition: background-color 0.4s, scale 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .kf-more:hover .kf-more-pill { background-color: rgb(0 74 128 / 0.16); scale: 1.08; }
    .kf-more:focus-visible .kf-more-pill { outline: 2px solid var(--pk-teal); outline-offset: 2px; }
    .kf-brand-item.is-open .kf-more-pill { background-color: var(--pk-navy); }
    .kf-brand-item.is-open .kf-more svg { stroke: #fff; rotate: 180deg; margin-top: -0.1rem; }
    .kf-brand-points { display: grid; gap: 0.4rem; margin: 0; padding: 1rem 0.25rem 0; list-style: none; font-size: 0.8125rem; color: var(--ink-muted); }
    .kf-brand-points li { display: flex; gap: 0.6rem; }
    .kf-brand-points li::before { content: ''; flex: none; width: 0.35rem; height: 0.35rem; margin-top: 0.5em; border-radius: 50%; background: var(--pk-teal); }
    .kf-models { overflow: hidden; }
    .kf-models-head { display: flex; justify-content: space-between; gap: 1rem; margin: 0; padding: 1rem 0.25rem 0.6rem; font-size: 0.75rem; color: var(--ink-muted); }
    .kf-models-head span:first-child { font-weight: 500; color: var(--pk-navy); }
    .kf-gal { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.6rem; margin: 0; padding: 0 0 0.35rem; list-style: none; }
    .kf-gal-item { all: unset; box-sizing: border-box; display: block; width: 100%; padding: 0.45rem; border-radius: 0.5rem; background: #fff; cursor: zoom-in; transition: box-shadow 0.6s cubic-bezier(0.22, 1, 0.36, 1), transform 0.6s cubic-bezier(0.22, 1, 0.36, 1); }
    .kf-gal-item:hover { box-shadow: 0 14px 30px -20px rgb(0 0 0 / 0.35); transform: translateY(-2px); }
    .kf-gal-item:focus-visible { outline: 1.5px solid var(--pk-teal); }
    .kf-gal-img { display: block; aspect-ratio: 4 / 3; border-radius: 0.375rem; overflow: hidden; background: #f1f0ed; }
    .kf-gal-img img { display: block; width: 100%; height: 100%; object-fit: cover; transition: scale 0.9s cubic-bezier(0.22, 1, 0.36, 1), filter 0.6s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.6s cubic-bezier(0.22, 1, 0.36, 1); }
    .kf-gal-item:hover .kf-gal-img img { scale: 1.06; }
    .kf-gal-item b { display: block; margin-top: 0.45rem; font-size: 0.8125rem; font-weight: 500; }
    .kf-gal-item small { display: block; font-size: 0.7rem; color: var(--ink-muted); }

    /* Galerie (Lightbox) – hell wie die Seite, Bedienelemente als bläuliche Glas-Pillen */
    .kf-lb-open, .kf-lb-open body { overflow: hidden; }
    .kf-lb { position: fixed; inset: 0; z-index: 1000; touch-action: pan-y; }
    .kf-lb-bg { position: absolute; inset: 0; background: rgb(239 239 239 / 0.94); -webkit-backdrop-filter: blur(18px); backdrop-filter: blur(18px); }
    .kf-lb-stage { position: absolute; inset: 4.5rem 6rem 10.5rem; pointer-events: none; }
    .kf-lb-img { position: absolute; left: 50%; top: 50%; margin: 0; translate: -50% -50%; border-radius: 0.5rem; box-shadow: 0 30px 60px -30px rgb(0 0 0 / 0.45); object-fit: cover; will-change: transform; }
    .kf-lb-cap { position: absolute; left: 50%; bottom: 2rem; translate: -50% 0; display: flex; flex-direction: column; align-items: center; gap: 0.2rem; width: min(40rem, 80vw); text-align: center; }
    .kf-lb-count { font-size: 0.7rem; font-weight: 500; letter-spacing: 0.06em; color: var(--pk-teal); }
    .kf-lb-cap b { font-size: 1.35rem; font-weight: 500; color: var(--ink); }
    .kf-lb-cap small { font-size: 0.8125rem; color: var(--ink-muted); }
    .kf-lb-pick { margin-top: 0.9rem; cursor: pointer; }
    .kf-lb-btn, .kf-lb-close {
      all: unset; position: absolute; display: grid; place-items: center; cursor: pointer; border-radius: 999px;
      background-color: rgb(0 74 128 / 0.08); -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px);
      box-shadow: inset 0 0 0 1px rgb(0 74 128 / 0.06); transition: background-color 0.4s, translate 0.6s cubic-bezier(0.22, 1, 0.36, 1);
      -webkit-tap-highlight-color: transparent;
    }
    .kf-lb-btn:hover, .kf-lb-close:hover { background-color: rgb(0 74 128 / 0.16); }
    .kf-lb-btn:focus-visible, .kf-lb-close:focus-visible { outline: 2px solid var(--pk-teal); outline-offset: 2px; }
    .kf-lb-btn { top: 50%; width: 2.6rem; height: 4rem; margin-top: -2.75rem; }
    .kf-lb-btn svg { width: 0.8rem; fill: none; stroke: var(--pk-navy); stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
    .kf-lb-btn.is-prev { left: 2rem; } .kf-lb-btn.is-prev svg { rotate: 90deg; }
    .kf-lb-btn.is-next { right: 2rem; } .kf-lb-btn.is-next svg { rotate: -90deg; }
    .kf-lb-btn.is-prev:hover { translate: -3px 0; } .kf-lb-btn.is-next:hover { translate: 3px 0; }
    .kf-lb-close { top: 1.25rem; right: 1.25rem; width: 2.6rem; height: 2.6rem; }
    .kf-lb-close svg { width: 0.75rem; fill: none; stroke: var(--pk-navy); stroke-width: 1.6; stroke-linecap: round; }
    .kf-kicker { font-size: 0.7rem; font-weight: 500; text-transform: uppercase; letter-spacing: 0.06em; color: var(--pk-teal); }
    .kf-filter { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; margin-bottom: 1.1rem; }
    .kf-fchip { all: unset; padding: 0.4rem 0.95rem; border-radius: 999px; background: #fff; border: 1px solid #deded9; font-size: 0.8125rem; cursor: pointer; transition: all 0.3s; }
    .kf-fchip:hover { border-color: #b9b8b2; }
    .kf-fchip[aria-pressed="true"], .kf-fchip[aria-checked="true"] { background: var(--ink); border-color: var(--ink); color: #fff; }
    .kf-count { margin-left: auto; font-size: 0.8125rem; color: var(--ink-muted); }

    /* Formular */
    .kf-form { display: grid; gap: 0.85rem; }
    .kf-grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 0.85rem; }
    .kf-grid3 { display: grid; grid-template-columns: 7rem 1fr; gap: 0.85rem; }
    .kf-field { display: grid; gap: 0.35rem; }
    .kf-field label { font-size: 0.8125rem; font-weight: 500; }
    .kf-field input, .kf-field textarea { font: inherit; font-size: 0.95rem; padding: 0.75rem 0.9rem; border-radius: 0.5rem; border: 1px solid #deded9; background: #fff; color: var(--ink); transition: border-color 0.3s, box-shadow 0.3s; }
    .kf-field textarea { min-height: 5.5rem; resize: vertical; }
    .kf-field input:focus, .kf-field textarea:focus { outline: none; border-color: var(--pk-navy); box-shadow: 0 0 0 3px #004a8022; }
    .kf-field.has-error input { border-color: #c0392b; }
    .kf-err { font-size: 0.75rem; color: #c0392b; }
    .kf-check { display: flex; gap: 0.7rem; align-items: flex-start; font-size: 0.8125rem; color: var(--ink-muted); cursor: pointer; }
    .kf-check input { margin-top: 0.15rem; width: 1.05rem; height: 1.05rem; accent-color: var(--pk-navy); flex: none; }
    .kf-check a { color: var(--pk-navy); text-decoration: underline; }
    .kf-switch { position: relative; display: flex; gap: 0.9rem; align-items: center; padding: 0.9rem 1rem; border-radius: 0.5rem; background: #fff; cursor: pointer; }
    .kf-switch input { position: absolute; opacity: 0; pointer-events: none; }
    .kf-switch .tr { position: relative; flex: none; width: 2.75rem; height: 1.6rem; border-radius: 1rem; background: #d5d4cf; transition: background 0.35s; }
    .kf-switch .tr::after { content: ''; position: absolute; top: 0.2rem; left: 0.2rem; width: 1.2rem; height: 1.2rem; border-radius: 50%; background: #fff; transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1); box-shadow: 0 1px 4px rgb(0 0 0 / 0.2); }
    .kf-switch input:checked + .tr { background: var(--pk-teal); }
    .kf-switch input:checked + .tr::after { transform: translateX(1.15rem); }
    .kf-switch b { display: block; font-weight: 500; font-size: 0.95rem; }
    .kf-switch small { color: var(--ink-muted); font-size: 0.8125rem; }
    .kf-consult { display: grid; gap: 0.85rem; }
    .kf-hp { position: absolute; left: -9999px; }

    /* Erfolg */
    .kf-done { display: grid; justify-items: start; gap: 1rem; }
    .kf-done-icon { display: grid; place-items: center; width: 4rem; height: 4rem; border-radius: 50%; background: var(--pk-teal); color: #fff; font-size: 1.8rem; }
    .kf-done h2 { margin: 0; font-size: 2.25rem; font-weight: 400; line-height: 1.1; }
    .kf-done p { margin: 0; color: var(--ink-muted); max-width: 46ch; }
    .kf-ref { display: inline-flex; gap: 0.6rem; align-items: baseline; padding: 0.6rem 1rem; border-radius: 0.5rem; background: #fff; font-size: var(--fs-small); }
    .kf-ref b { font-size: 1.1rem; font-weight: 500; letter-spacing: 0.04em; }
    .kf-test { padding: 0.85rem 1rem; border-radius: 0.5rem; background: #fff4e0; color: #7a4d00; font-size: 0.8125rem; }
    .kf-wave { position: absolute; left: 0; right: 0; bottom: 0; height: 60%; z-index: 3; pointer-events: none; }

    /* Nutzerwunsch: Übergang Start → Studio ruhiger – Bewegung des Bildes (Gruppe) und Überblendung gleich lang */
    ::view-transition-group(kf-stage), ::view-transition-old(kf-stage), ::view-transition-new(kf-stage) { animation-duration: 1.5s; animation-timing-function: cubic-bezier(0.65, 0, 0.35, 1); }
    ::view-transition-old(root), ::view-transition-new(root) { animation-duration: 0.9s; }

    /* Handy + Tablet: gestapelt; die Seite scrollt (kein eigener Scrollbereich), Bühne bleibt oben stehen,
       das Panel gleitet darüber, Zurück/Weiter klebt unten (Nutzerwunsch) */
    @media (max-width: 1024px) {
      .kf { --kf-top: 5.4rem; height: auto; min-height: 100svh; }
      .kf-bar { position: sticky; top: 0; background: var(--bg); transition: top 0.4s ease; z-index: 8; }
      html:has(.navbar:not(.is-hidden)) .kf-bar { top: var(--kf-top); }
      .kf-studio { display: block; }
      .kf-stage { position: sticky; top: 2.75rem; height: 40svh; z-index: 0; transition: top 0.4s ease; }
      html:has(.navbar:not(.is-hidden)) .kf-stage { top: calc(var(--kf-top) + 2.75rem); }
      .kf-panel { min-height: 60svh; }
      .kf-panel-scroll { flex: none; overflow: visible; }
      .kf-panel-foot { position: sticky; bottom: 0; z-index: 9; }
      .kf-cart-pop { position: fixed; z-index: 60; top: calc(var(--kf-top) + 3.25rem); }
      html:has(.navbar.is-hidden) .kf-cart-pop { top: 3.25rem; }
      .kf-start { grid-template-rows: 40svh auto; }
      .kf-start-text { overflow: visible; padding-bottom: 1.5rem; }
      .kf-pickcard p:not(.kf-pickcard-hint) { display: none; }
      .kf-pickcard h2 { font-size: 1.3rem; margin-bottom: 0; }
      .kf-pickcard .kf-pickcard-hint { margin-top: 0.35rem; }
      .kf-bar { height: 2.75rem; padding: 0 1rem; gap: 0.75rem; }
      .kf-progress { display: none; }
      .kf-mstep { display: block; margin-right: auto; font-size: 0.8125rem; color: var(--ink-muted); opacity: 0; transition: opacity 0.4s; }
      .kf-mstep b { color: var(--pk-navy); font-size: 1rem; font-weight: 500; }
      .kf[data-view="studio"] .kf-mstep, .kf[data-view="done"] .kf-mstep { opacity: 1; }
      .kf-cart { margin-left: auto; padding: 0.35rem 0.45rem 0.35rem 0.8rem; font-size: 0.8125rem; }
      .kf-mbar { display: block; position: absolute; left: 1rem; right: 1rem; bottom: 0; height: 3px; border-radius: 3px; background: #dcdbd6; overflow: hidden; opacity: 0; transition: opacity 0.4s; }
      .kf[data-view="studio"] .kf-mbar, .kf[data-view="done"] .kf-mbar { opacity: 1; }
      .kf-cart-pop { top: calc(var(--kf-top) + 2.75rem); right: 0.75rem; left: 0.75rem; width: auto; }

      .kf-start { grid-template-columns: 1fr; padding: 0 0.75rem 0.75rem; }
      .kf-start-media { order: 0; }
      .kf-start-text { justify-content: flex-start; gap: 0.9rem; padding: 1.1rem 0.25rem 1.5rem; }
      .kf-h1 { font-size: 2.3rem; }
      .kf-lead { font-size: 0.95rem; }
      .kf-facts { gap: 0.5rem; margin-top: 0; }
      .kf-facts li { padding: 0.7rem; } .kf-facts b { font-size: 1.25rem; } .kf-facts span { font-size: 0.72rem; }
      .kf-start-cta .kf-muted { display: none; }
      .kf-start-cta .btn-pill { width: 100%; }

      .kf-studio { gap: 0; padding: 0.5rem 0 0; }
      .kf-stage { border-radius: 0; }
      .kf-stage-info { left: 0.9rem; right: 0.9rem; bottom: 1.6rem; }
      .kf-chips { left: 0.9rem; top: 0.9rem; }
      .kf-daynight { right: 0.9rem; top: 0.9rem; }
      .kf-panel { margin-top: -1rem; border-radius: 1.1rem 1.1rem 0 0; box-shadow: 0 -12px 30px -20px rgb(0 0 0 / 0.4); z-index: 6; }
      .kf-panel::before { content: ''; position: absolute; top: 0.5rem; left: 50%; width: 2.75rem; height: 0.3rem; margin-left: -1.375rem; border-radius: 1rem; background: #d3d2cd; }
