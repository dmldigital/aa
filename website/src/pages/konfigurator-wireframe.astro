---
/*
  Wireframe Pool-Konfigurator („Pool-Studio“) – nur zur Abstimmung, nicht verlinkt, noindex.
  Jeder Screen: Desktop (1440 × 900, skaliert) + Handy (390 × 844, skaliert) + Notizen zu Animationen.
*/
import '../styles/global.css';

const steps = ['Hersteller', 'Becken', 'Farbe & LED', 'Abdeckung', 'Technik', 'Wärme & Licht', 'Kontakt'];

type Screen = {
  id: string; title: string; step: number; // 0 = Start, 1..7, 8 = Erfolg
  panelTitle?: string; notes: string[];
};
const screens: Screen[] = [
  { id: 'start', title: 'Start', step: 0, notes: [
    'Großes Poolbild füllt die Bühne, Überschrift steigt von unten ein (wie Website-Hero).',
    'Button „Pool konfigurieren“: Bild zoomt leicht heran, UI gleitet in den Studio-Aufbau über.',
    'Handy: Bild oben, Text + Button unten, Button fest am unteren Rand.',
  ] },
  { id: 'hersteller', title: 'Schritt 1 – Hersteller', step: 1, panelTitle: 'Welcher Hersteller passt zu Ihnen?', notes: [
    '3 große Markenkarten (WaterRows, Compass, Freedom) federn gestaffelt herein.',
    'Hover/Tippen: Bühne blendet in die Markenwelt über (Stimmungsbild + Material „GFK Graphene-Keramik“).',
    'Auswahl: Karte hebt sich, Haken zeichnet sich, Chip „WaterRows“ fliegt in „Ihr Pool“.',
  ] },
  { id: 'becken', title: 'Schritt 2 – Becken', step: 2, panelTitle: 'Wählen Sie Ihr Becken', notes: [
    'Filter oben: Form (Rechteckig, Geschwungen, Klassisch, Mini) + Längen-Regler + „mit Treppe“. Liste sortiert sich animiert um.',
    'Bühne: gewähltes Becken groß, Maßlinien zeichnen sich, Zahlen zählen hoch (6,4 × 3,1 × 1,5 m).',
    '„Vergleichen“: zweites Becken daneben, gleiche Maßstäbe.',
    'Handy: Karten waagerecht zum Wischen, Bühne zeigt das Becken in der Mitte der Liste.',
  ] },
  { id: 'farbe', title: 'Schritt 3 – Farbe & LED', step: 3, panelTitle: 'Welche Farbe, welches Licht?', notes: [
    'Große runde Farbmuster; Bühne blendet weich ins Farbbild des Beckens über.',
    'Schalter Tag/Nacht auf der Bühne: dunkelt ab, LED-Linie am Beckenrand leuchtet auf.',
    'LED-Streifen nur bei passenden Becken anwählbar (sonst ausgegraut mit Hinweis).',
  ] },
  { id: 'abdeckung', title: 'Schritt 4 – Abdeckung', step: 4, panelTitle: 'Wie soll Ihr Pool abgedeckt werden?', notes: [
    '6 Optionen als Karten mit Merkmal-Badges (z. B. „elektrisch“, „unsichtbar im Boden“).',
    'Bühne: gewählte Abdeckung fährt animiert über das Becken (Rollo / Stangen), „Ohne“ fährt sie weg.',
  ] },
  { id: 'technik', title: 'Schritt 5 – Technik & iWash', step: 5, panelTitle: 'Wo sitzt die Technik?', notes: [
    'Technikbox Essential / Premium / Technikwand als Karten; Bühne zeigt das Technikbild mit Hinweispunkten.',
    'iWash als Schalter darunter („Rückspülen automatisch“), kurze Erklär-Animation.',
  ] },
  { id: 'waerme', title: 'Schritt 6 – Wärme & Licht', step: 6, panelTitle: 'Wärme und Licht', notes: [
    'Wärmepumpe: Ohne / Standard / Premium. Saison-Balken (Mai–Sep) wächst auf April–Oktober.',
    'Scheinwerfer: RGB oder Weiß. Bühne im Nachtmodus, RGB läuft sanft durch die Farben.',
  ] },
  { id: 'kontakt', title: 'Schritt 7 – Ihr Pool & Kontakt', step: 7, panelTitle: 'Ihr Pool ist fertig geplant', notes: [
    'Links Zusammenfassung als Karte (Bild + alle Komponenten, jede Zeile „ändern“ springt zurück).',
    'Rechts Formular: Name, E-Mail, Telefon, PLZ, Rückruf-Zeitfenster als Pills, Nachricht, Datenschutz.',
    'Zwei Wege: „Konfiguration per E-Mail senden“ (Kunde bekommt PDF) und „Beratung anfragen“ (Poolbau Koch bekommt die Anfrage).',
  ] },
  { id: 'erfolg', title: 'Erfolg', step: 8, notes: [
    'Wasser-Welle läuft über den Bildschirm, Haken erscheint.',
    '„Ihre Konfiguration ist unterwegs“ + Vorschau des PDFs (Deckblatt mit Poolbild).',
    'Links: „Neue Konfiguration“ und „Zurück zur Website“.',
  ] },
];
const optionCount: Record<number, number> = { 1: 3, 2: 6, 3: 6, 4: 6, 5: 3, 6: 3 };
---

<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex" />
  <title>Wireframe Pool-Konfigurator | Poolbau Koch</title>
</head>
<body>
  <header class="page-head">
    <p class="eyebrow-tag"><span class="dot"></span>Wireframe · zur Abstimmung</p>
    <h1>Pool-Konfigurator „Pool-Studio“</h1>
    <p class="lead">Links Desktop, rechts Handy. Graue Flächen = Platzhalter, <span class="pool-chip">blau</span> = Pool/Bühne, <span class="nav-chip">dunkelblau</span> = Hauptaktion, <span class="ann-chip">1</span> = Animation (Notizen darunter).</p>
    <nav class="toc">{screens.map((s) => <a href={`#${s.id}`}>{s.title}</a>)}</nav>
  </header>

  {screens.map((s) => (
    <section class="screen" id={s.id}>
      <h2>{s.title}</h2>
      <div class="pair">
        {/* ---------- DESKTOP ---------- */}
        <div class="scaler" data-w="1440" data-h="900">
          <div class="frame desk">
            {s.step === 0 ? (
              <div class="d-start">
                <div class="topbar"><div class="logo">POOLBAU KOCH</div><div class="grow"></div><div class="ph">0177 450 95 00</div></div>
                <div class="d-start-stage pool"><span class="ann" style="left:6%;top:10%">1</span></div>
                <div class="d-start-text">
                  <div class="tag-line">Pool-Studio · Katalog 2026</div>
                  <div class="h-xl">Ihr Traumpool.<br />In 5 Minuten geplant.</div>
                  <div class="txt w60"></div><div class="txt w40"></div>
                  <div class="row"><div class="btn navy">Pool konfigurieren →<span class="ann" style="right:-14px;top:-14px">2</span></div><div class="muted-s">ca. 5 Minuten · unverbindlich</div></div>
                </div>
                <div class="d-facts">{['78 Becken', '3 Hersteller', 'PDF per E-Mail'].map((f) => <div class="fact"><b>{f}</b><div class="txt w80"></div></div>)}</div>
              </div>
            ) : s.step === 8 ? (
              <div class="d-done">
                <div class="topbar"><div class="logo">POOLBAU KOCH</div><div class="grow"></div></div>
                <div class="wave"><span class="ann" style="left:4%;top:20%">1</span></div>
                <div class="done-box">
                  <div class="check">✓</div>
                  <div class="h-l">Ihre Konfiguration ist unterwegs</div>
                  <div class="txt w70 c"></div><div class="txt w50 c"></div>
                  <div class="pdf"><div class="pdf-cover pool"></div><div class="txt w80"></div><div class="txt w60"></div><div class="txt w70"></div><span class="ann" style="right:-12px;top:-12px">2</span></div>
                  <div class="row c"><div class="btn ghost">Neue Konfiguration</div><div class="btn navy">Zur Website</div><span class="ann" style="position:relative">3</span></div>
                </div>
              </div>
            ) : (
              <div class="d-studio">
                <div class="topbar">
                  <div class="logo">POOLBAU KOCH</div>
                  <div class="progress">
                    {steps.map((n, i) => <div class={`pstep ${i + 1 < s.step ? 'done' : ''} ${i + 1 === s.step ? 'cur' : ''}`}><i>{i + 1}</i>{n}</div>)}
                    <div class="pline"><div class="pfill" style={`width:${(s.step / 7) * 100}%`}></div></div>
                  </div>
                  <div class="btn ghost sm">Ihr Pool ({Math.max(0, s.step - 1)})</div>
                </div>
                <div class="d-body">
                  {/* Bühne */}
                  <div class={`stage ${s.step === 3 || s.step === 6 ? 'night' : ''}`}>
                    {s.step === 1 && (<>
                      <div class="brand-mood pool"><div class="mood-logo">WaterRows</div><div class="mood-sub">GFK Graphene-Keramik · bis 36 °C</div></div>
                      <span class="ann" style="left:4%;top:5%">2</span>
                    </>)}
                    {s.step === 2 && (<>
                      <div class="pool-top"><div class="stair"></div></div>
                      <div class="dim dim-l"><span>6,4 m</span></div><div class="dim dim-w"><span>3,1 m</span></div>
                      <div class="spec-chips"><div class="chip">Bay 64</div><div class="chip">Tiefe 1,5 m</div><div class="chip">Treppe rechts</div></div>
                      <div class="btn ghost sm stage-btn">⇆ Vergleichen</div>
                      <span class="ann" style="left:4%;top:5%">2</span><span class="ann" style="right:4%;top:5%">3</span>
                    </>)}
                    {s.step === 3 && (<>
                      <div class="pool-top tinted"><div class="stair"></div><div class="led"></div></div>
                      <div class="toggle"><span class="on">Nacht</span><span>Tag</span></div>
                      <span class="ann" style="left:4%;top:5%">2</span>
                    </>)}
                    {s.step === 4 && (<>
                      <div class="pool-top"><div class="stair"></div><div class="cover"></div></div>
                      <div class="arrow-hint">→ Rollo fährt über das Becken</div>
                      <span class="ann" style="left:4%;top:5%">2</span>
                    </>)}
                    {s.step === 5 && (<>
                      <div class="tech-box"><div class="hot" style="left:30%;top:40%">+</div><div class="hot" style="left:62%;top:55%">+</div><div class="hot" style="left:45%;top:25%">+</div></div>
                      <span class="ann" style="left:4%;top:5%">1</span>
                    </>)}
                    {s.step === 6 && (<>
                      <div class="pool-top tinted rgb"><div class="stair"></div></div>
                      <div class="season"><div class="season-bar"><div class="season-fill"></div></div><div class="season-lbl"><span>Apr</span><span>Okt</span></div></div>
                      <span class="ann" style="left:4%;top:5%">1</span><span class="ann" style="right:4%;top:5%">2</span>
                    </>)}
                    {s.step === 7 && (
                      <div class="summary">
                        <div class="sum-img pool"></div>
                        <div class="h-m">Ihr Pool</div>
                        {['WaterRows · Bay 64', '6,4 × 3,1 × 1,5 m', 'Granite · LED-Streifen', 'Oberflurrollo Premium', 'Technikbox Premium Salz · iWash', 'Wärmepumpe Standard · RGB'].map((r) => <div class="sum-row"><span>{r}</span><em>ändern</em></div>)}
                        <span class="ann" style="left:-12px;top:-12px">1</span>
                      </div>
                    )}
                    {s.step < 7 && <div class="choice-bar">{['WaterRows', 'Bay 64', 'Granite', 'LED', 'Rollo', 'Box Premium'].slice(0, Math.max(0, s.step - 1)).map((c) => <div class="chip light">{c}</div>)}</div>}
                  </div>
                  {/* Panel */}
                  <div class="panel">
                    <div class="muted-s">Schritt {s.step} von 7</div>
                    <div class="h-l">{s.panelTitle}</div>
                    {s.step !== 7 && <div class="txt w80"></div>}
                    {s.step === 2 && (
                      <div class="filters">
                        <div class="row wrap">{['Alle', 'Rechteckig', 'Geschwungen', 'Klassisch', 'Mini'].map((f, i) => <div class={`chip ${i === 1 ? 'dark' : ''}`}>{f}</div>)}</div>
                        <div class="slider"><span>Länge</span><div class="track"><div class="knob" style="left:20%"></div><div class="knob" style="left:70%"></div></div><span>4–8 m</span></div>
                        <span class="ann" style="right:0;top:-6px">1</span>
                      </div>
                    )}
                    {s.step === 3 && (
                      <div>
                        <div class="swatches">{['#eef0f1', '#8d9296', '#5b6166', '#d8cfc0', '#2e3236', '#b9c3c9'].map((c, i) => <div class={`sw ${i === 1 ? 'sel' : ''}`} style={`background:${c}`}></div>)}<span class="ann" style="position:relative">1</span></div>
                        <div class="opt-row"><div class="switch on"></div><div><b>LED-Streifen am Beckenrand</b><div class="txt w70"></div></div><span class="ann" style="position:relative">3</span></div>
                      </div>
                    )}
                    {s.step === 5 && (
                      <div class="opt-row"><div class="switch on"></div><div><b>iWash – automatisch rückspülen</b><div class="txt w70"></div></div><span class="ann" style="position:relative">2</span></div>
                    )}
                    {s.step === 7 ? (
                      <div class="form">
                        <div class="grid2"><div class="field">Vorname</div><div class="field">Nachname</div><div class="field">E-Mail</div><div class="field">Telefon</div><div class="field">PLZ / Ort</div><div class="field">Budget (optional)</div></div>
                        <div class="muted-s">Rückruf am besten</div>
                        <div class="row wrap">{['08–10', '10–12', '12–14', '14–16', '16–18', '18–20'].map((t, i) => <div class={`chip ${i === 2 ? 'dark' : ''}`}>{t}</div>)}</div>
                        <div class="field tall">Nachricht</div>
                        <div class="row"><div class="box"></div><div class="txt w70"></div></div>
                        <div class="row"><div class="btn teal">PDF per E-Mail an mich</div><div class="btn navy">Beratung anfragen →</div><span class="ann" style="position:relative">3</span></div>
                        <span class="ann" style="right:0;top:-6px">2</span>
                      </div>
                    ) : s.step !== 3 ? (
                      <div class={`opts n${optionCount[s.step]} ${s.step === 1 ? 'brands' : ''}`}>
                        {Array.from({ length: optionCount[s.step] }).map((_, i) => (
                          <div class={`opt ${i === 0 ? 'sel' : ''}`}>
                            <div class={`opt-img ${s.step === 2 ? 'pool' : ''}`}>{s.step === 1 && <b>{['WaterRows', 'Compass', 'Freedom'][i]}</b>}</div>
                            <div class="opt-t"></div><div class="txt w60"></div>
                            {s.step === 2 && <div class="muted-s">6,4 × 3,1 m</div>}
                            {i === 0 && <div class="tick">✓</div>}
                          </div>
                        ))}
                        {s.step === 1 && <span class="ann" style="right:0;top:-10px">1</span>}
                        {s.step === 1 && <span class="ann" style="right:0;bottom:-10px">3</span>}
                        {(s.step === 4 || s.step === 6) && <span class="ann" style="right:0;top:-10px">1</span>}
                      </div>
                    ) : null}
                    {s.step === 6 && <div class="opt-row"><div class="seg"><span class="on">RGB</span><span>Weiß</span></div><b>Scheinwerfer</b><span class="ann" style="position:relative">2</span></div>}
                    {s.step !== 7 && <div class="panel-foot"><div class="btn ghost">← Zurück</div><div class="btn navy">Weiter →</div></div>}
                  </div>
                </div>
              </div>
            )}
          </div>
        </div>

        {/* ---------- HANDY ---------- */}
        <div class="scaler phone" data-w="390" data-h="844">
          <div class="frame mob">
            {s.step === 0 ? (
              <div class="m-start">
                <div class="m-top"><div class="logo">POOLBAU KOCH</div></div>
                <div class="m-start-img pool"></div>
                <div class="m-pad">
                  <div class="tag-line">Pool-Studio · Katalog 2026</div>
                  <div class="h-l">Ihr Traumpool. In 5 Minuten geplant.</div>
                  <div class="txt w90"></div><div class="txt w70"></div>
                </div>
                <div class="m-bottom"><div class="btn navy full">Pool konfigurieren →</div></div>
              </div>
            ) : s.step === 8 ? (
              <div class="m-done">
                <div class="m-top"><div class="logo">POOLBAU KOCH</div></div>
                <div class="wave m"></div>
                <div class="m-pad c">
                  <div class="check">✓</div>
                  <div class="h-l">Ihre Konfiguration ist unterwegs</div>
                  <div class="txt w90 c"></div>
                  <div class="pdf m"><div class="pdf-cover pool"></div><div class="txt w80"></div><div class="txt w60"></div></div>
                </div>
                <div class="m-bottom"><div class="btn ghost">Neu</div><div class="btn navy">Zur Website</div></div>
              </div>
            ) : (
              <div class="m-studio">
                <div class="m-top">
                  <div class="logo">POOLBAU KOCH</div><div class="grow"></div>
                  <div class="ring"><b>{s.step}</b>/7</div>
                  <div class="btn ghost xs">Ihr Pool</div>
                </div>
                <div class="m-pbar"><div class="pfill" style={`width:${(s.step / 7) * 100}%`}></div></div>
                {s.step === 7 ? (
                  <div class="m-scroll">
                    <div class="m-sum"><div class="sum-img pool"></div><div class="h-m">Ihr Pool</div>{['WaterRows · Bay 64', 'Granite · LED', 'Rollo Premium', 'Box Premium · iWash', 'Wärmepumpe · RGB'].map((r) => <div class="sum-row"><span>{r}</span><em>ändern</em></div>)}</div>
                    <div class="m-pad">
                      <div class="field">Name</div><div class="field">E-Mail</div><div class="field">Telefon</div>
                      <div class="row wrap">{['08–10', '10–12', '12–14', '14–16'].map((t, i) => <div class={`chip ${i === 1 ? 'dark' : ''}`}>{t}</div>)}</div>
                    </div>
                  </div>
                ) : (<>
                  <div class={`m-stage ${s.step === 3 || s.step === 6 ? 'night' : ''}`}>
                    {s.step === 1 && <div class="brand-mood pool m"><div class="mood-logo">WaterRows</div></div>}
                    {(s.step === 2 || s.step === 3 || s.step === 4 || s.step === 6) && <div class={`pool-top m ${s.step === 3 || s.step === 6 ? 'tinted' : ''} ${s.step === 6 ? 'rgb' : ''}`}><div class="stair"></div>{s.step === 3 && <div class="led"></div>}{s.step === 4 && <div class="cover"></div>}</div>}
                    {s.step === 2 && <><div class="dim dim-l m"><span>6,4 m</span></div></>}
                    {s.step === 3 && <div class="toggle m"><span class="on">Nacht</span><span>Tag</span></div>}
                    {s.step === 5 && <div class="tech-box m"></div>}
                  </div>
                  <div class="sheet">
                    <div class="handle"></div>
                    <div class="h-m">{s.panelTitle}</div>
                    {s.step === 2 && <div class="row scroll-x">{['Alle', 'Rechteckig', 'Geschwungen', 'Klassisch'].map((f, i) => <div class={`chip ${i === 1 ? 'dark' : ''}`}>{f}</div>)}</div>}
                    {s.step === 3 ? (
                      <>
                        <div class="swatches m">{['#eef0f1', '#8d9296', '#5b6166', '#d8cfc0', '#2e3236'].map((c, i) => <div class={`sw ${i === 1 ? 'sel' : ''}`} style={`background:${c}`}></div>)}</div>
                        <div class="opt-row"><div class="switch on"></div><b>LED-Streifen</b></div>
                      </>
                    ) : (
                      <div class="m-cards">
                        {Array.from({ length: Math.min(3, optionCount[s.step] ?? 3) }).map((_, i) => (
                          <div class={`opt m ${i === 0 ? 'sel' : ''}`}><div class={`opt-img ${s.step === 2 ? 'pool' : ''}`}>{s.step === 1 && <b>{['WaterRows', 'Compass', 'Freedom'][i]}</b>}</div><div class="opt-t"></div><div class="txt w60"></div>{i === 0 && <div class="tick">✓</div>}</div>
                        ))}
                      </div>
                    )}
                    {s.step === 5 && <div class="opt-row"><div class="switch on"></div><b>iWash</b></div>}
                    {s.step === 6 && <div class="opt-row"><div class="seg"><span class="on">RGB</span><span>Weiß</span></div><b>Scheinwerfer</b></div>}
                  </div>
                </>)}
                <div class="m-bottom">
                  {s.step === 7 ? <><div class="btn teal">PDF an mich</div><div class="btn navy">Anfragen →</div></> : <><div class="btn ghost">←</div><div class="btn navy grow">Weiter →</div></>}
                </div>
              </div>
            )}
          </div>
        </div>
      </div>
      <ol class="notes">{s.notes.map((n) => <li>{n}</li>)}</ol>
    </section>
  ))}

  <section class="screen tech">
    <h2>Technik dahinter (Cloudflare, kostenloser Rahmen)</h2>
    <ul class="notes plain">
      <li><b>Seite:</b> Cloudflare Pages (Astro, wie die Website).</li>
      <li><b>Katalog:</b> 78 Becken, Farben, Ausstattung als Daten in Cloudflare D1; Bilder in R2. Pflege später über eine kleine Admin-Seite.</li>
      <li><b>Absenden:</b> Pages Function (Worker) speichert die Anfrage in D1, erzeugt das PDF und verschickt die E-Mails.</li>
      <li><b>E-Mail an den Kunden:</b> Cloudflare selbst schickt nur an bestätigte eigene Adressen – für Kunden-Mails braucht es einen Mail-Dienst mit Gratis-Kontingent (z. B. Resend).</li>
    </ul>
  </section>

  <script>
    const fit = () => document.querySelectorAll<HTMLElement>('.scaler').forEach((s) => {
      const f = s.firstElementChild as HTMLElement;
      const w = Number(s.dataset.w), h = Number(s.dataset.h);
      const k = s.clientWidth / w;
      f.style.transform = `scale(${k})`;
      s.style.height = `${h * k}px`;
    });
    fit(); window.addEventListener('resize', fit);
  </script>

  <style is:global>
    body { background: var(--bg); color: var(--ink); }
    .page-head { max-width: 90rem; margin: 0 auto; padding: 3rem 2.5rem 1rem; }
    .page-head h1 { margin: 0.5rem 0 0.75rem; font-size: 3.5rem; font-weight: 400; line-height: 1.1; }
    .lead { max-width: 70ch; color: var(--ink-muted); }
    .eyebrow-tag { display: inline-flex; gap: 0.6rem; align-items: center; font-size: 0.875rem; font-weight: 500; text-transform: uppercase; }
    .dot { width: 0.35rem; height: 0.35rem; border-radius: 50%; background: var(--pk-teal); }
    .pool-chip, .nav-chip, .ann-chip { display: inline-block; padding: 0 0.5rem; border-radius: 99px; font-size: 0.85em; }
    .pool-chip { background: #bfe3ee; } .nav-chip { background: var(--pk-navy); color: #fff; }
    .ann-chip { background: var(--pk-teal); color: #fff; font-weight: 700; }
    .toc { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 1.5rem; }
    .toc a { padding: 0.35rem 0.9rem; border-radius: 99px; background: #fff; font-size: 0.875rem; }

    .screen { max-width: 90rem; margin: 0 auto; padding: 3rem 2.5rem 1rem; }
    .screen h2 { margin: 0 0 1.25rem; font-size: 1.75rem; font-weight: 500; }
    .pair { display: grid; grid-template-columns: 3.2fr 1fr; gap: 2rem; align-items: start; }
    .scaler { position: relative; width: 100%; overflow: hidden; border-radius: 12px; box-shadow: 0 20px 40px -20px rgb(0 0 0 / 0.25); }
    .scaler.phone { border-radius: 28px; }
    .frame { position: absolute; top: 0; left: 0; transform-origin: 0 0; background: #f6f6f5; font-family: inherit; color: #151515; overflow: hidden; }
    .frame.desk { width: 1440px; height: 900px; }
    .frame.mob { width: 390px; height: 844px; border-radius: 28px; }
    .notes { max-width: 80ch; margin: 1.25rem 0 0; padding-left: 1.4rem; color: var(--ink-muted); line-height: 1.6; }
