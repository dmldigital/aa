---
import { url } from '../lib/url';
/*
  Sektion „Warum Poolbau Koch?“ – Scroll-Bento nach 21st.dev bundled/1849 (Nutzerwunsch).
  Gemessen: Strecke 350vh, Bühne sticky 100vh (Innenabstand 16px, Abstand 16px), Raster 8 Spalten,
  Zeilen 1fr/.5fr/.5fr/1fr. Start: Boxen scale .5 + translate −35 % (x); beim Scrollen linear auf scale 1
  (fertig bei 90 %) und translate 0 (von 10 % bis 90 %). Mitteltext: opacity und scale 1 → 0 in der
  ersten Hälfte. Transform-Ursprung wie Vorlage (große Box oben rechts, rechte untere Box unten rechts,
  Box unten links oben rechts).
  Abweichungen (Nutzerwunsch): 6 statt 5 Boxen – die große Box ist geteilt; Boxen mit Bild und Text;
  Radius 8px (festgelegt). Handy: 2 × 3 Raster mit allen Boxen, nur Titel + kurzer Satz.
*/
import { Image } from 'astro:assets';
import img1 from '../assets/img/karte-ohne-beton.webp';
import img2 from '../assets/img/karte-nach-mass.webp';
import img3 from '../assets/img/karte-wasseraufbereitung.webp';
import img4 from '../assets/img/karte-garantie.webp';
import img5 from '../assets/img/karte-rueckbaubar.webp';
import img6 from '../assets/img/karte-beratung.webp';

const boxes = [
  { img: img1, alt: 'Pool mit Liegen und Sonnenschirmen auf einer hellen Terrasse', title: 'Poolbau ohne Beton', text: 'Die fertige Poolschale wird geliefert, eingesetzt und angeschlossen – ohne Betonarbeiten und wochenlange Baustelle. In 48 Stunden ist Ihr Pool einsatzbereit.' },
  { img: img2, alt: 'Pool in L-Form mit Sitzbank im Rasen', title: 'Poolbecken nach Maß', text: 'Rund, oval oder rechteckig, schlicht oder mit Sitzbank und Treppe: Keramik- und Fiberglaspools in vielen Formen und Größen.' },
  { img: img3, alt: 'Geöffnete Technikbox mit Filter, Pumpe und Salzelektrolyse', title: 'Wasseraufbereitung', text: 'Salzwasser mit Bayrol Salz-Hydrolyse oder klassisches Chlor – fertig verbaut in der Technikbox.' },
  { img: img4, alt: 'Keramikpool von oben mit grauer Terrasse', title: 'Bis zu 40 Jahre Garantie', text: 'Auf die Poolschale, je nach Hersteller. Hochwertige Materialien, Made in EU.' },
  { img: img5, alt: 'Pool mit Einstiegsstufen auf einer Terrasse', title: 'Rückbaubar', text: 'Bei Bedarf wird der Pool komplett zurückgebaut – ohne bleibende Schäden im Garten.' },
  { img: img6, alt: 'Langer schmaler Pool in einem grünen Garten', title: 'Beratung vor Ort', text: 'Persönlich, kostenlos und unverbindlich: Wir kommen zu Ihnen und planen Ihren Pool gemeinsam mit Ihnen.' },
];
---

<section id="leistungen" class="leistungen-section" aria-labelledby="leistungen-title" data-scroll-bento>
  <div class="track">
    <div class="stage">
      {boxes.map((b, i) => (
        <article class={`box box-${i + 1}`} data-box>
          <Image class="box-image" src={b.img} alt={b.alt} widths={[600, 1100]} sizes="(max-width: 767px) 50vw, 40vw" />
          <div class="box-shade" aria-hidden="true"></div>
          <div class="box-text">
            <h3 class="box-title">{b.title}</h3>
            <p class="box-copy">{b.text}</p>
          </div>
        </article>
      ))}
      <div class="center" data-center>
        <div class="center-tag"><span class="elipse" aria-hidden="true"></span><span class="caps">Warum Poolbau Koch?</span></div>
        <h2 id="leistungen-title" class="center-title">Über 30 Jahre Erfahrung im Poolbau</h2>
        <p class="center-copy">Unsere Lösungen machen den Traum vom eigenen Pool einfacher denn je – deutschlandweit, schnell und sauber.</p>
        <div class="center-buttons">
          <a href="#beratung" class="btn-pill is-navy">Beratung anfragen</a>
          <a href={url('konfigurator/')} class="btn-pill is-teal">Pool konfigurieren</a>
        </div>
      </div>
    </div>

  </div>
</section>

<style>
  .leistungen-section { margin-top: 10rem; }
  .track { position: relative; height: 350vh; }
  .stage {
    position: sticky; top: 0; z-index: 0; width: 100%; height: 100vh; padding: 1rem;
    display: grid; gap: 1rem;
    grid-template-columns: repeat(8, 1fr);
    grid-template-rows: 1fr 0.5fr 0.5fr 1fr;
  }
  /* Rasterplätze: große Box der Vorlage geteilt in 1 + 2 */
  .box-1 { grid-column: 1 / 4; grid-row: 1 / 4; transform-origin: top right; }
  .box-2 { grid-column: 4 / 7; grid-row: 1 / 4; transform-origin: top right; }
  .box-3 { grid-column: 7 / 9; grid-row: 1 / 3; }
  .box-4 { grid-column: 7 / 9; grid-row: 3 / 5; transform-origin: bottom right; }
  .box-5 { grid-column: 1 / 4; grid-row: 4 / 5; transform-origin: top right; }
  .box-6 { grid-column: 4 / 7; grid-row: 4 / 5; }

  .box {
    position: relative; overflow: hidden; border-radius: 0.5rem;
    box-shadow: 0 20px 25px -5px rgb(0 0 0 / 0.1), 0 8px 10px -6px rgb(0 0 0 / 0.1);
    translate: -35% 0; scale: 0.5; will-change: transform;
  }
  .box :global(.box-image) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .box-shade { position: absolute; inset: 0; background: linear-gradient(0deg, rgb(0 0 0 / 0.62) 0%, rgb(0 0 0 / 0.25) 38%, rgb(0 0 0 / 0) 62%); }
  .box-text {
    position: absolute; inset: auto 0 0 0; padding: 1.5rem;
    display: flex; flex-flow: column; gap: 0.5rem; color: #fff;
  }
  .box-title { margin: 0; font-size: 1.5rem; line-height: 1.2; font-weight: 500; }
  .box-copy { margin: 0; max-width: 42ch; font-size: 0.95rem; line-height: 1.45; opacity: 0.92; }

  .center {
    position: absolute; left: 50%; top: 50%; translate: -50% -50%; z-index: 10;
    display: flex; flex-flow: column; align-items: center; gap: 1.25rem;
    width: min(40rem, 90vw); text-align: center; pointer-events: none;
  }
  .center:global(.is-hidden) { visibility: hidden; pointer-events: none; }
  .center-tag { display: inline-flex; align-items: center; gap: 0.6rem; font-size: var(--fs-small); font-weight: 500; }
  .elipse { width: 0.35rem; height: 0.35rem; border-radius: 50%; background-color: var(--pk-teal); flex: none; }
  .caps { text-transform: uppercase; }
  .center-title { margin: 0; font-size: 4rem; line-height: 1.1; font-weight: 400; color: var(--ink); text-wrap: balance; }
  .center-copy { margin: 0; max-width: 45ch; color: var(--ink-muted); }
  .center-buttons { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.75rem; margin-top: 0.5rem; }

  @media (max-width: 991px) {
    .center-title { font-size: 2.7rem; }
    .box-title { font-size: 1.25rem; }
    .box-copy { font-size: 0.875rem; }
  }
  /* Handy: 2 × 3 Raster mit allen sechs Boxen */
  @media (max-width: 767px) {
    .leistungen-section { margin-top: 6rem; }
    .stage { height: 100svh; padding: 0.75rem; gap: 0.75rem; grid-template-columns: 1fr 1fr; grid-template-rows: 1fr 1fr 1fr; }
    .box-1, .box-2, .box-3, .box-4, .box-5, .box-6 { grid-column: auto; grid-row: auto; }
    .box-text { padding: 0.9rem; gap: 0.3rem; }
    .box-title { font-size: 1rem; }
    .box-copy { font-size: 0.75rem; line-height: 1.35; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
    .center-title { font-size: 2.2rem; }
    /* Handy: Boxen liegen am Anfang unter dem Text – helle Fläche für die Lesbarkeit */
    .center { width: calc(100vw - 3rem); padding: 1.5rem 1.25rem; border-radius: 0.5rem; background: rgb(239 239 239 / 0.92); -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .track { height: auto; }
    .stage { position: relative; }
    .box { translate: none; scale: 1; }
    .center { display: none; }
  }
</style>

<script>
  // Scroll-gekoppelt wie 21st.dev bundled/1849
  const section = document.querySelector<HTMLElement>('[data-scroll-bento]');
  if (section && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const track = section.querySelector<HTMLElement>('.track')!;
    const boxes = [...section.querySelectorAll<HTMLElement>('[data-box]')];
    const center = section.querySelector<HTMLElement>('[data-center]')!;
    const clamp = (v: number) => Math.min(1, Math.max(0, v));
    let ticking = false;
    const update = () => {
      ticking = false;
      const r = track.getBoundingClientRect();
      const vh = window.innerHeight;
      const p = clamp(-r.top / (r.height - vh));
      const s = 0.5 + 0.5 * clamp(p / 0.9);
      const t = -35 * (1 - clamp((p - 0.1) / 0.8));
      for (const b of boxes) { b.style.scale = s.toFixed(4); b.style.translate = `${t.toFixed(3)}% 0`; }
      const o = 1 - clamp(p / 0.5);
      center.style.opacity = o.toFixed(3);
      center.style.scale = Math.max(0.001, o).toFixed(3);
      center.classList.toggle('is-hidden', o < 0.05);
    };
    const onScroll = () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } };
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    update();
  }
</script>
