---
/*
  Sektion „Warum Poolbau Koch?“ – 1:1 Space Kit Produktraster (.products-wrapper, .products-header,
  .products-cards 3 Spalten, .product-link-Karten). Werte aus dem Original-CSS.
  Getauscht: Texte (Leistungen + „Warum Poolbau Koch?“ der alten Startseite), Bilder, Button = runder
  Pill-Button dunkelblau (festgelegt), Karten mit 8px Radius (festgelegt). 6 statt 3 Karten (2 Reihen).
  Animation wie Original (IX2 beim Hereinscrollen, einmalig): Kopf blendet von unten ein; über jedem Bild
  zieht sich eine hellgraue Fläche nach unten zurück, das Bild zoomt dabei von 109 % auf 100 %.
  Hover wie Original: Bild zoomt auf 109 %.
*/
import { Image } from 'astro:assets';
import img1 from '../assets/img/karte-ohne-beton.webp';
import img2 from '../assets/img/karte-nach-mass.webp';
import img3 from '../assets/img/karte-wasseraufbereitung.webp';
import img4 from '../assets/img/karte-rueckbaubar.webp';
import img5 from '../assets/img/karte-garantie.webp';
import img6 from '../assets/img/karte-beratung.webp';

const cards = [
  { img: img1, alt: 'Pool mit Liegen und Sonnenschirmen auf einer hellen Terrasse', name: 'Poolbau ohne Beton', sub: 'Fertig in 48 Stunden', key: '48 h' },
  { img: img2, alt: 'Pool in L-Form mit Sitzbank im Rasen', name: 'Poolbecken nach Maß', sub: 'Rund, oval oder eckig', key: 'Ihre Form' },
  { img: img3, alt: 'Geöffnete Technikbox mit Filter, Pumpe und Salzelektrolyse', name: 'Wasseraufbereitung', sub: 'Salzwasser oder Chlor', key: 'Bayrol' },
  { img: img4, alt: 'Pool mit Einstiegsstufen auf einer Terrasse', name: 'Rückbaubar', sub: 'Ohne bleibende Schäden', key: '100 %' },
  { img: img5, alt: 'Keramikpool von oben mit grauer Terrasse', name: 'Bis zu 40 Jahre Garantie', sub: 'Auf die Poolschale · Made in EU', key: '40 J.' },
  { img: img6, alt: 'Langer schmaler Pool in einem grünen Garten', name: 'Beratung vor Ort', sub: 'Kostenlos und unverbindlich', key: '0 €' },
];
---

<section id="leistungen" class="leistungen-section" aria-labelledby="leistungen-title" data-products>
  <div class="padding-global">
    <div class="container medium">
      <div class="products-wrapper">
        <div class="products-header">
          <div class="products-heading">
            <div class="flex-horizontal">
              <span class="elipse" aria-hidden="true"></span>
              <h2 id="leistungen-title" class="text-size-large text-weight-medium caps">Warum Poolbau Koch?</h2>
            </div>
            <div class="opacity-60"><p>Über 30 Jahre Erfahrung – deutschlandweit</p></div>
          </div>
          <div class="button-wrapper">
            <a href="#beratung" class="btn-pill is-navy">Beratung anfragen</a>
          </div>
        </div>

        <ul class="products-cards" role="list">
          {cards.map((c) => (
            <li>
              <div class="product-link">
                <div class="product-card-image">
                  <Image class="image" src={c.img} alt={c.alt} widths={[500, 900]} sizes="(max-width: 767px) 100vw, 33vw" />
                  <div class="mask-frame" aria-hidden="true"></div>
                </div>
                <div class="product-card-info">
                  <div class="info">
                    <h3 class="text-size-small text-weight-medium caps">{c.name}</h3>
                    <div class="text-size-small caps">{c.sub}</div>
                  </div>
                  <div class="text-size-small text-weight-medium key">{c.key}</div>
                </div>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .padding-global { padding-inline: 2.5rem; }
  .container { width: 100%; margin-inline: auto; }
  .container.medium { max-width: 100rem; }
  .products-wrapper { display: flex; flex-flow: column; gap: 2.8rem; margin-top: 10rem; }
  .products-header { display: flex; justify-content: space-between; }
  .products-heading { display: flex; flex-flow: column; align-items: flex-start; gap: 0.7rem; }
  .flex-horizontal { display: flex; align-items: center; gap: 0.7rem; }
  .elipse { width: 0.35rem; height: 0.35rem; border-radius: 50%; background-color: var(--pk-teal); flex: none; }
  .text-size-large { margin: 0; font-size: 1.5rem; line-height: 1.3; }
  .text-size-small { margin: 0; font-size: var(--fs-small); }
  .text-weight-medium { font-weight: 500; }
  .caps { text-transform: uppercase; }
  .opacity-60 { opacity: 0.6; }
  .opacity-60 p { margin: 0; }
  .button-wrapper { position: relative; display: flex; align-items: center; }

  .products-cards {
    display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1rem;
    margin: 0; padding: 0; list-style: none;
  }
  .product-link {
    position: relative; display: flex; flex-flow: column; justify-content: flex-start; align-items: stretch;
    width: 100%; height: 100%; padding-bottom: 1rem; background-color: #fff;
    border-radius: 0.5rem; overflow: hidden; /* festgelegt: 8px wie alle Bilder */
  }
  .product-card-image { position: relative; width: 100%; aspect-ratio: 443 / 374; overflow: hidden; }
  .product-card-image :global(.image) {
    display: block; width: 100%; height: 100%; object-fit: cover;
    transition: scale 0.45s ease;
  }
  .product-link:hover :global(.image) { scale: 1.09; }
  .mask-frame { position: absolute; inset: auto 0 0; height: 0; background-color: #e5e5e5; }
  .product-card-info { display: flex; justify-content: space-between; align-items: center; gap: 1rem; margin: 1rem 1.5rem 0 1rem; }
  .info { display: flex; flex-flow: column; align-items: flex-start; gap: 0.25rem; }
  .key { flex: none; }

  /* Einblenden wie Original – Startzustand nur mit aktivem Script */
  [data-products][data-reveal-ready] .products-header { opacity: 0; transform: translateY(100px); }
  [data-products][data-reveal-ready] .mask-frame { height: 100%; }
  [data-products][data-reveal-ready] .product-card-image :global(.image) { scale: 1.09; }
  .products-header { transition: opacity 0.8s cubic-bezier(0.22, 1, 0.36, 1), transform 0.8s cubic-bezier(0.22, 1, 0.36, 1); }
  .mask-frame { transition: height 0.75s cubic-bezier(0.65, 0, 0.35, 1); }
  [data-products][data-reveal-ready] :global(.is-in) .products-header,
  [data-products][data-reveal-ready] .products-header:global(.is-in) { opacity: 1; transform: none; }
  [data-products][data-reveal-ready] li:global(.is-in) .mask-frame { height: 0; }
  [data-products][data-reveal-ready] li:global(.is-in) .product-card-image :global(.image) { scale: 1; transition: scale 0.75s cubic-bezier(0.65, 0, 0.35, 1); }
  [data-products][data-reveal-ready] li:global(.is-in) .product-link:hover :global(.image) { scale: 1.09; transition: scale 0.45s ease; }

  @media (max-width: 991px) {
    .products-wrapper { margin-top: 8rem; }
  }
  @media (max-width: 767px) {
    .padding-global { padding-inline: 1.25rem; }
    .products-wrapper { margin-top: 6rem; }
    .products-cards { display: flex; flex-flow: column; }
  }
  @media (max-width: 479px) {
    .padding-global { padding-inline: 1rem; }
    .products-wrapper { margin-top: 4rem; }
    .products-header { flex-flow: column; justify-content: space-between; align-items: center; gap: 2rem; text-align: center; }
    .products-heading { justify-content: flex-start; align-items: center; }
  }
</style>

<script>
  // Einblenden beim Hereinscrollen (einmalig, läuft zeitbasiert fertig) – wie Webflow IX2 im Original
  const section = document.querySelector<HTMLElement>('[data-products]');
  if (section && 'IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    section.dataset.revealReady = '';
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        e.target.classList.add('is-in');
        io.unobserve(e.target);
      }
    }, { threshold: 0.2 });
    io.observe(section.querySelector('.products-header')!);
    section.querySelectorAll('.products-cards > li').forEach((li) => io.observe(li));
  }
</script>
