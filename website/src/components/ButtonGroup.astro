---
/*
  Button-Gruppe „Auffächern“ – 1:1 nach 21st.dev bundled/10 (website/ANIMATIONEN.md, Nr. 1).
  Ruhezustand: Buttons gestapelt, jeder weitere um 100px nach links hinter den vorigen geschoben
  (z-index absteigend). Hover/Fokus: federnd an die eigentliche Position; Maus weg: zurück.
  Touch-Geräte: erstes Antippen fächert auf, danach funktionieren die Links; Tippen daneben klappt zu.
  Die Optik der Buttons selbst bleibt unverändert (.btn-border/.btn-line, .btn-dark).
*/
interface Props {
  class?: string;
  label?: string;
}
const { class: className = '', label = 'Aktionen' } = Astro.props;
---

<div class:list={['fan', className]} role="group" aria-label={label} data-fan>
  <slot />
</div>

<style>
  .fan {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    width: fit-content;
  }
  .fan > :global(*) {
    position: relative;
    /* Feder mit leichtem Überschwingen, gemessen: ~0,9 s bis zur Ruhe, Staffelung ~0,1 s */
    transition: transform 0.7s cubic-bezier(0.3, 1.25, 0.5, 1);
  }
  .fan > :global(*:nth-child(1)) { z-index: 100; }
  .fan > :global(*:nth-child(2)) { z-index: 99; transform: translateX(-100px); }
  .fan > :global(*:nth-child(3)) { z-index: 98; transform: translateX(-200px); }
  .fan > :global(*:nth-child(4)) { z-index: 97; transform: translateX(-300px); }

  @media (hover: hover) {
    .fan:hover > :global(*),
    .fan:focus-within > :global(*) { transform: none; }
    .fan:hover > :global(*:nth-child(3)),
    .fan:focus-within > :global(*:nth-child(3)) { transition-delay: 0.1s; }
    .fan:hover > :global(*:nth-child(4)),
    .fan:focus-within > :global(*:nth-child(4)) { transition-delay: 0.2s; }
  }
  .fan:global(.is-open) > :global(*) { transform: none; }
  .fan:global(.is-open) > :global(*:nth-child(3)) { transition-delay: 0.1s; }

  /* Nutzerwunsch: im Ruhezustand lugen die hinteren Buttons alle paar Sekunden sachte hervor,
     damit man sieht, dass dahinter noch etwas liegt. Eigene Eigenschaft `translate`, damit es
     sich nicht mit dem Auffächern (`transform`) in die Quere kommt. */
  .fan > :global(*:nth-child(2)) { --peek: 14px 0; }
  .fan > :global(*:nth-child(3)) { --peek: 28px 0; }
  /* Erstes Mal früh (kurz nach dem Einblenden), danach alle 4,5 s wiederholen;
     der zweite hintere Button jeweils spürbar später als der erste. Bewegung: weich hinaus und zurück. */
  .fan > :global(*:nth-child(2)) { animation: fan-peek-first 1.35s ease-in-out 1.3s 1, fan-peek 4.5s ease-in-out 2.8s infinite; }
  .fan > :global(*:nth-child(3)) { animation: fan-peek-first 1.35s ease-in-out 1.65s 1, fan-peek 4.5s ease-in-out 3.15s infinite; }
  .fan:global(.is-open) > :global(*),
  .fan:focus-within > :global(*) { animation: none; }
  @media (hover: hover) { .fan:hover > :global(*) { animation: none; } }
  @keyframes fan-peek-first {
    0%, 100% { translate: 0 0; }
    50% { translate: var(--peek); }
  }
  @keyframes fan-peek {
    0%, 55%, 100% { translate: 0 0; }
    70% { translate: var(--peek); }
    85% { translate: 0 0; }
  }
  .fan:global(.is-open) > :global(*:nth-child(4)) { transition-delay: 0.2s; }

  /* Handy (Opt-in .v-mobile): senkrecht gestapelt, hintere Buttons schauen je 6px unten hervor,
     Antippen fächert nach unten auf. Gleich breite Buttons für einen sauberen Stapel. */
  @media (max-width: 767px) {
    .fan:global(.v-mobile) { flex-direction: column; align-items: center; }
    .fan:global(.v-mobile) > :global(*) { width: 16rem; justify-content: center; }
    .fan:global(.v-mobile) > :global(*:nth-child(2)) { transform: translateY(calc(-100% - 0.5rem + 6px)); }
    .fan:global(.v-mobile) > :global(*:nth-child(3)) { transform: translateY(calc(-200% - 1rem + 12px)); }
    .fan:global(.v-mobile) > :global(*:nth-child(4)) { transform: translateY(calc(-300% - 1.5rem + 18px)); }
    .fan:global(.v-mobile.is-open) > :global(*) { transform: none; }
    .fan:global(.v-mobile) > :global(*:nth-child(2)) { --peek: 0 8px; }
    .fan:global(.v-mobile) > :global(*:nth-child(3)) { --peek: 0 16px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .fan > :global(*) { transition: none; transform: none !important; animation: none !important; }
  }
</style>

<script>
  const touch = window.matchMedia('(hover: none)');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

  document.querySelectorAll<HTMLElement>('[data-fan]').forEach((fan) => {
    // Touch: erstes Antippen fächert auf, statt dem Link zu folgen
    fan.addEventListener('click', (event) => {
      if (!touch.matches || reduce.matches || fan.classList.contains('is-open')) return;
      event.preventDefault();
      fan.classList.add('is-open');
    });
  });

  document.addEventListener('click', (event) => {
    document.querySelectorAll<HTMLElement>('[data-fan].is-open').forEach((fan) => {
      if (!fan.contains(event.target as Node)) fan.classList.remove('is-open');
    });
  });
</script>
