---
/*
  Partner-Sektion (Nutzerwunsch, im Space Kit nicht vorhanden): Kopf im Stil der Bento-Sektion
  (.heading-component, .heading-4), darunter die Partner-Logos in einer Reihe.
  Logos grau; beim Scrollen läuft eine farbige Welle nahtlos durch die ganze Reihe
  (zweite, farbige Logo-Reihe darüber, per weicher Verlaufsmaske freigelegt – Position scroll-gekoppelt).
  Logos von poolbau-kochgmbh.de (medien/partner/), weiße Hintergründe entfernt, Böckenholt dunkel eingefärbt.
*/
import { url } from '../lib/url';

const logos = [
  { src: 'partner/compass.png', alt: 'COMPASS Pools', h: 44 },
  { src: 'partner/waterrows.svg', alt: 'Waterrows', h: 58 },
  { src: 'partner/mon-de-pra.png', alt: 'Mon de Pra', h: 40 },
  { src: 'partner/leisure-pools.svg', alt: 'Leisure Pools', h: 40 },
  { src: 'partner/boeckenholt.svg', alt: 'Böckenholt Wasseraufbereitung', h: 50 },
];
---

<section id="partner" class="partner-section" aria-labelledby="partner-title">
  <div class="padding-global">
    <div class="container">
      <div class="partner-wrapper">
        <div class="heading-component">
          <h2 id="partner-title" class="heading-4">Unsere Partner</h2>
          <div class="max-width-45ch">
            <p>Wir arbeiten mit führenden Herstellern zusammen, um Ihnen höchste Qualität zu garantieren.</p>
          </div>
        </div>

        <div class="logo-stage" data-wave>
          <ul class="logo-row is-grey" role="list">
            {logos.map((l) => (
              <li><img src={url(l.src)} alt={`${l.alt} Logo`} style={`--h:${l.h}px`} loading="lazy" /></li>
            ))}
          </ul>
          <ul class="logo-row is-color" aria-hidden="true">
            {logos.map((l) => (
              <li><img src={url(l.src)} alt="" style={`--h:${l.h}px`} loading="lazy" /></li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .padding-global { padding-inline: 2.5rem; }
  .container { width: 100%; max-width: 110rem; margin-inline: auto; }
  .partner-wrapper { display: flex; flex-flow: column; align-items: center; gap: 4rem; margin-top: 12rem; }
  .heading-component { display: flex; flex-flow: column; align-items: center; gap: 1rem; text-align: center; }
  .heading-4 { margin: 0; font-size: 4rem; line-height: 1.3; font-weight: 400; }
  .max-width-45ch { max-width: 45ch; }
  .max-width-45ch p { margin: 0; }

  .logo-stage { position: relative; width: 100%; max-width: 72rem; }
  .logo-row {
    display: flex; justify-content: space-between; align-items: center; gap: 2.5rem;
    margin: 0; padding: 0; list-style: none;
  }
  .logo-row li { display: flex; align-items: center; justify-content: center; }
  .logo-row img { display: block; height: var(--h); width: auto; max-width: 14rem; }

  /* Grau: Grundzustand */
  .is-grey img { filter: grayscale(1); opacity: 0.45; }
  /* Farbig: liegt deckungsgleich darüber, nur im Bereich der Welle sichtbar */
  .is-color {
    position: absolute; inset: 0;
    --x: -30%;
    -webkit-mask-image: linear-gradient(100deg, transparent calc(var(--x) - 22%), #000 calc(var(--x) - 7%), #000 calc(var(--x) + 7%), transparent calc(var(--x) + 22%));
            mask-image: linear-gradient(100deg, transparent calc(var(--x) - 22%), #000 calc(var(--x) - 7%), #000 calc(var(--x) + 7%), transparent calc(var(--x) + 22%));
  }

  @media (max-width: 991px) {
    .heading-4 { font-size: 2.7rem; }
    .container { max-width: 90vw; }
    .partner-wrapper { margin-top: 8rem; gap: 3rem; }
    .logo-row { flex-wrap: wrap; justify-content: center; gap: 2rem 2.5rem; }
    .logo-row img { height: calc(var(--h) * 0.8); }
  }
  @media (max-width: 767px) {
    .padding-global { padding-inline: 1.25rem; }
    .heading-4 { font-size: 2.5rem; }
    .partner-wrapper { margin-top: 6rem; }
    .logo-row { gap: 1.75rem 2rem; }
    .logo-row img { height: calc(var(--h) * 0.7); }
  }
  @media (max-width: 479px) {
    .padding-global { padding-inline: 1rem; }
    .heading-4 { font-size: 2.2rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .is-color { display: none; }
    .is-grey img { filter: none; opacity: 1; }
  }
</style>

<script>
  // Farbige Welle: läuft von links nach rechts durch, während die Logo-Reihe von 90 % bis 30 % Fensterhöhe wandert
  const stage = document.querySelector<HTMLElement>('[data-wave]');
  const color = stage?.querySelector<HTMLElement>('.is-color');
  if (stage && color && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let ticking = false;
    const update = () => {
      ticking = false;
      const vh = window.innerHeight;
      const r = stage.getBoundingClientRect();
      const mid = r.top + r.height / 2;
      const p = Math.min(1, Math.max(0, (vh * 0.9 - mid) / (vh * 0.6)));
      color.style.setProperty('--x', `${(-30 + 160 * p).toFixed(2)}%`);
    };
    const onScroll = () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } };
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    update();
  }
</script>
