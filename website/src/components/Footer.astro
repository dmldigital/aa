---
/*
  Footer – 1:1 Space Kit (.footer-component: Logo, .footer-grid 4 Spalten, .footer-social runde Icons,
  untere Linkzeile mit Trennstrichen, Credits-Zeile). Werte aus dem Original-CSS; Verhalten gemessen:
  Teile gleiten beim Hereinscrollen von unten ein; Links grau → dunkel + 2px hoch; Icons: Hover-Fläche in
  Akzentfarbe (Original Orange → Dunkelblau, festgelegt).
  Getauscht: Logo, Texte/Links, Icons (Telefon, E-Mail, Route, Konfigurator statt Social Media).
*/
import { url } from '../lib/url';

const cols = [
  { title: 'Entdecken', links: [['Pools', url('#pools')], ['Partner', url('#partner')]] },
  { title: 'Service', links: [['Leistungen', url('#leistungen')], ['Häufige Fragen', url('#faq')]] },
  { title: 'Kontakt', links: [['0177 - 450 95 00', 'tel:+491774509500'], ['E-Mail schreiben', 'mailto:info@poolbau-kochgmbh.de']] },
  { title: 'Online', links: [['Pool-Konfigurator', url('konfigurator/')], ['Shop', 'https://shop.poolbau-kochgmbh.de/']] },
];
const icon = (d: string) => `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${d}</svg>`;
const socials = [
  { label: 'Anrufen', href: 'tel:+491774509500', svg: icon('<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/>') },
  { label: 'E-Mail schreiben', href: 'mailto:info@poolbau-kochgmbh.de', svg: icon('<rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/>') },
  { label: 'Route planen', href: 'https://www.google.com/maps/search/?api=1&query=Mozartstra%C3%9Fe+33+59227+Ahlen', svg: icon('<path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/>') },
  { label: 'Pool-Konfigurator', href: url('konfigurator/'), svg: icon('<path d="M4 21v-7M4 10V3M12 21v-9M12 8V3M20 21v-5M20 12V3M1 14h6M9 8h6M17 16h6"/>') },
];
---

<footer class="footer" data-footer>
  <div class="padding-global">
    <div class="container">
      <div class="footer-component">
        <div class="footer-heading" data-fade-up>
          <img src={url('brand/logo-temp.png')} alt="Poolbau Koch" width="256" height="53" class="logo-footer" loading="lazy" />
        </div>
        <div class="footer-grid" data-fade-up>
          {cols.map((c) => (
            <div class="footer-grid-wrap">
              <div class="footer-text-size text-weight-medium">{c.title}</div>
              <div class="footer-links-wrapper">
                {c.links.map(([t, h]) => (
                  <a href={h} class="footer-link" {...(h.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {})}>{t}</a>
                ))}
              </div>
            </div>
          ))}
        </div>
        <div class="footer-social-wrapper" data-fade-up>
          {socials.map((s) => (
            <a href={s.href} class="footer-social" aria-label={s.label} {...(s.href.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {})} set:html={s.svg} />
          ))}
        </div>
        <div class="footer-links-wrapper" data-fade-up>
          <div class="footer-links">
            <a href="https://poolbau-kochgmbh.de/impressum" class="footer-link">Impressum</a>
            <div class="vertical-line"></div>
            <a href="https://poolbau-kochgmbh.de/datenschutz" class="footer-link">Datenschutz</a>
            <div class="vertical-line"></div>
            <a href="#inhalt" class="footer-link">Nach oben</a>
          </div>
          <div class="credits-wrapper">
            <p>Copyright © 2026</p>
            <p class="paragraph"><span class="text-color-black">Garten- und Landschaftsbau Koch GmbH</span></p>
            <p class="paragraph">Mozartstraße 33, 59227 Ahlen · Mo–Fr 08:00–18:00</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</footer>

<style>
  .padding-global { padding-inline: 2.5rem; }
  .container { width: 100%; max-width: 110rem; margin-inline: auto; }
  .footer-component { display: flex; flex-flow: column; justify-content: center; align-items: center; padding-top: 10rem; padding-bottom: 3rem; }
  .footer-heading { position: relative; display: flex; justify-content: flex-start; align-items: flex-start; height: 3rem; margin-bottom: 5rem; }
  .logo-footer { width: 11rem; height: auto; }
  .footer-grid { display: grid; grid-template-columns: repeat(4, auto); column-gap: 5rem; align-items: start; }
  .footer-grid-wrap { display: flex; flex-flow: column; justify-content: flex-start; align-items: center; gap: 0.75rem; }
  .footer-text-size { font-size: 1.5rem; }
  .text-weight-medium { font-weight: 500; }
  .footer-links-wrapper { display: flex; flex-flow: column; justify-content: flex-start; align-items: center; gap: 1rem; }
  .footer-link { color: #8e8c87; font-size: 1rem; font-weight: 400; text-decoration: none; transition: all 0.25s; }
  .footer-link:hover { color: #151515; transform: translate(0, -2px); }
  .footer-social-wrapper { display: flex; justify-content: center; align-items: center; gap: 1.5rem; margin-top: 4.8rem; margin-bottom: 11rem; }
  .footer-social {
    display: flex; justify-content: center; align-items: center; width: 2.6rem; height: 2.6rem; padding: 0.7rem;
    border-radius: 50%; color: #151515; transition: all 0.3s;
  }
  .footer-social:hover { background-color: var(--pk-navy); color: #c9d4d8; transform: translate(0, -2px); }
  .footer-links { display: flex; align-items: center; gap: 1.1rem; }
  .vertical-line { width: 1px; height: 0.8rem; background-color: #8e8c87; }
  .credits-wrapper { display: flex; justify-content: flex-start; align-items: center; gap: 1rem; }
  .credits-wrapper p { margin: 0; }
  .paragraph { color: #00000080; }
  .text-color-black { color: #151515; }

  /* Einblenden beim Hereinscrollen */
  [data-footer][data-reveal-ready] [data-fade-up] { opacity: 0; translate: 0 100px; }
  [data-footer] [data-fade-up] { transition: opacity 0.9s cubic-bezier(0.22, 1, 0.36, 1), translate 0.9s cubic-bezier(0.22, 1, 0.36, 1); }
  [data-footer][data-reveal-ready] [data-fade-up]:global(.is-in) { opacity: 1; translate: 0 0; }

  @media (max-width: 991px) {
    .footer-heading { margin-bottom: 4rem; }
    .footer-component { padding-top: 6rem; padding-bottom: 4rem; }
    .footer-social-wrapper { margin-bottom: 4rem; }
    .footer-text-size { font-size: 1.4rem; }
  }
  @media (max-width: 767px) {
    .padding-global { padding-inline: 1.25rem; }
    .credits-wrapper { flex-flow: column; margin-top: 1rem; text-align: center; }
    .footer-grid { gap: 4rem; grid-template-columns: 1fr 1fr; }
    .footer-heading { height: 2rem; }
    .footer-component { padding-top: 4rem; }
    .footer-text-size { font-size: 1.3rem; }
  }
  @media (max-width: 479px) {
    .padding-global { padding-inline: 1rem; }
    .credits-wrapper { flex-flow: wrap; justify-content: center; align-items: center; gap: 1rem; }
    .footer-grid { column-gap: 3rem; row-gap: 2rem; grid-auto-columns: 1fr; place-items: flex-start center; }
    .footer-heading { height: auto; }
    .footer-links { flex-flow: wrap; justify-content: center; align-items: center; }
    .footer-links-wrapper { text-align: center; }
    .footer-social-wrapper { margin-bottom: 2rem; }
    .footer-text-size { font-size: 1.2rem; }
  }
</style>

<script>
  const footer = document.querySelector<HTMLElement>('[data-footer]');
  if (footer && 'IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    footer.dataset.revealReady = '';
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } }
    }, { rootMargin: '0px 0px -5% 0px' });
    footer.querySelectorAll('[data-fade-up]').forEach((el) => io.observe(el));
  }
</script>
