---
/*
  Sektion 2 – 1:1 Space Kit (#bento: .bento-header mit Laufband, .heading-component,
  zwei .bento-row mit .card-small 35 % / .card-big 65 %). Werte aus dem Original-CSS.
  Getauscht: Texte, Bilder, Akzentfarbe (Punkt im Laufband = Türkis).
  Animation (Nutzerwunsch): „Scroll & Roll“-Kapsel aus 21st.dev bundled/1959 auf jeder Karte,
  zeitversetzt; Ecken durchgehend mit Original-Radius 0.5rem (keine Kapselform).
  Abweichungen (Nutzerwunsch): kleine Karten sind Textfelder statt Bilder; die Texte blenden
  gleichzeitig mit dem Bild ihrer Reihe ein. Button als runder Button (wie im Hero festgelegt).
*/
import { Image } from 'astro:assets';
import imgGross1 from '../assets/img/bento-pool-von-oben.webp';
import imgGross2 from '../assets/img/pool-holzdeck-garten.webp';

const tagText = 'Poolbau ohne Beton – fertig in 48 Stunden';
const arrow = `<svg width="11" height="10" viewBox="0 0 11 10" fill="none" aria-hidden="true"><path d="M6.25 1.25 10 5m0 0L6.25 8.75M10 5H0" stroke="currentColor" stroke-width=".78"/></svg>`;
---

<section id="ohne-beton" class="bento-section" aria-labelledby="bento-title">
  <div class="padding-global">
    <div class="container">
      <div class="bento-wrapper">
        <div class="bento-header">
          <div class="tag-marquee" aria-hidden="true">
            {[0, 1, 2].map(() => (
              <div class="tag"><span class="elipse"></span><span class="text-size-small caps">{tagText}</span></div>
            ))}
          </div>
          <div class="heading-component">
            <div class="max-width-80ch">
              <h2 id="bento-title" class="heading-4">Vom Rasen zum Traumpool – in nur zwei Tagen</h2>
            </div>
            <div class="max-width-45ch">
              <p>Klassischer Poolbau heißt Bagger, Beton und wochenlang Baustelle. Unser System kommt ohne Beton aus: Die fertige Poolschale wird geliefert, eingesetzt und angeschlossen.</p>
            </div>
          </div>
        </div>

        <div class="bento-component">
          <div class="bento-row">
            <div class="card-small card-text" data-fade>
              <div class="text-content">
                <span class="text-tag"><span class="elipse"></span><span class="text-size-small caps">Unsere Pools</span></span>
                <h3 class="heading-6">Keramik- und Fiberglaspools der führenden Marken</h3>
                <p>COMPASS, Waterrows, Leisure Pools und Mon de Pra – langlebig, pflegeleicht und mit bis zu 40&nbsp;Jahren Garantie auf die Poolschale.</p>
                <a href="#pools" class="secondary-button">
                  <span class="text-size-small text-weight-medium">Pools entdecken</span>
                  <span class="arrow-wrapper" set:html={arrow} />
                </a>
              </div>
            </div>
            <div class="card-big" data-roll>
              <div class="card-image"><Image class="image" src={imgGross1} alt="Pool von oben auf grauer Terrasse" widths={[900, 1600]} sizes="(max-width: 991px) 90vw, 65vw" /></div>
            </div>
          </div>

          <div class="bento-row">
            <div class="card-big" data-roll>
              <div class="card-image"><Image class="image" src={imgGross2} alt="Pool mit Holzdeck in einem grünen Garten" widths={[900, 1600]} sizes="(max-width: 991px) 90vw, 65vw" /></div>
            </div>
            <div class="card-small card-text" data-fade>
              <div class="text-content">
                <span class="text-tag"><span class="elipse"></span><span class="text-size-small caps">Alles aus einer Hand</span></span>
                <h3 class="heading-6">Technik, Lieferung und Einbau – in nur 48&nbsp;Stunden</h3>
                <p>Von der kostenlosen Beratung vor Ort über die Technikbox mit Salzwasser- oder Chlorpflege bis zum fertigen Einbau: Sie haben einen Ansprechpartner.</p>
                <a href="#beratung" class="btn-pill is-navy">Beratung anfragen</a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .padding-global { padding-inline: 2.5rem; }
  .container { width: 100%; max-width: 110rem; margin-inline: auto; }

  .bento-wrapper { display: flex; flex-flow: column; align-items: center; gap: 6rem; margin-top: 7.5rem; }
  .bento-header { display: flex; flex-flow: column; align-items: center; gap: 0.5rem; }

  /* Laufband: 33 px/s nach links, endlos (Original IX2) */
  .tag-marquee { display: flex; align-items: center; gap: 0.6rem; max-width: 15rem; overflow: hidden; white-space: nowrap; }
  .tag { display: flex; align-items: center; gap: 0.6rem; flex: none; animation: marquee var(--marquee-dur, 10s) linear infinite; }
  @keyframes marquee { to { transform: translateX(calc(-100% - 0.6rem)); } }
  .elipse { width: 0.35rem; height: 0.35rem; border-radius: 50%; background-color: var(--pk-teal); flex: none; }
  .text-size-small { font-size: var(--fs-small); }
  .text-weight-medium { font-weight: 500; }
  .caps { text-transform: uppercase; }

  .heading-component { display: flex; flex-flow: column; align-items: center; gap: 1rem; text-align: center; }
  .max-width-80ch { max-width: 80ch; }
  .max-width-60ch { max-width: 60ch; }
  .max-width-45ch { max-width: 45ch; }
  .max-width-40ch { max-width: 40ch; }
  .heading-4 { margin: 0; font-size: 4rem; line-height: 1.3; font-weight: 400; }
  .heading-6 { margin: 0; font-size: 2.5rem; line-height: 1.15; font-weight: 400; }

  .bento-component { display: flex; flex-flow: column; gap: 1rem; width: 100%; }
  .bento-row { display: flex; gap: 1rem; width: 100%; }
  .card-small, .card-big {
    position: relative; display: flex; height: 50vh; overflow: hidden;
    border: 0.1px solid #9b8f7e66; border-radius: 0.5rem;
  }
  .card-small { width: 35%; justify-content: center; align-items: center; }
  .card-big { width: 65%; align-items: flex-start; padding: 2.5rem; color: var(--ink); }
  .card-image { position: absolute; inset: 0; }
  .card-small > :global(.image), .card-image :global(.image) {
    width: 100%; height: 100%; object-fit: cover;
    transition: transform 0.6s ease;
  }
  .card-big:hover :global(.image) { transform: scale(1.09); }

  /* Textfelder an Stelle der kleinen Bilder (Nutzerwunsch): ohne Rahmen, Text vertikal zentriert */
  .card-text { border: 0; align-items: center; justify-content: flex-start; padding: 2.5rem; }
  .text-content { display: flex; flex-flow: column; align-items: flex-start; gap: 1.25rem; max-width: 40ch; will-change: opacity, transform; }
  .text-content p { margin: 0; color: var(--ink-muted); }
  .text-tag { display: inline-flex; align-items: center; gap: 0.6rem; }
  .card-big-content { position: relative; z-index: 2; display: flex; flex-flow: column; align-items: flex-start; gap: 1.5rem; }
  .secondary-button { display: flex; align-items: center; gap: 1rem; }
  .arrow-wrapper { display: flex; transition: transform 0.25s ease; }
  .secondary-button:hover .arrow-wrapper { transform: translateX(3.2px); }


  /* Bild-Animation (Werte aus 21st.dev bundled/1959): Fläche wächst aus der Mitte, Ecken bleiben 8px.
     Startzustand nur, wenn das Script aktiv ist; Auslösen per Klasse .is-in, dann läuft es zeitbasiert fertig. */
  .bento-section[data-roll-ready] [data-roll] { clip-path: inset(35.6% round 8px); }
  .bento-section[data-roll-ready] [data-roll] .card-image { scale: 0.7625; }
  .bento-section[data-roll-ready] [data-fade] .text-content { opacity: 0; transform: translateY(24px); }
  [data-roll] { transition: clip-path 1.4s cubic-bezier(0.22, 1, 0.36, 1); }
  [data-roll] .card-image { transition: scale 1.4s cubic-bezier(0.22, 1, 0.36, 1); }
  [data-fade] .text-content { transition: opacity 1.4s cubic-bezier(0.22, 1, 0.36, 1), transform 1.4s cubic-bezier(0.22, 1, 0.36, 1); }
  .bento-section[data-roll-ready] .is-in [data-roll] { clip-path: inset(0% round 8px); }
  .bento-section[data-roll-ready] .is-in [data-roll] .card-image { scale: 1; }
  .bento-section[data-roll-ready] .is-in [data-fade] .text-content { opacity: 1; transform: none; }

  @media (max-width: 991px) {
    .heading-6 { font-size: 2rem; }
    .heading-4 { font-size: 2.7rem; }
    .bento-header { gap: 1rem; }
    .bento-row { flex-flow: column; }
    .card-small { order: 1; width: 100%; }
    .card-big { width: 100%; }
    .container { max-width: 90vw; }
  }
  @media (max-width: 767px) {
    .padding-global { padding-inline: 1.25rem; }
    .heading-6 { font-size: 2rem; line-height: 1.3; }
    .heading-4 { font-size: 2.5rem; }
    .bento-wrapper { gap: 4rem; margin-top: 6rem; }
    .card-big { padding-top: 1.5rem; padding-left: 1.5rem; }
    .card-text { height: auto; padding: 1.5rem 0.25rem 1rem; }
  }
  @media (max-width: 479px) {
    .padding-global { padding-inline: 1rem; }
    .heading-6 { font-size: 1.5rem; line-height: 1.5; }
    .heading-4 { font-size: 2.2rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .tag { animation: none; }
  }
</style>

<script>
  // Laufband-Tempo exakt wie Original: 33 px pro Sekunde
  document.querySelectorAll<HTMLElement>('.tag-marquee .tag').forEach((tag) => {
    const dist = tag.getBoundingClientRect().width + 9.6;
    tag.style.setProperty('--marquee-dur', `${(dist / 33).toFixed(2)}s`);
  });

  // Bild-Animation (Werte aus 21st.dev bundled/1959, Ecken durchgehend 8px) und Text-Einblenden:
  // startet, sobald eine Reihe ins Bild kommt, und läuft dann zeitbasiert fertig – unabhängig vom Scrollen.
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const section = document.querySelector<HTMLElement>('.bento-section');
  if (section && !reduce && 'IntersectionObserver' in window) {
    section.dataset.rollReady = '';
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add('is-in');
          io.unobserve(entry.target);
        }
      },
      { threshold: 0.15 },
    );
    section.querySelectorAll('.bento-row').forEach((row) => io.observe(row));
  }
</script>
