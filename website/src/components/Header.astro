---
import ButtonGroup from './ButtonGroup.astro';

const nav = [
  { href: '/pools/', label: 'Pools' },
  { href: '/komplettpakete/', label: 'Komplettpakete' },
  { href: '/poolbau-ohne-beton/', label: 'Ohne Beton' },
  { href: '/projekte/', label: 'Projekte' },
  { href: '/ueber-uns/', label: 'Über uns' },
];
---

<header class="site-header">
  <div class="nav-pill">
    <a href="/" class="brand" aria-label="Poolbau Koch – zur Startseite">
      <img src="/brand/logo-temp.png" alt="Poolbau Koch" width="256" height="53" />
    </a>

    <nav class="nav-links" aria-label="Hauptnavigation">
      <ul>
        {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </nav>

    <ButtonGroup class="nav-cta" delay={500}>
      <a href="tel:+491774509500" class="btn btn-ghost nav-phone" aria-label="Anrufen: 0177 450 95 00">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"/></svg>
        <span>0177 450 95 00</span>
      </a>
      <a href="#beratung" class="btn btn-light btn-nav">Beratung anfragen</a>
    </ButtonGroup>

    <button class="menu-toggle" aria-expanded="false" aria-controls="mobile-menu" aria-label="Menü öffnen">
      <span></span><span></span>
    </button>
  </div>

  <div id="mobile-menu" class="mobile-menu" hidden>
    <ul>
      {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
    </ul>
    <div class="mobile-cta">
      <a href="#beratung" class="btn btn-primary">Kostenlose Beratung</a>
      <a href="tel:+491774509500" class="btn btn-light">0177 450 95 00</a>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: fixed; inset: 1.25rem var(--gutter) auto; z-index: 100;
    max-width: calc(var(--container) - 2 * var(--gutter)); margin-inline: auto;
  }
  .nav-pill {
    display: flex; align-items: center; justify-content: space-between; gap: 1.5rem;
    padding: 0.75rem 0.75rem 0.75rem 1.75rem;
    border-radius: var(--radius-nav);
    background: rgba(255, 255, 255, 0.55);
    backdrop-filter: blur(20px) saturate(140%); -webkit-backdrop-filter: blur(20px) saturate(140%);
    transition: background var(--t-fast), box-shadow var(--t-fast);
  }
  .site-header.is-scrolled .nav-pill {
    background: rgba(255, 255, 255, 0.78);
    box-shadow: 0 8px 32px rgba(0, 54, 94, 0.08);
  }
  .brand img { height: 2.625rem; width: auto; }

  .nav-links ul { display: flex; gap: 2rem; list-style: none; margin: 0; padding: 0; }
  .nav-links a { display: inline-block; transition: opacity var(--t-fast), transform var(--t-fast); }
  .nav-links a:hover { opacity: 0.6; transform: translateY(1px); }

  .nav-pill :global(.nav-cta) { flex-wrap: nowrap; gap: 1.25rem; }
  .nav-phone { gap: 0.5rem; font-weight: 500; }
  .btn-nav { padding: 0.625rem 1.5rem; }

  .menu-toggle {
    display: none; width: 3rem; height: 3rem; border: 0; border-radius: 14px;
    background: rgba(255, 255, 255, 0.7); cursor: pointer; position: relative;
  }
  .menu-toggle span {
    position: absolute; left: 50%; width: 1.25rem; height: 1.5px; background: var(--ink);
    transform: translateX(-50%); transition: transform var(--t-fast), top var(--t-fast);
  }
  .menu-toggle span:first-child { top: 42%; }
  .menu-toggle span:last-child { top: 58%; }
  .menu-toggle[aria-expanded='true'] span:first-child { top: 50%; transform: translateX(-50%) rotate(45deg); }
  .menu-toggle[aria-expanded='true'] span:last-child { top: 50%; transform: translateX(-50%) rotate(-45deg); }

  .mobile-menu {
    margin-top: 0.75rem; padding: 2rem; border-radius: var(--radius-nav);
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
    text-align: center;
    animation: menu-in 0.35s var(--ease);
  }
  .mobile-menu ul { list-style: none; margin: 0 0 1.5rem; padding: 0; display: grid; gap: 1rem; font-size: 1.25rem; }
  .mobile-cta { display: grid; gap: 0.75rem; }
  @keyframes menu-in { from { opacity: 0; transform: translateY(-8px); } }

  @media (max-width: 1100px) {
    .nav-links, .nav-pill :global(.nav-cta) { display: none; }
    .menu-toggle { display: block; }
    .nav-pill { padding-left: 1.25rem; }
  }
  @media (max-width: 479px) {
    .site-header { inset-block-start: 0.75rem; }
    .brand img { height: 2.25rem; }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('.site-header');
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const menu = document.getElementById('mobile-menu');

  const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 40);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    toggle.setAttribute('aria-label', open ? 'Menü öffnen' : 'Menü schließen');
    if (menu) menu.hidden = open;
  });
  menu?.querySelectorAll('a').forEach((a) =>
    a.addEventListener('click', () => {
      toggle?.setAttribute('aria-expanded', 'false');
      menu.hidden = true;
    }),
  );
</script>
