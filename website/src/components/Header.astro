---
/*
  Navigation – 1:1 Space Kit (.navbar / .navbar-component / Webflow-Nav mit Mobile-Menü).
  Werte aus dem Original (Computed Style + CSS), nur Logo, Texte und Akzentfarbe getauscht.
*/
import { url } from '../lib/url';

const nav = [
  { href: url('pools/'), label: 'Pools' },
  { href: url('komplettpakete/'), label: 'Komplettpakete' },
  { href: url('poolbau-ohne-beton/'), label: 'Ohne Beton' },
  { href: url('projekte/'), label: 'Projekte' },
  { href: url('ueber-uns/'), label: 'Über uns' },
];
const cta = { href: '#beratung', label: 'Beratung anfragen' };
---

<header class="navbar" data-navbar>
  <div class="nav-pad">
    <div class="nav-container">
      <div class="navbar-component">
        <a href={url()} class="brand" aria-label="Poolbau Koch, zur Startseite">
          <img src={url('brand/logo-temp.png')} alt="Poolbau Koch" width="256" height="53" class="logo-navbar" />
        </a>

        <div class="right-navbar-content">
          <nav class="nav-menu" aria-label="Hauptnavigation">
            {nav.map((item) => <a href={item.href} class="nav-link">{item.label}</a>)}
            <a href={cta.href} class="btn-pill is-navy nav-cta">{cta.label}</a>
          </nav>

          <button class="menu-button" type="button" aria-expanded="false" aria-controls="mobile-menu" aria-label="Menü öffnen" data-menu-button>
            <svg class="menu-icon" width="24" height="24" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6.5h16v2H4zM4 11h16v2H4zM4 15.5h16v2H4z" fill="currentColor"/></svg>
          </button>
        </div>
      </div>
    </div>
  </div>

  <div class="nav-overlay" data-menu-overlay>
    <nav id="mobile-menu" class="mobile-menu" aria-label="Hauptnavigation (mobil)" data-menu>
      {nav.map((item) => <a href={item.href} class="nav-link">{item.label}</a>)}
      <div class="mobile-cta">
        <a href={cta.href} class="btn-pill is-navy">{cta.label}</a>
        <a href={url('konfigurator/')} class="btn-pill is-teal">Pool konfigurieren</a>
      </div>
    </nav>
  </div>
</header>

<style>
  /* Smart sticky (Nutzerwunsch): beim Runterscrollen ausblenden, beim Hochscrollen wieder einblenden */
  .navbar { position: fixed; inset: 0 0 auto; z-index: 50; transition: transform 0.4s ease; }
  .navbar:global(.is-hidden) { transform: translateY(calc(-100% - 1.5rem)); }
  .nav-pad { padding-inline: 2.5rem; }
  .nav-container { width: 100%; max-width: 110rem; margin-inline: auto; }

  .navbar-component {
    display: flex; justify-content: space-between; align-items: center;
    margin-top: 1.25rem; padding: 1rem 2.2rem 1rem 2.25rem;
    border-radius: 0.5rem; /* Nutzerwunsch: Radius wie die Bilder (8px) */
    background-color: #ffffff38;
    box-shadow: 0 2px 14px rgba(0, 0, 0, 0.06); /* Nutzerwunsch: ganz leichter Schlagschatten */
    -webkit-backdrop-filter: blur(20px); backdrop-filter: blur(20px);
    /* Lade-Animation Original: fällt von oben herein, leichtes Überschwingen */
    animation: nav-drop 0.9s cubic-bezier(0.3, 1.2, 0.5, 1) 0.5s both;
  }
  @keyframes nav-drop { from { transform: translateY(-90px); } }

  .brand { display: flex; align-items: center; transition: transform 0.25s, opacity 0.25s; }
  .brand:hover { opacity: 0.8; transform: translate(0, 1px); }
  /* Abweichung (Logo): Original 8rem breit; unser Logo hat eine Unterzeile und braucht mehr Breite */
  .logo-navbar { width: 12rem; height: auto; }

  .right-navbar-content { display: flex; align-items: center; gap: 0.8rem; }
  .nav-menu { display: flex; align-items: center; gap: 1rem; }
  .nav-link { padding-inline: 0.5rem; transition: all 0.25s; }
  .nav-link:hover { opacity: 0.6; transform: translate(0, 1px); }
  .nav-cta { margin-left: 1rem; }

  .menu-button {
    display: none; width: 60px; height: 60px; padding: 18px; border: 0; border-radius: 4px;
    background: transparent; color: var(--pk-navy); cursor: pointer; overflow: hidden;
  }
  .menu-button[aria-expanded='true'] { background-color: #fff9; }
  .menu-icon { display: block; }

  .nav-overlay { display: none; }

  @media (max-width: 991px) {
    .nav-container { max-width: 90vw; }
    .navbar-component { padding: 0.5rem 1rem 0.5rem 2.25rem; position: relative; }
    .nav-menu { display: none; }
    .menu-button { display: block; }

    /* Mobile-Menü wie Webflow-Nav: gleitet unter der Leiste hervor (0,4 s ease) */
    .nav-overlay {
      display: block; position: absolute; top: 100%; left: 0; right: 0;
      height: calc(100svh - 100%); overflow: hidden; pointer-events: none;
    }
    .mobile-menu {
      display: flex; flex-direction: column; align-items: center;
      width: 90vw; margin: 1rem 5vw 0; padding: 2rem;
      background-color: #fffc; border-radius: 0.5rem; text-align: center;
      transform: translateY(calc(-100% - 12rem)); visibility: hidden;
      transition: transform 0.4s ease, visibility 0s linear 0.4s;
    }
    .mobile-menu .nav-link { margin-bottom: 1rem; }
    /* Nutzerwunsch: Konfigurator auch im Handy-Menü (Pille wie in „Warum Poolbau Koch?“) */
    .mobile-cta { display: flex; flex-direction: column; align-items: center; gap: 0.6rem; margin-top: 0.25rem; }
    .navbar:global(.is-open) .nav-overlay { pointer-events: auto; }
    .navbar:global(.is-open) .mobile-menu {
      transform: none; visibility: visible;
      transition: transform 0.4s ease, visibility 0s;
    }
  }
  @media (max-width: 767px) {
    .nav-pad { padding-inline: 1.25rem; }
    .navbar-component { padding: 0 0 0 1rem; }
  }
  @media (max-width: 479px) {
    .nav-pad { padding-inline: 1rem; }
    .mobile-menu { padding-block: 1.8rem; }
    .logo-navbar { width: 10.5rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .navbar-component { animation: none; }
    .mobile-menu { transition: none; }
  }
</style>

<script>
  const navbar = document.querySelector<HTMLElement>('[data-navbar]');
  const button = document.querySelector<HTMLButtonElement>('[data-menu-button]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');

  const setOpen = (open: boolean) => {
    navbar?.classList.toggle('is-open', open);
    button?.setAttribute('aria-expanded', String(open));
    button?.setAttribute('aria-label', open ? 'Menü schließen' : 'Menü öffnen');
  };
  button?.addEventListener('click', () => setOpen(button.getAttribute('aria-expanded') !== 'true'));
  menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setOpen(false); });
  document.addEventListener('click', (e) => {
    if (navbar?.classList.contains('is-open') && !navbar.contains(e.target as Node)) setOpen(false);
  });

  // Smart sticky: runter = weg, hoch = da; ganz oben und bei offenem Menü immer sichtbar
  let lastY = window.scrollY;
  let ticking = false;
  const onScroll = () => {
    ticking = false;
    const y = window.scrollY;
    const dy = y - lastY;
    if (Math.abs(dy) < 4) return;
    const hide = dy > 0 && y > 120 && !navbar?.classList.contains('is-open');
    navbar?.classList.toggle('is-hidden', hide);
    lastY = y;
  };
  window.addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(onScroll); } }, { passive: true });
  navbar?.addEventListener('focusin', () => navbar.classList.remove('is-hidden'));
</script>
