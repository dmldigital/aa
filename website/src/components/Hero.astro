---
/*
  Hero – 1:1 Space Kit (.hero-wrapper, .hero-heading, .read-more-tag, .heading-3,
  .hero-grid-Hotspots, .button-hero mit Umlauftext). Getauscht: Bild, Texte, Akzentfarbe.
  Einzige inhaltliche Ergänzung (vom Nutzer gewünscht): Button-Gruppe mit Auffächern.
*/
import { Image } from 'astro:assets';
import ButtonGroup from './ButtonGroup.astro';
import imgGarten from '../assets/img/hero/ebene-garten.webp';
import imgTerrasse from '../assets/img/hero/ebene-terrasse.webp';
import imgVorne from '../assets/img/hero/ebene-vorne.webp';
import kaustik from '../assets/img/hero/kaustik.png';
import maskeWasser from '../assets/img/hero/maske-wasser.png';

// Mittelpunkt des Wassers im Quellbild (1920×1282) – Zielpunkt der Kamerafahrt beim Köpfer
const WATER = { x: 900, y: 860, w: 1920, h: 1282 };
const layerWidths = [800, 1280, 1920];

// Hotspots: Position in % der Bildfläche (Bild 16:10, Desktop-Hero 1440×900 = gleicher Ausschnitt)
const hotspots = [
  { x: 46, y: 60, title: 'Keramik-Poolschale', text: 'bis 40 Jahre Garantie', href: '#ohne-beton' },
  { x: 77, y: 70, title: 'Einbau in 48 Stunden', text: 'ganz ohne Beton', href: '#ohne-beton' },
  { x: 21, y: 47, title: 'Komplettpaket inkl. Technik', text: 'ab 22.700 € zzgl. Erdarbeiten', href: '#pakete' },
];

// Wellen-Kreis wie Original (CIRCLE.svg: 115px, weiß 19 %, Hintergrund-Unschärfe, 37 Bögen)
const BUMPS = 37;
const circle = Array.from({ length: 360 }, (_, i) => {
  const a = (i / 360) * Math.PI * 2;
  const r = 56.4 + 0.55 * Math.cos(a * BUMPS);
  return `${i ? 'L' : 'M'}${(57.5 + r * Math.sin(a)).toFixed(2)},${(57.5 - r * Math.cos(a)).toFixed(2)}`;
}).join('') + 'Z';
const ringText = 'OHNE BETON • IN 48 STUNDEN • BIS 40 JAHRE GARANTIE • ';
---

<section class="hero" aria-labelledby="hero-title" data-dive
  data-water-x={WATER.x} data-water-y={WATER.y} data-img-w={WATER.w} data-img-h={WATER.h}>
  <div class="hero-wrapper">
    <!-- Szene in Ebenen (Studiowand = CSS-Hintergrund). Alle Ebenen haben denselben Bildausschnitt. -->
    <div class="scene" aria-hidden="true">
      <div class="cam" data-cam>
        <div class="layer" data-layer="garden"><Image src={imgGarten} alt="" widths={layerWidths} sizes="100vw" loading="eager" /></div>
        <div class="layer" data-layer="terrace">
          <Image src={imgTerrasse} alt="" widths={layerWidths} sizes="100vw" loading="eager" fetchpriority="high" />
          <div class="shimmer" style={`--kaustik:url(${kaustik.src});--maske:url(${maskeWasser.src})`}></div>
        </div>
        <div class="layer" data-layer="front"><Image src={imgVorne} alt="" widths={layerWidths} sizes="100vw" loading="eager" /></div>
      </div>
    </div>
    <div class="dive-flash" data-flash aria-hidden="true"></div>
    <div class="underwater" data-under style={`--kaustik:url(${kaustik.src})`}>
      <canvas class="bubbles" data-bubbles aria-hidden="true"></canvas>
      <div class="under-text" data-under-text>
        <p class="under-title">Einfach eintauchen.</p>
        <p class="under-lead">Ihr eigener Pool – ohne Baustelle, ohne Beton, fertig in 48&nbsp;Stunden.</p>
      </div>
    </div>
    <div class="surface" data-surface aria-hidden="true"></div>
    <div class="overlay-mobile" aria-hidden="true"></div>

    <div class="hero-ui" data-ui>
    <div class="hero-grid">
      {hotspots.map((h) => (
        <a href={h.href} class="hover-relative" style={`left:${h.x}%;top:${h.y}%`}>
          <span class="circle-hover"><span class="circle-hero"></span></span>
          <span class="hero-hover">
            <span class="hover-content">
              <span class="text-weight-medium">{h.title}</span>
              <span>{h.text}</span>
            </span>
            <span class="arrow-hero" aria-hidden="true">
              <svg width="12" height="10" viewBox="0 0 12 10" fill="none"><path d="M1.3 8.93 11.34 1.87m0 0-1.44 6.6m1.44-6.6-6.7-.84" stroke="#151515" stroke-width="1.14" stroke-linecap="square" stroke-linejoin="round"/></svg>
            </span>
          </span>
        </a>
      ))}
    </div>

    <div class="hero-heading">
      <a href="#pakete" class="read-more-tag rise" style="--d:.35s">
        <span class="text-size-small text-weight-bold">Komplettpaket ab 22.700 €</span>
        <span class="vertical-line-tag"></span>
        <span class="read-more-button">
          <span class="opacity-50 text-size-small text-weight-bold">zzgl. Erdarbeiten</span>
          <svg class="arrow" width="11" height="10" viewBox="0 0 11 10" fill="none" aria-hidden="true"><path d="M6.25 1.25 10 5m0 0L6.25 8.75M10 5H0" stroke="#1F1F1F" stroke-width=".78"/></svg>
        </span>
      </a>
      <h1 id="hero-title" class="heading-3 text-weight-light rise" style="--d:.5s">
        Ihr Traumpool.<br />Fertig in 48 Stunden.
      </h1>
      <div class="rise" style="--d:.65s">
        <ButtonGroup label="Nächste Schritte">
          <span class="btn-border"><a href="#beratung" class="btn-line">Kostenlose Beratung</a></span>
          <a href="https://konfig.poolbau-koch.de/" class="btn-dark" target="_blank" rel="noopener">Pool konfigurieren</a>
        </ButtonGroup>
      </div>
    </div>

    <a href="#ohne-beton" class="button-hero" aria-label="Weiter nach unten">
      <span class="button-image">
        <svg width="115" height="115" viewBox="0 0 115 115" aria-hidden="true"><path d={circle} fill="#fff" fill-opacity=".19" /></svg>
      </span>
      <span class="circular-text" aria-hidden="true">
        <svg width="120" height="120" viewBox="0 0 140 140">
          <defs><path id="ring" d="M70,70 m-60,0 a60,60 0 1,1 120,0 a60,60 0 1,1 -120,0" /></defs>
          <text fill="#151515" font-size="9.4" font-weight="500"><textPath href="#ring" textLength="376" lengthAdjust="spacing">{ringText}</textPath></text>
        </svg>
      </span>
      <span class="button-arrow" aria-hidden="true">
        <span class="hero-arrow-wrapper">
          <svg class="h-arrow" width="24" height="36" viewBox="0 0 36 54" fill="none"><path d="M2.31 36.89a1.07 1.07 0 0 0-1.5 1.55l14.42 13.89a4 4 0 0 0 5.55 0L35.2 38.44a1.07 1.07 0 0 0-1.5-1.55l-7.81 7.52c-2.54 2.45-6.77.65-6.77-2.88V1.11a1.11 1.11 0 1 0-2.22 0v40.42c0 3.53-4.24 5.33-6.78 2.88Z" fill="#242424"/></svg>
          <svg class="h-arrow" width="24" height="36" viewBox="0 0 36 54" fill="none"><path d="M2.31 36.89a1.07 1.07 0 0 0-1.5 1.55l14.42 13.89a4 4 0 0 0 5.55 0L35.2 38.44a1.07 1.07 0 0 0-1.5-1.55l-7.81 7.52c-2.54 2.45-6.77.65-6.77-2.88V1.11a1.11 1.11 0 1 0-2.22 0v40.42c0 3.53-4.24 5.33-6.78 2.88Z" fill="#242424"/></svg>
        </span>
      </span>
    </a>
    </div>
  </div>
</section>

<style>
  .hero-wrapper {
    position: relative; display: flex; flex-flow: column; justify-content: flex-end;
    height: 100vh; overflow: hidden;
  }
  /* Köpfer: Scroll-Strecke, Bühne bleibt stehen */
  .hero { position: relative; height: 280vh; }
  .hero-wrapper { position: sticky; top: 0; }
  .hero-ui { position: absolute; inset: 0; display: flex; flex-flow: column; justify-content: flex-end; will-change: opacity, transform; }

  .scene {
    position: absolute; inset: 0; overflow: hidden;
    /* Studiowand wie im Original: hellgrau, mittig heller */
    background: radial-gradient(120% 90% at 45% 30%, #e6e6e6 0%, #dcdcdc 60%, #d4d4d4 100%);
    perspective: 1400px;
  }
  .cam, .layer { position: absolute; inset: 0; will-change: transform; }
  .layer :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: 50% 50%; }

  /* Lebendiges Wasser: Lichtnetz, nur auf der Wasserfläche (Maske), langsam driftend */
  .shimmer {
    position: absolute; inset: 0; pointer-events: none;
    background-image: var(--kaustik), var(--kaustik);
    background-size: 240px 240px, 380px 380px;
    mix-blend-mode: soft-light; opacity: 0.7;
    -webkit-mask-image: var(--maske); mask-image: var(--maske);
    -webkit-mask-size: cover; mask-size: cover; -webkit-mask-position: 50% 50%; mask-position: 50% 50%;
    animation: drift 18s linear infinite;
  }
  @keyframes drift { to { background-position: 240px 120px, -380px 190px; } }

  .dive-flash { position: absolute; inset: 0; background: radial-gradient(circle at 50% 55%, #fff 0%, #e8f6ff 45%, rgba(255,255,255,0) 80%); opacity: 0; pointer-events: none; z-index: 6; }
  .underwater {
    position: absolute; inset: 0; z-index: 7; opacity: 0; pointer-events: none; overflow: hidden;
    background:
      var(--kaustik) 0 0 / 420px 420px,
      linear-gradient(180deg, #1b8fce 0%, #0b67a8 40%, #004A80 100%);
    background-blend-mode: soft-light, normal;
    animation: under-drift 22s linear infinite;
    display: grid; place-items: center; text-align: center; color: #fff;
  }
  @keyframes under-drift { to { background-position: 420px 210px, 0 0; } }
  .bubbles { position: absolute; inset: 0; width: 100%; height: 100%; }
  .under-text { position: relative; display: grid; gap: 1rem; padding-inline: 1.5rem; opacity: 0; }
  .under-title { font-size: clamp(2.5rem, 6vw, 4.875rem); font-weight: 300; line-height: 1; margin: 0; }
  .under-lead { font-size: 1.125rem; max-width: 36ch; margin: 0 auto; opacity: 0.9; }
  .surface { position: absolute; inset: 0; z-index: 8; background: var(--bg); opacity: 0; pointer-events: none; }

  /* Hotspots (Original .hero-grid, nur Desktop) */
  .hero-grid { position: absolute; inset: 0; z-index: 3; }
  .hover-relative { position: absolute; transform: translate(-50%, -50%); }
  .circle-hover {
    display: flex; justify-content: center; align-items: center; width: 2rem; height: 2rem;
    border-radius: 50%; background-color: #ffffff1a;
    -webkit-backdrop-filter: blur(1.5px); backdrop-filter: blur(1.5px);
  }
  .circle-hero { width: 1rem; height: 1rem; border-radius: 50%; background-color: #fff; }
  .hero-hover {
    position: absolute; left: 0.5rem; top: 100%; z-index: 2;
    display: flex; align-items: flex-start; gap: 1.8rem; padding: 0.75rem 1rem;
    background-color: var(--surface); border-bottom: 1px solid var(--pk-navy);
    border-radius: 0.0625rem 0.3125rem 0.3125rem; white-space: nowrap; overflow: hidden;
    /* Original: Karte wächst in ~0,45 s aus dem Punkt heraus und blendet auf */
    opacity: 0; clip-path: inset(0 calc(100% - 2rem) calc(100% - 1.6rem) 0 round 0.3125rem);
    transition: clip-path 0.45s ease, opacity 0.45s ease; pointer-events: none;
  }
  .hover-relative:hover .hero-hover, .hover-relative:focus-visible .hero-hover {
    opacity: 1; clip-path: inset(0 0 0 0 round 0.3125rem);
  }
  .hover-content { display: flex; flex-flow: column; align-items: flex-start; gap: 0.25rem; }
  .arrow-hero { display: flex; width: 1rem; height: 0.9rem; margin-top: 0.4rem; overflow: hidden; }
  .arrow-hero svg { transform: translate(-100%, 100%); transition: transform 0.4s ease 0.05s; }
  .hover-relative:hover .arrow-hero svg, .hover-relative:focus-visible .arrow-hero svg { transform: none; }

  /* Text unten links (Original .hero-heading) */
  .hero-heading {
    position: relative; z-index: 5; display: flex; flex-flow: column; align-items: flex-start;
    gap: 1.125rem; max-width: 63ch; margin: 0 0 3rem 3.5rem;
  }
  .read-more-tag {
    display: flex; justify-content: space-between; align-items: center; gap: 0.5rem;
    padding: 0.5rem 0.75rem; border-radius: 2.3125rem; background-color: #efefef; color: #000;
  }
  .vertical-line-tag { width: 1px; height: 1rem; background-color: #000; opacity: 0.5; }
  .read-more-button { display: flex; align-items: center; gap: 0.5rem; transition: all 0.25s; }
  .read-more-button:hover { gap: 0.8rem; }
  .text-size-small { font-size: var(--fs-small); }
  .text-weight-bold { font-weight: 700; }
  .text-weight-medium { font-weight: 500; }
  .text-weight-light { font-weight: 300; }
  .opacity-50 { opacity: 0.5; }
  .heading-3 { margin: 0; font-size: 4.875rem; line-height: 1; color: var(--ink); }

  /* Wellen-Kreis mit Umlauftext (Original .button-hero) */
  .button-hero {
    position: absolute; right: 2.5rem; bottom: 2.5rem; z-index: 5;
    display: flex; justify-content: center; align-items: center;
    animation: badge-in 0.8s cubic-bezier(0.3, 1.2, 0.5, 1) 0.8s both;
  }
  .button-image { position: relative; display: block; }
  .button-image svg { display: block; -webkit-backdrop-filter: blur(6.5px); backdrop-filter: blur(6.5px); border-radius: 50%; }
  .circular-text { position: absolute; padding: 0.5rem; animation: spin 30s linear infinite; }
  .circular-text svg { display: block; }
  .button-arrow { position: absolute; }
  .hero-arrow-wrapper {
    display: flex; flex-flow: column; justify-content: flex-end; align-items: center; gap: 2rem;
    width: 1.5rem; height: 2rem; overflow: hidden;
  }
  .h-arrow { flex: none; }
  @keyframes spin { to { transform: rotate(360deg); } }
  @keyframes badge-in { from { opacity: 0; transform: scale(1.2); } 80% { transform: scale(0.99); } }

  /* Lade-Animation Original: von unten, leichtes Überschwingen, verzögertes Aufblenden */
  .rise { animation: rise-move 0.8s cubic-bezier(0.3, 1.25, 0.5, 1) var(--d, 0s) both, rise-fade 1.1s ease var(--d, 0s) both; }
  @keyframes rise-move { from { transform: translateY(90px); } }
  @keyframes rise-fade { from { opacity: 0; } 30% { opacity: 0; } }

  .overlay-mobile { display: none; }

  @media (max-width: 991px) {
    .hero-wrapper { height: 100svh; align-items: stretch; }
    .hero-grid { display: none; }
    .hero-heading { max-width: 50ch; }
    .heading-3 { font-size: 3rem; }
  }
  @media (max-width: 767px) {
    .hero-heading { align-items: center; text-align: center; max-width: none; margin-inline: 1rem; }
    .heading-3 { font-size: 2.7rem; }
    .button-hero { display: none; }
  }
  @media (max-width: 479px) {
    .heading-3 { font-size: 2.5rem; }
    .read-more-tag { gap: 0.75rem; border-radius: 1rem; padding-block: 0.75rem; }
    .overlay-mobile {
      display: block; position: absolute; inset: auto 0 0; height: 50vh; z-index: 2;
      background-image: linear-gradient(0deg, var(--bg), #efefef00);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .rise, .button-hero, .circular-text, .shimmer { animation: none; }
    .hero { height: auto; }
    .underwater, .dive-flash, .surface { display: none; }
  }
</style>

<script>
  const hero = document.querySelector<HTMLElement>('[data-dive]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (hero && !reduce) {
    const cam = hero.querySelector<HTMLElement>('[data-cam]')!;
    const layers = {
      garden: hero.querySelector<HTMLElement>('[data-layer="garden"]')!,
      terrace: hero.querySelector<HTMLElement>('[data-layer="terrace"]')!,
      front: hero.querySelector<HTMLElement>('[data-layer="front"]')!,
    };
    const ui = hero.querySelector<HTMLElement>('[data-ui]')!;
    const flash = hero.querySelector<HTMLElement>('[data-flash]')!;
    const under = hero.querySelector<HTMLElement>('[data-under]')!;
    const underText = hero.querySelector<HTMLElement>('[data-under-text]')!;
    const surface = hero.querySelector<HTMLElement>('[data-surface]')!;
    const canvas = hero.querySelector<HTMLCanvasElement>('[data-bubbles]')!;
    const ctx = canvas.getContext('2d')!;

    const clamp = (v: number, a = 0, b = 1) => Math.min(b, Math.max(a, v));
    const easeInOut = (t: number) => (t < 0.5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2);
    const easeIn = (t: number) => t * t * t;

    // Wassermittelpunkt (Bildkoordinaten) → Bildschirmkoordinaten bei object-fit: cover
    const W = Number(hero.dataset.imgW), H = Number(hero.dataset.imgH);
    const WX = Number(hero.dataset.waterX), WY = Number(hero.dataset.waterY);
    const setOrigin = () => {
      const w = hero.clientWidth, h = window.innerHeight;
      const s = Math.max(w / W, h / H);
      const ox = (w - W * s) / 2 + WX * s, oy = (h - H * s) / 2 + WY * s;
      for (const el of [cam, layers.garden, layers.terrace, layers.front]) el.style.transformOrigin = `${ox}px ${oy}px`;
    };

    // Luftblasen unter Wasser
    type Bubble = { x: number; y: number; r: number; v: number; ph: number };
    let bubbles: Bubble[] = [];
    let underAmount = 0;
    const resizeCanvas = () => {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = canvas.clientWidth * dpr; canvas.height = canvas.clientHeight * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    };
    const spawn = (n: number) => {
      const w = canvas.clientWidth, h = canvas.clientHeight;
      for (let i = 0; i < n; i++) bubbles.push({ x: w * (0.2 + Math.random() * 0.6), y: h + Math.random() * h * 0.3, r: 2 + Math.random() * 9, v: 0.6 + Math.random() * 1.8, ph: Math.random() * 6.28 });
    };
    let bubbleLoop = 0;
    const drawBubbles = () => {
      const w = canvas.clientWidth, h = canvas.clientHeight;
      ctx.clearRect(0, 0, w, h);
      if (bubbles.length < 70 * underAmount) spawn(2);
      bubbles = bubbles.filter((b) => b.y > -20);
      for (const b of bubbles) {
        b.y -= b.v * (1 + b.r / 6); b.ph += 0.05; b.x += Math.sin(b.ph) * 0.6;
        ctx.beginPath(); ctx.arc(b.x, b.y, b.r, 0, Math.PI * 2);
        ctx.strokeStyle = 'rgba(255,255,255,0.55)'; ctx.lineWidth = 1.2; ctx.stroke();
        ctx.beginPath(); ctx.arc(b.x - b.r * 0.35, b.y - b.r * 0.35, b.r * 0.25, 0, Math.PI * 2);
        ctx.fillStyle = 'rgba(255,255,255,0.6)'; ctx.fill();
      }
      bubbleLoop = underAmount > 0.02 ? requestAnimationFrame(drawBubbles) : 0;
    };

    let ticking = false;
    const update = () => {
      ticking = false;
      const r = hero.getBoundingClientRect();
      const p = clamp(-r.top / (r.height - window.innerHeight));

      // 1) Text & Hotspots gehen zuerst
      const uiOut = clamp(p / 0.12);
      ui.style.opacity = String(1 - uiOut);
      ui.style.transform = `translateY(${-40 * uiOut}px)`;
      ui.style.pointerEvents = uiOut > 0.5 ? 'none' : '';

      // 2) Anlauf: Blick neigt sich zum Wasser, Kamera fährt heran (Ebenen unterschiedlich schnell)
      const run = easeInOut(clamp(p / 0.55));
      // 3) Eintauchen: Wasser füllt das Bild
      const dive = easeIn(clamp((p - 0.46) / 0.22));
      cam.style.transform = `rotateX(${(16 * run).toFixed(2)}deg)`;
      layers.garden.style.transform = `scale(${(1 + 0.1 * run + 1.5 * dive).toFixed(4)})`;
      layers.terrace.style.transform = `scale(${((1 + 0.55 * run) * (1 + 9 * dive)).toFixed(4)})`;
      layers.front.style.transform = `translateY(${(6 * run).toFixed(2)}vh) scale(${((1 + 1.1 * run) * (1 + 14 * dive)).toFixed(4)})`;
      layers.front.style.opacity = String(1 - clamp((dive - 0.3) / 0.4));

      // 4) Spritzer / Aufprall
      flash.style.opacity = String(clamp(1 - Math.abs(p - 0.66) / 0.05) * 0.9);

      // 5) Unter Wasser, Text taucht auf; am Ende Auftauchen ins helle Grau der nächsten Sektion
      underAmount = clamp((p - 0.63) / 0.08);
      under.style.opacity = String(underAmount);
      underText.style.opacity = String(clamp((p - 0.72) / 0.06) * (1 - clamp((p - 0.88) / 0.05)));
      underText.style.transform = `translateY(${(1 - clamp((p - 0.72) / 0.12)) * 30}px)`;
      surface.style.opacity = String(clamp((p - 0.9) / 0.1));
      if (underAmount > 0.02 && !bubbleLoop) bubbleLoop = requestAnimationFrame(drawBubbles);
    };
    const onScroll = () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } };
    const onResize = () => { setOrigin(); resizeCanvas(); onScroll(); };

    onResize();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onResize);
  }
</script>
