---
/*
  Hero – 1:1 Space Kit (.hero-wrapper, .hero-heading, .read-more-tag, .heading-3,
  .button-hero mit Umlauftext). Getauscht: Bild, Texte, Akzentfarbe. Hotspots auf Nutzerwunsch entfernt.
  Einzige inhaltliche Ergänzung (vom Nutzer gewünscht): Button-Gruppe mit Auffächern.
*/
import ButtonGroup from './ButtonGroup.astro';
import { url } from '../lib/url';

/*
  Hintergrund: Bildfolge aus dem Köpfer-Video (Higgsfield, MiniMax H3, 2K), läuft beim ersten Scrollen
  automatisch durch und ganz oben wieder rückwärts.
  96 Einzelbilder (12 pro Videosekunde), Desktop 1920×1080 (d/), Handy 720×1280 Hochformat (m/).
*/
const FRAMES = 96;
const framesBase = url('koepfer/');
const poster = url('koepfer/d/000.webp');

// Wellen-Kreis wie Original (CIRCLE.svg: 115px, weiß 19 %, Hintergrund-Unschärfe, 37 Bögen)
const BUMPS = 37;
const circle = Array.from({ length: 360 }, (_, i) => {
  const a = (i / 360) * Math.PI * 2;
  const r = 56.4 + 0.55 * Math.cos(a * BUMPS);
  return `${i ? 'L' : 'M'}${(57.5 + r * Math.sin(a)).toFixed(2)},${(57.5 - r * Math.cos(a)).toFixed(2)}`;
}).join('') + 'Z';
const ringText = 'OHNE BETON • IN 48 STUNDEN • BIS 40 JAHRE GARANTIE • ';
---

<section class="hero" aria-labelledby="hero-title" data-scrub data-frames={FRAMES} data-base={framesBase}>
  <div class="hero-wrapper">
    <div class="hero-background" aria-hidden="true">
      <img class="hero-poster" src={poster} alt="" width="1920" height="1080" fetchpriority="high" />
      <canvas class="hero-canvas" data-canvas></canvas>
    </div>

    <div class="hero-ui" data-ui>
    <div class="hero-fade" aria-hidden="true"></div>
    <div class="overlay-mobile" aria-hidden="true"></div>

    <div class="hero-heading">
      <a href="#pakete" class="read-more-tag rise" style="--d:.35s">
        <span class="text-size-small text-weight-bold">Komplettpaket ab 22.700 €</span>
        <span class="vertical-line-tag"></span>
        <span class="read-more-button">
          <span class="opacity-50 text-size-small text-weight-bold">zzgl. Erdarbeiten</span>
          <svg class="arrow" width="11" height="10" viewBox="0 0 11 10" fill="none" aria-hidden="true"><path d="M6.25 1.25 10 5m0 0L6.25 8.75M10 5H0" stroke="#1F1F1F" stroke-width=".78"/></svg>
        </span>
      </a>
      <h1 id="hero-title" class="heading-3 text-weight-light rise" style="--d:.5s">
        Ihr Traumpool.<br />Fertig in 48&nbsp;Stunden.
      </h1>
      <div class="rise" style="--d:.65s">
        <ButtonGroup label="Nächste Schritte" class="v-mobile">
          <a href="#beratung" class="btn-pill is-navy">Kostenlose Beratung</a>
          <a href="https://konfig.poolbau-koch.de/" class="btn-pill is-teal" target="_blank" rel="noopener">Pool konfigurieren</a>
          <a href="#pakete" class="btn-pill is-stone">Komplettpakete</a>
        </ButtonGroup>
      </div>
    </div>

    <a href="#ohne-beton" class="button-hero" aria-label="Weiter nach unten">
      <span class="button-image">
        <svg width="115" height="115" viewBox="0 0 115 115" aria-hidden="true"><path d={circle} fill="#fff" fill-opacity=".19" /></svg>
      </span>
      <span class="circular-text" aria-hidden="true">
        <svg width="120" height="120" viewBox="0 0 140 140">
          <defs><path id="ring" d="M70,70 m-60,0 a60,60 0 1,1 120,0 a60,60 0 1,1 -120,0" /></defs>
          <text fill="#151515" font-size="9.4" font-weight="500"><textPath href="#ring" textLength="376" lengthAdjust="spacing">{ringText}</textPath></text>
        </svg>
      </span>
      <span class="button-arrow" aria-hidden="true">
        <span class="hero-arrow-wrapper">
          <svg class="h-arrow" width="24" height="36" viewBox="0 0 36 54" fill="none"><path d="M2.31 36.89a1.07 1.07 0 0 0-1.5 1.55l14.42 13.89a4 4 0 0 0 5.55 0L35.2 38.44a1.07 1.07 0 0 0-1.5-1.55l-7.81 7.52c-2.54 2.45-6.77.65-6.77-2.88V1.11a1.11 1.11 0 1 0-2.22 0v40.42c0 3.53-4.24 5.33-6.78 2.88Z" fill="#242424"/></svg>
          <svg class="h-arrow" width="24" height="36" viewBox="0 0 36 54" fill="none"><path d="M2.31 36.89a1.07 1.07 0 0 0-1.5 1.55l14.42 13.89a4 4 0 0 0 5.55 0L35.2 38.44a1.07 1.07 0 0 0-1.5-1.55l-7.81 7.52c-2.54 2.45-6.77.65-6.77-2.88V1.11a1.11 1.11 0 1 0-2.22 0v40.42c0 3.53-4.24 5.33-6.78 2.88Z" fill="#242424"/></svg>
        </span>
      </span>
    </a>
    </div>
  </div>
</section>

<style>
  /* Video läuft beim ersten Scrollen von selbst durch (Script unten) */
  .hero { position: relative; }
  .hero-wrapper {
    position: relative; display: flex; flex-flow: column; justify-content: flex-end;
    height: 100vh; overflow: hidden; background: #cfe3ee;
  }
  .hero-background { position: absolute; inset: 0; }
  .hero-poster, .hero-canvas { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .hero-canvas { opacity: 0; }
  .hero-canvas:global(.is-ready) { opacity: 1; }

  /* Bedienelemente als Ebene – blendet beim Losscrollen aus */
  .hero-ui { position: absolute; inset: 0; display: flex; flex-flow: column; justify-content: flex-end; will-change: opacity; }
  /* Heller Auslauf unten links für die dunkle Schrift (wie zuvor im Hero-Bild) */
  .hero-fade {
    position: absolute; inset: 0; pointer-events: none;
    background:
      linear-gradient(0deg, rgba(239, 239, 239, 0.55) 0%, rgba(239, 239, 239, 0) 38%),
      radial-gradient(75% 60% at 0% 100%, rgba(239, 239, 239, 0.62) 0%, rgba(239, 239, 239, 0) 70%);
  }

  /* Text unten links (Original .hero-heading) */
  .hero-heading {
    position: relative; z-index: 5; display: flex; flex-flow: column; align-items: flex-start;
    gap: 1.125rem; max-width: 63ch; margin: 0 0 3rem 3.5rem;
  }
  .read-more-tag {
    display: flex; justify-content: space-between; align-items: center; gap: 0.5rem;
    padding: 0.5rem 0.75rem; border-radius: 2.3125rem; background-color: #efefef; color: #000;
  }
  .vertical-line-tag { width: 1px; height: 1rem; background-color: #000; opacity: 0.5; }
  .read-more-button { display: flex; align-items: center; gap: 0.5rem; transition: all 0.25s; }
  .read-more-button:hover { gap: 0.8rem; }
  .text-size-small { font-size: var(--fs-small); }
  .text-weight-bold { font-weight: 700; }
  .text-weight-medium { font-weight: 500; }
  .text-weight-light { font-weight: 300; }
  .opacity-50 { opacity: 0.5; }
  .heading-3 { margin: 0; font-size: 4.875rem; line-height: 1; color: var(--ink); text-wrap: balance; }

  /* Wellen-Kreis mit Umlauftext (Original .button-hero) */
  .button-hero {
    position: absolute; right: 2.5rem; bottom: 2.5rem; z-index: 5;
    display: flex; justify-content: center; align-items: center;
    animation: badge-in 0.8s cubic-bezier(0.3, 1.2, 0.5, 1) 0.8s both;
  }
  .button-image { position: relative; display: block; }
  .button-image svg { display: block; -webkit-backdrop-filter: blur(6.5px); backdrop-filter: blur(6.5px); border-radius: 50%; }
  .circular-text { position: absolute; padding: 0.5rem; animation: spin 30s linear infinite; }
  .circular-text svg { display: block; }
  .button-arrow { position: absolute; }
  .hero-arrow-wrapper {
    display: flex; flex-flow: column; justify-content: flex-end; align-items: center; gap: 2rem;
    width: 1.5rem; height: 2rem; overflow: hidden;
  }
  .h-arrow { flex: none; }
  @keyframes spin { to { transform: rotate(360deg); } }
  @keyframes badge-in { from { opacity: 0; transform: scale(1.2); } 80% { transform: scale(0.99); } }

  /* Lade-Animation Original: von unten, leichtes Überschwingen, verzögertes Aufblenden */
  .rise { animation: rise-move 0.8s cubic-bezier(0.3, 1.25, 0.5, 1) var(--d, 0s) both, rise-fade 1.1s ease var(--d, 0s) both; }
  @keyframes rise-move { from { transform: translateY(90px); } }
  @keyframes rise-fade { from { opacity: 0; } 30% { opacity: 0; } }

  .overlay-mobile { display: none; }

  @media (max-width: 991px) {
    .hero-wrapper { height: 100svh; align-items: stretch; }
    .hero-ui { align-items: stretch; }
    .hero-heading { max-width: 50ch; }
    .heading-3 { font-size: 3rem; }
  }
  @media (max-width: 767px) {
    .hero-heading { align-items: center; text-align: center; max-width: none; margin-inline: 1rem; }
    .heading-3 { font-size: 2.7rem; }
    .button-hero { display: none; }
  }
  /* Schmale Handys: Pill zweizeilig und zentriert statt zerstückelt */
  @media (max-width: 420px) {
    .read-more-tag { flex-direction: column; gap: 0.125rem; padding: 0.625rem 1.25rem; text-align: center; }
    .vertical-line-tag { display: none; }
  }
  @media (max-width: 479px) {
    .heading-3 { font-size: 2.5rem; }
    .read-more-tag { gap: 0.75rem; border-radius: 1rem; padding-block: 0.75rem; }
    .overlay-mobile {
      display: block; position: absolute; inset: auto 0 0; height: 50vh; z-index: 2;
      background-image: linear-gradient(0deg, var(--bg), #efefef00);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .rise, .button-hero, .circular-text { animation: none; }
    .hero-canvas { display: none; }
  }
</style>

<script>
  // Köpfer-Video als Bildfolge.
  // Ruhe oben: nur das Wasser bewegt sich (Schleife aus stabilisierten Videobildern, Kamera steht).
  // Losscrollen: Video läuft von selbst bis unter Wasser durch (Seite steht so lange), danach
  // scrollt die Seite automatisch zu Sektion 2. Zurück ganz oben: Video läuft genauso rückwärts.
  const hero = document.querySelector<HTMLElement>('[data-scrub]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (hero && !reduce) {
    const canvas = hero.querySelector<HTMLCanvasElement>('[data-canvas]')!;
    const ui = hero.querySelector<HTMLElement>('[data-ui]')!;
    const ctx = canvas.getContext('2d')!;
    const N = Number(hero.dataset.frames);
    const END = N - 1;
    const DURATION = 3200; // ms für den ganzen Durchlauf
    const mobile = window.matchMedia('(max-aspect-ratio: 4/5)').matches;
    const set = mobile ? 'm' : 'd';
    const src = (i: number) => `${hero.dataset.base}${set}/${String(i).padStart(3, '0')}.webp`;
    const frames: (HTMLImageElement | null)[] = new Array(N).fill(null);
    const clamp = (v: number, a = 0, b = 1) => Math.min(b, Math.max(a, v));

    // Wasser-Schleife: 95 Ausschnitte (Pool-Bereich, weicher Rand) aus dem Higgsfield-Wasserclip mit fester
    // Kamera (Start = Ende, daher nahtlos), auf Bild 0 ausgerichtet, im 1920×1080-Raster
    const W_N = 95, W_FPS = 6, W_X = 80, W_Y = 480; // Clip hat 12 Bilder/s → halbe Geschwindigkeit
    // Handy-Bildsatz = Hochformat-Ausschnitt aus der Bildmitte (x ab 656,25 bei 1920 Breite, ×1280/1080)
    const W_SCALE = mobile ? 1280 / 1080 : 1, W_OFF = mobile ? -656.25 : 0;
    const water: (HTMLImageElement | null)[] = new Array(W_N).fill(null);

    const load = (url: string) => new Promise<HTMLImageElement | null>((resolve) => {
      const img = new Image();
      img.decoding = 'async';
      img.onload = () => resolve(img);
      img.onerror = () => resolve(null);
      img.src = url;
    });
    const loadFrame = async (i: number) => { frames[i] = await load(src(i)); };

    // Ladereihenfolge: erst Start/Ende, dann immer feiner verteilt
    const order: number[] = [0, N - 1];
    for (let step = 32; step >= 1; step = Math.floor(step / 2)) {
      for (let i = 0; i < N; i += step) if (!order.includes(i)) order.push(i);
      if (step === 1) break;
    }

    // Bild im „cover“-Modus zeichnen; liefert Maßstab und Versatz für die Wasser-Ausschnitte
    let fit = { s: 1, x: 0, y: 0 };
    const cover = (img: HTMLImageElement) => {
      const cw = canvas.width, ch = canvas.height;
      const s = Math.max(cw / img.naturalWidth, ch / img.naturalHeight);
      const w = img.naturalWidth * s, h = img.naturalHeight * s;
      fit = { s, x: (cw - w) / 2, y: (ch - h) / 2 };
      ctx.drawImage(img, fit.x, fit.y, w, h);
    };
    const nearestLoaded = (i: number) => {
      for (let d = 0; d < N; d++) {
        if (frames[i - d]) return i - d;
        if (frames[i + d]) return i + d;
      }
      return -1;
    };
    const draw = (i: number) => {
      const k = nearestLoaded(i);
      if (k < 0) return;
      cover(frames[k]!);
      canvas.classList.add('is-ready');
    };
    // Langsamer als im Clip: zwischen zwei Bildern weich überblenden, damit es nicht ruckelt
    const drawWater = (t: number) => {
      const j = Math.floor(t) % W_N, f = t - Math.floor(t);
      const w = water[j], n = water[(j + 1) % W_N];
      if (!w || !frames[0]) return;
      cover(frames[0]);
      const k = fit.s * W_SCALE;
      const put = (img: HTMLImageElement) => ctx.drawImage(img, fit.x + (W_X + W_OFF) * k, fit.y + W_Y * k, img.naturalWidth * k, img.naturalHeight * k);
      put(w);
      if (n && f > 0.02) { ctx.globalAlpha = f; put(n); ctx.globalAlpha = 1; }
    };

    // Abspielen: pos läuft mit konstantem Tempo auf target zu (Richtungswechsel mitten drin ist weich)
    let pos = 0;
    let target = 0;
    let locked = false;     // Seite steht, solange das Video vorwärts läuft
    let leftTop = false;    // erst nach echtem Wegscrollen löst „ganz oben“ das Rückwärtslaufen aus
    let raf = 0;
    let last = 0;
    let heroVisible = true;
    let waterRaf = 0, waterT = 0, waterLast = 0;

    const render = () => {
      ui.style.opacity = String(1 - clamp(pos / 12));
      ui.style.pointerEvents = pos > 3 ? 'none' : '';
      if (pos === 0 && target === 0 && water[0]) startWater();
      else draw(Math.round(pos));
    };

    const waterTick = (t: number) => {
      waterRaf = 0;
      if (raf || pos !== 0 || target !== 0 || !heroVisible) { waterLast = 0; return; }
      waterT += waterLast ? ((t - waterLast) / 1000) * W_FPS : 0;
      waterLast = t;
      drawWater(waterT % W_N);
      waterRaf = requestAnimationFrame(waterTick);
    };
    function startWater() { if (!waterRaf) { waterLast = 0; waterRaf = requestAnimationFrame(waterTick); } }

    const scrollToNext = () => {
      const y = hero.offsetTop + hero.offsetHeight;   // Beginn von Sektion 2
      const lenis = (window as any).lenis;
      if (lenis) lenis.scrollTo(y, { duration: 1.4 });
      else window.scrollTo({ top: y, behavior: 'smooth' });
    };

    const tick = (t: number) => {
      const dt = last ? t - last : 16;
      last = t;
      const step = (dt / DURATION) * (N - 1);
      pos = target > pos ? Math.min(target, pos + step) : Math.max(target, pos - step);
      render();
      if (pos !== target) { raf = requestAnimationFrame(tick); return; }
      raf = 0; last = 0;
      if (locked) { locked = false; scrollToNext(); }   // Ende der Videofahrt → weiter zum Text
    };
    const play = (to: number) => {
      target = to;
      locked = to === END;
      if (!raf) raf = requestAnimationFrame(tick);
    };
    const forward = () => { if (target !== END) { leftTop = false; play(END); } };
    const backward = () => { if (target !== 0) play(0); };
    const atTop = () => window.scrollY <= 2;

    // Scroll-Absicht abfangen (vor Lenis, daher Capture-Phase)
    const block = (e: Event) => { if (e.cancelable) e.preventDefault(); (e as any).lenisStopPropagation = true; };
    window.addEventListener('wheel', (e) => {
      if (e.deltaY > 0 && atTop()) forward();
      else if (e.deltaY < 0 && atTop() && target === END && !locked) backward();
      if (locked) block(e);
    }, { capture: true, passive: false });
    let touchY = 0;
    window.addEventListener('touchstart', (e) => { touchY = e.touches[0].clientY; }, { capture: true, passive: true });
    window.addEventListener('touchmove', (e) => {
      const dy = touchY - e.touches[0].clientY;   // > 0 = nach unten scrollen
      if (dy > 8 && atTop()) forward();
      else if (dy < -8 && atTop() && target === END && !locked) backward();
      if (locked) block(e);
    }, { capture: true, passive: false });
    window.addEventListener('keydown', (e) => {
      const down = ['ArrowDown', 'PageDown', 'End', ' '].includes(e.key);
      if (down && atTop() && !(e.target as HTMLElement).closest?.('input, textarea, select')) forward();
      if (locked && down) e.preventDefault();
    }, { capture: true });
    window.addEventListener('scroll', () => {
      const y = window.scrollY;
      if (y > 40) leftTop = true;
      if (y > 10 && target === 0) forward();                 // z. B. Scrollleiste gezogen, Anker-Link
      else if (atTop() && leftTop && !locked) backward();    // zurück ganz oben → rückwärts
    }, { passive: true });

    new IntersectionObserver(([e]) => { heroVisible = e.isIntersecting; if (heroVisible) render(); }).observe(hero);

    const resize = () => {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.round(canvas.clientWidth * dpr);
      canvas.height = Math.round(canvas.clientHeight * dpr);
      render();
    };

    (async () => {
      // Seite schon weiter unten geladen (Neuladen, Anker): gleich Unterwasserbild zeigen
      if (window.scrollY > 10) { pos = target = END; leftTop = true; await loadFrame(END); }
      await loadFrame(0);
      resize();
      window.addEventListener('resize', resize);
      // Wasser-Schleife zuerst, dann die Videobilder – je 6 gleichzeitig
      const wq = Array.from({ length: W_N }, (_, j) => j);
      const wWorker = async () => { while (wq.length) { const j = wq.shift()!; water[j] = await load(`${hero.dataset.base}w/${String(j).padStart(3, '0')}.webp`); } };
      await Promise.all(Array.from({ length: 6 }, wWorker));
      if (!raf) render();
      const queue = order.slice(1);
      const worker = async () => { while (queue.length) { await loadFrame(queue.shift()!); if (raf === 0 && pos !== 0) render(); } };
      await Promise.all(Array.from({ length: 6 }, worker));
    })();
  }
</script>
