---
/*
  Sektion 3 – 1:1 Space Kit (section > .sticky-wrapper: links .sticky-component (50 %, 90vh, sticky top 5vh),
  rechts .sticky-content mit großem Bild und zwei .sticky-text-Blöcken; Bilder mit Parallax).
  Abweichung auf Nutzerwunsch: statt kleinem + mittlerem Bild zwei gleich hohe Bilder nebeneinander,
  statt dem letzten kleinen Bild ein breites, flaches Bild.
  Werte aus dem Original-CSS (spacekit-template.webflow.75a22ccde.css).
  Parallax wie Original (Webflow IX2 „while scrolling in view“): Bild ist 110 % hoch und wandert linear
  von 0 auf −10 %, während sein Rahmen von der Unterkante bis ganz über die Oberkante des Fensters läuft.
  Getauscht: Bilder, Texte.
*/
import { Image } from 'astro:assets';
import imgSticky from '../assets/img/pool-garten-abendsonne.webp';
import imgBig from '../assets/img/pool-wasserfall-whirlpool.webp';
import imgPair1 from '../assets/img/pool-compass-treppe.webp';
import imgPair2 from '../assets/img/pool-holzdeck-rasen.webp';
import imgWide from '../assets/img/pool-rollladen-abdeckung.webp';
---

<section id="pools" class="sticky-section" aria-label="Pools und Technik">
  <div class="sticky-wrapper">
    <div class="sticky-left" data-sticky-left>
      <div class="sticky-component">
        <Image src={imgSticky} alt="Pool mit Naturstein-Rand in einem Garten bei Abendsonne" widths={[800, 1440]} sizes="(max-width: 767px) 100vw, 50vw" />
      </div>
    </div>
    <div class="sticky-content">
      <div class="sticky-big-image">
        <Image src={imgBig} alt="Pool mit Wasserfall und Whirlpool vor einem Holzzaun" widths={[800, 1260]} sizes="(max-width: 767px) 100vw, 50vw" />
      </div>

      <div class="sticky-text">
        <div class="text-weight-medium caps regular-vw-small">Keramik, Fiberglas, Composite</div>
        <div class="content max-width-34vw">
          <h2 class="heading-vw">Pools für Jahrzehnte</h2>
          <div class="sticky-paragraph">
            <p class="regular-vw">Wir arbeiten ausschließlich mit renommierten Herstellern: COMPASS Ceramic Composite, Waterrows, Leisure Pools und Mon de Pra. Die Poolschalen kommen fertig aus dem Werk, mit glatter, pflegeleichter Oberfläche und in vielen Formen und Größen.</p>
            <p class="regular-vw">Auf die Poolschale gibt es je nach Hersteller bis zu 40&nbsp;Jahre Garantie.</p>
          </div>
        </div>
      </div>
      <div class="sticky-pair">
        <div class="sticky-pair-image">
          <Image class="image-parallax" src={imgPair1} alt="COMPASS Keramikpool mit Einstiegstreppe" widths={[500, 900]} sizes="(max-width: 767px) 50vw, 25vw" data-parallax />
        </div>
        <div class="sticky-pair-image">
          <Image class="image-parallax" src={imgPair2} alt="Pool mit Holzdeck im Rasen" widths={[500, 900]} sizes="(max-width: 767px) 50vw, 25vw" data-parallax />
        </div>
      </div>

      <div class="sticky-text" data-sticky-stop>
        <div class="text-weight-medium caps regular-vw-small">Technik &amp; Wasserpflege</div>
        <div class="content">
          <h2 class="heading-vw">Technik, die mitdenkt</h2>
          <div class="sticky-paragraph">
            <p class="regular-vw">Filterpumpe, Filteranlage und Steuerung sitzen fertig verbaut in einer kompakten Technikbox neben dem Pool. Für die Wasserpflege wählen Sie zwischen Salzwasser mit Bayrol Salz-Hydrolyse und klassischer Chlorpflege.</p>
            <p class="regular-vw">Auf Wunsch ergänzen wir Wärmepumpe, Beleuchtung und Abdeckung. Alles aus einer Hand.</p>
          </div>
        </div>
      </div>
      <div class="sticky-wide-image">
        <Image class="image-parallax" src={imgWide} alt="Pool mit Rollladen-Abdeckung in einem Garten" widths={[800, 1440]} sizes="(max-width: 767px) 100vw, 50vw" data-parallax />
      </div>
    </div>
  </div>
</section>

<style>
  .sticky-wrapper { display: flex; gap: 0.5rem; margin-top: 12rem; position: relative; }
  /* Nutzerwunsch: das linke Bild bleibt nur stehen, bis der zweite Textblock oben bündig mit ihm ist –
     danach läuft die ganze Seite weiter. Dafür endet die linke Spalte genau dort (Höhe per Script). */
  .sticky-left { flex: none; width: 50%; align-self: flex-start; }
  .sticky-component { width: 100%; height: 90vh; position: sticky; top: 5vh; bottom: 5vh; overflow: hidden; }
  .sticky-content { display: flex; flex-flow: column; align-items: flex-start; width: 50%; padding-bottom: 20vh; position: relative; }
  .sticky-big-image { width: 100%; height: 90vh; overflow: hidden; }
  .sticky-component :global(img), .sticky-big-image :global(img),
  .sticky-pair-image :global(img), .sticky-wide-image :global(img) {
    display: inline-block; width: 100%; height: 100%; max-width: 100%; object-fit: cover; vertical-align: middle;
  }
  .sticky-text {
    display: flex; flex-flow: column; align-items: flex-start; gap: 2.8vw;
    margin-top: 10vw; margin-left: 4vw; margin-right: 2rem;
  }
  .text-weight-medium { font-weight: 500; }
  .caps { text-transform: uppercase; }
  .regular-vw-small { font-size: 0.8vw; line-height: 1.5; }
  .content { display: flex; flex-flow: column; align-items: flex-start; gap: 1.667vw; max-width: 36vw; }
  .content.max-width-34vw { max-width: 34vw; }
  .heading-vw { margin: 0; font-size: 4.8vw; line-height: 1; font-weight: 400; }
  .sticky-paragraph { display: flex; flex-flow: column; align-items: flex-start; gap: 1vw; max-width: 30vw; }
  .regular-vw { margin: 0; font-size: 1.1vw; line-height: 1.5; }
  /* Nutzerwunsch statt kleinem + mittlerem Bild: zwei gleich hohe Bilder nebeneinander,
     statt letztem kleinen Bild: ein breites, flaches Bild */
  .sticky-pair { display: flex; gap: 0.5rem; width: 100%; margin-top: 7.5vw; }
  .sticky-pair-image { flex: 1; aspect-ratio: 4 / 5; overflow: hidden; }
  .sticky-wide-image { flex: none; width: 100%; aspect-ratio: 16 / 7; margin-top: 7.5vw; overflow: hidden; }
  .sticky-section :global(.image-parallax) { height: 110%; will-change: transform; }
  /* Nutzerwunsch: Bilder mit Radius wie im Rest der Seite (8px) */
  .sticky-component, .sticky-big-image, .sticky-pair-image, .sticky-wide-image { border-radius: 0.5rem; }
  /* Nutzerwunsch (Desktop): Ecken am Bildschirmrand ohne Rundung */
  @media (max-width: 767px) {
    /* Handy: Bilder gehen über die volle Breite → Ecken am Bildschirmrand eckig */
    .sticky-component, .sticky-big-image, .sticky-wide-image { border-radius: 0; }
    .sticky-pair-image:first-child { border-top-left-radius: 0; border-bottom-left-radius: 0; }
    .sticky-pair-image:last-child { border-top-right-radius: 0; border-bottom-right-radius: 0; }
  }
  @media (min-width: 768px) {
    .sticky-component { border-top-left-radius: 0; border-bottom-left-radius: 0; }
    .sticky-big-image, .sticky-pair-image:last-child, .sticky-wide-image { border-top-right-radius: 0; border-bottom-right-radius: 0; }
  }

  @media (max-width: 991px) {
    .regular-vw-small { font-size: 1rem; }
    .sticky-wrapper { margin-top: 8rem; }
    .content, .content.max-width-34vw { max-width: none; gap: 1.5rem; }
    .sticky-paragraph { gap: 1rem; max-width: none; }
    .heading-vw { font-size: 2.7rem; line-height: 1.2; }
    .regular-vw { font-size: 1rem; }
  }
  @media (max-width: 767px) {
    .sticky-wrapper { gap: 2.5rem; flex-flow: column; width: 100%; margin-top: 4rem; }
    .sticky-left { width: 100%; height: auto !important; }
    .sticky-component { width: 100%; height: 50vh; position: relative; }
    /* Nutzerwunsch: großes Bild auf dem Handy im Querformat statt 90vh hoch */
    .sticky-big-image { height: auto; aspect-ratio: 4 / 3; }
    .sticky-content { width: 100%; padding-bottom: 0; }
    .sticky-text { gap: 1rem; margin-top: 4rem; margin-left: 2rem; }
    .sticky-paragraph { max-width: none; }
    .sticky-pair, .sticky-wide-image { margin-top: 4rem; }
    .heading-vw { font-size: 2.5rem; }
  }
  @media (max-width: 479px) {
    .heading-vw { font-size: 2.2rem; }
  }
</style>

<script>
  // Linke Spalte endet, wenn der zweite Textblock oben bündig mit dem stehenden Bild ist
  const left = document.querySelector<HTMLElement>('[data-sticky-left]');
  const stop = document.querySelector<HTMLElement>('[data-sticky-stop]');
  if (left && stop) {
    const fit = () => {
      const pic = left.firstElementChild as HTMLElement;
      const t = stop.getBoundingClientRect().top - left.getBoundingClientRect().top;
      left.style.height = `${Math.round(t + pic.offsetHeight)}px`;
    };
    fit();
    new ResizeObserver(fit).observe(left.parentElement!);
    window.addEventListener('load', fit);
  }

  // Parallax wie Original: 0 % → −10 %, linear, solange der Bildrahmen durchs Fenster läuft
  // + Nutzerwunsch, scroll-gekoppelt:
  //   Aufziehen: linkes Bild und erstes Bild rechts öffnen sich von unten nach oben (wie Sektion 2, aber
  //   nur senkrecht), Ecken bleiben gerundet (am Bildschirmrand eckig).
  //   Einziehen: ab dem Stopp-Punkt zieht sich das breite Bild nach oben weg ein; erreicht seine
  //   Unterkante die des linken Bildes, zieht sich das linke Bild mit nach oben ein.
  const imgs = [...document.querySelectorAll<HTMLElement>('[data-parallax]')];
  const wrap = document.querySelector<HTMLElement>('.sticky-wrapper');
  const pic = document.querySelector<HTMLElement>('.sticky-component');
  const big = document.querySelector<HTMLElement>('.sticky-big-image');
  const wide = document.querySelector<HTMLElement>('.sticky-wide-image');
  if (wrap && pic && big && wide && stop && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const desktop = window.matchMedia('(min-width: 768px)');
    const clamp = (v: number, a = 0, b = 1) => Math.min(b, Math.max(a, v));
    const R = '0.5rem';
    const clip = (el: HTMLElement, top: number, bottom: number, edge: 'left' | 'right') => {
      // Ecken am Bildschirmrand eckig: Handy volle Breite (alle), Desktop je nach Seite
      const round = !desktop.matches ? '0' : edge === 'left' ? `0 ${R} ${R} 0` : `${R} 0 0 ${R}`;
      el.style.clipPath = `inset(${top.toFixed(1)}px 0 ${bottom.toFixed(1)}px 0 round ${round})`;
    };
    // Aufziehen: Fortschritt, während die Oberkante vom unteren Fensterrand bis 20 % Höhe läuft
    const reveal = (el: HTMLElement, top: number, vh: number) => {
      const p = clamp((vh - top) / (0.8 * vh));
      const e = 1 - Math.pow(1 - p, 3);
      const h = el.offsetHeight;
      const img = el.querySelector<HTMLElement>('img');
      if (img) { img.style.transformOrigin = '50% 100%'; img.style.scale = String(1.15 - 0.15 * e); }
      return h * (1 - e);
    };
    let ticking = false;
    const update = () => {
      ticking = false;
      const vh = window.innerHeight;
      const y = window.scrollY;
      for (const img of imgs) {
        const r = img.parentElement!.getBoundingClientRect();
        const p = clamp((vh - r.top) / (vh + r.height));
        img.style.transform = `translate3d(0, ${(-10 * p).toFixed(3)}%, 0)`;
      }
      const wr = wrap.getBoundingClientRect();
      const pr = pic.getBoundingClientRect();
      const br = big.getBoundingClientRect();
      // Aufziehen (links am Anfang an der Oberkante der Sektion ausgerichtet wie rechts)
      const topPic = reveal(pic, desktop.matches ? wr.top : pr.top, vh);
      const topBig = reveal(big, br.top, vh);
      // Einziehen (nur Desktop): Linie in Seitenkoordinaten wandert von Unterkante breites Bild bis Oberkante linkes Bild
      let botPic = 0, botWide = 0;
      if (desktop.matches) {
        const s0 = stop.getBoundingClientRect().top + y - 0.05 * vh;
        const q = clamp((y - s0) / (0.75 * vh));
        if (q > 0) {
          const wdr = wide.getBoundingClientRect();
          const wTop = wdr.top + y, wBot = wdr.bottom + y;
          const pTop = pr.top + y, pBot = pr.bottom + y;
          const line = wBot - (wBot - pTop) * q;
          botWide = wBot - clamp(line, wTop, wBot);
          botPic = pBot - clamp(line, pTop, pBot);
        }
      }
      clip(pic, topPic, botPic, 'left');
      clip(big, topBig, 0, 'right');
      clip(wide, 0, botWide, 'right');
    };
    const onScroll = () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } };
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    update();
  }
</script>
