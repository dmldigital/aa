{
  "enabledMcpjsonServers": [
    "playwright",
    "chrome-devtools"
  ],
  "permissions": {
    "allow": [
      "mcp__playwright",
      "mcp__chrome-devtools",
      "Bash(npx -y dembrandt@latest:*)",
      "Bash(npx skillui:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/mcp/browser-trust.sh"
          }
        ]
      }
    ]
  }
}
