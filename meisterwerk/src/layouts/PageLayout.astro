---
import Layout from './Layout.astro';
import Header from '../components/sections/Header.astro';
import Menu from '../components/sections/Menu.astro';
import FloatingMenu from '../components/sections/FloatingMenu.astro';
import Footer from '../components/sections/Footer.astro';
import type { Site } from '../data/nav';
import { composeTitle } from '../lib/seo';

interface Props {
  title: string;
  description?: string;
  /** Canonical-Pfad, falls nicht die Seite selbst (sonst regelt `lib/seo.ts` die Ausnahmen) */
  canonical?: string;
  /** Pfad der Seite (wie auf der alten Seite, z. B. /services/malerarbeiten/), markiert den Menüpunkt. */
  current?: string;
  /** Auftritt: Hauptseite (Standard) oder Teil-Website „Meisterwerke Exklusive“ mit eigenem Kopf und Fuß. */
  site?: Site;
  /** Seite mit eigenem Hero (Startseite): Der Hero bringt die Kopfzeile selbst mit. */
  hero?: boolean;
}

const { title, description, canonical, current = '/', site = 'main', hero = false } = Astro.props;
---

<Layout title={composeTitle(title, site)} {description} {canonical} {site}>
  {!hero && <Header {site} />}
  <FloatingMenu {site} />
  <Menu {site} {current} />
  <main>
    <slot />
  </main>
  <Footer {site} />
</Layout>
