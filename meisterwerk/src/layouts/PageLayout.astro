---
import Layout from './Layout.astro';
import Header from '../components/sections/Header.astro';
import Menu from '../components/sections/Menu.astro';
import SmartHeader from '../components/sections/SmartHeader.astro';
import Vergleich from '../components/sections/Vergleich.astro';
import Footer from '../components/sections/Footer.astro';
import type { Site } from '../data/nav';

interface Props {
  title: string;
  description?: string;
  /** Pfad der Seite (wie auf der alten Seite, z. B. /services/malerarbeiten/), markiert den Menüpunkt. */
  current?: string;
  /** Auftritt: Hauptseite (Standard) oder Teil-Website „Meisterwerke Exklusive“ mit eigenem Kopf und Fuß. */
  site?: Site;
  /** Seite mit eigenem Hero (Startseite): Der Hero bringt die Kopfzeile selbst mit. */
  hero?: boolean;
}

const { title, description, current = '/', site = 'main', hero = false } = Astro.props;
---

<Layout {title} {description}>
  {!hero && <Header {site} />}
  <SmartHeader {site} />
  <Menu {site} {current} />
  <Vergleich />
  <main>
    <slot />
  </main>
  <Footer {site} />
</Layout>
