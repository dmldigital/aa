---
import { Font } from 'astro:assets';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
// Vorschau-Builds sind für Suchmaschinen gesperrt. Für den Livegang: PUBLIC_INDEXABLE=true beim Build setzen.
const noindex = import.meta.env.PUBLIC_INDEXABLE !== 'true';
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.png`} />
    <Font cssVariable="--font-urbanist" preload />
    <script is:inline>
      document.documentElement.classList.add('js');
      // Vergleich der Varianten (Menü, Kopfzeile): per ?menu=2&header=2 oder zuletzt gewählt, vorübergehend
      try {
        const q = new URLSearchParams(location.search);
        for (const key of ['menu', 'header']) {
          const v = q.get(key) || localStorage.getItem('compare-' + key);
          if (v) document.documentElement.dataset[key] = v;
        }
      } catch {}
    </script>
  </head>
  <body>
    <slot />
    <script>
      import '../scripts/motion';
      import '../scripts/accordion';
    </script>
  </body>
</html>
