---
import { href } from '../../data/links';
/**
 * Akkordeon mit Text-Link und Bild (Original a59ae57 der Exklusiv-Seiten): links Akkordeon und „Jetzt beraten lassen!“,
 * rechts ein Bild (Handy: Bild oben). Der erste Eintrag ist geöffnet.
 */
import { Picture } from 'astro:assets';
import Icon from '../Icon.astro';
import ArrowLink from '../ui/ArrowLink.astro';
import { rich } from '../../lib/rich';

interface Props {
  id?: string;
  items: { title: string; html: string; open: boolean }[];
  button: { label: string; href: string };
  img: ImageMetadata;
  alt?: string;
  rootClass?: string;
  /** Innenabstand des Containers */
  innerClass?: string;
  leftClass?: string;
  rightClass?: string;
  /** Breite des Bildes (Standard: feste Breite wie im Original) */
  imageClass?: string;
}
const {
  id = 'a59ae57',
  items,
  button,
  img,
  alt = '',
  rootClass = '',
  innerClass = 'lg:py-0',
  leftClass = 'md:w-[39.4%]',
  rightClass = 'md:w-[58.7%] lg:w-[59.2%]',
  imageClass = 'w-77.5 md:w-75 lg:w-180',
} = Astro.props;
---

<section data-section={id} class:list={['px-5 lg:px-7.5', rootClass]}>
  <div
    class:list={[
      'mx-auto w-full max-w-mobile py-10 md:max-w-tablet md:py-15 lg:max-w-page',
      innerClass,
    ]}
  >
    <div class="flex flex-wrap items-end justify-between gap-5 md:flex-nowrap">
      <div
        class:list={[
          'flex w-full flex-col justify-between gap-5 max-md:order-last lg:gap-13.5',
          leftClass,
        ]}
      >
        <div data-accordion data-accordion-ease="power1.inOut" class="-mt-4 md:mt-0">
          {items.map((item, i) => (
            <div>
              <button
                type="button"
                id={`feat-q-${i}`}
                aria-expanded={item.open ? 'true' : 'false'}
                aria-controls={`feat-a-${i}`}
                class="group/acc flex w-full cursor-pointer items-center justify-between gap-x-2.5 border-b border-black/20 py-4 text-left font-display text-[19px]/[24.7px] font-medium text-[#1f2124] md:py-3.75 md:text-h5 lg:py-5.5 lg:text-h4"
              >
                <span>{item.title}</span>
                <span class="flex shrink-0 items-center">
                  <Icon name="plus" class="size-3.75 group-aria-expanded/acc:hidden" />
                  <Icon name="minus" class="hidden size-3.75 group-aria-expanded/acc:block" />
                </span>
              </button>
              <div
                id={`feat-a-${i}`}
                role="region"
                aria-labelledby={`feat-q-${i}`}
                hidden={!item.open}
                class="border-b border-black/20 pt-8 pr-0 pb-4 md:pt-7.5 md:pb-3.75 lg:pr-7.5"
              >
                <div class:list={['text-body', rich]} set:html={item.html} />
              </div>
            </div>
          ))}
        </div>
        <div class="text-[16px]/[24px]">
          <ArrowLink href={href(button.href)} tone="black">
            {button.label}
          </ArrowLink>
        </div>
      </div>
      <div class:list={['flex w-full justify-end px-5 lg:px-7.5', rightClass]}>
        <div class:list={['overflow-hidden', imageClass]} data-anim="fadeIn" data-anim-delay="100">
          <Picture
            formats={['avif']}
            fallbackFormat="webp"
            src={img}
            {alt}
            widths={[310, 620, 720, 1440]}
            sizes="(min-width: 1025px) 720px, (min-width: 768px) 300px, 310px"
            loading="lazy"
            class="block h-auto w-full"
          />
        </div>
      </div>
    </div>
  </div>
</section>
