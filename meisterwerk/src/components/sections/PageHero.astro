---
/**
 * Kopfbereich der Leistungsseiten (Original 16ee660): große Überschrift mit Text links, hochkantes Bild rechts
 * (Handy: Bild oben, Text darunter).
 */
import { Picture } from 'astro:assets';

interface Props {
  id?: string;
  title: string;
  text: string;
  img: ImageMetadata;
  alt: string;
}
const { id = '16ee660', title, text, img, alt } = Astro.props;
---

<section
  data-section={id}
  class="mb-10 overflow-hidden px-5 md:mb-15 md:min-h-screen lg:mb-27 lg:px-7.5"
>
  <div class="mx-auto flex w-full max-w-mobile flex-col gap-5 md:max-w-tablet md:min-h-[inherit] md:flex-row md:gap-7.5 lg:max-w-page">
    <div class="order-2 flex flex-col items-start justify-center gap-3.75 md:order-1 md:min-w-0 md:flex-1 md:gap-5 lg:w-[48.99%] lg:flex-none lg:pr-[8%]">
      <h1
        class="font-display text-h1 font-medium text-ink lg:mb-5"
        data-anim="fadeInLeft"
      >
        {title}
      </h1>
      <p class="text-body lg:w-4/5">{text}</p>
    </div>
    <div class="order-1 overflow-hidden md:order-2 md:h-[calc(100vh-50px)] md:min-w-0 md:flex-1 md:self-start">
      <Picture
        formats={['avif']}
        fallbackFormat="webp"
        src={img}
        {alt}
        widths={[477, 700, 1000, 1400]}
        sizes="(min-width: 1025px) 674px, (min-width: 768px) 477px, calc(100vw - 40px)"
        loading="eager"
        fetchpriority="high"
        class="block h-auto w-full object-cover object-[50%_0%] md:h-full"
      />
    </div>
  </div>
</section>
