---
import Button from '../ui/Button.astro';
import { href, routes } from '../../data/links';
import ProjectCard from '../ui/ProjectCard.astro';
import { projects as homeProjects } from '../../data/projects';

/**
 * Projekte-Reihe (Original 3472c30). Ohne Props: Startseite, drei Projekte nebeneinander (Handy untereinander), darunter
 * der Link „Weitere Projekte“. Kein Karussell (Vorgabe des Nutzers).
 */
interface Props {
  id?: string;
  heading?: string;
  /** Ziel von „Weitere Projekte“ */
  link?: string;
  linkLabel?: string;
  projects?: { title: string; href: string; img: ImageMetadata; alt: string }[];
  /** Anzahl der gezeigten Projekte */
  count?: number;
  /** Außenabstände der Sektion */
  rootClass?: string;
  headingTag?: 'h2' | 'h3';
  /** Hintergrund der Sektion (Weiß und Hellgrau wechseln sich ab) */
  tone?: 'white' | 'soft';
  headingClass?: string;
  linkTone?: 'gold' | 'black';
}
const {
  id = '3472c30',
  heading = 'Unsere Exklusive Projekte',
  link = routes.projects,
  linkLabel = 'Weitere Projekte',
  projects = homeProjects,
  count = 3,
  rootClass = '',
  tone = 'white',
  headingTag: Heading = 'h2',
  headingClass = 'text-h2 text-gold',
  linkTone = 'gold',
} = Astro.props;
const CardTitle = Heading === 'h2' ? 'h3' : 'h4';
---

<section
  data-section={id}
  class:list={['flex flex-col overflow-x-clip px-page py-section', tone === 'soft' ? 'bg-soft' : 'bg-white', rootClass]}
>
  <div class="mx-auto flex w-full max-w-page grow flex-col gap-3.75 lg:gap-5">
    <div class="mb-1.25 lg:mb-5">
      <Heading class:list={['font-display', headingClass]}>{heading}</Heading>
    </div>

    <div class="grid grid-cols-1 gap-x-5 gap-y-10 md:grid-cols-3">
      {projects.slice(0, count).map((p) => (
        <ProjectCard project={p} reveal instant lazy titleTag={CardTitle} />
      ))}
    </div>

    <div class="mt-5">
      <Button href={href(link)}>
        {linkLabel}
      </Button>
    </div>
  </div>
</section>
