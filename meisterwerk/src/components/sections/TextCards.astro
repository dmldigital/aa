---
/**
 * Drei Textkarten nebeneinander (Original 797793f auf /meisterwerk-exklusive/): Überschrift und Fließtext auf einer
 * Fläche ohne Rahmen. Auf dem Handy untereinander.
 */
interface Props {
  id?: string;
  cards: { title: string; text: string }[];
  /** Hintergrund der Sektion (Weiß und Hellgrau wechseln sich ab); die Karten haben die jeweils andere Fläche */
  tone?: 'white' | 'soft';
  rootClass?: string;
}
const { id = '797793f', cards, tone = 'white', rootClass = '' } = Astro.props;
---

<section data-section={id} class:list={['px-page py-section', tone === 'soft' ? 'bg-soft' : 'bg-white', rootClass]}>
  <div class="mx-auto grid w-full max-w-page grid-cols-1 gap-5 md:grid-cols-3">
    {cards.map((card) => (
      <div
        class:list={['flex flex-col gap-4 p-6 text-ink md:p-8', tone === 'soft' ? 'bg-white' : 'bg-soft']}
        data-anim="fadeIn"
        data-anim-delay="100"
      >
        <h3 class="font-display text-h4 font-medium">
          {card.title}
        </h3>
        <p class="text-body">{card.text}</p>
      </div>
    ))}
  </div>
</section>
