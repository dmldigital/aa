---
import { href } from '../../data/links';
import { footers } from '../../data/footer';
import type { Site } from '../../data/nav';
import Badge from '../footer/Badge.astro';
import Contact from '../footer/Contact.astro';
import Copyright from '../footer/Copyright.astro';
import Frage from '../footer/Frage.astro';
import Legal from '../footer/Legal.astro';
import Logos from '../footer/Logos.astro';
import Social from '../footer/Social.astro';
import ToTop from '../footer/ToTop.astro';
/**
 * Fußbereich (Original: Elementor-Container 80dbe99), Inhalte wie im Original: Kontaktaufruf, Bewertungs-Badge,
 * Logos, Social Media, Kontaktdaten, rechtliche Links, Pfeil nach oben und der schwebende Link "Projekt starten".
 * Ab Tablet vier Spalten in einer Zeile (Überschrift, Badge, Logo mit Kontakt, zweites Logo mit Links) und eine
 * schmale Leiste; auf dem Handy eine Spalte in anderer Reihenfolge (die Spalten lösen sich per `contents` auf).
 */
interface Props {
  /** Auftritt: Hauptseite oder Teil-Website „Meisterwerke Exklusive“ (eigene Links, Logos, ohne Bewertungs-Badge). */
  site?: Site;
}
const { site = 'main' } = Astro.props;
const f = footers[site];
const line =
  'block h-px w-full origin-center bg-black/20 transition-transform duration-[1400ms] ease-css not-motion-reduce:scale-x-0 not-motion-reduce:data-[in]:scale-x-100 md:hidden';
---

<footer data-section="80dbe99" class="relative z-10 overflow-x-clip bg-white">
  <!-- Trennlinie, enthält den schwebenden Link "Projekt starten" -->
  <div class="border-b border-black/20">
    <a
      href={href(f.contactHref)}
      data-floating-cta
      class="group/cta invisible fixed bottom-7.5 left-7.5 z-[9999] inline-block -translate-x-[50px] border border-black bg-white px-6 py-2 text-center text-14 text-black md:leading-[22.5px] opacity-0 shadow-[0_2px_8px_rgb(0_0_0/0.1)] transition-all duration-300 ease-[ease] hover:-translate-y-px hover:bg-black hover:shadow-[0_4px_12px_rgb(0_0_0/0.15)] data-[show]:visible data-[show]:translate-x-0 data-[show]:opacity-100 max-[768px]:bottom-5 max-[768px]:left-5 max-[768px]:px-5 max-[768px]:py-1.5 max-[768px]:text-13 max-[480px]:px-4.5 max-[480px]:py-1.25 max-[480px]:text-[12px]"
    >
      <span class="text-black transition-colors duration-300 group-hover/cta:text-white">
        Projekt starten
      </span>
    </a>
  </div>

  <div class="px-5 pt-8 pb-5 lg:px-7.5">
    <div class="mx-auto flex w-full max-w-[min(100%,767px)] flex-col gap-6 md:grid md:max-w-[min(100%,1024px)] md:grid-cols-6 md:gap-x-5 md:gap-y-8 lg:max-w-[min(100%,1700px)] lg:grid-cols-12">
      <div
        data-anim="fadeInUp"
        data-anim-mobile="fadeInLeft"
        class="order-2 md:order-none md:col-span-3 lg:col-span-5"
      >
        <Frage {site} />
      </div>
      <span data-line class={`${line} order-3`}></span>
      <div
        data-anim="fadeInUp"
        data-anim-delay="120"
        data-anim-mobile="fadeInUp"
        class="order-6 md:order-none md:col-span-3 lg:col-span-2"
      >
        {f.badge && <Badge />}
      </div>
      <div
        class="contents md:col-span-3 md:flex md:flex-col md:gap-3 lg:col-span-3"
        data-anim="fadeInUp"
        data-anim-delay="240"
        data-anim-mobile="none"
      >
        <Logos {site} which="main" wrapperClass="order-1 md:order-none" class="w-44.5" />
        <Contact {site} class="order-4 gap-1.5 md:order-none" />
        <Social class="order-5 -ml-2.5 md:order-none" />
      </div>
      <div
        class="contents md:col-span-3 md:flex md:flex-col md:gap-3 lg:col-span-2"
        data-anim="fadeInUp"
        data-anim-delay="360"
        data-anim-mobile="none"
      >
        <Logos {site} which="other" wrapperClass="order-9 md:order-none" class="w-44.5" />
        <Legal
          {site}
          copyright={false}
          class="order-7 flex-wrap gap-x-5 gap-y-2 md:order-none md:flex-col md:gap-2.5"
        />
      </div>
      <div class="order-8 flex items-center justify-between gap-4 md:order-none md:col-span-full md:border-t md:border-black/20 md:pt-4">
        <Copyright />
        <ToTop />
      </div>
    </div>
  </div>
</footer>

<script>
  import { lenis } from '../../scripts/motion';

  // Pfeil nach oben
  document.querySelectorAll<HTMLElement>('[data-to-top]').forEach((el) =>
    el.addEventListener('click', (e) => {
      e.preventDefault();
      if (lenis) lenis.scrollTo(0);
      else window.scrollTo({ top: 0, behavior: 'smooth' });
    }),
  );

  // Schwebender Link "Projekt starten": erscheint nach 100vh Scrollen und verschwindet wieder
  // 100vh (Handy bis 768 px: 150vh) vor dem Seitenende, wie im Original
  const cta = document.querySelector<HTMLElement>('[data-floating-cta]');
  if (cta) {
    const update = () => {
      const h = window.innerHeight;
      const y = window.scrollY;
      const hideDistance = window.innerWidth <= 768 ? h * 1.5 : h;
      const nearEnd = y + h > document.documentElement.scrollHeight - hideDistance;
      cta.toggleAttribute('data-show', y > h && !nearEnd);
    };
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();
  }

  // Linien zeichnen sich beim Hereinscrollen
  const lineObserver = new IntersectionObserver(
    (entries) =>
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.setAttribute('data-in', '');
          lineObserver.unobserve(entry.target);
        }
      }),
    { threshold: 1 },
  );
  document.querySelectorAll('[data-line]').forEach((line) => lineObserver.observe(line));
</script>
