                </svg>
              </a>
            </li>
            <li>
              <a
                href="https://www.facebook.com/Meisterwerk2014/"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Facebook"
                class={social}
              >
                <svg
                  viewBox="0 0 320 512"
                  fill="currentColor"
                  aria-hidden="true"
                  class="block h-4 w-2.5"
                >
                  <path d="M279.14 288l14.22-92.66h-88.91v-60.13c0-25.35 12.42-50.06 52.24-50.06h40.42V6.26S260.43 0 225.36 0c-73.22 0-121.08 44.38-121.08 124.72v70.62H22.89V288h81.39v224h100.17V288z" />
                </svg>
              </a>
            </li>
          </ul>
        </div>
        <div>
          <a href={`mailto:${site.email}`} class={contactLink}>
            <span class="flex justify-center gap-1.25">
              <span class="underline-anim [--underline-gap:3px]">{site.email}</span>
            </span>
          </a>
        </div>
        <div>
          <a href={`tel:${site.phoneHref}`} class={contactLink}>
            <span class="flex justify-center gap-1.25">
              <span class="underline-anim [--underline-gap:3px]">{site.phone}</span>
            </span>
          </a>
        </div>
        <div class="w-57.5 max-w-full lg:mb-5">
          <div class="font-display text-label font-medium tracking-label text-ink uppercase">
            <a href={site.mapsUrl} target="_blank" rel="noopener noreferrer" class={smallLink}>
