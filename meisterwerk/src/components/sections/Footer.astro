---
import Button from '../ui/Button.astro';
import { href } from '../../data/links';
import { footers } from '../../data/footer';
import type { Site } from '../../data/nav';
import Badge from '../footer/Badge.astro';
import Contact from '../footer/Contact.astro';
import Copyright from '../footer/Copyright.astro';
import Frage from '../footer/Frage.astro';
import Legal from '../footer/Legal.astro';
import Logos from '../footer/Logos.astro';
import Social from '../footer/Social.astro';
import ToTop from '../footer/ToTop.astro';
/**
 * Fußbereich (Original: Elementor-Container 80dbe99), Inhalte wie im Original: Kontaktaufruf, Bewertungs-Badge,
 * Logos, Social Media, Kontaktdaten, rechtliche Links, Pfeil nach oben und der schwebende Button "Projekt starten"
 * (Sticker). Wann der Sticker wegbleibt, steht im Skript unten.
 * Ab Tablet vier Spalten in einer Zeile (Überschrift, Badge, Logo mit Kontakt, zweites Logo mit Links) und eine
 * schmale Leiste; auf dem Handy eine Spalte in anderer Reihenfolge (die Spalten lösen sich per `contents` auf).
 */
interface Props {
  /** Auftritt: Hauptseite oder Teil-Website „Meisterwerke Exklusive“ (eigene Links, Logos, ohne Bewertungs-Badge). */
  site?: Site;
}
const { site = 'main' } = Astro.props;
const f = footers[site];
---

<footer data-section="80dbe99" class="relative z-10 overflow-x-clip bg-white">
  <!-- Trennlinie, enthält den schwebenden Button "Projekt starten" (derselbe Button wie überall) -->
  <div>
    <Button
      href={href(f.contactHref)}
      data-floating-cta
      inert
      class="invisible fixed bottom-7.5 left-7.5 z-[9999] origin-bottom-left -translate-x-5 translate-y-1.5 scale-95 opacity-0 transition-[translate,scale,opacity,visibility,background-color] duration-[380ms] ease-[cubic-bezier(0.4,0,0.2,1)] data-[show]:visible data-[show]:translate-x-0 data-[show]:translate-y-0 data-[show]:scale-100 data-[show]:opacity-100 data-[show]:duration-[700ms] data-[show]:ease-[cubic-bezier(0.22,1,0.36,1)] max-[768px]:bottom-5 max-[768px]:left-5"
    >
      Projekt starten
    </Button>
  </div>

  <div class="px-page pt-section pb-stack md:pt-group lg:px-7.5">
    <div class="mx-auto grid w-full max-w-[min(100%,767px)] grid-cols-2 gap-x-stack gap-y-group md:max-w-[min(100%,1024px)] md:grid-cols-6 lg:max-w-[min(100%,1700px)] lg:grid-cols-12">
      <div class="order-1 col-span-2 md:order-none md:col-span-3 lg:col-span-4 min-[1300px]:col-span-5">
        <Frage {site} />
      </div>
      <div
        data-anim="fadeInUp"
        data-anim-delay="120"
        data-anim-mobile="fadeInUp"
        class="order-3 col-span-1 self-center md:order-none md:col-span-3 md:self-auto lg:col-span-2"
      >
        {f.badge && <Badge />}
      </div>
      <div
        class="order-2 col-span-2 flex flex-col gap-stack bg-soft p-inner md:order-none md:col-span-3 md:gap-3 md:bg-transparent md:p-0 lg:col-span-3"
        data-anim="fadeInUp"
        data-anim-delay="240"
        data-anim-mobile="fadeInUp"
      >
        <Logos {site} which="main" class="w-36 md:w-44.5" />
        <Contact {site} class="gap-4 md:gap-1.5" />
        <Social class="-ml-2.5 -mt-2 md:mt-0" />
      </div>
      <div
        class="contents md:col-span-3 md:flex md:flex-col md:gap-3 lg:col-span-3 min-[1300px]:col-span-2"
        data-anim="fadeInUp"
        data-anim-delay="360"
        data-anim-mobile="none"
      >
        <Logos {site} which="other" wrapperClass="order-3 col-span-1 self-center justify-self-end md:order-none md:self-auto md:justify-self-auto" class="w-32 md:w-44.5" />
        <Legal
          {site}
          copyright={false}
          class="order-4 col-span-2 gap-x-5 gap-y-3 max-md:grid max-md:grid-cols-2 md:order-none md:flex-col md:gap-2.5"
        />
      </div>
      <div
        data-anim="fadeIn"
        data-anim-delay="1000"
        data-anim-dur="fast"
        class="order-5 col-span-2 flex items-center justify-between gap-4 md:order-none md:col-span-full md:pt-group"
      >
        <Copyright />
        <ToTop />
      </div>
    </div>
  </div>
</footer>

<script>
  import { lenis } from '../../scripts/motion';

  // Pfeil nach oben
  document.querySelectorAll<HTMLElement>('[data-to-top]').forEach((el) =>
    el.addEventListener('click', (e) => {
      e.preventDefault();
      if (lenis) lenis.scrollTo(0);
      else window.scrollTo({ top: 0, behavior: 'smooth' });
    }),
  );

  /*
   * Schwebender Button „Projekt starten“ (Sticker). Er erscheint nach 100vh Scrollen (auf der Startseite nach dem Hero)
   * und bleibt weg,
   *  - kurz vor dem Seitenende (100vh, Handy 150vh), dort steht der Kontaktaufruf im Fuß,
   *  - auf den Kontaktseiten selbst und in Bereichen mit `data-cta-off` (eigener Kontaktaufruf oder Formular),
   *  - bei geöffnetem Menü oder Großansicht,
   *  - solange er ein Bild, einen Button, ein Formularfeld oder eine Überschrift verdecken würde.
   * Er blendet sofort aus, kommt aber erst nach 0,35 s ohne Konflikt wieder, damit er beim Scrollen nicht flackert.
   */
  const cta = document.querySelector<HTMLElement>('[data-floating-cta]');
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  if (cta) {
    const here = location.pathname.replace(/\/$/, '');
    const own = new URL(cta.getAttribute('href') ?? '', location.href).pathname.replace(/\/$/, '');
    const offZones = [...document.querySelectorAll<HTMLElement>('[data-cta-off]')];
    const PROTECT = 'img,picture,video,svg,a,button,input,textarea,select,label,summary,h1,h2,h3,h4,h5,h6';
    let on = false;
    let timer = 0;

    const set = (visible: boolean) => {
      if (visible === on) return;
      on = visible;
      cta.toggleAttribute('data-show', visible);
      cta.inert = !visible;
    };
    const allowed = () => {
      if (here === own) return false;
      if (document.querySelector('dialog[open], [data-gallery-lightbox]:not([hidden]), [data-lb]:not([hidden])')) return false;
      const h = window.innerHeight;
      const y = window.scrollY;
      const hideDistance = window.innerWidth <= 768 ? h * 1.5 : h;
      if (y + h > document.documentElement.scrollHeight - hideDistance) return false;
      // Auf der Startseite erst nach dem Hero (er ist mehrere Bildschirme hoch)
      if (y <= Math.max(h, hero ? hero.offsetTop + hero.offsetHeight : 0)) return false;
      return !offZones.some((z) => {
        const r = z.getBoundingClientRect();
        return r.top < h && r.bottom > 0;
      });
    };
    // Würde der Sticker etwas Wichtiges verdecken? Prüft sechs Punkte auf seiner Fläche.
    const covers = () => {
      const cs = getComputedStyle(cta);
      const w = cta.offsetWidth;
      const hgt = cta.offsetHeight;
      const left = parseFloat(cs.left);
      const top = window.innerHeight - parseFloat(cs.bottom) - hgt;
      const pts: [number, number][] = [
        [left + 3, top + 3],
        [left + w - 3, top + 3],
        [left + 3, top + hgt - 3],
        [left + w - 3, top + hgt - 3],
        [left + w / 2, top + hgt / 2],
        [left + w / 2, top + 3],
      ];
      return pts.some(([x, yy]) => {
        const el = document
          .elementsFromPoint(x, yy)
          .find((e) => !cta.contains(e) && !e.closest('[data-smart-header]') && e !== document.documentElement && e !== document.body);
        return !!el?.closest(PROTECT);
      });
    };
    const free = () => allowed() && !covers();
    const update = () => {
      if (!free()) {
        window.clearTimeout(timer);
        timer = 0;
        set(false);
        return;
      }
      if (!on && !timer)
        timer = window.setTimeout(() => {
          timer = 0;
          if (free()) set(true);
        }, 350);
    };
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    document.addEventListener('keyup', update);
    new MutationObserver(update).observe(document.documentElement, { attributes: true, attributeFilter: ['style', 'class'] });
    update();
  }

  // Linien zeichnen sich beim Hereinscrollen
  const lineObserver = new IntersectionObserver(
    (entries) =>
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.setAttribute('data-in', '');
          lineObserver.unobserve(entry.target);
        }
      }),
    { threshold: 1 },
  );
  document.querySelectorAll('[data-line]').forEach((line) => lineObserver.observe(line));
</script>
