  <!-- Pfeil nach oben -->
  <div class="mb-7.5 px-5 lg:mb-11.25 lg:px-7.5">
    <div class="mx-auto w-full max-w-[min(100%,767px)] text-right md:max-w-page md:text-left">
      <a
        href="#"
        data-to-top
        aria-label="Nach oben"
        class="relative top-0.5 inline-block bg-white pr-[0.5px] font-display text-[15px] leading-[16.5px] font-semibold tracking-button text-black"
      >
        <span class="flex justify-center gap-1.25">
          <span class="flex items-center">
            <svg
              viewBox="0 0 1024 1024"
              fill="currentColor"
              aria-hidden="true"
              class="block size-3.75"
            >
              <path
                transform="matrix(1 0 0 -1 0 960)"
                d="M533.614 951.047c-11.936 11.936-31.289 11.936-43.227 0l-427.942-427.942c-11.936-11.936-11.936-31.289 0-43.227s31.289-11.936 43.227 0l387.698 387.611-0.048-900.925c0-16.88 13.685-30.565 30.565-30.565s30.565 13.685 30.565 30.565l0.039 877.237 363.837-363.923c10.61-10.61 27.080-11.789 38.993-3.536l4.233 3.536c11.936 11.936 11.936 31.289 0 43.227l-427.942 427.942z"
              ></path>
