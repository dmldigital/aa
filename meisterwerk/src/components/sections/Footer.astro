          </div>
        </div>
        <div class="w-57.5 max-w-full">
          <div class={smallText}>
            <a
              href={href(routes.imprint)}
              target="_blank"
              rel="noopener noreferrer"
              class={smallLink}
            >
              Impressum
            </a>
          </div>
        </div>
        <div class="w-57.5 max-w-full">
          <div class={smallText}>
            <a
              href={href(routes.privacy)}
              target="_blank"
              rel="noopener noreferrer"
              class={smallLink}
            >
              Datenschutzerklärung
            </a>
          </div>
        </div>
        <div class="w-57.5 max-w-full">
          <div class={smallText}>
            <a
              href={href(routes.privacy)}
              target="_blank"
              rel="noopener noreferrer"
              class={smallLink}
            >
              Cookie-Einstellungen
            </a>
          </div>
        </div>
        <div class="w-57.5 max-w-full">
          <div class="font-display text-label font-medium tracking-label text-ink uppercase">
            <a href="#" class={smallLink}>
              © 2026 Meisterwerke
