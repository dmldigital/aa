              </div>
            </div>
          </div>
          <a
            href="https://share.google/DnitNH9jIeNPjNxgP"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Google-Bewertungen ansehen"
            class="absolute inset-0 z-[5]"
          ></a>
        </div>
      </div>

      <!-- Spalte 3: Logo, Social Media, Kontakt, rechtliche Links -->
      <div class="flex w-full min-w-0 flex-col gap-5 md:w-[40%]">
        <div data-anim="slideInDown" class="overflow-hidden">
          <a
            href={href(routes.home)}
            class="block"
            aria-label="Meisterwerk Malermanufaktur, zur Startseite"
          >
            <Picture
              formats={['avif', 'webp']}
              src={logo}
              alt="Meisterwerk Malermanufaktur by Baldasarre Fortino"
              widths={[228, 456]}
              sizes="(min-width: 1025px) 178px, 228px"
              class="h-auto w-[65%] md:w-[80%]"
            />
          </a>
        </div>
        <div class="md:-ml-2.5">
          <ul class="inline-grid grid-cols-[repeat(4,auto)] justify-center gap-x-5">
            <li>
              <a
                href="https://www.instagram.com/maler.meisterwerk/"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Instagram"
                class={social}
