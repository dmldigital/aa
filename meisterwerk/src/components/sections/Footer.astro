---
import { href } from '../../data/links';
import { footers } from '../../data/footer';
import type { Site } from '../../data/nav';
import Variante1 from '../footer/Variante1.astro';
import Variante2 from '../footer/Variante2.astro';
import Variante3 from '../footer/Variante3.astro';
/**
 * Fußbereich (Original: Elementor-Container 80dbe99), Inhalte wie im Original: Kontaktaufruf, Bewertungs-Badge,
 * Logos, Social Media, Kontaktdaten, rechtliche Links, Pfeil nach oben und der schwebende Link "Projekt starten".
 * Zum Vergleich gibt es drei kompakte Anordnungen (`footer/Variante1…3`), umschaltbar unten rechts
 * (auch per `?footer=1` bis `3`). Nach der Entscheidung bleibt eine Variante, Umschalter und Rest entfallen.
 */
interface Props {
  /** Auftritt: Hauptseite oder Teil-Website „Meisterwerke Exklusive“ (eigene Links, Logos, ohne Bewertungs-Badge). */
  site?: Site;
}
const { site = 'main' } = Astro.props;
const f = footers[site];
const variants = [Variante1, Variante2, Variante3];
---

<footer data-section="80dbe99" class="relative z-10 overflow-x-clip bg-white">
  <!-- Trennlinie, enthält den schwebenden Link "Projekt starten" -->
  <div class="border-b border-black/20">
    <a
      href={href(f.contactHref)}
      data-floating-cta
      class="group/cta invisible fixed bottom-7.5 left-7.5 z-[9999] inline-block -translate-x-[50px] border border-black bg-white px-6 py-2 text-center text-14 text-black md:leading-[22.5px] opacity-0 shadow-[0_2px_8px_rgb(0_0_0/0.1)] transition-all duration-300 ease-[ease] hover:-translate-y-px hover:bg-black hover:shadow-[0_4px_12px_rgb(0_0_0/0.15)] data-[show]:visible data-[show]:translate-x-0 data-[show]:opacity-100 max-[768px]:bottom-5 max-[768px]:left-5 max-[768px]:px-5 max-[768px]:py-1.5 max-[768px]:text-13 max-[480px]:px-4.5 max-[480px]:py-1.25 max-[480px]:text-[12px]"
    >
      <span class="text-black transition-colors duration-300 group-hover/cta:text-white">
        Projekt starten
      </span>
    </a>
  </div>

  {variants.map((Variante, i) => (
    <div data-footer-variant={i + 1} hidden={i > 0}>
      <Variante {site} />
    </div>
  ))}

  <div
    data-footer-switch
    class="fixed right-5 bottom-5 z-[99999] flex items-center gap-1 rounded-full border border-black/20 bg-white p-1 text-[12px] shadow-[0_2px_8px_rgb(0_0_0/0.1)]"
  >
    <span class="px-2 text-black/60">Footer</span>
    {[1, 2, 3].map((n) => (
      <button
        type="button"
        data-footer-pick={n}
        class="size-7 cursor-pointer rounded-full text-black aria-pressed:bg-black aria-pressed:text-white"
      >
        {n}
      </button>
    ))}
  </div>
</footer>

<script>
  import { lenis, playAnim } from '../../scripts/motion';

  // Pfeil nach oben
  document.querySelectorAll<HTMLElement>('[data-to-top]').forEach((el) =>
    el.addEventListener('click', (e) => {
      e.preventDefault();
      if (lenis) lenis.scrollTo(0);
      else window.scrollTo({ top: 0, behavior: 'smooth' });
    }),
  );

  // Schwebender Link "Projekt starten": erscheint nach 100vh Scrollen und verschwindet wieder
  // 100vh (Handy bis 768 px: 150vh) vor dem Seitenende, wie im Original
  const cta = document.querySelector<HTMLElement>('[data-floating-cta]');
  if (cta) {
    const update = () => {
      const h = window.innerHeight;
      const y = window.scrollY;
      const hideDistance = window.innerWidth <= 768 ? h * 1.5 : h;
      const nearEnd = y + h > document.documentElement.scrollHeight - hideDistance;
      cta.toggleAttribute('data-show', y > h && !nearEnd);
    };
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();
  }

  // Linien zeichnen sich beim Hereinscrollen
  const lineObserver = new IntersectionObserver(
    (entries) =>
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.setAttribute('data-in', '');
          lineObserver.unobserve(entry.target);
        }
      }),
    { threshold: 1 },
  );
  const watchLines = (root: ParentNode) =>
    root.querySelectorAll('[data-line]').forEach((line) => {
      line.removeAttribute('data-in');
      lineObserver.observe(line);
    });

  // Vergleich der Varianten: Umschalter, Auswahl bleibt im Browser
  const variants = document.querySelectorAll<HTMLElement>('[data-footer-variant]');
  const picks = document.querySelectorAll<HTMLButtonElement>('[data-footer-pick]');
  const show = (n: number, replay: boolean) => {
    variants.forEach((v) => (v.hidden = Number(v.dataset.footerVariant) !== n));
    picks.forEach((b) =>
      b.setAttribute('aria-pressed', String(Number(b.dataset.footerPick) === n)),
    );
    const active = document.querySelector<HTMLElement>(`[data-footer-variant="${n}"]`);
    if (!active) return;
    if (replay) {
      active.querySelectorAll<HTMLElement>('[data-anim]').forEach((el) => {
        el.style.visibility = 'hidden';
        requestAnimationFrame(() => playAnim(el, el.dataset.anim || 'none'));
      });
    }
    watchLines(active);
  };
  let start = 1;
  try {
    start =
      Number(new URLSearchParams(location.search).get('footer')) ||
      Number(localStorage.getItem('footer-variant')) ||
      1;
  } catch {}
  show(Math.min(3, Math.max(1, start)), false);
  picks.forEach((b) =>
    b.addEventListener('click', () => {
      const n = Number(b.dataset.footerPick);
      try {
        localStorage.setItem('footer-variant', String(n));
      } catch {}
      show(n, true);
    }),
  );
</script>
