---
import Button from '../ui/Button.astro';
import { href, routes } from '../../data/links';
import { site } from '../../data/site';
/**
 * Fußbereich (Original: Elementor-Container 80dbe99) mit Kontaktaufruf, Bewertungs-Badge, Kontaktdaten und
 * dem schwebenden Link "Projekt starten". Das Badge ist ein statischer Nachbau des Trustindex-Widgets
 * (ohne Fremd-Skript), Icons sind Inline-SVG aus den Schriften des Originals (theme-icons, Font Awesome 5 Free).
 */
import { Picture } from 'astro:assets';
import logo from '../../assets/img/cropped-meisterwerk_malerbetrieb_logo.png';
import exklusive from '../../assets/img/logo_exklusive.png';

const heading =
  'font-display text-[26px]/[28.6px] font-medium text-ink md:text-[34px]/[37.4px] lg:text-[40px]/[44px]';
// Kontakt-Links (Original: Button-Widget mit Unterstrich-Animation, 12px/15,6px, Laufweite 2px)
const contactLink =
  'group/ul inline-block text-center font-display text-label font-medium tracking-label text-black uppercase';
// Kleine Links und Text (Original: Überschriften-Widget)
const smallText = 'font-display text-[8px]/[10.4px] font-medium tracking-label text-ink uppercase';
const smallLink = 'hover:text-black';
const social =
  'inline-flex items-center justify-center text-[16px]/[16px] text-ink transition-[transform,opacity,color] duration-300 hover:scale-110 hover:text-black hover:opacity-90 size-4 md:size-9';
---

<footer data-section="80dbe99" class="relative z-10 flex flex-col gap-5 overflow-x-clip bg-white">
  <!-- Trennlinie, enthält den schwebenden Link "Projekt starten" -->
  <div class="border-b border-black/20 md:mb-7.5 md:px-5 lg:mb-0 lg:px-0">
    <div class="mx-auto md:max-w-[min(100%,1024px)] md:pt-15 md:pb-7.5 lg:max-w-[min(100%,1700px)] lg:p-0">
      <a
        href={href(routes.contact)}
        data-floating-cta
        class="group/cta invisible fixed bottom-7.5 left-7.5 z-[9999] inline-block -translate-x-[50px] border border-black bg-white px-6 py-2 text-center text-[14px] text-black md:leading-[22.5px] opacity-0 shadow-[0_2px_8px_rgb(0_0_0/0.1)] transition-all duration-300 ease-[ease] hover:-translate-y-px hover:bg-black hover:shadow-[0_4px_12px_rgb(0_0_0/0.15)] data-[show]:visible data-[show]:translate-x-0 data-[show]:opacity-100 max-[768px]:bottom-5 max-[768px]:left-5 max-[768px]:px-5 max-[768px]:py-[6px] max-[768px]:text-[13px] max-[480px]:px-[18px] max-[480px]:py-[5px] max-[480px]:text-[12px]"
      >
        <span class="text-black transition-colors duration-300 group-hover/cta:text-white">
          Projekt starten
        </span>
      </a>
    </div>
  </div>

  <div class="mb-5 px-5 md:mb-7.5 lg:px-7.5">
    <div class="mx-auto flex w-full max-w-[min(100%,767px)] flex-wrap gap-y-12.5 md:max-w-[min(100%,1024px)] md:flex-nowrap md:gap-5 lg:max-w-[min(100%,1700px)]">
      <!-- Spalte 1: Überschrift und Button -->
      <div class="mb-1.25 flex w-full flex-col gap-y-2.5 md:mb-0 md:w-[61%] md:shrink-0">
        <div data-anim="slideInUp">
          <h3 class={heading}>Sie haben Fragen?</h3>
        </div>
        <div data-anim="slideInUp" data-anim-delay="50">
          <div class="mb-2.5">
            <h3 class={heading}>Lassen Sie uns reden.</h3>
          </div>
        </div>
        <div data-anim="slideInUp" data-anim-delay="100">
          <Button href={href(routes.contact)}>SCHREIBEN SIE UNS</Button>
        </div>
      </div>

      <!-- Spalte 2: Bewertungs-Badge (statischer Nachbau des Trustindex-Widgets) -->
      <div class="flex w-full flex-row flex-wrap gap-5 md:w-[20%] md:shrink-0 md:flex-col">
        <div class="relative inline-block self-start">
          <div class="mb-3.75 text-center text-[14px]/[19.6px] text-black">
            <div class="inline-block border border-[#cecece] grayscale-[.84]">
              <div class="p-2.5 text-[16.5px]/[23.1px] font-semibold">
