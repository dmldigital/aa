---
import { Picture } from 'astro:assets';

/**
 * Seiteneinstieg: Überschrift und Absätze links, Bild rechts (nur Desktop), z. B. /projekte/ (Original b9d36c5).
 */
interface Props {
  id?: string;
  heading: string;
  paragraphs: string[];
  image?: ImageMetadata;
  imageAlt?: string;
  rootClass?: string;
  /** Schrift und Absatzabstand der Absätze (Standard: Hauptseite). */
  bodyClass?: string;
  /** Zusätzliche Klassen der Textspalte. */
  textClass?: string;
}
const {
  id = 'b9d36c5',
  heading,
  paragraphs,
  image,
  imageAlt = '',
  rootClass = 'mt-19.5 md:mt-0 md:mb-10 lg:mt-[12vh] lg:mb-0',
  bodyClass = '[&>p]:mb-3.75 [&>p]:text-15 lg:[&>p]:mb-para',
  textClass,
} = Astro.props;
---

<section data-section={id} class:list={['flex flex-col px-5 lg:px-7.5', rootClass]}>
  <div class="mx-auto flex w-full max-w-page items-center lg:gap-0">
    <div class:list={['flex w-full flex-col gap-3.75 md:w-1/2 lg:gap-5', textClass]}>
      <h2
        class="font-display text-[23px]/[27.6px] font-medium text-ink md:text-[29px]/[39.15px] lg:text-h2"
        data-anim="fadeInUp"
        data-anim-delay="100"
      >
        {heading}
      </h2>
      <div class={bodyClass}>
        {paragraphs.map((p) => (
          <p set:html={p} />
        ))}
      </div>
    </div>
    {image && (
      <div class="hidden w-1/2 justify-end lg:flex">
        <div class="w-[80%] overflow-hidden" data-grow="bottom" data-anim-delay="340">
          <Picture
            formats={['avif']}
            fallbackFormat="webp"
            src={image}
            alt={imageAlt}
            widths={[544, 1088]}
            sizes="544px"
            class="block h-auto w-full"
          />
        </div>
      </div>
    )}
  </div>
</section>
