---
/**
 * Seiteneinstieg mit Bild: Überschrift und Absätze links, Bild rechts, z. B. /projekte/ (Original b9d36c5).
 * Rendert den einheitlichen Seitenkopf `PageHeader.astro` (genau eine H1, Überzeile `label`, Absätze, Bild).
 * Die Props `rootClass`, `bodyClass` und `textClass` aus früheren Fassungen werden nicht mehr gebraucht.
 */
import PageHeader from './PageHeader.astro';

interface Props {
  id?: string;
  heading: string;
  paragraphs: string[];
  /** Überzeile über der Überschrift */
  label?: string;
  /** Einleitung in größerer Schrift (Stufe „lead“) */
  lead?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  button?: { label: string; href: string };
  rootClass?: string;
  bodyClass?: string;
  textClass?: string;
}
const { heading, paragraphs, label, lead, image, imageAlt = '', button } = Astro.props;
---

<PageHeader title={heading} {label} {lead} {paragraphs} {button} {image} {imageAlt} />
