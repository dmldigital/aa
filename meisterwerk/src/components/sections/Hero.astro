---
/**
 * Hero der Startseite (Vorlage: Hero der Referenzseite „Kaisergärten“, im Meisterwerk-Design).
 * Links eine helle Fläche mit Kopfzeile, Beschreibung, großer H1 und Anfrage-Box, rechts ein großes Bild.
 * Beim Scrollen (Desktop): Kopfzeile fährt weg, oben links läuft ein Streifen mit den Bildern des bisherigen
 * Heros seitlich durch, danach schiebt sich der Text nach links hinaus, die Fläche folgt, das Bild wächst auf
 * die volle Breite und bekommt einen schmalen Rand, dann scrollt die Seite normal weiter. Handy: Fläche fährt
 * nach oben weg, das Bild füllt den Bildschirm. Ohne reduzierte Bewegung nur als ruhige Zweiteilung bzw. Stapel.
 * Die Zustände steuern die Varianten `hero-d` und `hero-m` (global.css), die Animation das Skript unten.
 */
import { Picture } from 'astro:assets';
import Button from '../ui/Button.astro';
import Header from './Header.astro';
import { href, routes } from '../../data/links';
import { slides } from '../../data/hero';

interface Props {
  /** Original-ID (data-section), Standard: Startseite */
  id?: string;
}
const { id = 'ca992c2' } = Astro.props;
---

<section
  data-hero
  data-section={id}
  aria-label="Willkommen bei Meisterwerk Malermanufaktur"
  class="relative bg-soft hero-d:h-[420svh] hero-m:h-[380svh]"
>
  <div class="relative flex flex-col overflow-hidden bg-soft min-[701px]:block min-[701px]:h-svh min-[701px]:min-h-150 hero-d:sticky hero-d:top-0 hero-d:overflow-clip hero-m:sticky hero-m:top-0 hero-m:block hero-m:h-svh hero-m:min-h-0 hero-m:overflow-clip">
    <div
      data-hero-picture
      class="relative order-1 h-120 overflow-hidden min-[701px]:absolute min-[701px]:inset-[0_0_0_50%] min-[701px]:h-auto hero-m:absolute hero-m:inset-x-0 hero-m:top-full hero-m:-bottom-full hero-m:h-auto"
    >
      {slides.map((slide, i) => (
        <div
          data-hero-slide
          class:list={['absolute inset-0', i > 0 && 'hidden opacity-0 hero-d:block']}
        >
          <Picture
            formats={['avif']}
            fallbackFormat="webp"
            src={slide.image}
            alt={i === 0 ? slide.alt : ''}
            widths={[640, 1024, 1440, 1920, 2560]}
            sizes="100vw"
            loading={i === 0 ? 'eager' : 'lazy'}
            fetchpriority={i === 0 ? 'high' : undefined}
            class="size-full max-w-none object-cover object-[30%_50%] min-[701px]:object-center"
          />
        </div>
      ))}
      <div class="absolute inset-0 bg-[linear-gradient(transparent_55%,rgb(0_0_0/0.35))] hero-m:bg-[linear-gradient(transparent_45%,rgb(0_0_0/0.4))]"></div>
      <p class="absolute right-6 bottom-6 font-display text-[9px] tracking-[0.17em] text-white uppercase min-[701px]:right-[clamp(24px,4.4vw,88px)] min-[701px]:bottom-8 min-[701px]:text-[10px] hero-m:hidden">
        Streichen. Lackieren. Tapezieren.
      </p>
      <p
        aria-hidden="true"
        class="absolute inset-x-5.5 bottom-6.5 hidden items-center gap-4 font-display text-[8px] tracking-[0.12em] text-white uppercase hero-m:flex"
      >
        <span>Weiter scrollen</span>
        <i class="block h-px flex-1 bg-white/45"></i>
        <span>↓</span>
      </p>
    </div>

    <div
      data-hero-panel
      class="relative z-[2] flex min-h-165 w-full flex-col overflow-hidden bg-soft text-ink min-[701px]:h-full min-[701px]:min-h-0 min-[701px]:w-1/2 hero-m:absolute hero-m:inset-x-0 hero-m:top-0 hero-m:h-full"
    >
      <Header variant="hero" />

      <div
        data-hero-gallery
        aria-hidden="true"
        class="invisible absolute inset-x-0 top-9.5 hidden overflow-hidden opacity-0 hero-d:block hero-m:visible hero-m:top-23 hero-m:block hero-m:opacity-100"
      >
        <div
          data-hero-track
          class="flex w-max gap-4 pl-6 will-change-transform hero-m:gap-3.5 hero-m:pl-5.5"
        >
          {slides.map((slide, i) => (
            <figure class="flex w-[clamp(160px,15vw,300px)] shrink-0 flex-col gap-3 hero-m:w-[clamp(140px,46vw,220px)] hero-m:gap-2.5">
              <div class="h-[clamp(120px,12vw,240px)] overflow-hidden hero-m:h-[clamp(100px,16svh,150px)]">
                <Picture
                  formats={['avif']}
                  fallbackFormat="webp"
                  src={slide.image}
                  alt=""
                  widths={[320, 640]}
                  sizes="300px"
                  loading="lazy"
                  class="size-full object-cover"
                />
              </div>
              <figcaption
                data-hero-caption
                class:list={[
                  'font-display text-[clamp(14px,1.2vw,19px)]/[1.2] tracking-[-0.01em] text-ink',
                  i > 0 && 'opacity-35',
                ]}
              >
                {slide.word}
              </figcaption>
            </figure>
          ))}
        </div>
      </div>

      <div
        data-hero-content
        class="relative px-6 pt-52.5 pb-6 min-[701px]:absolute min-[701px]:inset-x-6 min-[701px]:bottom-6 min-[701px]:p-0 hero-m:absolute hero-m:inset-[92px_22px_20px] hero-m:flex hero-m:flex-col hero-m:justify-between hero-m:gap-4 hero-m:p-0 hero-m:pt-[clamp(150px,24svh,200px)]"
      >
        <h1 class="mb-5.5 font-display text-[11.5vw]/[0.92] font-semibold tracking-[-0.045em] text-ink min-[701px]:mb-5.5 min-[701px]:text-[clamp(38px,4.4vw,80px)]/[0.94] hero-m:order-0 hero-m:m-0 hero-m:text-[11.5vw]/[0.94]">
          <span class="mb-3.5 block font-display text-[12px]/[1] font-normal tracking-[0.2em] text-ink uppercase hero-m:mb-2.5 hero-m:text-[9px]">
            Meisterwerk Malermanufaktur
          </span>
          Malerarbeiten in Ludwigsburg, Freiberg und Umgebung
        </h1>
        <p class="mb-7.5 max-w-full font-display text-[18px]/[1.35] tracking-[-0.02em] text-ink min-[701px]:max-w-[88%] min-[701px]:text-[clamp(16px,1.4vw,26px)]/[1.35] hero-m:order-1 hero-m:m-0 hero-m:max-w-80 hero-m:text-[14px]/[1.4]">
          Ihr Meisterbetrieb für Streichen, Lackieren, Tapezieren und glatte Oberflächen.{' '}
          <span class="text-muted hero-m:hidden">
            Persönlich beraten, sauber ausgeführt, mit über 22 Jahren Erfahrung.
          </span>
        </p>
        <div class="flex flex-wrap items-center gap-2.5 rounded-[3px] border border-black/15 bg-white/60 p-2 backdrop-blur-[10px] min-[701px]:flex-nowrap min-[701px]:p-2.5 hero-m:order-2 hero-m:flex-nowrap hero-m:border-0 hero-m:bg-transparent hero-m:p-0 hero-m:backdrop-blur-none">
          <span class="flex-1 p-2 font-display text-[12px] text-muted min-[701px]:pl-2 min-[701px]:text-[clamp(10px,1vw,17px)] hero-m:hidden">
            Ihr Malerbetrieb in Freiberg a. N.
          </span>
          <Button href={href(routes.contact)}>PROJEKT ANFRAGEN ↗</Button>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap, ScrollTrigger } from '../../scripts/motion';

  const hero = document.querySelector<HTMLElement>('[data-hero]');
  if (hero) {
    const q = <T extends Element = HTMLElement>(s: string) => hero.querySelector<T>(s)!;
    const mm = gsap.matchMedia();

    // Desktop (ab 701 px): erst läuft der Streifen mit Bildern und Wörtern durch (das große Bild wechselt mit),
    // danach schiebt sich der Text weg, die Fläche folgt, das Bild wächst auf die volle Breite und bekommt einen Rand
    mm.add('(min-width: 701px) and (prefers-reduced-motion: no-preference)', () => {
      const slidesEl = [...hero.querySelectorAll<HTMLElement>('[data-hero-slide]')];
      const captions = [...hero.querySelectorAll<HTMLElement>('[data-hero-caption]')];
      const track = q('[data-hero-track]');
      const panel = q('[data-hero-panel]');
      const n = slidesEl.length;
      const START = 0.06;
      const SLIDE = 0.1; // Anteil des Scrollwegs je Wort
      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: hero,
          start: 'top top',
          end: 'bottom bottom',
          scrub: 1,
          invalidateOnRefresh: true,
        },
      });
      tl.to(
        q('[data-site-header]'),
        { yPercent: -110, autoAlpha: 0, duration: 0.08, ease: 'none' },
        0,
      )
        .fromTo(
          q('[data-hero-gallery]'),
          { autoAlpha: 0, y: 24 },
          { autoAlpha: 1, y: 0, duration: 0.1, ease: 'none' },
          0.03,
        )
        .to(
          track,
          {
            x: () => -(track.scrollWidth - panel.offsetWidth + 24),
            duration: n * SLIDE,
            ease: 'none',
          },
          START,
        );
      tl.fromTo(
        slidesEl[0].querySelector('img'),
        { scale: 1.04 },
        { scale: 1, duration: START + SLIDE, ease: 'none' },
        0,
      );
      // Wort und großes Bild je Station
      for (let k = 1; k < n; k++) {
        const at = START + k * SLIDE;
        tl.fromTo(
          slidesEl[k],
          { opacity: 0 },
          { opacity: 1, duration: 0.05, ease: 'power1.inOut' },
          at - 0.025,
        )
          .fromTo(
            slidesEl[k].querySelector('img'),
            { scale: 1.08 },
            { scale: 1, duration: SLIDE, ease: 'none' },
            at - 0.025,
          )
          .fromTo(
            captions[k],
            { opacity: 0.35 },
            { opacity: 1, duration: 0.04, ease: 'none' },
            at - 0.02,
          )
          .fromTo(
            captions[k - 1],
            { opacity: 1 },
            { opacity: 0.35, duration: 0.04, ease: 'none' },
            at - 0.02,
          );
      }
      // Danach: Text weg, Fläche weg, Bild groß, Rand
      const END = START + n * SLIDE + 0.06;
      tl.to(q('[data-hero-content]'), { xPercent: -110, duration: 0.28, ease: 'power1.inOut' }, END)
        .to(panel, { xPercent: -100, duration: 0.32, ease: 'power1.inOut' }, END + 0.04)
        .to(
          q('[data-hero-picture]'),
          { left: '0%', duration: 0.32, ease: 'power1.inOut' },
          END + 0.04,
        )
        .to(
          q('[data-hero-picture]'),
          { top: 24, right: 24, bottom: 24, left: 24, duration: 0.08, ease: 'none' },
          END + 0.36,
        );
      // Gesamtlänge der Zeitleiste auf 1 normieren
      tl.duration(1);
    });

    // Handy (bis 700 px, Höhe ab 650 px): Am Anfang steht nur die Fläche mit Kopfzeile, Streifen und Text im Bild.
    // Der Streifen läuft erst durch, dann fährt die Fläche nach oben weg, das Bild schiebt sich von unten herein
    // und zoomt auf, danach bekommt es einen Rand.
    mm.add(
      '(max-width: 700px) and (min-height: 650px) and (prefers-reduced-motion: no-preference)',
      () => {
        const captions = [...hero.querySelectorAll<HTMLElement>('[data-hero-caption]')];
        const track = q('[data-hero-track]');
        const panel = q('[data-hero-panel]');
        const n = captions.length;
        const START = 0.04;
        const SLIDE = 0.11;
        const tl = gsap.timeline({
          scrollTrigger: {
            trigger: hero,
            start: 'top top',
            end: 'bottom bottom',
            scrub: 0.45,
            invalidateOnRefresh: true,
          },
        });
        tl.to(
          track,
          {
            x: () => -(track.scrollWidth - panel.offsetWidth + 22),
            duration: n * SLIDE,
            ease: 'none',
          },
          START,
        );
        for (let k = 1; k < n; k++) {
          const at = START + k * SLIDE;
          tl.fromTo(
            captions[k],
            { opacity: 0.35 },
            { opacity: 1, duration: 0.04, ease: 'none' },
            at - 0.02,
          ).fromTo(
            captions[k - 1],
            { opacity: 1 },
            { opacity: 0.35, duration: 0.04, ease: 'none' },
            at - 0.02,
          );
        }
        const END = START + n * SLIDE + 0.08;
        tl.to(q('[data-hero-content]'), { y: -20, opacity: 0, duration: 0.14, ease: 'none' }, END)
          .to(panel, { yPercent: -100, duration: 0.3, ease: 'power1.inOut' }, END + 0.02)
          .to(
            q('[data-hero-picture]'),
            { top: '0%', bottom: '0%', duration: 0.3, ease: 'power1.inOut' },
            END + 0.02,
          )
          .fromTo(
            '[data-hero-picture] img',
            { scale: 1.18 },
            { scale: 1, duration: 0.4, ease: 'none' },
            END + 0.02,
          )
          .to(
            q('[data-hero-picture]'),
            { left: 12, right: 12, bottom: '20%', top: 12, duration: 0.1, ease: 'none' },
            END + 0.34,
          );
        tl.duration(1);
      },
    );

    document.fonts.ready.then(() => ScrollTrigger.refresh());
  }
</script>
