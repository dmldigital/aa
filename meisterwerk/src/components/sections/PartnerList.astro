---
/**
 * Partner- und Sponsorenliste (Original ce0397d: HTML-Block "Sponsor / Spenden / Partner / Hersteller").
 * Überschriften mit Linie, darunter ein Raster aus Linkzeilen mit Plus.
 */
import type { PartnerGroup } from '../../data/pages/partner';

interface Props {
  id?: string;
  groups: PartnerGroup[];
}
const { id = 'ce0397d', groups } = Astro.props;
---

<section data-section={id} class="mt-[6vh] px-5 lg:px-7.5">
  <div class="mx-auto flex max-w-page flex-col">
    <div>
      <div class="mx-auto mb-25 w-full max-w-page px-5 text-black">
        {
          groups.map((group) => (
            <>
              <h2 class="mt-[0.6em] mb-10 border-b-2 border-black pb-3.75 font-display text-[23px]/[27.6px] font-medium tracking-[4px] text-ink md:text-[29px]/[39.15px] lg:text-h2">
                {group.title}
              </h2>
              <div class="grid grid-cols-1 gap-x-[50px] gap-y-5 pb-15 min-[501px]:grid-cols-2 min-[801px]:grid-cols-3 min-[1101px]:grid-cols-4 min-[1401px]:grid-cols-5">
                {group.links.map((link) => (
                  <a
                    href={link.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="group/p flex items-center justify-between border-b border-[#eee] py-3.75 text-[13.6px] text-ink transition-all duration-300 ease-[ease] hover:border-black hover:pl-2 hover:text-black"
                  >
                    <span class="block text-[13.6px]/[19.04px] tracking-[1px] uppercase">
                      {link.name}
                      {link.sub && (
                        <>
                          <br />
                          <small class="mt-1 block text-[10.4px]/[13.52px] tracking-normal text-[#999] normal-case">
                            {link.sub}
                          </small>
                        </>
                      )}
                    </span>
                    <span class="ml-2.5 text-[19.2px]/6 md:leading-[22.5px] font-extralight text-[#bbb] transition-all duration-300 group-hover/p:scale-120 group-hover/p:text-black">
                      +
                    </span>
                  </a>
                ))}
              </div>
            </>
          ))
        }
      </div>
    </div>
  </div>
</section>
