---
/**
 * Partner- und Sponsorenliste (Original ce0397d: HTML-Block "Sponsor / Spenden / Partner / Hersteller").
 * Überschriften mit Linie, darunter ein Raster aus Linkzeilen mit Plus.
 */
import type { PartnerGroup } from '../../data/pages/partner';

interface Props {
  id?: string;
  groups: PartnerGroup[];
}
const { id = 'ce0397d', groups } = Astro.props;
---

<section data-section={id} class="mt-[6vh] px-5 lg:px-7.5">
  <div class="mx-auto flex max-w-page flex-col">
    <div>
      <div class="mx-auto mb-25 w-full max-w-page px-5 text-black">
        {groups.map((group) => (
          <>
            <h2 class="mt-[0.6em] mb-10 border-b-2 border-black pb-3.75 font-display text-h2 font-medium tracking-[4px] text-ink">
              {group.title}
            </h2>
            <div class="grid grid-cols-1 gap-x-12.5 gap-y-5 pb-15 min-[501px]:grid-cols-2 min-[801px]:grid-cols-3 min-[1101px]:grid-cols-4 min-[1401px]:grid-cols-5">
              {group.links.map((link) => (
                <a
                  href={link.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group/p flex items-center justify-between border-b border-[#eee] py-3.75 text-small text-ink transition-all duration-300 ease-[ease] hover:border-black hover:pl-2 hover:text-black"
                >
                  <span class="block text-label tracking-[1px] uppercase">
                    {link.name}
                    {link.sub && (
                      <>
                        <br />
                        <small class="mt-1 block text-small tracking-normal text-[#999] normal-case">
                          {link.sub}
                        </small>
                      </>
                    )}
                  </span>
                  <span class="ml-2.5 text-h4 font-extralight text-[#bbb] transition-all duration-300 group-hover/p:scale-120 group-hover/p:text-black">
                    +
                  </span>
                </a>
              ))}
            </div>
          </>
        ))}
      </div>
    </div>
  </div>
</section>
