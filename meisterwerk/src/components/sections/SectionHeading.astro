---
/** Überschrift-Sektion der Unterseiten (Original 7d071c8 „Exzellenz ist unser Maßstab“, dd2507a, 4ef4fcc). */
interface Props {
  id: string;
  title: string;
  /** Außenabstand der Sektion */
  rootClass?: string;
  /** Maximale Breite der Überschrift (Zeilenumbruch wie im Original) */
  widthClass?: string;
}
const {
  id,
  title,
  rootClass = 'mb-5 md:mb-6.25 lg:mb-27',
  widthClass = 'max-w-[400px]',
} = Astro.props;
---

<section data-section={id} class:list={['px-5 lg:px-7.5', rootClass]}>
  <div class="mx-auto w-full max-w-mobile md:max-w-tablet lg:max-w-page">
    <h2
      class:list={[
        'font-display text-[23px]/[27.6px] font-medium text-ink md:text-[29px]/[39.15px] lg:text-h2',
        widthClass,
      ]}
    >
      {title}
    </h2>
  </div>
</section>
