---
import { href } from '../../data/links';
import { Image } from 'astro:assets';
import Icon from '../Icon.astro';
import { cards } from '../../data/services';

const sizes =
  '(min-width: 1760px) 316px, (min-width: 1025px) calc((100vw - 180px) / 5), (min-width: 768px) calc((100vw - 70px) / 2), calc(100vw - 40px)';
const widths = [252, 350, 477, 700, 954];
---

<section
  data-section="bc3ca42"
  class="mt-[14vh] flex flex-col bg-soft px-5 md:mt-0 md:mb-15 lg:mt-[20vh] lg:mb-0 lg:px-7.5"
>
  <div class="mx-auto flex w-full flex-col gap-3.75 py-10 md:py-15 lg:max-w-page lg:gap-5 lg:py-[12vh]">
    <div>
      <p class="mb-3 font-display text-label font-medium tracking-label uppercase lg:mb-4.5">
        Unsere Leistungen
      </p>
    </div>

    <div class="mb-1.25 md:max-w-[690px] lg:mb-5">
      <h3 class="font-display text-[21px]/[26.25px] text-gold md:text-[24px]/[30px] lg:text-h3">
        Planung, Gestaltung, Umsetzung – alles für Ihr Projekt.
      </h3>
    </div>

    <div class="grid grid-cols-1 items-stretch gap-7.5 md:grid-cols-2 lg:grid-cols-5">
      {cards.map((card) => (
        <a
          href={href(card.href)}
          class="group/card flex flex-col gap-5 text-ink hover:text-black"
          data-anim="fadeIn"
          data-anim-delay="100"
        >
          <div class="group/img relative overflow-hidden">
            <div data-grow="left" data-anim-delay="450">
              <Image
                src={card.img}
                alt={card.alt}
                {widths}
                {sizes}
                class="block h-auto w-full transition-transform duration-[450ms] ease-in-out group-hover/img:scale-110 group-hover/img:opacity-80"
              />
            </div>
            <span
              aria-hidden="true"
              class="pointer-events-none absolute top-1/2 left-1/2 z-10 flex size-17.5 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full bg-black/70 text-[40px] text-white opacity-0 transition-all duration-300 ease-[ease] group-hover/img:opacity-100"
            >
              +
            </span>
          </div>

          <div class="flex flex-wrap items-start justify-between gap-5 md:flex-nowrap">
            <div class="w-full min-w-0" data-anim-mobile="fadeInLeft">
              <h4 class="font-display text-[18px] leading-[1.3em] font-medium lg:text-[24px]">
                {card.title}
                <br />
                <span class="text-[16px]">{card.subtitle}</span>
              </h4>
            </div>
            <div
              class="min-w-0 transition-opacity duration-300 ease-in-out lg:[@media(hover:hover)]:opacity-0 lg:group-hover/card:opacity-100"
              data-anim-mobile="fadeInUp"
            >
              <div class="text-center">
                <span class="inline-block size-4 align-baseline text-black">
                  <Icon name="plus" class="block size-4" />
                </span>
              </div>
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
