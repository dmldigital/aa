---
import { Picture } from 'astro:assets';
import { href } from '../../data/links';
import Icon from '../Icon.astro';

/** Raster aller Projekte (Original 6dc4e82 auf /projekte/): drei Spalten, Tablet drei, Handy eine. */
interface Props {
  id?: string;
  projects: { title: string; href: string; img: ImageMetadata; alt: string }[];
  rootClass?: string;
}
const {
  id = '6dc4e82',
  projects,
  rootClass = 'mt-[78px] md:mt-[12vh] md:mb-[8vh] lg:mb-[72px]',
} = Astro.props;
---

<section data-section={id} class:list={['flex flex-col px-5 lg:px-7.5', rootClass]}>
  <div class="mx-auto grid w-full max-w-page grid-cols-1 gap-x-5 gap-y-7.5 md:grid-cols-3 md:gap-y-15 lg:gap-x-7.5 lg:gap-y-27">
    {projects.map((p) => (
      <a href={href(p.href)} class="group/card flex flex-col gap-5 text-ink" data-anim="fadeIn">
        <div class="relative overflow-hidden">
          <div data-grow="bottom">
            <Picture
              formats={['avif', 'webp']}
              src={p.img}
              alt={p.alt}
              widths={[350, 440, 880]}
              sizes="(min-width: 1025px) 440px, (min-width: 768px) 315px, 350px"
              class="block h-auto w-full transition-transform duration-[450ms] ease-in-out group-hover/card:scale-110 group-hover/card:opacity-80"
            />
          </div>
          <span
            aria-hidden="true"
            class="pointer-events-none absolute top-1/2 left-1/2 z-10 flex size-17.5 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full bg-black/70 text-[40px]/[22.5px] text-white opacity-0 transition-opacity duration-300 group-hover/card:opacity-100"
          >
            +
          </span>
        </div>
        <div class="flex flex-wrap items-start justify-between gap-5">
          <h4 class="w-[calc(100%-40px)] font-display text-[19px]/[24.7px] font-medium md:text-h5 lg:text-h4">
            {p.title}
          </h4>
          <span
            class="text-[16px] text-black transition-opacity duration-300 ease-in-out [@media(hover:hover)]:opacity-0 group-hover/card:opacity-100"
            aria-hidden="true"
          >
            <Icon name="plus" class="block size-4 shrink-0" />
          </span>
        </div>
      </a>
    ))}
  </div>
</section>
