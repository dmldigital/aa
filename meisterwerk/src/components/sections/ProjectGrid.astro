---
import ProjectCard from '../ui/ProjectCard.astro';

/** Raster aller Projekte (Original 6dc4e82 auf /projekte/): drei Spalten, Tablet drei, Handy eine. */
interface Props {
  id?: string;
  projects: { title: string; href: string; img: ImageMetadata; alt: string }[];
  rootClass?: string;
  /** Größe des Plus-Symbols der Karten (Exklusive: kleiner). */
  iconClass?: string;
  /** Hintergrund der Sektion (Weiß und Hellgrau wechseln sich ab) */
  tone?: 'white' | 'soft';
}
const {
  id = '6dc4e82',
  projects,
  rootClass = '',
  iconClass,
  tone = 'white',
} = Astro.props;
---

<section data-section={id} class:list={['flex flex-col px-page py-section', tone === 'soft' ? 'bg-soft' : 'bg-white', rootClass]}>
  <div class="mx-auto grid w-full max-w-page grid-cols-1 gap-x-5 gap-y-10 md:grid-cols-3">
    {projects.map((p) => (
      <ProjectCard project={p} reveal {iconClass} titleTag="h2" data-anim="fadeIn" />
    ))}
  </div>
</section>
