---
/**
 * Ablauf und Vorteile des Urlaubsservice (Original: Desktop b7643d9 als Banner auf Bild, Tablet/Handy 9a4846f
 * als zwei helle Textspalten). Beide Darstellungen aus denselben Daten.
 */
import { getImage } from 'astro:assets';

interface Props {
  background: ImageMetadata;
  columns: { title: string; items: string[] }[];
  /** Teil-Website Exklusive: Desktop als zwei weiße Spalten mit Linienraster statt Banner auf Bild. */
  boxed?: boolean;
}
const { background, columns, boxed = false } = Astro.props;
const bg = boxed
  ? null
  : await getImage({ src: background, width: 2000, format: 'webp', quality: 80 });
---

<!-- Desktop: Exklusive (f3c82e3) -->
{boxed ? (
  <section data-section="f3c82e3" class="mt-27 mb-18 hidden flex-col px-7.5 lg:flex">
    <div class="mx-auto flex w-full max-w-page gap-x-[8%]">
      {columns.map((col) => (
        <div class="flex flex-1 flex-col gap-5">
          <div class="-mb-5 flex border-b border-ink pl-[10%]">
            <div class="h-22.25 w-[90%] border-x border-ink"></div>
          </div>
          <div class="flex border-b border-ink pl-[10%]">
            <div class="flex min-h-124.75 w-[90%] flex-col justify-center gap-5 border-x border-ink px-7.5 py-10">
              <div class="flex flex-col gap-5">
                <h5 class="font-display text-h4 font-medium text-ink">{col.title}</h5>
                <ul class="my-3.75 list-disc pl-[25.5px]">
                  {col.items.map((item) => (
                    <li>
                      <p class="mb-para" set:html={item} />
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </div>
          <div class="-mt-6.25 flex pl-[10%]">
            <div class="h-22.5 w-[90%] border-x border-ink"></div>
          </div>
        </div>
      ))}
    </div>
  </section>
) : (
  <section
    data-section="b7643d9"
    class="mt-11.25 mb-18 hidden flex-col bg-cover bg-center lg:flex"
    style={`background-image:url(${bg!.src})`}
  >
    <div class="flex h-13.5 flex-col pl-[10%]">
      <div class="w-105 grow border-x border-line"></div>
    </div>
    <div class="flex pr-[10%]">
      {columns.map((col, i) => (
        <div
          class:list={[
            'flex flex-1 flex-col items-start justify-between gap-5 px-7.5 py-10 backdrop-blur-[40px] backdrop-saturate-[1.8]',
            i === 0 && 'mr-25',
          ]}
        >
          <h5 class="font-display text-h4 font-medium text-white">{col.title}</h5>
          <div class="w-full">
            <ul class="my-3.75 list-disc pl-[25.5px] text-soft">
              {col.items.map((item) => (
                <li>
                  <p class="mb-para" set:html={item} />
                </li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </div>
    <div class="flex h-13.5 flex-col pl-[10%]">
      <div class="w-105 grow border-x border-line"></div>
    </div>
  </section>
)}

<!-- Tablet und Handy -->
<section
  data-section="9a4846f"
  class="mt-19.5 mb-9.75 flex flex-col px-5 md:mt-0 md:mb-11.25 lg:hidden"
>
  <div class="mx-auto flex w-full flex-wrap gap-x-2.5 gap-y-3.75 md:flex-nowrap md:gap-x-7.5">
    {columns.map((col, i) => (
      <div
        class:list={[
          'flex flex-col gap-3.75 md:gap-5',
          i === 0 ? 'w-full md:w-[52.5%]' : 'w-full md:flex-1',
        ]}
      >
        <h5
          class:list={[
            'font-display text-h4 text-ink',
          ]}
        >
          {col.title}
        </h5>
        <div>
          <ul
            class:list={[
              'list-disc',
              boxed ? 'my-4 pl-[27.2px] md:my-3.75 md:pl-[25.5px]' : 'my-3.75 pl-[25.5px]',
            ]}
          >
            {col.items.map((item) => (
              <li>
                <p
                  class:list={[boxed ? 'mb-4 md:mb-3.75 md:text-body' : 'mb-3.75 text-body']}
                  set:html={item}
                />
              </li>
            ))}
          </ul>
        </div>
      </div>
    ))}
  </div>
</section>
