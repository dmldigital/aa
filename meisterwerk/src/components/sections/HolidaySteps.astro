---
/**
 * Ablauf und Vorteile des Urlaubsservice (Original: Desktop b7643d9 als Banner auf Bild, Tablet/Handy 9a4846f
 * als zwei helle Textspalten). Beide Darstellungen aus denselben Daten, ohne Linien.
 */
import { Picture } from 'astro:assets';

interface Props {
  background: ImageMetadata;
  columns: { title: string; items: string[] }[];
  /** Teil-Website Exklusive: Desktop als zwei Kartenflächen statt Banner auf Bild. */
  boxed?: boolean;
  /** Hintergrund der Sektion (Weiß und Hellgrau wechseln sich ab) */
  tone?: 'white' | 'soft';
}
const { background, columns, boxed = false, tone = 'white' } = Astro.props;
const bg = tone === 'soft' ? 'bg-soft' : 'bg-white';
const card = tone === 'soft' ? 'bg-white' : 'bg-soft';
---

<!-- Desktop: Exklusive (f3c82e3) -->
{boxed ? (
  <section data-section="f3c82e3" class:list={['hidden px-page py-section lg:block', bg]}>
    <div class="mx-auto grid w-full max-w-page grid-cols-2 gap-5">
      {columns.map((col) => (
        <div class:list={['flex flex-col gap-5 p-8', card]}>
          <h2 class="font-display text-h4 font-medium text-ink">{col.title}</h2>
          <ul class="list-disc pl-6">
            {col.items.map((item) => (
              <li>
                <p class="mb-4 text-body" set:html={item} />
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>
) : (
  <section data-section="b7643d9" class="relative hidden overflow-hidden lg:block">
    <Picture
      formats={['avif']}
      fallbackFormat="webp"
      src={background}
      alt=""
      widths={[1024, 1440, 2000]}
      sizes="100vw"
      loading="lazy"
      class="absolute inset-0 size-full object-cover object-center"
    />
    <div class="relative flex gap-x-25 px-page py-section">
      {columns.map((col) => (
        <div class="flex flex-1 flex-col items-start justify-between gap-5 px-7.5 py-10 backdrop-blur-[40px] backdrop-saturate-[1.8]">
          <h2 class="font-display text-h4 font-medium text-white">{col.title}</h2>
          <div class="w-full">
            <ul class="my-3.75 list-disc pl-6 text-soft">
              {col.items.map((item) => (
                <li>
                  <p class="mb-4 text-body" set:html={item} />
                </li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </div>
  </section>
)}

<!-- Tablet und Handy -->
<section data-section="9a4846f" class:list={['px-page py-section lg:hidden', bg]}>
  <div class="mx-auto grid w-full grid-cols-1 gap-5 md:grid-cols-2">
    {columns.map((col) => (
      <div class:list={['flex flex-col gap-4 p-6 md:p-8', card]}>
        <h2 class="font-display text-h4 text-ink">{col.title}</h2>
        <ul class="list-disc pl-6">
          {col.items.map((item) => (
            <li>
              <p class="mb-3 text-body" set:html={item} />
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</section>
