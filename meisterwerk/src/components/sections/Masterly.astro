---
import { Image } from 'astro:assets';
import stairs from '../../assets/img/2025-meisterwerk-20230524-HDR-scaled.jpg';
---

<section
  data-section="9e8e860"
  class="mt-[10vh] flex flex-col overflow-hidden px-[20px] md:mt-0 md:mb-[40px] lg:mt-[20vh] lg:mb-0 lg:px-[30px]"
>
  <div class="mx-auto flex w-full max-w-[1700px] grow flex-col gap-[20px] md:flex-row md:items-center md:gap-x-[30px] lg:gap-x-[20px]">
    <div class="flex flex-col gap-[15px] md:w-1/2 lg:gap-[20px]">
      <div>
        <span class="font-display text-[12px]/[15.6px] font-medium tracking-[2px] uppercase">
          Meisterwerk Maler Manufaktur
        </span>
      </div>
      <div
        class="w-full max-w-full lg:mb-[20px] lg:max-w-[500px]"
        data-anim="slideInUp"
        data-anim-delay="360"
      >
        <h2 class="font-display text-[23px]/[27.6px] font-medium text-gold md:text-[29px]/[39.15px] lg:text-[40px]/[54px]">
          Meisterliche Malerarbeiten für Wohnträume und Lebensräume
        </h2>
      </div>
    </div>
    <div class="overflow-hidden md:w-1/2">
      <div class="[clip-path:none]" data-grow="bottom" data-anim-delay="340">
        <Image
          src={stairs}
          alt="Helles Treppenhaus mit Holzstufen, frisch gestrichene Wände und Wandleuchte"
          widths={[350, 700, 1360]}
          sizes="(min-width: 1025px) 680px, (min-width: 768px) 477px, 350px"
          class="block h-auto w-full"
        />
      </div>
    </div>
  </div>
</section>
