---
import { Image } from 'astro:assets';
import stairs from '../../assets/img/2025-meisterwerk-20230524-HDR-scaled.jpg';
---

<section
  data-section="9e8e860"
  class="mt-[10vh] flex flex-col overflow-hidden px-5 md:mt-0 md:mb-10 lg:mt-[20vh] lg:mb-0 lg:px-7.5"
>
  <div class="mx-auto flex w-full max-w-page grow flex-col gap-5 md:flex-row md:items-center md:gap-x-7.5 lg:gap-x-5">
    <div class="flex flex-col gap-3.75 md:w-1/2 lg:gap-5">
      <div>
        <span class="font-display text-label font-medium tracking-label uppercase">
          Meisterwerk Maler Manufaktur
        </span>
      </div>
      <div
        class="w-full max-w-full lg:mb-5 lg:max-w-[500px]"
        data-anim="slideInUp"
        data-anim-delay="360"
      >
        <h2 class="font-display text-[23px]/[27.6px] font-medium text-gold md:text-[29px]/[39.15px] lg:text-h2">
          Meisterliche Malerarbeiten für Wohnträume und Lebensräume
        </h2>
      </div>
    </div>
    <div class="overflow-hidden md:w-1/2">
      <div class="[clip-path:none]" data-grow="bottom" data-anim-delay="340">
        <Image
          src={stairs}
          alt="Helles Treppenhaus mit Holzstufen, frisch gestrichene Wände und Wandleuchte"
          widths={[350, 700, 1360]}
          sizes="(min-width: 1025px) 680px, (min-width: 768px) 477px, 350px"
          class="block h-auto w-full"
        />
      </div>
    </div>
  </div>
</section>
