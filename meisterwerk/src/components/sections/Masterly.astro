---
import { Picture } from 'astro:assets';
import stairs from '../../assets/img/2025-meisterwerk-20230524-HDR-scaled.jpg';

/**
 * Text links, Bild rechts (Original 9e8e860). Ohne Props: Startseite. Für Unterseiten: Überzeile
 * (`null` = keine), Überschrift, optionaler Fließtext, Bild, Klassen für Wurzel und Überschriftfarbe.
 */
interface Props {
  id?: string;
  eyebrow?: string | null;
  /** Aus Kompatibilität erlaubt, die Überzeile ist immer ein Absatz (keine Überschrift). */
  eyebrowTag?: 'h6';
  heading?: string;
  headingColor?: string;
  text?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  rootClass?: string;
  /** Hintergrund der Sektion (Weiß und Hellgrau wechseln sich ab) */
  tone?: 'white' | 'soft';
}
const {
  id = '9e8e860',
  eyebrow = 'Meisterwerk Maler Manufaktur',
  heading = 'Meisterliche Malerarbeiten für Wohnträume und Lebensräume',
  headingColor = 'text-gold',
  text,
  image = stairs,
  imageAlt = 'Helles Treppenhaus mit Holzstufen, frisch gestrichene Wände und Wandleuchte',
  rootClass = '',
  tone = 'soft',
} = Astro.props;
---

<section
  data-section={id}
  class:list={['overflow-hidden px-page py-section', tone === 'soft' ? 'bg-soft' : 'bg-white', rootClass]}
>
  <div class="mx-auto flex w-full max-w-page grow flex-col gap-5 md:flex-row md:items-center md:gap-x-7.5 lg:gap-x-5">
    <div class="flex flex-col gap-3.75 md:w-1/2 lg:gap-5">
      {eyebrow && (
        <p class="font-display text-label font-medium tracking-label text-ink uppercase">
          {eyebrow}
        </p>
      )}
      <div
        class="w-full max-w-full lg:mb-5 lg:max-w-[500px]"
        data-anim="slideInUp"
        data-anim-delay="360"
      >
        <h2
          class:list={[
            'font-display text-h2 font-medium',
            headingColor,
          ]}
          set:html={heading}
        />
      </div>
      {text && <p class="text-body" set:html={text} />}
    </div>
    <div class="overflow-hidden md:w-1/2">
      <div class="[clip-path:none]" data-grow="bottom" data-anim-delay="340">
        <Picture
          formats={['avif']}
          fallbackFormat="webp"
          src={image}
          alt={imageAlt}
          widths={[350, 700, 1360]}
          sizes="(min-width: 1025px) 680px, (min-width: 768px) 477px, 350px"
          class="block h-auto w-full"
        />
      </div>
    </div>
  </div>
</section>
