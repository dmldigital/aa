---
import type { Site } from '../../data/nav';
import Brand from '../header/Brand.astro';
/**
 * Kopfzeile (Vorlage: Header der Referenzseite, Referenz „Kaisergärten“): nur das Logo. Rechts steht die Pille „Kontakt | Menü“
 * (FloatingMenu.astro): Sie liegt beim Laden an dieser Stelle und gleitet beim Scrollen an ihre schwebende Position, beim
 * Zurückscrollen wieder hierher. `bar` steht oben auf jeder Unterseite im Fluss, `hero` liegt auf der Fläche des Startseiten-Heros
 * (durchsichtig) und fährt mit der Hero-Animation weg. Die Kopfzeile steht nur oben (nicht mitlaufend).
 */
interface Props {
  site?: Site;
  variant?: 'bar' | 'hero';
  /** `light` = weißes Logo (Hero über Foto oder Video), `duo` = Gold und Weiß (Vollbild-Hero) */
  tone?: 'dark' | 'light' | 'duo';
}
const { site = 'main', variant = 'bar', tone = 'dark' } = Astro.props;
const hero = variant === 'hero';
---

<header
  data-site-header
  class:list={[
    'z-10 flex items-center justify-between gap-6',
    hero
      ? 'absolute top-0 left-0 h-23.75 w-full items-start px-6 py-5.5 min-[701px]:h-32.5 min-[701px]:p-7.5 hero-m:h-19 hero-m:px-5.5 hero-m:py-5'
      : 'relative h-20.5 border-b border-black/10 bg-white px-5 min-[701px]:h-26 min-[701px]:px-7.5',
  ]}
>
  <Brand {site} {tone} class="w-32 min-[380px]:w-36 min-[701px]:w-44.5" />
</header>
