---
import { Image } from 'astro:assets';
import ThemeIcon from '../icons/ThemeIcon.astro';
import sketch from '../../assets/img/house-sketch.png';
import { faqs } from '../../data/faq';
---

<section
  data-section="b1f5cd6"
  class="mt-[10vh] flex flex-col bg-soft px-5 md:mt-[20vh] lg:mt-[20vh] lg:px-7.5"
>
  <div class="mx-auto flex w-full max-w-page grow flex-col gap-7.5 py-10 md:py-15 lg:gap-y-10 lg:py-[12vh]">
    <!-- Überschrift und Einleitung -->
    <div class="flex w-full flex-col gap-3.75 lg:w-[70%] lg:gap-5">
      <div class="w-full">
        <h2 class="font-display text-[23px]/[27.6px] font-medium text-gold md:text-[29px]/[39.15px] lg:text-h2">
          FAQ
        </h2>
      </div>
      <div class="min-h-53.75 w-full max-w-[496px] md:min-h-48.75 lg:min-h-[202.5px]">
        <p class="mb-3.75 text-[15px]/[24px] md:text-body lg:mb-[22.5px]">
          Damit aus Ihren Ideen ein echtes Meisterwerk wird, begleiten wir Sie Schritt für Schritt,
          klar, individuell und im engen Austausch mit Ihnen.
        </p>
      </div>
    </div>

    <!-- Akkordeon und Haus-Skizze -->
    <div class="-mt-[16%] flex flex-wrap items-end justify-between gap-5 md:flex-nowrap">
      <div class="z-[3] flex w-full flex-none flex-col justify-between max-md:order-last md:w-[39.369%] lg:gap-[6vh]">
        <div
          class="-mt-[1em] p-2.5 md:mt-0 md:p-0 md:pt-25"
          data-anim="fadeIn"
          data-accordion
          data-accordion-exclusive
          data-accordion-ease="power1.inOut"
        >
          {faqs.map((f, i) => (
            <div>
              <button
                type="button"
                id={`faq-q-${i}`}
                aria-expanded="false"
                aria-controls={`faq-a-${i}`}
                class="group/faq flex w-full cursor-pointer items-center justify-between gap-x-2.5 py-[1em] text-left text-black hover:text-gold aria-expanded:text-gold"
              >
                <span class="block font-display text-[19px]/[24.7px] font-medium md:text-h5 lg:text-[18px]/[23.4px]">
                  {f.q}
                </span>
                <span class="flex items-center">
                  <ThemeIcon name="plus" class="size-3.75 group-aria-expanded/faq:hidden" />
                  <ThemeIcon name="minus" class="hidden size-3.75 group-aria-expanded/faq:block" />
                </span>
              </button>
              <div
                id={`faq-a-${i}`}
                role="region"
                aria-labelledby={`faq-q-${i}`}
                hidden
                class="flex flex-col border-b border-black/20 pt-[2em] pb-[1em] lg:pr-[2em]"
              >
                {f.a.map((block) =>
                  block.type === 'steps' ? (
                    <ul class="m-0 list-none p-0">
                      {block.items.map((step, n) => (
                        <li class="my-2 flex items-center">
                          <span class="mr-2.5 inline-flex size-6.5 items-center justify-center rounded-full border border-[#333] text-[14px] font-bold text-[#333]">
                            {n + 1}
                          </span>{' '}
                          {step}
                        </li>
                      ))}
                    </ul>
                  ) : (
                    <p class="mb-3.75 text-[15px]/[24px] md:text-body lg:mb-[22.5px]">
                      {block.parts.map((part) =>
                        typeof part === 'string' ? (
                          part
                        ) : 'br' in part ? (
                          <br />
                        ) : (
                          <a
                            class="text-ink no-underline"
                            href={part.href}
                            target="_blank"
                            rel="noopener"
                          >
                            {part.text}
                          </a>
                        ),
                      )}
                    </p>
                  ),
                )}
              </div>
            </div>
          ))}
        </div>
      </div>
      <div class="flex w-full flex-col items-end justify-center px-5 md:w-[60%] lg:px-7.5">
        <div class="w-full overflow-hidden lg:w-[45rem]" data-anim="fadeIn" data-anim-delay="100">
          <Image
            src={sketch}
            alt="Handzeichnung eines Einfamilienhauses mit Terrasse und Gartenmöbeln"
            widths={[310, 537, 720, 1024]}
            sizes="(min-width: 1025px) 720px, (min-width: 768px) 537px, 310px"
            class="block h-auto w-full"
          />
        </div>
      </div>
    </div>
  </div>
</section>
