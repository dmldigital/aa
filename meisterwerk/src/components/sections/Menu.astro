---
import type { Site } from '../../data/nav';
import V2 from '../menu/V2.astro';
import V3 from '../menu/V3.astro';
/**
 * Menü: Es öffnet aus der Pille „Kontakt | Menü“ (FloatingMenu.astro) und wächst aus ihrem Umriss auf seine Größe. Tablet und
 * Desktop (ab 701 px) geteiltes Vollbild-Menü (`menu/V2`, rechts Untermenü oder Kontakt mit kurzem Formular), Handy (bis 700 px)
 * Seitenfläche (`menu/V3`). Öffnen und Schließen steuert das Skript unten, ebenso die rechte Seite des Desktop-Menüs.
 */
interface Props {
  site?: Site;
  /** Pfad der aktuellen Seite, markiert den aktiven Eintrag */
  current?: string;
}
const { site = 'main', current = '/' } = Astro.props;
---

<V2 {site} {current} />
<V3 {site} {current} />

<script>
  import { gsap } from 'gsap';
  import { lenis } from '../../scripts/motion';

  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const dialogs = [...document.querySelectorAll<HTMLDialogElement>('[data-menu-dialog]')];
  const active = () =>
    dialogs.find(
      (d) => d.dataset.variant === (window.matchMedia('(max-width: 700px)').matches ? '3' : '2'),
    ) ?? dialogs[0];
  let busy = false;
  let opener: HTMLElement | null = null;

  const lock = (on: boolean) => {
    document.body.style.overflow = on ? 'hidden' : '';
    if (on) lenis?.stop();
    else lenis?.start();
  };
  const setExpanded = (on: boolean) =>
    document
      .querySelectorAll('[data-menu-open]')
      .forEach((b) => b.setAttribute('aria-expanded', String(on)));
  const axis = (d: HTMLElement) =>
    d.dataset.menuFrom === 'right'
      ? { from: { xPercent: 110 }, to: { xPercent: 0 } }
      : { from: { yPercent: -110 }, to: { yPercent: 0 } };

  // Aufklappen aus der Pille: Das Fenster wird von außen zugeschnitten (clip-path) und wächst aus dem Umriss der Pille gleichzeitig nach links,
  // rechts und unten auf seine Größe (Pille mittig: nach beiden Seiten, Pille rechts: nach unten und links). Der Inhalt blendet danach ein.
  const pillClip = (menu: HTMLElement, pill: HTMLElement) => {
    const m = menu.getBoundingClientRect();
    const p = pill.getBoundingClientRect();
    return `inset(${p.top - m.top}px ${m.right - p.right}px ${m.bottom - p.bottom}px ${p.left - m.left}px round ${p.height / 2}px)`;
  };
  const pillOf = (b: HTMLElement | null) => b?.closest<HTMLElement>('[data-float-menu]') ?? null;
  // Abbild der Pille im Fenster, genau über der echten Pille: So ist beim Wechsel nichts zu sehen, die Pille wird einfach größer,
  // ihre Beschriftung blendet dabei aus (und beim Schließen wieder ein)
  const ghostOf = (menu: HTMLElement, pill: HTMLElement) => {
    const inner = pill.firstElementChild as HTMLElement;
    const g = inner.cloneNode(true) as HTMLElement;
    g.querySelectorAll('[id]').forEach((e) => e.removeAttribute('id'));
    g.querySelectorAll('[data-menu-open],[data-fm-contact]').forEach((e) => {
      e.removeAttribute('data-menu-open');
      e.removeAttribute('data-fm-contact');
    });
    g.setAttribute('aria-hidden', 'true');
    g.setAttribute('inert', '');
    const m = menu.getBoundingClientRect();
    const r = inner.getBoundingClientRect();
    Object.assign(g.style, {
      position: 'absolute',
      left: `${r.left - m.left}px`,
      top: `${r.top - m.top}px`,
      width: `${r.width}px`,
      height: `${r.height}px`,
      margin: '0',
      boxShadow: 'none',
      pointerEvents: 'none',
      zIndex: '5',
    });
    menu.appendChild(g);
    return g;
  };
  const showPill = () => {
    const pill = document.querySelector<HTMLElement>('[data-float-menu]');
    pill?.setAttribute('data-init', '');
    document.documentElement.removeAttribute('data-menu-morph');
    requestAnimationFrame(() => requestAnimationFrame(() => pill?.removeAttribute('data-init')));
  };

  const open = (from: HTMLElement) => {
    const menu = active();
    if (!menu || menu.open || busy) return;
    opener = from;
    const pill = pillOf(from);
    menu.showModal();
    lock(true);
    setExpanded(true);
    if (reduced) return;
    const items = menu.querySelectorAll('[data-menu-item]');
    if (pill) {
      // Die Pille wird größer: Das Fenster beginnt als ihr Abbild (weiß, gleicher Umriss, gleiche Beschriftung), wächst aus diesem Umriss
      // gleichzeitig nach links, rechts und unten, die Beschriftung blendet dabei aus, der Inhalt des Menüs erst danach ein.
      const css = getComputedStyle(menu);
      const bg = css.backgroundColor;
      const radius = css.borderTopLeftRadius;
      const content = [...menu.children] as HTMLElement[];
      busy = true;
      const ghost = ghostOf(menu, pill);
      document.documentElement.setAttribute('data-menu-morph', '');
      gsap.set(menu, { clipPath: pillClip(menu, pill), backgroundColor: '#ffffff', '--bd': 0 });
      gsap.set(content, { opacity: 0 });
      gsap
        .timeline({
          onComplete: () => {
            ghost.remove();
            busy = false;
          },
        })
        .to(menu, { clipPath: `inset(0px 0px 0px 0px round ${radius})`, duration: 1, ease: 'power2.inOut' }, 0)
        .to(menu, { '--bd': 1, duration: 0.8, ease: 'power1.out' }, 0)
        .to(menu, { backgroundColor: bg, duration: 0.7, ease: 'power1.inOut' }, 0.1)
        .to(ghost, { opacity: 0, scale: 1.2, duration: 0.45, ease: 'power1.in' }, 0.05)
        .to(content, { opacity: 1, duration: 0.5, ease: 'power1.out', clearProps: 'opacity' }, 0.5)
        .set(menu, { clearProps: 'clipPath,backgroundColor,--bd' });
      gsap.fromTo(
        items,
        { opacity: 0, y: 22 },
        { opacity: 1, y: 0, duration: 0.55, stagger: 0.06, delay: 0.6, clearProps: 'opacity,transform' },
      );
      return;
    }
    const a = axis(menu);
    gsap.fromTo(menu, a.from, { ...a.to, duration: 0.75, ease: 'power3.out' });
    gsap.fromTo(
      items,
      { opacity: 0, y: 22 },
      { opacity: 1, y: 0, duration: 0.5, stagger: 0.06, delay: 0.3, clearProps: 'opacity,transform' },
    );
  };

  const close = (hash?: string) => {
    const menu = dialogs.find((d) => d.open);
    if (!menu || busy) return;
    busy = true;
    const pill = pillOf(opener);
    const done = () => {
      menu.close();
      lock(false);
      setExpanded(false);
      gsap.set(menu, { clearProps: 'transform,opacity,clipPath,backgroundColor,--bd' });
      gsap.set(menu.children, { clearProps: 'opacity' });
      busy = false;
      if (hash) {
        const target = document.querySelector<HTMLElement>(hash);
        if (target) {
          if (lenis) lenis.scrollTo(target, { offset: -25 });
          else target.scrollIntoView({ behavior: 'smooth' });
          history.replaceState(null, '', hash);
        }
      } else opener?.focus({ preventScroll: true });
    };
    if (reduced) done();
    else if (pill) {
      // Zurück in die Pille: Inhalt blendet zuerst aus, das Fenster zieht sich auf ihren Umriss zusammen und wird weiß, ihre Beschriftung
      // blendet wieder ein. Am Ende ist die echte Pille da, ohne dass etwas springt.
      const content = [...menu.children] as HTMLElement[];
      const ghost = ghostOf(menu, pill);
      gsap.set(ghost, { opacity: 0 });
      gsap.set(menu, { '--bd': 1 }); // Startwert festhalten, sonst fängt die Abdunklung bei 0 an und ist sofort weg
      gsap
        .timeline({
          onComplete: () => {
            showPill();
            ghost.remove();
            done();
          },
        })
        .to(content, { opacity: 0, duration: 0.2, ease: 'power1.in' }, 0)
        .to(menu, { clipPath: pillClip(menu, pill), duration: 0.7, ease: 'power2.inOut' }, 0)
        .to(menu, { backgroundColor: '#ffffff', duration: 0.5, ease: 'none' }, 0)
        .to(menu, { '--bd': 0, duration: 0.6, ease: 'power1.in' }, 0)
        .fromTo(ghost, { opacity: 0, scale: 1.2 }, { opacity: 1, scale: 1, duration: 0.4, ease: 'power1.out' }, 0.3);
    } else {
      const a = axis(menu);
      gsap.to(menu, { ...a.from, duration: 0.45, ease: 'power3.in', onComplete: done });
    }
  };

  document
    .querySelectorAll<HTMLElement>('[data-menu-open]')
    .forEach((b) => b.addEventListener('click', () => open(b)));
  dialogs.forEach((menu) => {
    menu.querySelector('[data-menu-close]')?.addEventListener('click', () => close());
    menu.addEventListener('cancel', (e) => {
      e.preventDefault();
      close();
    });
    // Klick auf die abgedunkelte Fläche neben der Seitenfläche schließt
    menu.addEventListener('click', (e) => {
      if (e.target === menu) close();
    });
    // Link auf einen Anker der aktuellen Seite: erst schließen, dann dorthin scrollen
    menu.querySelectorAll<HTMLAnchorElement>('a[href]').forEach((a) =>
      a.addEventListener('click', (e) => {
        if (a.pathname === location.pathname && a.hash) {
          e.preventDefault();
          close(a.hash);
        }
      }),
    );
  });

  // Desktop-Menü: Untermenü rechts anzeigen (Überfahren, Fokus oder Anwählen), sonst Kontakt
  const split = document.querySelector<HTMLDialogElement>('[data-variant="2"]');
  if (split) {
    const panels = [...split.querySelectorAll<HTMLElement>('[data-split-panel]')];
    const targets = [...split.querySelectorAll<HTMLElement>('[data-split-target]')];
    const show = (id: string) => {
      targets.forEach((t) =>
        t.toggleAttribute('data-active', t.dataset.splitTarget === id && id !== 'contact'),
      );
      panels.forEach((p) => p.toggleAttribute('data-show', p.dataset.splitPanel === id));
    };
    // Kurze Verzögerung (Hover-Absicht): Beim schnellen Überfahren mehrerer Punkte flackern keine Zwischenflächen
    let timer = 0;
    const later = (id: string) => {
      clearTimeout(timer);
      timer = window.setTimeout(() => show(id), 90);
    };
    targets.forEach((t) => {
      const id = t.dataset.splitTarget!;
      t.addEventListener('mouseenter', () => later(id));
      t.addEventListener('focus', () => show(id));
      t.addEventListener('mouseleave', () => clearTimeout(timer));
      if (t.tagName === 'BUTTON') t.addEventListener('click', () => show(id));
    });
    split.addEventListener('close', () => show('contact'));
  }

  // Kurzes Formular im Menü: noch nicht angebunden, wie beim Kontaktformular nur eine Meldung
  document.querySelectorAll<HTMLFormElement>('form[data-menu-form]').forEach((form) =>
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const message = form.querySelector<HTMLElement>('[data-form-message]');
      if (message) message.hidden = false;
    }),
  );
</script>
