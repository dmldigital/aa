---
import { Picture } from 'astro:assets';
import TeamCard from '../TeamCard.astro';
import { href } from '../../data/links';
import Timeline from '../Timeline.astro';
import TimelinePin from '../TimelinePin.astro';
import {
  team,
  founder,
  memorial,
  timeline,
  haltung,
  exklusiveTeam,
  exklusiveFounder,
  exklusiveHaltung,
} from '../../data/pages/studio';

interface Props {
  /** Teil-Website Exklusive: andere Texte, Profil-Links und Aufbau von Team und Text (Zeitleiste nur Desktop). */
  exklusive?: boolean;
}
const { exklusive = false } = Astro.props;
const people = exklusive ? exklusiveTeam : team;
const head = exklusive ? exklusiveFounder : founder;
const ex = exklusiveHaltung;

/** Haltungs-Text der Seite /studio/ in Bausteine zerlegt, damit er gestaltet statt als Fließtext gesetzt werden kann. */
const [lead, meansLabel, meansList, statement, teamBlock, closing] = haltung.html as [
  string,
  string,
  { list: string[] },
  string,
  string,
  string,
];
const strip = (html: string) => html.replace(/<[^>]+>/g, '');
const splitDash = (text: string): [string, string] => {
  const i = text.indexOf(' – ');
  return i < 0 ? [text, ''] : [text.slice(0, i), text.slice(i + 3)];
};
const points = meansList.list.map(splitDash);
const initials = (name: string) =>
  name
    .split(' ')
    .map((w) => w[0])
    .join('')
    .slice(0, 2);
const teamMatch = teamBlock.match(/<strong>(.*?)<\/strong><br \/>(.*)/s);
const [teamKicker, teamTitle] = splitDash(strip(teamMatch?.[1] ?? 'Unser Team'));
const teamText = teamMatch?.[2] ?? '';

/**
 * Team und Haltung der Seite /studio/. Das Original hat dafür zwei Desktop-Container (4ea78bd Gründer und Zeitleiste,
 * 2257150 Team und Text) und einen für Tablet/Handy (1eb1fb2; dort steht der Gründer mit der Zeitleiste im Pin-and-Scroll
 * zwischen Text und Team).
 */
---

<!-- Desktop: Gründer und Zeitleiste -->
<section
  data-section="4ea78bd"
  data-tl-scene
  class:list={[exklusive ? 'mt-6.75' : 'mt-22.5', 'hidden flex-col overflow-x-clip px-7.5 lg:flex']}
>
  <div class="mx-auto flex w-full max-w-page justify-between gap-x-7.5">
    <div data-tl-founder data-tl-pending class="relative z-10 flex w-44 shrink-0 flex-col">
      <h6 class="font-display text-label font-medium tracking-label text-ink uppercase">
        {memorial}
      </h6>
      <a href={href(head.href)} class="fc">
        <span class="fc-photo">
          <Picture
            formats={['avif']}
            fallbackFormat="webp"
            src={head.img}
            alt={head.alt}
            widths={[176, 352, 438]}
            sizes="176px"
            loading="lazy"
            class="fc-img"
          />
          <span class="fc-shade" aria-hidden="true"></span>
          <span class="fc-frame" aria-hidden="true"></span>
          <span class="fc-go" aria-hidden="true">Zum Profil ↗</span>
        </span>
        <span class="fc-meta">
          <span class="fc-name">{head.name}</span>
          <span>/</span>
          <span>{head.role}</span>
        </span>
      </a>
    </div>
    <div class="flex flex-1 flex-col justify-center">
      <Timeline items={timeline} />
    </div>
  </div>
</section>

{exklusive ? (
  <section
    data-section="2257150"
    class="mt-19.5 mb-0 flex flex-col px-5 md:mt-0 md:mb-15 md:px-5 lg:mt-27 lg:mb-18 lg:px-7.5"
  >
    <div class="mx-auto flex w-full max-w-tablet flex-col gap-5 md:max-w-tablet md:flex-row md:justify-between md:gap-x-7.5 lg:max-w-page">
      <div class="order-2 grid grid-cols-1 items-start gap-y-6.25 md:order-1 md:w-119.25 md:shrink-0 md:grid-cols-2 md:gap-x-5 md:gap-y-7.5 lg:w-172.5 lg:gap-x-7.5">
        {people.map((m) => (
          <TeamCard
            member={m}
            textClass="text-body"
            sizes="(min-width: 1025px) 330px, (min-width: 768px) 229px, 350px"
            widths={[229, 350, 458, 660, 700]}
          />
        ))}
      </div>
      <div class="order-1 mb-1.25 flex flex-col gap-3.75 md:order-2 md:mb-0 md:w-119.25 md:shrink-0 lg:w-141.5 lg:gap-5 lg:pr-[8%]">
        <h6 class="font-display text-label font-medium tracking-label text-ink uppercase">
          {ex.eyebrow}
        </h6>
        <h2 class="font-display text-h2 font-medium text-ink lg:mb-5">
          {ex.heading}
        </h2>
        <div class="-mb-4.25 text-body lg:-mb-[25.5px] [&>p]:mb-4.25 lg:[&>p]:mb-[25.5px]">
          {ex.html.map((html) => (
            <p set:html={html} />
          ))}
        </div>
        <h6 class="font-display text-label font-medium tracking-label text-ink uppercase">
          {ex.teamEyebrow}
        </h6>
        <h5 class="font-display text-h4 text-ink">
          {ex.milestones}
        </h5>
        <h2 class="font-display text-h2 font-medium text-ink lg:mb-5">
          {ex.teamHeading}
        </h2>
        <div class="-mb-4.25 text-body lg:-mb-[25.5px] [&>p]:mb-4.25 lg:[&>p]:mb-[25.5px]">
          {ex.teamHtml.map((html) => (
            <p set:html={html} />
          ))}
        </div>
      </div>
    </div>
  </section>
) : (
  <>
    <!-- Desktop: Text links, Team als Bild-Akkordeon rechts (Hover klappt das Bild auf, Klick führt zum Profil) -->
    <section
      data-section="2257150"
      data-ta-scene
      data-ta-pend
      class="mt-45 mb-22.5 hidden flex-col px-7.5 lg:flex"
    >
      <div class="mx-auto flex w-full max-w-page justify-between gap-x-12.5">
        <div class="flex w-141.5 shrink-0 flex-col pr-[3%]">
          <h6 class="ta-eyebrow font-display text-label font-medium tracking-label text-ink uppercase">
            {haltung.eyebrow}
          </h6>
          <h1 class="mt-6 font-display text-h1 font-medium text-ink">
            {haltung.heading}
          </h1>
          <p class="mt-8 text-lead text-muted" set:html={lead} />

          <h6 class="mt-12 font-display text-label font-medium tracking-label text-gold uppercase">
            {strip(meansLabel)}
          </h6>
          <ul class="mt-4">
            {points.map(([title, text]) => (
              <li class="grid grid-cols-[22px_1fr] gap-x-2 border-t border-black/10 py-4 last:border-b">
                <span class="mt-2.25 block size-1.5 bg-gold" aria-hidden="true"></span>
                <div>
                  <h3 class="font-display text-h4 text-ink">{title}</h3>
                  {text && <p class="mt-1 text-body text-muted">{text}</p>}
                </div>
              </li>
            ))}
          </ul>

          <p
            class="mt-12 border-l-2 border-gold pl-6 font-display text-h3 font-normal text-ink"
            set:html={statement}
          />

          <h6 class="mt-12 font-display text-label font-medium tracking-label text-gold uppercase">
            {teamKicker}
          </h6>
          <h3 class="mt-3 font-display text-h2 font-medium text-ink">{teamTitle}</h3>
          <p class="mt-4 text-body text-muted" set:html={teamText} />
          <p class="mt-6 text-body text-ink" set:html={closing} />
        </div>

        <div class="min-w-0 flex-1 self-start lg:sticky lg:top-24">
          <ul class="ta" data-ta aria-label="Unser Team">
            {team.map((m, i) => (
              <li class:list={['ta-item', i === 0 && 'is-active']} data-ta-item>
                <a href={href(m.href)} class="ta-link" aria-label={`${m.name}, ${m.role}`}>
                  {m.noPhoto ? (
                    <span class="ta-mono" aria-hidden="true">
                      <span class="ta-mono-letters">{initials(m.name)}</span>
                    </span>
                  ) : (
                    <Picture
                      formats={['avif']}
                      fallbackFormat="webp"
                      src={m.img}
                      alt={m.alt}
                      widths={[330, 480, 700, 960]}
                      sizes="(min-width: 1025px) 480px, 330px"
                      loading="lazy"
                      class="ta-img"
                    />
                  )}
                  <span class="ta-shade" aria-hidden="true"></span>
                  <span class="ta-cap">
                    <span class="ta-name">{m.name}</span>
                    <span class="ta-role">{m.role}</span>
                    <span class="ta-go">Zum Profil ↗</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- Tablet und Handy -->
    <section
      data-section="1eb1fb2"
      class="mt-[10vh] mb-[10vh] flex flex-col px-5 md:mt-0 md:mb-15 lg:hidden"
    >
      <div class="mx-auto flex w-full max-w-tablet flex-col justify-between gap-y-6.25 md:flex-row md:flex-wrap md:gap-x-7.5">
        <div class="order-1 flex flex-col gap-3.75 md:order-2 md:mt-5 md:w-119.25 md:shrink-0">
          <h6 class="font-display text-label font-medium tracking-label text-ink uppercase">
            {haltung.eyebrow}
          </h6>
          <h1 class="font-display text-h1 font-medium text-ink">{haltung.heading}</h1>
          <div class="text-body [&>p]:mb-3.75">
            {haltung.html.map((block) =>
              typeof block === 'string' ? (
                <p set:html={block} />
              ) : (
                <ul class="my-4.25 list-disc pl-[28.9px]">
                  {block.list.map((li) => (
                    <li class="pl-[6.375px]">
                      <p class="mb-3.75 text-body">{li}</p>
                    </li>
                  ))}
                </ul>
              ),
            )}
          </div>
        </div>

        <!-- Zeitleiste: Pin-and-Scroll, läuft beim Scrollen durch die Jahre (Handy und Tablet) -->
        <TimelinePin
          class="order-2 md:order-3 md:w-full"
          title={haltung.toggle}
          items={timeline}
          member={founder}
          label={memorial}
        />
        <div class="order-3 grid auto-rows-fr grid-cols-2 content-start gap-x-5 gap-y-6.25 md:order-1 md:max-w-119.25 md:min-w-0 md:flex-1 md:basis-0 md:gap-y-7.5">
          {team.map((m) => (
            <TeamCard member={m} />
          ))}
        </div>
      </div>
    </section>
  </>
)}

<script>
  import { initTimelineDesktop } from '../../scripts/timeline';

  initTimelineDesktop();
</script>

<script>
  import { gsap, ScrollTrigger } from '../../scripts/motion';

  /*
   * Team-Akkordeon (Desktop): Bei Hover oder Fokus klappt das Bild auf, die anderen werden schmal. Das zuletzt
   * angewählte bleibt offen. Auf Touch-Geräten öffnet der erste Tipp das Bild, der zweite führt zum Profil.
   */
  const scene = document.querySelector<HTMLElement>('[data-ta-scene]');
  const items = scene ? [...scene.querySelectorAll<HTMLElement>('[data-ta-item]')] : [];
  if (scene && items.length) {
    let touched = false;
    const activate = (i: number) => items.forEach((it, k) => it.classList.toggle('is-active', k === i));
    items.forEach((it, i) => {
      it.addEventListener('pointerenter', (e) => {
        if (e.pointerType === 'mouse') activate(i);
      });
      it.addEventListener('pointerdown', (e) => {
        touched = e.pointerType !== 'mouse';
      });
      it.addEventListener('focusin', () => activate(i));
      it.querySelector('a')?.addEventListener('click', (e) => {
        if (touched && !it.classList.contains('is-active')) {
          e.preventDefault();
          activate(i);
        }
        touched = false;
      });
    });

    // Auftritt: Die Bilder steigen gestaffelt von unten auf, sobald der Bereich im Bild ist
    const mm = gsap.matchMedia();
    mm.add('(min-width: 64.0625rem) and (prefers-reduced-motion: no-preference)', () => {
      gsap.set(items, { y: 48, autoAlpha: 0 });
      scene.removeAttribute('data-ta-pend');
      const tl = gsap.timeline({ paused: true });
      tl.to(items, { y: 0, autoAlpha: 1, duration: 1.1, ease: 'power3.out', stagger: 0.12 });
      const st = ScrollTrigger.create({
        trigger: scene.querySelector('[data-ta]'),
        start: 'top 85%',
        once: true,
        onEnter: () => tl.play(),
      });
      return () => {
        st.kill();
        tl.kill();
        gsap.set(items, { clearProps: 'transform,opacity,visibility' });
      };
    });
  }
</script>

<style>
  .ta {
    --ta-h: clamp(480px, calc(100svh - 190px), 760px);
    display: flex;
    gap: 10px;
    height: var(--ta-h);
    container-type: inline-size;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .ta-item {
    position: relative;
    flex: 1 1 0;
    min-width: 0;
    overflow: hidden;
    background: #1b1a18;
    transition: flex-grow 0.85s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .ta-item.is-active {
    flex-grow: 6;
  }
  .ta-link {
    position: absolute;
    inset: 0;
    display: block;
    color: #fff;
    text-decoration: none;
  }
  /* Das Bild ist eine feste Ebene in Breite des geöffneten Streifens und steht mittig, die wachsende Box deckt nur mehr
     davon auf. So bewegt sich das Bild selbst nicht, es gibt weder Zoom noch neuen Zuschnitt. (60cqw minus 24px ist
     die Breite des geöffneten Streifens: sechs von zehn Teilen der Zeile ohne die vier Abstände.) */
  .ta-link :global(.ta-img) {
    position: absolute;
    top: 0;
    left: 50%;
    width: calc(60cqw - 24px);
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: 50% 20%;
    transform: translateX(-50%);
    filter: grayscale(1);
    transition: filter 0.8s ease;
  }
  .ta-item.is-active :global(.ta-img) {
    filter: grayscale(0);
  }
  .ta-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(9 4 2 / 0.78) 0%, rgb(9 4 2 / 0.12) 55%, rgb(9 4 2 / 0.28) 100%);
    transition: background-color 0.8s ease;
  }
  .ta-item:not(.is-active) .ta-shade {
    background-color: rgb(9 4 2 / 0.22);
  }
  /*
   * Der Name ist ein einziges Element: Schmal steht er hochkant am Fuß, beim Aufklappen dreht er sich weich auf
   * und wächst auf Normalgröße (Drehpunkt links unten, Position, Drehung und Größe laufen im selben Zug).
   */
  .ta-cap {
    --cap-h: 94px;
    position: absolute;
    right: 28px;
    bottom: 30px;
    left: 28px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    height: var(--cap-h);
    padding-top: 37px;
  }
  .ta-name {
    position: absolute;
    top: calc(var(--cap-h) + 8px - 31px);
    left: calc(50% + 9px);
    font-family: var(--font-display);
    font-size: var(--text-h3);
    line-height: var(--text-h3--line-height);
    font-weight: 500;
    letter-spacing: 0.01em;
    white-space: nowrap;
    transform-origin: 0 100%;
    transform: rotate(-90deg) scale(0.58);
    transition:
      top 0.9s cubic-bezier(0.22, 1, 0.36, 1),
      left 0.9s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.9s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .ta-item.is-active .ta-name {
    top: 0;
    left: 0;
    transform: none;
  }
  .ta-role,
  .ta-go {
    opacity: 0;
    transform: translateY(12px);
    transition:
      opacity 0.3s ease,
      transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .ta-item.is-active .ta-role,
  .ta-item.is-active .ta-go {
    opacity: 1;
    transform: none;
    transition-duration: 0.55s, 0.7s;
    transition-delay: 0.35s;
  }
  .ta-item.is-active .ta-go {
    transition-delay: 0.45s;
  }
  .ta-role {
    font-size: var(--text-body);
    line-height: var(--text-body--line-height);
    color: rgb(255 255 255 / 0.82);
  }
  .ta-go {
    margin-top: 8px;
    width: fit-content;
    border-bottom: 1px solid var(--color-gold);
    padding-bottom: 4px;
    font-family: var(--font-display);
    font-size: var(--text-label);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .ta-link:hover .ta-go,
  .ta-link:focus-visible .ta-go {
    border-bottom-color: #fff;
  }

  /* Noch kein Foto: Monogramm auf ruhigem Steingrund, eigene Gestaltung statt Platzhalterbild */
  .ta-mono {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    width: calc(60cqw - 24px);
    padding-top: 22%;
    overflow: hidden;
    background: radial-gradient(120% 70% at 50% 28%, #4a463f 0%, #2a2824 55%, #1b1a18 100%);
    transform: translateX(-50%);
  }
  .ta-mono::before,
  .ta-mono::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    width: 1px;
    background: rgb(255 255 255 / 0.07);
  }
  .ta-mono::before {
    left: 33%;
  }
  .ta-mono::after {
    right: 33%;
  }
  .ta-mono-letters {
    font-family: var(--font-display);
    font-size: clamp(120px, 14vw, 190px);
    line-height: 1;
    font-weight: 300;
    letter-spacing: 0.04em;
    color: transparent;
    -webkit-text-stroke: 1px var(--color-gold);
    opacity: 0;
    transition: opacity 0.6s ease;
  }
  .ta-item.is-active .ta-mono-letters {
    opacity: 1;
    transition-delay: 0.3s;
  }
  .ta-link:focus-visible {
    outline: 2px solid var(--color-gold);
    outline-offset: -4px;
  }
  /* Gründer in der Zeitleiste: Hover ohne Zoom. Das Foto wird farbig, unten läuft ein Schatten auf, ein feiner heller
     Rahmen zieht sich ein, „Zum Profil“ steigt auf, der Name wird golden. */
  .fc {
    display: flex;
    flex-direction: column;
    gap: 10px;
    color: var(--color-ink);
    text-decoration: none;
  }
  .fc-photo {
    position: relative;
    display: block;
    overflow: hidden;
  }
  .fc-photo :global(.fc-img) {
    display: block;
    width: 100%;
    height: auto;
    filter: grayscale(1);
    transition: filter 0.9s ease;
  }
  .fc-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(9 4 2 / 0.7) 0%, rgb(9 4 2 / 0) 55%);
    opacity: 0;
    transition: opacity 0.7s ease;
  }
  .fc-frame {
    position: absolute;
    inset: 16px;
    border: 1px solid rgb(255 255 255 / 0.85);
    opacity: 0;
    transition:
      opacity 0.6s ease,
      inset 0.9s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .fc-go {
    position: absolute;
    bottom: 24px;
    left: 24px;
    padding-bottom: 3px;
    border-bottom: 1px solid var(--color-gold);
    color: #fff;
    font-family: var(--font-display);
    font-size: var(--text-label);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    opacity: 0;
    transform: translateY(8px);
    transition:
      opacity 0.5s ease,
      transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .fc-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 5px;
    color: var(--color-muted);
    font-size: var(--text-body);
    line-height: var(--text-body--line-height);
  }
  .fc-name {
    font-weight: 600;
    transition: color 0.4s ease;
  }
  .fc:hover :global(.fc-img),
  .fc:focus-visible :global(.fc-img) {
    filter: grayscale(0);
  }
  .fc:hover .fc-shade,
  .fc:focus-visible .fc-shade {
    opacity: 1;
  }
  .fc:hover .fc-frame,
  .fc:focus-visible .fc-frame {
    inset: 10px;
    opacity: 1;
  }
  .fc:hover .fc-go,
  .fc:focus-visible .fc-go {
    opacity: 1;
    transform: none;
    transition-delay: 0.15s;
  }
  .fc:hover .fc-name,
  .fc:focus-visible .fc-name {
    color: var(--color-gold);
  }
</style>
