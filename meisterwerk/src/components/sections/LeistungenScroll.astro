---
/**
 * Leistungen der Startseite: Pin- und Scroll-Sektion von rechts nach links.
 * Die Sektion bleibt stehen (Pin), Überschrift und Zähler bleiben oben, die Karten ziehen beim Scrollen als eine Reihe von rechts
 * nach links durchs Bild, die Bilder gleiten dabei ganz leicht gegenläufig. Die letzte Karte (Meisterwerke Exklusive) endet mit
 * demselben Randabstand wie die Überschrift. Jede Karte ist ein Link: Bild, Titel, ein Satz, runder Pfeil.
 * Gleicher Ablauf auf Handy und Desktop. Reduzierte Bewegung oder sehr flache Fenster: kein Pin, die Reihe lässt sich wischen.
 * Skript unten (GSAP-Pin, `scrub`), Abstände aus dem Abstandssystem.
 */
import { Picture } from 'astro:assets';
import { href } from '../../data/links';
import { cards } from '../../data/services';
import logo from '../../assets/img/logo_exklusive.png';
import raum from '../../assets/img/2026-04-14-glatte-waende-kinderzimmer.jpg';
import treppe from '../../assets/img/2018-meisterwerk-20230524-Bearbeitet-scaled.jpg';
import tapete from '../../assets/img/2026-04-14-tapete-schlafzimmer.jpg';
import fassade from '../../assets/img/2026-05-28-fassade-verputzt.jpg';
import dunkleWand from '../../assets/img/188-mw-20241125-scaled.jpg';

// Titel, Satz und Alt-Text wie in der Auswahl-Vorschau (lokale Texte der Startseite)
const copy: Record<string, [string, string, string]> = {
  '/services/glatte-waende/': [
    'Glatte Wände & Q4-⁠Spachtelung',
    'Perfekt glatte Oberflächen in Q3 und Q4, modern und sauber',
    'Glatte Wände: Kinderzimmer mit perfekt glatter, tiefblau gestrichener Wand',
  ],
  '/services/lackierarbeiten/': [
    'Lackierarbeiten',
    'Türen, Fenster und Treppen, innen wie außen, mit dauerhaftem Schutz',
    'Lackierarbeiten: weiß lackiertes Treppengeländer mit Holzhandlauf vor einem Fenster',
  ],
  '/services/malerarbeiten/': [
    'Malerarbeiten',
    'Innen- und Außenanstrich mit Farbberatung, präzise und sauber',
    'Malerarbeiten im Wohnzimmer: frisch gestrichene Wände, graues Sofa und Vorhänge',
  ],
  '/services/tapezieren/': [
    'Tapezierarbeiten',
    'Tapeten an Wand und Decke, mit Fachberatung zur Auswahl',
    'Tapezierarbeiten: Schlafzimmer mit Wandbild-Tapete über die ganze Wand',
  ],
  '/services/verputzen/': [
    'Verputzarbeiten',
    'Innen- und Außenputz und dekorative Oberflächen, langlebig ausgeführt',
    'Verputzarbeiten: frisch verputzte Fassade eines Hauses mit weißem Putz und rotem Ziegeldach',
  ],
};
// Bilder der Startseite (Kundenwunsch vom 07.11.): Raum statt Treppe, Treppe ganz sichtbar, ganze Tapetenwand, Fassade. Glatte Wände, Tapeten und Fassade
// stammen aus den neuen Shootings 2026 (Drive des Fotografen), die Treppe aus dem Projekt von 2023.
const photo: Record<string, { img: ImageMetadata; pos: string }> = {
  '/services/glatte-waende/': { img: raum, pos: '50% 50%' },
  '/services/lackierarbeiten/': { img: treppe, pos: '60% 50%' },
  '/services/tapezieren/': { img: tapete, pos: '50% 50%' },
  '/services/verputzen/': { img: fassade, pos: '45% 50%' },
};
const items = cards.map((c) => ({
  href: c.href,
  title: copy[c.href]?.[0] ?? c.title,
  sub: copy[c.href]?.[1] ?? c.subtitle ?? '',
  alt: copy[c.href]?.[2] ?? c.alt,
  img: photo[c.href]?.img ?? c.img,
  pos: photo[c.href]?.pos ?? '50% 50%',
}));
const total = String(items.length + 1).padStart(2, '0');
const sizes = '(min-width: 1025px) 28vw, 80vw';
const widths = [252, 350, 477, 700, 954];

const card =
  'group/card flex h-full flex-col bg-white text-ink no-underline focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-ink';
const arrow =
  'grid size-11 shrink-0 self-end place-items-center rounded-full bg-soft text-ink transition-colors duration-300 group-hover/card:bg-gold group-hover/card:text-white';
const body = 'lk-text flex flex-none items-start justify-between gap-stack p-inner';
---

<section data-lk data-no-autolink aria-labelledby="lk-title" class="bg-soft text-ink">
  <div class="mx-auto grid w-full max-w-page gap-text px-page pt-section pb-group lg:grid-cols-12 lg:items-end lg:gap-x-stack">
    <div class="flex flex-col gap-text lg:col-span-7">
      <p class="font-display text-label font-medium tracking-label text-ink uppercase">Unsere Leistungen</p>
      <h2 id="lk-title" class="font-display text-h2 font-medium text-balance text-gold">
        Ihr Malerbetrieb für Ludwigsburg, Marbach und Bietigheim-Bissingen
      </h2>
    </div>
    <p class="max-w-[28rem] text-body text-muted max-lg:hidden lg:col-span-4 lg:col-start-9">
      Meisterbetrieb aus Freiberg am Neckar für Ludwigsburg, Marbach, Bietigheim-Bissingen und Stuttgart.
    </p>
  </div>

  <div
    data-lk-stage
    class="flex flex-col pb-section lk-p:h-svh lk-p:overflow-clip lk-p:pt-[clamp(72px,10svh,104px)] lk-p:pb-[clamp(96px,13svh,120px)]"
  >
    <div
      aria-hidden="true"
      class="mx-auto mb-stack hidden w-full max-w-page shrink-0 items-baseline justify-between px-page font-display text-label tracking-label text-muted uppercase lk-p:flex"
    >
      <span>Leistungen</span>
      <span><b data-lk-count class="font-medium text-ink">01</b> / {total}</span>
    </div>

    <!-- Fenster: Der Container misst seine Höhe, daraus ergeben sich Kartenbreite und Bildhöhe (Bild und Text bleiben im Verhältnis) -->
    <div
      data-lk-window
      class="lk-win relative flex h-[34rem] snap-x snap-mandatory items-center overflow-x-auto overscroll-x-contain [scrollbar-width:none] lk-p:h-auto lk-p:min-h-0 lk-p:flex-1 lk-p:snap-none lk-p:overflow-clip [&::-webkit-scrollbar]:hidden"
    >
      <ul
        data-lk-track
        class="flex w-max items-stretch gap-stack px-[max(var(--space-gutter),calc((100vw-var(--container-page))/2+var(--space-gutter)))] will-change-transform"
      >
        {items.map((it) => (
          <li data-lk-card class="lk-card shrink-0 snap-start">
            <a href={href(it.href)} class={card}>
              <div class="lk-media relative overflow-hidden">
                <Picture
                  formats={['avif']}
                  fallbackFormat="webp"
                  src={it.img}
                  alt={it.alt}
                  {widths}
                  {sizes}
                  loading="lazy"
                  pictureAttributes={{ class: 'contents' }}
                  class="absolute inset-0 size-full scale-[1.12] object-cover transition-[scale] duration-700 ease-out group-hover/card:scale-[1.17]"
                  style={`object-position: ${it.pos}`}
                  data-lk-img
                />
              </div>
              <div class={body}>
                <div>
                  <h3 class="font-display text-h3 font-medium">{it.title}</h3>
                  <p class="mt-text text-body text-muted">{it.sub}</p>
                </div>
                <span class={arrow} aria-hidden="true">
                  <svg class="size-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true" focusable="false"><path d="M2 8h11" /><path d="m9 4 4 4-4 4" /></svg>
                </span>
              </div>
            </a>
          </li>
        ))}
        <li data-lk-card class="lk-card lk-card--ex shrink-0 snap-start">
          <a href={href('/meisterwerk-exklusive/')} class={card}>
            <div class="lk-media relative grid place-items-center overflow-hidden bg-ink">
              <Picture
                formats={['avif']}
                fallbackFormat="webp"
                src={dunkleWand}
                alt=""
                {widths}
                {sizes}
                loading="lazy"
                pictureAttributes={{ class: 'contents' }}
                class="absolute inset-0 size-full scale-[1.12] object-cover transition-[scale] duration-700 ease-out group-hover/card:scale-[1.17]"
                data-lk-img
              />
              <Picture
                formats={['avif']}
                fallbackFormat="webp"
                src={logo}
                alt="Meisterwerke Exklusive by Baldassarre Fortino"
                sizes="240px"
                widths={[240, 480]}
                loading="lazy"
                pictureAttributes={{ class: 'relative block w-[58%] max-w-[250px]' }}
                class="block h-auto w-full brightness-0 invert"
              />
            </div>
            <div class={body}>
              <div>
                <h3 class="font-display text-h3 font-medium">Fugenlose Bäder und Böden, Spachteltechniken und Stuckleisten</h3>
                <p class="mt-text text-body text-muted">
                  Unsere Spezialleistungen als Meisterbetrieb. Im Showroom in Freiberg am Neckar sehen Sie die Oberflächen persönlich.
                </p>
              </div>
              <span class={arrow} aria-hidden="true">
                <svg class="size-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true" focusable="false"><path d="M2 8h11" /><path d="m9 4 4 4-4 4" /></svg>
              </span>
            </div>
          </a>
        </li>
      </ul>
    </div>
  </div>
</section>

<style>
  /* Bild und Text im festen Verhältnis, auf jedem Gerät gleich: Die Karte ist so hoch wie das Bild (4:5) plus der Text. Ist das
     Fenster flacher, wird das Bild niedriger und die Karte zugleich schmaler, sodass das Bild nie flacher als 4:3 wird.
     --lk-tp = Platz für den Text der Fotokarten, --lk-te = Platz für den längeren Text der Karte „Meisterwerke Exklusive“
     (dort ist die Logo-Fläche entsprechend niedriger). Alle Fotokarten haben so gleich große Bilder und gleich hohe Textflächen. */
  .lk-win {
    container-type: size;
  }
  .lk-card {
    --lk-tp: 12rem;
    --lk-te: 17.5rem;
    --lk-w: min(80vw, 340px, max(200px, calc((100cqh - var(--lk-tp)) / 0.75)));
    width: var(--lk-w);
    height: min(100cqh, calc(var(--lk-w) * 1.25 + var(--lk-tp)));
  }
  .lk-media {
    flex: 1 1 0;
    min-height: 6rem;
  }
  .lk-text {
    min-height: var(--lk-tp);
  }
  .lk-card--ex .lk-text {
    min-height: var(--lk-te);
  }
  @media (min-width: 768px) {
    .lk-card {
      --lk-tp: 13rem;
      --lk-te: 21rem;
      --lk-w: min(clamp(300px, 28vw, 440px), max(220px, calc((100cqh - var(--lk-tp)) / 0.75)));
    }
  }
  @media (min-width: 1025px) {
    .lk-card {
      --lk-tp: 12.5rem;
      --lk-te: 19.5rem;
    }
  }
</style>

<script>
  import { gsap } from '../../scripts/motion';

  const sec = document.querySelector<HTMLElement>('[data-lk]');
  if (sec) {
    const stage = sec.querySelector<HTMLElement>('[data-lk-stage]')!;
    const win = sec.querySelector<HTMLElement>('[data-lk-window]')!;
    const track = sec.querySelector<HTMLElement>('[data-lk-track]')!;
    const count = sec.querySelector<HTMLElement>('[data-lk-count]');
    const imgs = [...track.querySelectorAll<HTMLElement>('[data-lk-img]')];
    const n = track.querySelectorAll('[data-lk-card]').length;
    const pad = (v: number) => String(v).padStart(2, '0');
    const mm = gsap.matchMedia();

    // Pin und Scroll von rechts nach links: Die Sektion bleibt stehen, die Kartenreihe wandert mit dem Scrollen nach links.
    // Reduzierte Bewegung oder sehr flache Fenster: kein Pin, die Reihe lässt sich wischen (CSS).
    mm.add('(min-height: 560px) and (prefers-reduced-motion: no-preference)', () => {
      const travel = () => Math.max(0, track.scrollWidth - win.clientWidth);
      // Scrollweg etwas länger als die Strecke der Karten: ruhiger, jede Karte steht einen Moment im Bild
      const ratio = () => (window.innerWidth < 768 ? 1.15 : 1.5);
      const tl = gsap.timeline({
        defaults: { ease: 'none' },
        scrollTrigger: {
          trigger: stage,
          start: 'top top',
          end: () => `+=${Math.round(travel() * ratio())}`,
          pin: stage,
          scrub: 0.8,
          anticipatePin: 1,
          invalidateOnRefresh: true,
          refreshPriority: 5, // nach den Pins weiter oben (Willkommen: 10) messen, damit der Start stimmt
          onUpdate: (self) => {
            if (count) count.textContent = pad(1 + Math.round(self.progress * (n - 1)));
          },
        },
      });
      tl.to(track, { x: () => -travel() }, 0);
      tl.fromTo(imgs, { xPercent: 4 }, { xPercent: -4 }, 0);
      return () => {
        tl.scrollTrigger?.kill();
        tl.kill();
        gsap.set([track, ...imgs], { clearProps: 'transform' });
        if (count) count.textContent = '01';
      };
    });
  }
</script>
