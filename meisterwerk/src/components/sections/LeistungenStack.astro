---
/**
 * Leistungen der Startseite (aus der Auswahl-Vorschau in die Quelle übertragen, vorher `LeistungenStack.css/js`).
 * Hellgraue Fläche, Label, goldene Überschrift, weiße Karten (Bild oben, Text darunter), letzte Karte Meisterwerke Exklusive.
 * Desktop/Tablet (ab 701 px, `lk-d`): Text links bleibt stehen, die Karten fahren beim Scrollen von rechts übereinander,
 * bis die letzte Karte rechts denselben Randabstand hat wie die Überschrift links (ohne Fortschrittslinie, ohne Autolinks).
 * Handy (bis 700 px, Höhe ab 650 px, `lk-m`): Überschrift oben, darunter stapeln sich die Karten von unten übereinander.
 * Handy-Karte: Zähler (01 / 06) klein und gold über dem Titel, ein Satz, runder Pfeil-Knopf unten rechts; die Karte endet
 * über dem schwebenden Button „Projekt starten“. Exklusive-Karte im selben Aufbau, Logo auf zarter Goldfläche statt Foto.
 * Reduzierte Bewegung oder flache Fenster: Karten untereinander (Handy) bzw. im Raster (Desktop).
 */
import { Picture } from 'astro:assets';
import { href } from '../../data/links';
import { cards } from '../../data/services';
import Button from '../ui/Button.astro';
import logo from '../../assets/img/logo_exklusive.png';

// Titel, Satz und Alt-Text wie in der Auswahl-Vorschau (lokale Texte der Startseite)
const copy: Record<string, [string, string, string]> = {
  '/services/glatte-waende/': [
    'Glatte Wände & Q4-⁠Spachtelung',
    'Perfekt glatte Oberflächen in Q3 und Q4, modern und sauber',
    'Glatte Wände im Treppenhaus: helle Treppe mit Holzstufen und weiß gestrichenen Wänden',
  ],
  '/services/lackierarbeiten/': [
    'Lackierarbeiten',
    'Türen, Fenster und Treppen, innen wie außen, mit dauerhaftem Schutz',
    'Lackierarbeiten: weiß lackiertes Treppengeländer mit Holzhandlauf vor einem Fenster',
  ],
  '/services/malerarbeiten/': [
    'Malerarbeiten',
    'Innen- und Außenanstrich mit Farbberatung, präzise und sauber',
    'Malerarbeiten im Wohnzimmer: frisch gestrichene Wände, graues Sofa und Vorhänge',
  ],
  '/services/tapezieren/': [
    'Tapezierarbeiten',
    'Tapeten an Wand und Decke, mit Fachberatung zur Auswahl',
    'Tapezierarbeiten: Wand mit hellem Ornamentmuster und indirekter Beleuchtung',
  ],
  '/services/verputzen/': [
    'Verputzarbeiten',
    'Innen- und Außenputz und dekorative Oberflächen, langlebig ausgeführt',
    'Verputzarbeiten: Flur mit fein verputzten Wänden und Decke',
  ],
};
const items = cards.map((c) => ({
  href: c.href,
  title: copy[c.href]?.[0] ?? c.title,
  sub: copy[c.href]?.[1] ?? c.subtitle ?? '',
  alt: copy[c.href]?.[2] ?? c.alt,
  img: c.img,
}));
const total = String(items.length + 1).padStart(2, '0');
const nr = (i: number) => `${String(i + 1).padStart(2, '0')} / ${total}`;
const sizes = '(min-width: 1800px) 500px, (min-width: 701px) 32vw, calc(100vw - 42px)';
const widths = [252, 350, 477, 700, 954];

// Karte (Bild- und Logo-Karte gemeinsam)
const card =
  'relative flex flex-col bg-white text-ink no-underline focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-ink lk-d:h-[475px] lk-d:w-[clamp(350px,32vw,500px)] lk-d:shrink-0 lk-xl:h-[530px] lk-t:w-[min(350px,calc(.65*(100vw_-_var(--lk-gutter))_-_var(--lk-gutter)_-_5*var(--lk-strip)_-_16px))] lk-m:absolute lk-m:inset-0 lk-m:size-full lk-m:origin-top lk-m:will-change-transform lk-m:not-first:translate-y-[125%] group-[.lk--ready]/lk:translate-none';
const title =
  'm-0 font-display font-medium max-lg:text-h4 lg:text-h3';
const sub =
  'mt-1 block min-h-[3.2em] text-body font-normal tracking-normal text-ink/70 lk-t:min-h-[4.8em] max-[700px]:min-h-0 max-[700px]:mt-1.5 lk-ms:text-small';
const count = 'mb-2 hidden font-display text-label tracking-label text-gold max-[700px]:block';
const arrow =
  'hidden size-11 flex-none items-center justify-center rounded-full bg-soft text-ink max-[700px]:flex';
---

<section
  data-lk
  data-header-lock
  data-no-autolink
  aria-labelledby="lk-title"
  class="group/lk relative mt-[14vh] bg-soft px-(--lk-gutter) py-15 text-ink [--lk-gutter:clamp(24px,4.4vw,88px)] [--lk-strip:58px] md:mt-0 md:mb-15 lg:mt-[20vh] lg:mb-0 max-[700px]:px-5 max-[700px]:py-12.5 lk-d:h-[520vh] lk-d:p-0 lk-t:[--lk-strip:34px] lk-m:h-[525svh] lk-m:px-5 lk-m:py-0"
>
  <div
    class="lk-d:sticky lk-d:top-0 lk-d:grid lk-d:h-svh lk-d:min-h-[680px] lk-d:grid-cols-[38%_62%] lk-d:items-center lk-d:overflow-clip lk-d:pl-(--lk-gutter) lk-t:grid-cols-[35%_65%] lk-m:sticky lk-m:top-0 lk-m:flex lk-m:h-svh lk-m:flex-col lk-m:overflow-clip"
  >
    <div class="mb-[35px] lk-d:m-0 lk-d:pr-[30px] lk-m:m-0 lk-m:pt-[92px] lk-ms:pt-[84px]">
      <p data-lk-eyebrow class="m-0 font-display text-label font-medium tracking-label uppercase">Unsere Leistungen</p>
      <h2
        id="lk-title"
        class="mt-9 mb-6 font-display text-h2 font-medium text-balance text-gold lk-m:mt-3.5 lk-m:mb-0 lk-ms:mt-2.5"
      >
        Ihr Malerbetrieb für Ludwigsburg, Marbach und Bietigheim-Bissingen
      </h2>
      <p class="m-0 text-body text-muted lk-m:hidden">
        Meisterbetrieb aus Freiberg am Neckar für Ludwigsburg, Marbach, Bietigheim-Bissingen und Stuttgart.
      </p>
    </div>

    <div class="lk-d:overflow-visible lk-m:relative lk-m:mt-6 lk-m:mb-[84px] lk-m:min-h-0 lk-m:flex-1 lk-ms:mt-4">
      <div
        class="grid grid-cols-2 gap-5 max-[700px]:grid-cols-1 lk-d:flex lk-d:w-max lk-d:gap-0 lk-m:relative lk-m:block lk-m:size-full lk-m:perspective-[1100px]"
      >
        {items.map((it, i) => (
          <a data-lk-card class={card} href={href(it.href)}>
            <div class="group/img relative aspect-[4/3] overflow-hidden lk-d:min-h-0 lk-d:flex-[1_1_0] lk-d:aspect-auto lk-m:min-h-0 lk-m:flex-[1_1_0] lk-m:aspect-auto">
              <Picture
                formats={['avif']}
                fallbackFormat="webp"
                src={it.img}
                alt={it.alt}
                {widths}
                {sizes}
                loading="lazy"
                pictureAttributes={{ class: 'block size-full' }}
                class="block size-full object-cover transition-[scale,opacity] duration-450 ease-in-out group-hover/img:scale-105 group-hover/img:opacity-80"
              />
              <span
                aria-hidden="true"
                class="pointer-events-none absolute top-1/2 left-1/2 z-1 flex size-[70px] -translate-1/2 items-center justify-center rounded-full bg-black/70 text-white opacity-0 transition-opacity duration-300 group-hover/img:opacity-100"
              >
                <svg class="size-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false"><path d="M20 13.5V21H3V4h7.5" /><path d="M14 3h7v7" /><path d="M21 3 11 13" /></svg>
              </span>
            </div>
            <div class="flex items-start justify-between gap-5 p-6 lg:p-8 max-[700px]:items-end max-[700px]:gap-4 max-[700px]:p-5">
              <div>
                <span class={count} aria-hidden="true">{nr(i)}</span>
                <h3 class={title}>
                  {it.title}
                  <span class={sub}>{it.sub}</span>
                </h3>
              </div>
              <svg class="mt-[5px] block size-5 flex-none max-[700px]:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false"><path d="M20 13.5V21H3V4h7.5" /><path d="M14 3h7v7" /><path d="M21 3 11 13" /></svg>
              <span class={arrow} aria-hidden="true">
                <svg class="size-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true" focusable="false"><path d="M2 8h11" /><path d="m9 4 4 4-4 4" /></svg>
              </span>
            </div>
          </a>
        ))}

        <div
          data-lk-card
          class:list={[
            card,
            'justify-between gap-5 p-6 lg:p-8 lk-t:gap-4 max-[700px]:justify-start max-[700px]:gap-0 max-[700px]:p-0',
          ]}
        >
          <div class="max-[700px]:flex max-[700px]:aspect-[4/3] max-[700px]:items-center max-[700px]:justify-center max-[700px]:bg-gold/10 lk-m:min-h-0 lk-m:flex-[1_1_0] lk-m:aspect-auto">
            <Picture
              formats={['avif']}
              fallbackFormat="webp"
              src={logo}
              alt="Meisterwerke Exklusive by Baldassarre Fortino"
              sizes="240px"
              widths={[240, 480]}
              loading="lazy"
              pictureAttributes={{
                class: 'block w-[min(70%,240px)] lk-t:w-[min(75%,190px)] max-[700px]:w-[min(55%,190px)]',
              }}
              class="block h-auto w-full"
            />
          </div>
          <div class="max-[700px]:flex max-[700px]:items-end max-[700px]:justify-between max-[700px]:gap-4 max-[700px]:p-5">
            <div>
              <span class={count} aria-hidden="true">{nr(items.length)}</span>
              <h3 class={title}>Fugenlose Bäder und Böden, Spachteltechniken und Stuckleisten</h3>
              <p class="mt-3 mb-0 max-w-[360px] text-body text-ink/70 max-[700px]:mt-1.5 lk-ms:text-small">
                Unsere Spezialleistungen als Meisterbetrieb. Im Showroom in Freiberg am Neckar sehen Sie die Oberflächen
                persönlich.
              </p>
            </div>
            <span class={arrow} aria-hidden="true">
              <svg class="size-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true" focusable="false"><path d="M2 8h11" /><path d="m9 4 4 4-4 4" /></svg>
            </span>
          </div>
          <Button
            href={href('/meisterwerk-exklusive/')}
            class="whitespace-nowrap after:absolute after:inset-0 after:content-[''] min-[701px]:h-12 max-[700px]:size-0 max-[700px]:min-h-0 max-[700px]:overflow-hidden max-[700px]:border-0 max-[700px]:p-0 max-[700px]:text-transparent max-[700px]:shadow-none"
          >
            Zu Meisterwerk Exklusive
          </Button>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from '../../scripts/motion';

  // Desktop/Tablet: Die Karten fächern sich so weit auf, dass die letzte Karte rechts denselben Randabstand hat wie die
  // Überschrift links (strip() = Abstand der Streifen aus Fensterbreite, Randabstand und Kartenbreite).
  // Handy: Die Karten schieben sich nacheinander von unten über die vorige.
  const sec = document.querySelector<HTMLElement>('[data-lk]');
  if (sec) {
    const cards = [...sec.querySelectorAll<HTMLElement>('[data-lk-card]')];
    const eyebrow = sec.querySelector<HTMLElement>('[data-lk-eyebrow]')!;
    const last = cards.length - 1;
    const strip = () => {
      const first = cards[0].getBoundingClientRect();
      const vw = document.documentElement.clientWidth;
      return Math.max(24, (vw - eyebrow.getBoundingClientRect().left - first.width - first.left) / last);
    };
    const mm = gsap.matchMedia();

    mm.add('(min-width: 701px) and (prefers-reduced-motion: no-preference)', () => {
      const tl = gsap.timeline({
        scrollTrigger: { trigger: sec, start: 'top top', end: 'bottom bottom', scrub: 1, invalidateOnRefresh: true },
      });
      cards.slice(1).forEach((c, i) =>
        tl.to(
          c,
          { x: () => -(i + 1) * (c.getBoundingClientRect().width - strip()), duration: i + 1, ease: 'power1.inOut' },
          (i * (i + 1)) / 2,
        ),
      );
      return () => {
        tl.scrollTrigger?.kill();
        tl.kill();
        gsap.set(cards, { clearProps: 'transform' });
      };
    });

    mm.add('(max-width: 700px) and (min-height: 650px) and (prefers-reduced-motion: no-preference)', () => {
      sec.classList.add('lk--ready');
      // Ausgangslage: Karten unter der Bühne. GSAP übernimmt beim ersten Lesen das CSS-`translate` (125 % aus der Klasse vor dem
      // Laden) als `y`, darum `y: 0` und die Lage nur über `yPercent`.
      gsap.set(cards.slice(1), { y: 0, yPercent: 125 });
      const tl = gsap.timeline({
        scrollTrigger: { trigger: sec, start: 'top top', end: 'bottom bottom', scrub: 0.9, invalidateOnRefresh: true },
      });
      cards.slice(1).forEach((c, i) => tl.to(c, { yPercent: 0, duration: 0.75, ease: 'power1.inOut' }, 0.35 + i));
      tl.to({}, { duration: last + 0.5 }, 0);
      return () => {
        tl.scrollTrigger?.kill();
        tl.kill();
        gsap.set(cards, { clearProps: 'transform,translate' });
        sec.classList.remove('lk--ready');
      };
    });
  }
</script>
