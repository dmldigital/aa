---
/**
 * Textseite (Impressum, Datenschutzerklärung): Seitenkopf (`PageHeader.astro`, genau eine H1) und darunter der lange
 * Text aus einer HTML-Datei.
 */
import PageHeader from './PageHeader.astro';

interface Props {
  id?: string;
  title: string;
  /** Fertiges HTML des Textes (h2 bis h5, p, ul, a). */
  html: string;
  /** Teil-Website Exklusive (gleiche Darstellung, Prop bleibt aus Kompatibilität). */
  exklusive?: boolean;
}
const { id = '9e8e860', title, html } = Astro.props;
---

<PageHeader title={title} />
<section data-section={id} class="overflow-hidden bg-white px-page pb-16 md:pb-24 lg:pb-32">
  <div class="mx-auto flex w-full max-w-page flex-col">
    <div
      class="max-w-[65ch] [&_a]:cursor-pointer [&_a]:text-ink [&_a]:underline [&_a]:transition-[color] [&_a]:duration-300 [&_a:hover]:text-gold [&_div]:contents [&_h2]:mt-10 [&_h2]:mb-3 [&_h2]:font-display [&_h2]:text-h2 [&_h2]:font-medium [&_h2]:text-ink [&_h3]:mt-8 [&_h3]:mb-3 [&_h3]:font-display [&_h3]:text-h3 [&_h3]:text-ink [&_h4]:mt-6 [&_h4]:mb-2 [&_h4]:font-display [&_h4]:text-h4 [&_h4]:font-medium [&_h4]:text-ink [&_h5]:mt-6 [&_h5]:mb-2 [&_h5]:font-display [&_h5]:text-h4 [&_h5]:font-medium [&_h5]:text-ink [&_li]:list-item [&_p]:mb-4 [&_p]:text-body [&_strong]:font-bold [&_ul]:my-4 [&_ul]:list-disc [&_ul]:pl-6"
      set:html={html}
    />
  </div>
</section>
