---
/**
 * Beitragskopf der Exklusiv-Site (Original fced28b): Kategorie, Überschrift und Datum, mittig (am Handy linksbündig).
 */
import { href } from '../../data/links';

interface Props {
  id?: string;
  title: string;
  category: string;
  categoryHref: string;
  date: string;
}
const { id = 'fced28b', title, category, categoryHref, date } = Astro.props;
const label = 'text-label font-medium tracking-label uppercase';
---

<section data-section={id} class="my-5 px-5 lg:mt-20 lg:mb-10 lg:px-7.5">
  <div class="mx-auto flex max-w-mobile flex-col items-start gap-3.75 md:max-w-tablet md:items-center md:gap-3.75 text-body lg:max-w-page lg:gap-5">
    <div>
      <span class={label}>
        <a href={href(categoryHref)}>{category}</a>
      </span>
    </div>
    <h1 class="w-full max-w-205 font-display text-h1 font-medium text-ink md:mb-1.25 md:text-center lg:mb-2.5">
      {title}
    </h1>
    <div class:list={[label, 'leading-[15.6px]']}>
      <time>{date}</time>
    </div>
  </div>
</section>
