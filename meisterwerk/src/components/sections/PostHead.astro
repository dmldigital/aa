---
/**
 * Beitragskopf der Exklusiv-Site (Original fced28b): Kategorie, Überschrift und Datum. Gleicher Aufbau und gleiche
 * Abstände wie `PageHeader.astro` (Überzeile, genau eine H1, Zeile darunter), nur dass die Überzeile ein Link ist.
 */
import { href } from '../../data/links';

interface Props {
  id?: string;
  title: string;
  category: string;
  categoryHref: string;
  date: string;
}
const { id = 'fced28b', title, category, categoryHref, date } = Astro.props;
---

<section data-section={id} class="bg-white px-page pt-16 pb-12 md:pt-24 md:pb-16">
  <div class="mx-auto flex w-full max-w-page flex-col">
    <div class="flex max-w-[65ch] flex-col">
      <p class="mb-3 font-display text-label font-medium tracking-label text-ink uppercase" data-anim="fadeIn">
        <a href={href(categoryHref)}>{category}</a>
      </p>
      <h1 class="font-display text-h1 text-balance text-ink" data-anim="fadeInUp" data-anim-delay="100">
        {title}
      </h1>
      <p class="mt-6 font-display text-lead text-ink" data-anim="fadeInUp" data-anim-delay="150">
        <time>{date}</time>
      </p>
    </div>
  </div>
</section>
