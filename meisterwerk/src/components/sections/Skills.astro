---
import Icon from '../Icon.astro';
import { accordions } from '../../data/skills';

/**
 * Drei Akkordeons (Original 0ee7325) als Karten ohne Rahmen. `embedded`: ohne eigene Sektion, z. B. im Slot von Services
 * (dann bestimmt `class` den Außenabstand; die Karten sind weiß, weil Services hellgrau ist).
 * `tone` ist der Hintergrund der Sektion, die Karten haben die jeweils andere Fläche.
 */
interface Props {
  id?: string;
  embedded?: boolean;
  class?: string;
  /** Hintergrund der Sektion (Standard: Weiß, eingebettet Hellgrau wie die umgebende Services-Fläche) */
  tone?: 'white' | 'soft';
}
const { id = '0ee7325', embedded = false, class: className, tone: toneProp } = Astro.props;
const tone = toneProp ?? (embedded ? 'soft' : 'white');
const card = tone === 'soft' ? 'bg-white' : 'bg-soft';
const Wrapper = embedded ? 'div' : 'section';
---

<Wrapper
  data-section={embedded ? undefined : id}
  class:list={[
    embedded ? 'flex flex-col' : ['px-page py-section', tone === 'soft' ? 'bg-soft' : 'bg-white'],
    className,
  ]}
>
  <div class="mx-auto flex w-full max-w-page flex-col">
    <div class="grid grid-cols-1 items-start gap-5 md:grid-cols-3">
      {accordions.map((acc, i) => (
        <div
          class:list={['flex flex-col gap-5 p-6 md:p-8', card]}
          data-anim="slideInUp"
          data-anim-delay="50"
          data-anim-dur="fast"
        >
          <div
            class="w-full"
            data-anim="fadeIn"
            data-accordion
            data-accordion-ease="none"
          >
            <button
              type="button"
              id={`skills-title-${i + 1}`}
              aria-expanded="false"
              aria-controls={`skills-panel-${i + 1}`}
              class="group/acc flex w-full cursor-pointer items-center justify-center gap-x-2.5 text-start text-black hover:text-gold aria-expanded:text-gold"
            >
              <span
                class="font-display text-h3 font-medium"
                set:html={acc.title}
              />
              <span class="flex shrink-0 items-center">
                <Icon name="plus" class="size-3.75 group-aria-expanded/acc:hidden" />
                <Icon name="minus" class="hidden size-3.75 group-aria-expanded/acc:block" />
              </span>
            </button>

            <div
              id={`skills-panel-${i + 1}`}
              role="region"
              aria-labelledby={`skills-title-${i + 1}`}
              class="overflow-hidden"
              hidden
            >
              <div class="flex flex-col gap-5 pt-5">
                <div class="[&>p]:mb-3.75 [&>p]:text-body lg:[&>p]:mb-para">
                  <p set:html={acc.intro} />
                </div>

                <div class="flex flex-col gap-3.75 lg:gap-5">
                  {acc.groups.map((group) => (
                    <>
                      <h4
                        class="font-display text-body font-medium text-gold"
                        set:html={group.heading}
                      />
                      <ul>
                        {group.items.map((item) => (
                          <li class="mt-0.5 flex items-start pb-0.5 first:mt-0 last:pb-0">
                            <span class="relative top-1 flex w-[18.75px] shrink-0 text-gold">
                              <Icon name={item.icon} class="h-3.75 w-auto" />
                            </span>
                            <span
                              class="self-center pl-1.25 text-body"
                              set:html={item.html}
                            />
                          </li>
                        ))}
                      </ul>
                    </>
                  ))}
                  <h4
                    class="self-stretch font-display text-body font-medium text-gold"
                    set:html={acc.closing}
                  />
                </div>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</Wrapper>
