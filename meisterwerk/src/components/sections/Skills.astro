---
import Icon from '../Icon.astro';
import { accordions } from '../../data/skills';
---

<section data-section="0ee7325" class="bg-soft md:my-15 lg:my-0">
  <div class="mx-auto flex w-full flex-col pb-12.5 lg:max-w-page">
    <div class="grid grid-cols-1 items-stretch gap-5 md:grid-cols-3 lg:gap-7.5">
      {accordions.map((acc, i) => (
        <div
          class="flex flex-col gap-7.5 my-[0.5px] md:my-0 md:px-7.5 md:pt-10 md:pb-5 lg:gap-5 lg:p-0"
          data-anim="slideInUp"
          data-anim-delay="50"
          data-anim-dur="fast"
        >
          <div
            class="-mt-4 p-2.5 md:m-0 md:p-0"
            data-anim="fadeIn"
            data-accordion
            data-accordion-ease="none"
          >
            <button
              type="button"
              id={`skills-title-${i + 1}`}
              aria-expanded="false"
              aria-controls={`skills-panel-${i + 1}`}
              class="group/acc flex w-full cursor-pointer items-center justify-center gap-x-2.5 py-4 text-start text-black hover:text-gold aria-expanded:text-gold md:py-3.75 lg:py-[22.5px]"
            >
              <span
                class="font-display text-[19px] leading-[1.3] font-medium md:text-[20px] lg:text-[24px]"
                set:html={acc.title}
              />
              <span class="flex shrink-0 items-center">
                <Icon name="plus" class="size-3.75 group-aria-expanded/acc:hidden" />
                <Icon name="minus" class="hidden size-3.75 group-aria-expanded/acc:block" />
              </span>
            </button>

            <div
              id={`skills-panel-${i + 1}`}
              role="region"
              aria-labelledby={`skills-title-${i + 1}`}
              class="overflow-hidden"

              hidden
            >
              <div class="flex flex-col gap-5 border-b border-black/20 pt-8 pr-0 pb-4 md:pt-7.5 md:pb-3.75 lg:pr-7.5">
                <div class="[&>p]:mb-[15px] [&>p]:text-[15px] lg:[&>p]:mb-[22.5px]">
                  <p set:html={acc.intro} />
                </div>

                <div class="flex flex-col gap-3.75 border-t border-gold pt-5 transition-[border-color] duration-300 ease-[ease] hover:border-ink lg:gap-5 lg:pt-6.25">
                  {acc.groups.map((group) => (
                    <>
                      <h4
                        class="font-display text-[16px] leading-[1.3] font-medium text-gold"
                        set:html={group.heading}
                      />
                      <ul>
                        {group.items.map((item) => (
                          <li class="mt-0.5 flex items-start pb-0.5 first:mt-0 last:pb-0">
                            <span class="relative top-1 flex w-[18.75px] shrink-0 text-gold">
                              <Icon name={item.icon} class="h-3.75 w-auto" />
                            </span>
                            <span
                              class="self-center pl-1.25 text-[14px] leading-6 md:leading-[22.5px]"
                              set:html={item.html}
                            />
                          </li>
                        ))}
                      </ul>
                    </>
                  ))}
                  <h4
                    class="self-stretch font-display text-[16px] leading-[1.3] font-medium text-gold"
                    set:html={acc.closing}
                  />
                </div>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
