---
/**
 * Hero der Startseite (vom Kunden gewählt): Hero in voller Größe mit dem Flug-Video, Logo mit goldenem „MEISTERWERK“.
 * Das Video (Haus des Kunden mit weißer Fassade und rotem Ziegeldach, Flug durch das Fenster im Untergeschoss ins Wohnzimmer) füllt den ganzen Hero bis an den Rand, die Kopfzeile
 * liegt durchsichtig mit weißem Logo darüber, die große weiße Überschrift steht unten links.
 * Abspielen wie beim Pool-Hero (Poolbau Koch): Oben steht das Standbild. Beim ersten Losscrollen (Rad, Wischen, Pfeiltaste)
 * läuft das Video von selbst durch (`DURATION`, die Seite steht so lange), danach scrollt die Seite selbst zum nächsten
 * Abschnitt. Zurück ganz oben läuft das Video genauso rückwärts. Kopfzeile und Text blenden mit dem Video aus und ein.
 * Kein Anhalten durch Scrollen (nicht scrollgesteuert). Reduzierte Bewegung und kurze Handys: nur das Standbild.
 * Handy: Die stehende Bühne ist `100lvh` hoch (größte Fensterhöhe), damit beim Ein- und Ausblenden der Browserleiste
 * unten kein schwarzer Streifen entsteht; der Text sitzt über der Leiste (`100lvh - 100svh` Abstand).
 */
import Button from '../ui/Button.astro';
import Header from './Header.astro';
import { href, routes } from '../../data/links';

const FRAMES = 177;
// Version der Bildfolge: bei jedem neuen Flug erhöhen (Browser-Cache)
const FLUG_V = '2026-11-09b';
const flug = `${import.meta.env.BASE_URL.replace(/\/?$/, '/')}hero-flug/`;
---

<section
  data-hero
  data-hero-full
  data-section="hero-a"
  aria-label="Willkommen bei Meisterwerk Malermanufaktur"
  class="relative bg-ink"
>
  <div class="relative h-svh min-h-150 overflow-clip hero-m:h-lvh hero-m:min-h-0">
    <div data-hero-picture class="absolute inset-0 overflow-hidden">
      <div data-hero-media class="absolute inset-0">
        <picture>
          <source media="(max-aspect-ratio: 4/5)" srcset={`${flug}m/000.webp?v=${FLUG_V}`} />
          <img
            src={`${flug}d/000.webp?v=${FLUG_V}`}
            alt="Haus mit weißer Fassade und rotem Ziegeldach, die Kamera fliegt durch ein Fenster im Untergeschoss in ein helles Wohnzimmer"
            fetchpriority="high"
            class="absolute inset-0 size-full max-w-none object-cover object-[42%_50%]"
          />
        </picture>
        <canvas
          data-hero-canvas
          data-frames={FRAMES}
          data-base={flug}
          data-v={FLUG_V}
          aria-hidden="true"
          class="absolute inset-0 size-full object-cover object-[42%_50%] opacity-0 [&.is-ready]:opacity-100"
        ></canvas>
      </div>
      <div
        class="absolute inset-0 bg-[linear-gradient(rgb(0_0_0/0.38),transparent_24%,transparent_38%,rgb(0_0_0/0.62))]"
      >
      </div>
    </div>

    <Header variant="hero" tone="duo" />

    <div
      data-hero-content
      class="absolute inset-x-5.5 bottom-7 z-[2] flex flex-col text-white min-[701px]:inset-x-7.5 min-[701px]:bottom-10 hero-m:bottom-[calc(100lvh-100svh+28px)]"
    >
      <div class="max-w-[min(1180px,100%)]">
        <h1
          class="mb-5 font-display text-display text-white min-[701px]:mb-6"
        >
          <span
            class="mb-3.5 block font-display text-label font-normal tracking-[0.2em] text-white uppercase"
          >
            Meisterwerk Malermanufaktur
          </span>
          Malerarbeiten in Ludwigsburg und Freiberg am Neckar
        </h1>
        <p
          class="mb-7 max-w-[34rem] font-display text-lead text-white/90 min-[701px]:mb-8"
        >
          Ihr Meisterbetrieb für Streichen, Lackieren, Tapezieren und glatte Oberflächen.{' '}
          <span class="max-[700px]:hidden">Persönlich beraten, sauber ausgeführt, mit über 24 Jahren Erfahrung.</span>
        </p>
        <Button href={href(routes.contact)} variant="light">Projekt anfragen</Button>
      </div>
    </div>

    <p
      data-hero-caption
      class="absolute right-[clamp(24px,4.4vw,88px)] bottom-10 z-[2] hidden font-display text-label tracking-[0.17em] text-white uppercase min-[701px]:block"
    >
      Streichen. Lackieren. Tapezieren.
    </p>
  </div>
</section>

<script>
  import { lenis } from '../../scripts/motion';
  import { createFlug } from '../../scripts/flug';

  const hero = document.querySelector<HTMLElement>('[data-hero-full]');
  // Reduzierte Bewegung und kurze Handys (wie `hero-m:` im Markup): nur das Standbild, normales Scrollen
  const active =
    !window.matchMedia('(prefers-reduced-motion: reduce)').matches &&
    (window.innerWidth > 700 || window.innerHeight >= 650);

  if (hero && active) {
    const q = <T extends Element = HTMLElement>(s: string) => hero.querySelector<T>(s)!;
    const header = document.querySelector<HTMLElement>('[data-site-header]');
    const content = q('[data-hero-content]');
    const caption = q('[data-hero-caption]');
    const flug = createFlug(q<HTMLCanvasElement>('[data-hero-canvas]'));
    const END = Number(q<HTMLCanvasElement>('[data-hero-canvas]').dataset.frames) - 1;
    const DURATION = 5000; // ms für den ganzen Durchlauf, vorwärts wie rückwärts
    const clamp = (v: number, a = 0, b = 1) => Math.min(b, Math.max(a, v));

    // Abspielen: pos (in Bildern) läuft mit konstantem Tempo auf target zu, ein Richtungswechsel mitten drin ist weich
    let pos = 0;
    let target = 0;
    let locked = false; // Seite steht, solange das Video vorwärts läuft
    let leftTop = false; // erst nach echtem Wegscrollen löst „ganz oben“ das Rückwärtslaufen aus
    let raf = 0;
    let last = 0;

    const fade = (el: HTMLElement | null, k: number, y = 0) => {
      if (!el) return;
      el.style.opacity = String(1 - k);
      el.style.visibility = k >= 1 ? 'hidden' : '';
      el.style.transform = y ? `translateY(${(y * k).toFixed(1)}px)` : '';
    };
    const render = () => {
      const p = pos / END;
      fade(header, clamp(p / 0.06), -16);
      fade(content, clamp(p / 0.14), -40);
      fade(caption, clamp(p / 0.06));
      content.style.pointerEvents = p > 0.02 ? 'none' : '';
      flug.seek(p);
    };

    const scrollToNext = () => {
      const y = hero.getBoundingClientRect().bottom + window.scrollY; // Beginn des nächsten Abschnitts
      if (lenis) lenis.scrollTo(y, { duration: 1.4 });
      else window.scrollTo({ top: y, behavior: 'smooth' });
    };
    const tick = (t: number) => {
      const dt = last ? t - last : 16;
      last = t;
      const step = (dt / DURATION) * END;
      pos = target > pos ? Math.min(target, pos + step) : Math.max(target, pos - step);
      render();
      if (pos !== target) {
        raf = requestAnimationFrame(tick);
        return;
      }
      raf = 0;
      last = 0;
      if (locked) {
        locked = false; // Ende der Fahrt: weiter zum nächsten Abschnitt
        scrollToNext();
      }
    };
    const play = (to: number) => {
      target = to;
      locked = to === END;
      if (!raf) raf = requestAnimationFrame(tick);
    };
    const forward = () => {
      if (target !== END) {
        leftTop = false;
        play(END);
      }
    };
    const backward = () => {
      if (target !== 0) play(0);
    };
    const atTop = () => window.scrollY <= 2;

    // Scroll-Absicht abfangen (vor Lenis, daher Capture-Phase); solange das Video vorwärts läuft, steht die Seite
    const block = (e: Event) => {
      if (e.cancelable) e.preventDefault();
      (e as Event & { lenisStopPropagation?: boolean }).lenisStopPropagation = true;
    };
    window.addEventListener(
      'wheel',
      (e) => {
        if (e.deltaY > 0 && atTop()) forward();
        else if (e.deltaY < 0 && atTop() && target === END && !locked) backward();
        if (locked) block(e);
      },
      { capture: true, passive: false },
    );
    let touchY = 0;
    window.addEventListener('touchstart', (e) => (touchY = e.touches[0].clientY), { capture: true, passive: true });
    window.addEventListener(
      'touchmove',
      (e) => {
        const dy = touchY - e.touches[0].clientY; // > 0 = nach unten scrollen
        if (dy > 8 && atTop()) forward();
        else if (dy < -8 && atTop() && target === END && !locked) backward();
        if (locked) block(e);
      },
      { capture: true, passive: false },
    );
    window.addEventListener(
      'keydown',
      (e) => {
        const down = ['ArrowDown', 'PageDown', 'End', ' '].includes(e.key);
        if (down && atTop() && !(e.target as HTMLElement).closest?.('input, textarea, select, button, a')) forward();
        if (locked && down) e.preventDefault();
      },
      { capture: true },
    );
    // Anker-Links auf dieser Seite (Menü, Buttons): Fahrt überspringen und direkt zum Ziel scrollen,
    // sonst würde die automatische Fahrt die Anker-Fahrt überlagern
    const hashTarget = (h: string) => {
      try {
        return h && h !== '#' ? document.querySelector(h) : null;
      } catch {
        return null;
      }
    };
    document.addEventListener(
      'click',
      (e) => {
        const a = (e.target as Element).closest?.('a[href*="#"]') as HTMLAnchorElement | null;
        if (!a || (pos >= END && !locked)) return;
        const u = new URL(a.href, location.href);
        if (u.pathname !== location.pathname || !hashTarget(u.hash)) return;
        locked = false;
        leftTop = true;
        pos = target = END;
        render();
      },
      true,
    );
    window.addEventListener(
      'scroll',
      () => {
        if (window.scrollY > 40) leftTop = true;
        if (window.scrollY > 10 && target === 0) forward(); // z. B. Scrollleiste gezogen
        else if (atTop() && leftTop && !locked) backward(); // zurück ganz oben: rückwärts
      },
      { passive: true },
    );

    // Seite schon weiter unten geladen (Neuladen, Anker): gleich das Endbild zeigen
    if (window.scrollY > 10 || hashTarget(location.hash)) {
      pos = target = END;
      leftTop = true;
    }
    flug.load().then(render);
    render();
  }
</script>
