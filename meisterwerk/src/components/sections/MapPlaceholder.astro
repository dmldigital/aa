---
/**
 * Anfahrt (Original 2a4b946: eingebettete Google-Karte): ruhige Karte mit Adresse und Button zu Google Maps, ohne Fremd-Embed.
 */
import Button from '../ui/Button.astro';
import { site } from '../../data/site';

interface Props {
  id?: string;
  /** Hintergrund der Sektion (Weiß und Hellgrau wechseln sich ab) */
  tone?: 'white' | 'soft';
}
const { id = '2a4b946', tone = 'white' } = Astro.props;
---

<section data-section={id} class:list={['px-page py-section', tone === 'soft' ? 'bg-soft' : 'bg-white']}>
  <div class="mx-auto flex max-w-page flex-col items-start gap-stack bg-soft p-inner md:flex-row md:items-center md:justify-between lg:p-[clamp(2rem,4vw,3.5rem)]">
    <div class="flex items-center gap-stack">
      <span class="grid size-14 shrink-0 place-items-center rounded-full bg-white text-gold" aria-hidden="true">
        <svg class="h-6 w-4.5" viewBox="0 0 24 34" fill="currentColor"><path d="M12 0C5.4 0 0 5.4 0 12c0 9 12 22 12 22s12-13 12-22C24 5.4 18.6 0 12 0zm0 16.5a4.5 4.5 0 1 1 0-9 4.5 4.5 0 0 1 0 9z" /></svg>
      </span>
      <div>
        <p class="font-display text-label font-medium tracking-label text-ink uppercase">Showroom und Werkstatt</p>
        <p class="mt-1 font-display text-h3 font-medium text-ink">{site.street}, {site.postalCode} {site.city}</p>
      </div>
    </div>
    <Button
      href={site.mapsUrl}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={`Karte: ${site.street}, ${site.postalCode} ${site.city} auf Google Maps öffnen`}
    >
      Auf Google Maps ansehen
    </Button>
  </div>
</section>
