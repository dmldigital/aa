---
/**
 * Karte (Original 2a4b946: eingebettete Google-Karte in Graustufen, 561 px hoch).
 * Statische neutrale Fläche in gleicher Größe, ohne Fremd-Embed; verlinkt auf Google Maps.
 */
import { site } from '../../data/site';

interface Props {
  id?: string;
}
const { id = '2a4b946' } = Astro.props;
---

<section data-section={id} class="my-[4vw] px-5 lg:px-7.5">
  <div class="mx-auto max-w-page">
    <a
      href={site.mapsUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="flex h-[561px] flex-col items-center justify-center gap-3 bg-[#e2e2e2] font-display text-ink"
      aria-label={`Karte: ${site.street}, ${site.postalCode} ${site.city} auf Google Maps öffnen`}
    >
      <svg class="h-10 w-7" viewBox="0 0 24 34" fill="currentColor" aria-hidden="true">
        <path d="M12 0C5.4 0 0 5.4 0 12c0 9 12 22 12 22s12-13 12-22C24 5.4 18.6 0 12 0zm0 16.5a4.5 4.5 0 1 1 0-9 4.5 4.5 0 0 1 0 9z" />
      </svg>
      <span class="text-h5 font-medium">{site.street}, {site.postalCode} {site.city}</span>
      <span class="text-label tracking-label uppercase underline underline-offset-4">Auf Google Maps ansehen</span>
    </a>
  </div>
</section>
