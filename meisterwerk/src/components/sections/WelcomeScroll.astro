---
import { Picture } from 'astro:assets';
import ArrowLink from '../ui/ArrowLink.astro';
import { href, routes } from '../../data/links';
import wohnzimmer from '../../assets/img/209-meisterwerk-20230120-scaled.jpg';
import kueche from '../../assets/img/2014-meisterwerk-20230524-Bearbeitet-1-scaled.jpg';
import wohnbereich from '../../assets/img/205-meisterwerk-20230120-Bearbeitet-scaled.jpg';

/**
 * Willkommen-Szene der Startseite (Original 53bda50 und 3c77667): Text und drei Bilder. Desktop: Der Text bleibt
 * stehen (sticky), während die Bilder links nacheinander hochscrollen (die beiden unteren öffnen sich von unten).
 * Zuletzt gleitet die Überschrift „Ihr Partner für exklusive Malerleistungen …“ unter dem Text herein. Bis 1024 px steht der Text oben, die
 * Bilder liegen darunter übereinander und schieben sich bei angehaltener Seite (Pin) von rechts herein.
 * Ohne reduzierte Bewegung nur als Stapel untereinander. Skript unten.
 */
interface Props {
  heading: string;
  paragraphs: string[];
  /** Überschrift nach den Bildern */
  closing?: string;
}
const {
  heading,
  paragraphs,
  closing = 'Ihr Partner für exklusive Malerleistungen und individuelle Raumgestaltung',
} = Astro.props;

const images = [
  {
    src: wohnzimmer,
    alt: 'Modernes Wohnzimmer mit dunkler mineralischer Akzentwand, perfekt glatten weißen Wänden und indirekter Deckenbeleuchtung in Ludwigsburg.',
  },
  {
    src: kueche,
    alt: 'Moderne Design-Küche mit dunkler Kochinsel, fugenlosem mineralischem Boden und perfekt glatten Wänden in Ludwigsburg.',
  },
  {
    src: wohnbereich,
    alt: 'Heller Essbereich mit Esstisch, Pendelleuchte, Vorhängen und perfekt glatten Wänden mit indirekter Deckenbeleuchtung.',
  },
];
---

<section
  data-section="53bda50"
  data-welcome-scene
  class="mt-[8vh] overflow-x-clip px-5 md:mt-0 md:mb-10 lg:mt-[20vh] lg:mb-0 lg:px-7.5"
>
  <div class="mx-auto w-full max-w-page lg:flex lg:flex-row-reverse lg:gap-x-5">
    <div data-ws-pin class="lg:contents">
      <!-- Text: bleibt am Desktop stehen, solange die Bilder vorbeilaufen -->
      <div class="mb-7.5 flex w-full flex-col lg:mb-0 lg:w-1/2 lg:flex-1">
        <div class="flex flex-col gap-3.75 lg:sticky lg:top-[14vh] lg:gap-5">
          <div
            class="lg:mb-5 lg:max-w-[690px]"
            data-anim="fadeInUp"
            data-anim-delay="280"
            data-anim-dur="slow"
          >
            <h2
              class="font-display text-[23px]/[25.3px] font-medium text-gold md:text-[30px]/[33px] lg:text-h2"
              set:html={heading}
            />
          </div>
          <div class="[&>p]:mb-3.75 [&>p]:text-15 lg:[&>p]:mb-para">
            {paragraphs.map((p) => (
              <p set:html={p} />
            ))}
          </div>
          <div
            data-anim="fadeIn"
            data-anim-mobile="slideInRight"
            data-anim-delay="500"
            data-anim-dur="slow"
          >
            <div>
              <ArrowLink href={href(routes.contact)} tone="gold" gap="3px">
                Projekt starten
              </ArrowLink>
            </div>
          </div>
          <!-- Kommt nach den Bildern an der Textstelle hereingeglitten (Skript unten) -->
          <div data-ws-closing data-section="3c77667" class="mt-5 max-w-[660px] lg:mt-12">
            <h2 class="font-display text-[23px]/[27.6px] font-medium text-gold md:text-[29px]/[39.15px] lg:text-h2">
              {closing}
            </h2>
          </div>
        </div>
      </div>

      <!-- Bilder: Desktop untereinander (laufen hoch), bis 1024 px übereinander (schieben sich von rechts herein) -->
      <div
        data-ws-stack
        class="flex w-full flex-col gap-5 lg:w-1/2 lg:flex-1 lg:gap-7.5 ws-m:relative ws-m:grid ws-m:aspect-[4/5] md:ws-m:aspect-[3/2] ws-m:gap-0 ws-m:overflow-hidden"
      >
        {images.map((img, i) => (
          <div data-ws-img class="overflow-hidden ws-m:col-start-1 ws-m:row-start-1 ws-m:size-full">
            <div
              data-grow={i === 0 ? 'bottom' : undefined}
              data-anim-delay="420"
              class="ws-m:size-full"
            >
              <Picture
                formats={['avif']}
                fallbackFormat="webp"
                src={img.src}
                alt={img.alt}
                widths={[680, 840, 1360, 1680]}
                sizes="(min-width: 1760px) 840px, (min-width: 1025px) calc(50vw - 40px), calc(100vw - 40px)"
                loading={i === 0 ? 'eager' : 'lazy'}
                class="block h-auto w-full ws-m:size-full ws-m:object-cover"
              />
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap, ScrollTrigger } from '../../scripts/motion';

  const scene = document.querySelector<HTMLElement>('[data-welcome-scene]');
  if (scene) {
    const stack = scene.querySelector<HTMLElement>('[data-ws-stack]')!;
    const wrap = scene.querySelector<HTMLElement>('[data-ws-pin]')!;
    const closing = scene.querySelector<HTMLElement>('[data-ws-closing]')!;
    const imgs = [...stack.querySelectorAll<HTMLElement>('[data-ws-img]')];
    const mm = gsap.matchMedia();

    // Desktop: die beiden unteren Bilder öffnen sich von unten, während der Text steht
    mm.add('(min-width: 1025px) and (prefers-reduced-motion: no-preference)', () => {
      // Schlussüberschrift gleitet unter dem Text herein, sobald das letzte Bild ankommt
      gsap.set(closing, { opacity: 0, x: -60 });
      gsap.to(closing, {
        opacity: 1,
        x: 0,
        duration: 1.25,
        ease: 'css',
        scrollTrigger: { trigger: imgs[2], start: 'top 55%', once: true },
      });
      imgs.slice(1).forEach((el) => {
        const img = el.querySelector('img');
        gsap.fromTo(
          el,
          { clipPath: 'inset(100% 0% 0% 0%)' },
          {
            clipPath: 'inset(0% 0% 0% 0%)',
            duration: 1.25,
            ease: 'grow',
            scrollTrigger: { trigger: el, start: 'top 88%', once: true },
          },
        );
        if (img) {
          gsap.fromTo(
            img,
            { scale: 1.3, transformOrigin: '50% 100%' },
            {
              scale: 1,
              duration: 1.25,
              ease: 'grow',
              scrollTrigger: { trigger: el, start: 'top 88%', once: true },
            },
          );
        }
      });
    });

    // Tablet und Handy: Sobald das Ende des Blocks den unteren Bildschirmrand erreicht, hält die Seite an: oben bleibt das
    // Textende stehen, unten schieben sich das zweite und dritte Bild von rechts über das erste
    mm.add('(max-width: 1024px) and (prefers-reduced-motion: no-preference)', () => {
      gsap.set(imgs.slice(1), { xPercent: 100 });
      gsap.set(closing, { opacity: 0, x: -40 });
      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: wrap,
          start: 'bottom bottom',
          end: '+=180%',
          pin: true,
          scrub: 0.5,
          anticipatePin: 1,
          invalidateOnRefresh: true,
        },
      });
      tl.to(imgs[1], { xPercent: 0, duration: 1, ease: 'power2.inOut' })
        .to(imgs[2], { xPercent: 0, duration: 1, ease: 'power2.inOut' }, '+=0.15')
        .to(closing, { opacity: 1, x: 0, duration: 0.7, ease: 'power2.out' }, '>-0.1');
    });
  }
</script>
