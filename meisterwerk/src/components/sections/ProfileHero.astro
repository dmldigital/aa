---
/**
 * Profil-Kopf (Original 16ee660): große Überschrift links, Hochformat-Foto rechts, so hoch wie der Bildschirm.
 * Am Handy steht das Foto über dem Namen.
 */
import { Picture } from 'astro:assets';
import { img } from '../../lib/img';

interface Props {
  id?: string;
  name: string;
  photo: string;
}
const { id = '16ee660', name, photo } = Astro.props;
---

<section
  data-section={id}
  class="mb-10 overflow-hidden px-5 md:mb-15 md:min-h-screen lg:mb-27 lg:px-7.5"
>
  <div class="mx-auto flex max-w-[767px] flex-col-reverse gap-5 md:max-w-[1024px] md:flex-row md:items-stretch md:gap-x-7.5 lg:max-w-page">
    <div class="flex min-h-25 flex-col items-start justify-center gap-3.75 md:min-h-0 md:w-[calc((100%-30px)/2)] md:gap-5 lg:w-[49%] lg:pr-[110.39px]">
      <h1 class="font-display lg:pb-5 text-[23px]/[25.3px] font-medium text-ink md:text-[34px]/[37.4px] lg:text-h1">
        {name}
      </h1>
    </div>
    <div class="md:w-[calc((100%-30px)/2)] md:self-start lg:w-auto lg:flex-1">
      <Picture
        formats={['avif', 'webp']}
        src={img(photo)}
        alt={name}
        widths={[350, 700, 1348]}
        sizes="(min-width: 1025px) 674px, (min-width: 768px) 477px, 350px"
        loading="eager"
        class="block aspect-[3/4] w-full object-cover object-top md:h-[calc(100vh-50px)] md:aspect-auto"
      />
    </div>
  </div>
</section>
