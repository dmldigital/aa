---
/**
 * Profil-Kopf (Original 16ee660): große Überschrift links, Hochformat-Foto rechts, so hoch wie der Bildschirm.
 * Am Handy steht das Foto über dem Namen.
 */
import { Picture } from 'astro:assets';

interface Props {
  id?: string;
  name: string;
  photo: ImageMetadata;
  /** Tag des Namens (Standard h1: der Profil-Kopf ist der Seitenkopf) */
  headingTag?: 'h1' | 'h2';
}
const { id = '16ee660', name, photo, headingTag: Heading = 'h1' } = Astro.props;
---

<section
  data-section={id}
  class="overflow-hidden bg-white px-page pt-16 pb-12 md:min-h-screen md:pt-24 md:pb-16"
>
  <div class="mx-auto flex w-full max-w-page flex-col-reverse gap-5 md:flex-row md:items-stretch md:gap-x-7.5">
    <div class="flex min-h-25 flex-col items-start justify-center gap-3.75 md:min-h-0 md:w-[calc((100%-30px)/2)] md:gap-5 lg:w-[49%] lg:pr-[110.39px]">
      <Heading class="font-display lg:pb-5 text-h1 font-medium text-ink">
        {name}
      </Heading>
    </div>
    <div class="md:w-[calc((100%-30px)/2)] md:self-start lg:w-auto lg:flex-1">
      <Picture
        formats={['avif']}
        fallbackFormat="webp"
        src={photo}
        alt={`${name}, Porträt`}
        widths={[350, 700, 1348]}
        sizes="(min-width: 1025px) 674px, (min-width: 768px) 477px, 350px"
        loading="eager"
        class="block aspect-[3/4] w-full object-cover object-top md:h-[calc(100vh-50px)] md:aspect-auto"
      />
    </div>
  </div>
</section>
