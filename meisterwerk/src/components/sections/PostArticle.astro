---
/**
 * Projektbeitrag (Original: Elementor-Vorlage "single-post", Wurzel 4587619):
 * Titelbild, Infoleiste (Leistungen, Jahr, Ort, Zeitspanne, Quadratmeter), Textabschnitte und Galerie.
 */
import { Picture } from 'astro:assets';
import Gallery from './Gallery.astro';
import type { Post } from '../../data/pages/posts';

interface Props {
  id?: string;
  post: Post;
}
const { id = '4587619', post } = Astro.props;

const images = import.meta.glob<{ default: ImageMetadata }>('../../assets/img/*.jpg', {
  eager: true,
});
const image = images[`../../assets/img/${post.image}`].default;

const label =
  'font-display text-[19px]/[24.7px] font-medium tracking-label text-ink uppercase md:text-xs/[15.6px] lg:text-[18px]/[23.4px]';
const value = 'leading-4 md:leading-[15px]';
const info = [
  { label: 'Jahr', value: post.info.year },
  { label: 'Ort', value: post.info.place },
  { label: 'Zeitspanne', value: post.info.duration },
  { label: 'Quadratmeter', value: post.info.area },
];
---

<section
  data-section={id}
  class="mt-10 mb-21.25 flex flex-col gap-5 md:mb-30 md:gap-7.5 lg:mt-30 lg:mb-40.5 lg:gap-13.5"
>
  <!-- Titelbild -->
  <div class="px-5 lg:px-7.5">
    <div class="mx-auto max-w-wide overflow-hidden">
      <Picture
        formats={['avif']}
        fallbackFormat="webp"
        src={image}
        alt={post.title}
        widths={[350, 700, 984, 1120, 1600]}
        sizes="(min-width: 1025px) 1120px, (min-width: 768px) 984px, 350px"
        loading="eager"
        class="block h-117 w-full object-cover md:h-150 lg:h-180"
      />
    </div>
  </div>

  <div class="flow-root">
    <!-- Infoleiste -->
    <div class="mb-10 px-5 md:mb-15 lg:mb-27 lg:px-7.5">
      <div class="mx-auto flex max-w-wide flex-wrap justify-start gap-x-5 gap-y-7.5 md:gap-x-7.5 lg:flex-nowrap lg:justify-center lg:gap-y-5">
        <div class="flex w-full flex-wrap gap-2.5 md:-ml-6.25 md:w-[60%] lg:w-1/3 lg:gap-x-7.5 lg:gap-y-5">
          <h5 class:list={[label, 'w-full']}>Erbrachte Leistungen</h5>
          {post.services.map((service) => (
            <div>
              <span class={value}>{service}</span>
            </div>
          ))}
        </div>
        {info.map((item) => (
          <div class="flex w-[45%] flex-col gap-2.5 md:w-[30%] lg:w-37.5 lg:gap-5">
            <h5 class={label}>{item.label}</h5>
            <div>
              <span class={value}>{item.value}</span>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Textabschnitte -->
    <div class="px-5 lg:px-7.5">
      <div class="mx-auto flex max-w-wide flex-col gap-3.75 md:gap-5">
        {post.sections.map((section) => (
          <>
            <h3 class="font-display text-[21px]/[26.25px] text-ink md:text-[24px]/[30px] lg:text-[32px]/[40px]">
              {section.heading}
            </h3>
            <div class:list={post.largeText ? 'text-[17px]/[25.5px]' : 'text-body'}>
              {section.text}
            </div>
          </>
        ))}
      </div>
    </div>

    <!-- Galerie (Original: 3 Spalten bei wenigen Bildern, sonst 2; Abstand 30, am Handy 10) -->
    <Gallery
      id="838a0e7"
      items={post.gallery}
      columns={post.gallery.length <= 3 ? [3, 3, 1] : [2, 2, 1]}
      gap={[30, 30, 10]}
      rootClass="mt-3.75 mb-8.75 lg:mt-[31.5px] lg:mb-13.5"
    />
  </div>
</section>
