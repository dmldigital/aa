---
/**
 * Projektbeitrag (Original: Elementor-Vorlage "single-post", Wurzel 4587619):
 * Titelbild, Infoleiste (Leistungen, Jahr, Ort, Zeitspanne, Quadratmeter), Textabschnitte und Galerie.
 */
import { Picture } from 'astro:assets';
import Gallery from './Gallery.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  id?: string;
  post: CollectionEntry<'beitraege'>['data'];
  /** Zusätzliche Klassen der Sektion (Abstände kommen aus `py-section`) */
  rootClass?: string;
  /** Hintergrund der Sektion (Weiß und Hellgrau wechseln sich ab) */
  tone?: 'white' | 'soft';
  /** Alt-Text des Titelbilds (Standard: Titel) */
  imageAlt?: string;
  /** Spalten der Galerie je Desktop, Tablet, Handy (Standard: nach Bildzahl) */
  columns?: [number, number, number];
  /** Galerie-Anordnung (Standard: natürliche Seitenverhältnisse) */
  galleryLayout?: 'masonry' | 'grid';
  /** Schrift der Beschriftungen in der Infoleiste (Standard: Hauptseite, 18 px am Desktop) */
  labelClass?: string;
  /** Versatz der Leistungen-Spalte am Tablet (Standard: Hauptseite) */
  servicesClass?: string;
}
const {
  id = '4587619',
  post,
  rootClass = '',
  tone = 'white',
  imageAlt = post.title,
  columns = post.gallery.length <= 3 ? [3, 3, 1] : [2, 2, 1],
  galleryLayout = 'masonry',
  servicesClass = 'md:-ml-6.25',
  labelClass = 'text-label',
} = Astro.props;

const label = ['font-display font-medium tracking-label text-ink uppercase', labelClass].join(' ');
const value = 'leading-4 md:leading-[15px]';
const info = [
  { label: 'Jahr', value: post.info.year },
  { label: 'Ort', value: post.info.place },
  { label: 'Zeitspanne', value: post.info.duration },
  { label: 'Quadratmeter', value: post.info.area },
];
---

<section
  data-section={id}
  class:list={['flex flex-col px-page py-section', tone === 'soft' ? 'bg-soft' : 'bg-white', rootClass]}
>
  <div class="mx-auto flex w-full max-w-wide flex-col gap-12 lg:gap-16">
  <!-- Titelbild -->
  <div>
    <div class="overflow-hidden">
      <Picture
        formats={['avif']}
        fallbackFormat="webp"
        src={post.image}
        alt={imageAlt}
        widths={[350, 700, 984, 1120, 1600]}
        sizes="(min-width: 1025px) 1120px, (min-width: 768px) 984px, 350px"
        loading="eager"
        fetchpriority="high"
        class="block h-117 w-full object-cover md:h-150 lg:h-180"
      />
    </div>
  </div>

  <div class="flex flex-col gap-12 lg:gap-16">
    <!-- Infoleiste -->
    <div>
      <div class="flex flex-wrap justify-start gap-x-5 gap-y-7.5 md:gap-x-7.5 lg:flex-nowrap lg:justify-center lg:gap-y-5">
        <div
          class:list={[
            'flex w-full flex-wrap gap-2.5 md:w-[60%] lg:w-1/3 lg:gap-x-7.5 lg:gap-y-5',
            servicesClass,
          ]}
        >
          <p class:list={[label, 'w-full']}>Erbrachte Leistungen</p>
          {post.services.map((service) => (
            <div>
              <span class={value}>{service}</span>
            </div>
          ))}
        </div>
        {info.map((item) => (
          <div class="flex w-[45%] flex-col gap-2.5 md:w-[30%] lg:w-37.5 lg:gap-5">
            <p class={label}>{item.label}</p>
            <div>
              <span class={value}>{item.value}</span>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Textabschnitte -->
    <div>
      <div class="flex flex-col gap-4 md:gap-5">
        {post.sections.map((section) => (
          <>
            <h2 class="font-display text-h2 text-ink">
              {section.heading}
            </h2>
            <div class:list={post.largeText ? 'text-lead' : 'text-body'}>
              {section.text}
            </div>
          </>
        ))}
      </div>
    </div>

    <!-- Galerie (Original: 3 Spalten bei wenigen Bildern, sonst 2; Abstand 30, am Handy 10) -->
    <Gallery
      id="838a0e7"
      items={post.gallery}
      {columns}
      layout={galleryLayout}
      gap={[30, 30, 10]}
      alt={post.title}
      rootClass=""
      innerClass="max-w-none"
    />
  </div>
  </div>
</section>
