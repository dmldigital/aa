---
import { Picture } from 'astro:assets';
import Button from '../ui/Button.astro';
import { href, routes } from '../../data/links';
import concrete from '../../assets/img/249-mw-20241125-scaled.jpg';

/**
 * Betonwand-Banner (Original 882761a). Ohne Props: Startseite. Foto-Szene: bleibt vollflächig, hat keinen Grund-Wechsel
 * Weiß/Hellgrau und keine Linien; der Text steht auf einer Milchglas-Fläche.
 */
interface Props {
  id?: string;
  image?: ImageMetadata;
  /** Kurztext über dem Button; `leadTag` + `leadClass` ersetzen die Startseiten-Darstellung (span, weiß, 15 px). */
  lead?: string;
  /** `h5` bleibt aus Kompatibilität erlaubt, wird aber als Absatz ausgegeben */
  leadTag?: 'span' | 'p' | 'h5';
  leadClass?: string;
  button?: { label: string; href: string };
  heading?: string;
  /** Tag der Überschrift (Standard h2) */
  headingTag?: 'h2' | 'h3';
  rootClass?: string;
}
const {
  id = '882761a',
  image = concrete,
  lead = 'Lassen Sie uns gemeinsam etwas Einzigartiges schaffen.',
  leadTag = 'span',
  leadClass = 'text-white text-body',
  button = { label: 'Projekt Starten', href: href(routes.contact) },
  heading = 'Jede Oberfläche ist einzigartig. <br /> Genauso wie unser Ansatz.',
  headingTag: Heading = 'h2',
  rootClass = '',
} = Astro.props;
const Lead = leadTag === 'h5' ? 'p' : leadTag;
---

<section data-section={id} data-cta-off class:list={['relative flex flex-col overflow-hidden', rootClass]}>
  <Picture
    formats={['avif']}
    fallbackFormat="webp"
    src={image}
    alt=""
    widths={[640, 1024, 1440, 2000]}
    sizes="100vw"
    loading="lazy"
    class="absolute inset-0 size-full object-cover object-center"
  />

  <div class="relative flex min-h-[100vw] flex-col py-5 pl-[5%] md:min-h-100 md:py-15 md:pl-[10%] lg:min-h-[clamp(500px,80vh,600px)] lg:py-[10vh]">
    <div class="mx-auto flex w-full max-w-page grow">
      <div class="flex w-[65%] flex-col justify-between gap-5 px-5 py-7.5 backdrop-blur-[40px] backdrop-saturate-[1.8] md:w-85 lg:w-105 lg:px-7.5 lg:py-10">
        <div class="flex flex-col gap-3.75 lg:gap-5">
          <div class="mb-2.5 w-full max-w-[280px]" data-anim="slideInUp" data-anim-delay="50">
            <Lead class={leadClass} set:html={lead} />
          </div>
          <div data-anim="slideInUp" data-anim-delay="100">
            <Button href={href(button.href)} variant="light">
              {button.label}
            </Button>
          </div>
        </div>
        <div data-anim="slideInUp">
          <Heading class="font-display text-h2 font-medium text-white" set:html={heading} />
        </div>
      </div>
    </div>
  </div>
</section>
