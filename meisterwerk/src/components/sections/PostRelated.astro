---
/**
 * „Related“ unter einem Beitrag der Exklusiv-Site (Original 774b801, dort ein Endlos-Karussell): hier drei
 * feststehende Karten (Handy eine), im Original ist es dieselbe Ansicht der Schleife.
 */
import { Picture } from 'astro:assets';
import { href } from '../../data/links';
import { img } from '../../lib/img';

interface Props {
  id?: string;
  items: {
    href: string;
    image: string;
    alt: string;
    category: string;
    categoryHref: string;
    title: string;
  }[];
  rootClass?: string;
}
const {
  id = '774b801',
  items,
  rootClass = 'mt-10 mb-10 md:mt-15 md:mb-15 lg:mt-27 lg:mb-27',
} = Astro.props;
// Die Schleife zeigt auf dem Desktop und Tablet drei Karten: Wiederholung der echten
const slides = [0, 1, 2].map((i) => items[i % items.length]);
---

<section data-section={id} class:list={['px-5 lg:px-7.5', rootClass]}>
  <div class="mx-auto flex max-w-mobile flex-col gap-5 md:max-w-tablet lg:max-w-page">
    <h3 class="font-display text-h3 text-ink lg:text-h2">
      Related
    </h3>
    <div class="flex overflow-hidden pb-7.5 md:pb-8.75 lg:pb-0">
      {slides.map((item, i) => (
        <div
          class:list={[
            'mr-5 flex w-full shrink-0 flex-col gap-5 lg:mr-7.5 md:w-[calc((100%-40px)/3)] lg:w-[calc((100%-60px)/3)]',
            i > 0 && 'hidden md:flex',
          ]}
        >
          <a
            href={href(item.href)}
            class="mb-2.5 block h-117 overflow-hidden text-ink md:h-150 lg:h-180"
          >
            <Picture
              formats={['avif']}
              fallbackFormat="webp"
              src={img(item.image)}
              alt={item.alt}
              widths={[350, 440, 880]}
              sizes="(min-width: 1025px) 440px, (min-width: 768px) 315px, 350px"
              loading="lazy"
              class="block size-full object-cover"
            />
          </a>
          <div class="flex flex-col gap-2.5">
            <div class="-mb-0.75 text-small">
              <a href={href(item.categoryHref)}>{item.category}</a>
            </div>
            <h4 class="font-display text-h3 font-medium text-ink md:w-[calc(100%-32px)] lg:w-[calc(100%-44px)]">
              <a href={href(item.href)}>{item.title}</a>
            </h4>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
