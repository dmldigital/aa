---
/**
 * „Weitere Projekte“ unter einem Beitrag der Exklusiv-Site (Original 774b801, dort ein Endlos-Karussell): bis zu drei
 * Karten nebeneinander (Handy untereinander). Der aktuelle Beitrag wird ausgenommen, es erscheinen nur vorhandene Karten.
 */
import { Picture } from 'astro:assets';
import { href } from '../../data/links';
import { img } from '../../lib/img';

interface Props {
  id?: string;
  items: {
    href: string;
    image: string;
    alt: string;
    category: string;
    categoryHref: string;
    title: string;
  }[];
  /** Adresse der aktuellen Seite (Standard: aktuelle URL), diese Karte wird nicht gezeigt */
  current?: string;
  heading?: string;
  /** Hintergrund der Sektion (Weiß und Hellgrau wechseln sich ab) */
  tone?: 'white' | 'soft';
  rootClass?: string;
}
const {
  id = '774b801',
  items,
  current = Astro.url.pathname,
  heading = 'Weitere Projekte',
  tone = 'soft',
  rootClass = '',
} = Astro.props;
// Vergleich über den Pfad ohne Basis, Adresse und Anker (href() liefert je nach Seite absolute Adressen)
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const norm = (p: string) => {
  let path = p;
  try {
    path = new URL(p, 'https://x.invalid').pathname;
  } catch {}
  if (base && path.startsWith(`${base}/`)) path = path.slice(base.length);
  return path.replace(/\/$/, '');
};
const here = norm(current);
const slides = items.filter((item) => norm(item.href) !== here).slice(0, 3);
---

{slides.length > 0 && (
  <section
    data-section={id}
    class:list={['px-page py-section', tone === 'soft' ? 'bg-soft' : 'bg-white', rootClass]}
  >
    <div class="mx-auto flex w-full max-w-page flex-col gap-8">
      <h2 class="font-display text-h2 font-medium text-ink">{heading}</h2>
      <div class="grid grid-cols-1 gap-5 md:grid-cols-3">
        {slides.map((item) => (
          <div class="flex flex-col gap-5">
            <a href={href(item.href)} class="block aspect-[3/4] overflow-hidden text-ink" tabindex="-1" aria-hidden="true">
              <Picture
                formats={['avif']}
                fallbackFormat="webp"
                src={img(item.image)}
                alt=""
                widths={[350, 440, 880]}
                sizes="(min-width: 1025px) 440px, (min-width: 768px) 315px, 350px"
                loading="lazy"
                class="block size-full object-cover"
              />
            </a>
            <div class="flex flex-col gap-2.5">
              <p class="text-small">
                <a href={href(item.categoryHref)}>{item.category}</a>
              </p>
              <h3 class="font-display text-h3 font-medium text-ink">
                <a href={href(item.href)}>{item.title}</a>
              </h3>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
)}
