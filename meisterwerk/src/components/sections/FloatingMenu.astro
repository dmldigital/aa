---
import ContactIcon from '../ui/ContactIcon.astro';
import { href } from '../../data/links';
import { site as company } from '../../data/site';
import type { Site } from '../../data/nav';
/**
 * Die Pille „Kontakt | Menü“ ersetzt Menü-Knopf und Kontakt-Button der Kopfzeile (Header.astro, nur noch das Logo). Sie ist ein festes
 * Element: Beim Laden liegt sie an der Stelle der Kopfzeile (rechts, mittig zum Logo), sobald man scrollt, gleitet sie weich an ihre
 * schwebende Position oben rechts, beim Zurückscrollen an den Anfang wieder in die Kopfzeile. Die Verschiebung misst das Skript unten
 * (`--fm-dx`, `--fm-dy`), sie hängt nur von der Kopfzeile der Seite ab. Zwei Felder:
 *   Kontakt  klappt die Kontaktwege auf: WhatsApp, Telefon, Kontakt, Projektanfrage. Maus: Überfahren öffnet, die Box steht
 *            links neben der Pille, der Name als Schild unter dem Symbol. Touch: Antippen öffnet, die Box steht als Liste
 *            unter der Pille. Tastatur: Fokus öffnet. Antippen daneben oder Esc schließt.
 *   Menü     öffnet das Hauptmenü (Menu.astro).
 * Kein Zoom und keine Schattenänderung beim Überfahren. Rund wie alle Buttons der Seite (Button.astro).
 */
interface Props {
  site?: Site;
}
const { site = 'main' } = Astro.props;
const exk = site === 'exklusive';
const items = [
  { icon: 'whatsapp', label: 'WhatsApp', sub: 'Nachricht schreiben', href: company.whatsappHref, ext: true },
  { icon: 'phone', label: 'Telefon', sub: company.phone, href: `tel:${company.phoneHref}`, ext: false },
  {
    icon: 'mail',
    label: 'Kontakt',
    sub: 'Nachricht senden',
    href: href(exk ? '/meisterwerk-exklusive/kontakt/' : '/schnellkontakt/'),
    ext: false,
  },
  ...(exk
    ? []
    : [{ icon: 'roller', label: 'Projektanfrage', sub: 'Projekt starten', href: href('/kontakt/'), ext: false }]),
] as const;
const ext = (on: boolean) => (on ? { target: '_blank', rel: 'noopener noreferrer' } : {});
const n = items.length;
// Breite der Symbol-Reihe fest berechnet (Symbole 2,25 rem, Abstand 0,375 rem, seitlich 0,75 rem): kein Verlass auf die Breitenermittlung des Browsers
const rowWidth = `${n * 2.25 + (n - 1) * 0.375 + 1.5}rem`;

const shadow =
  'shadow-[0_1px_1px_rgb(21_24_27/0.04),0_6px_16px_-4px_rgb(21_24_27/0.1),0_18px_40px_-14px_rgb(21_24_27/0.2)]';
// Handy und Desktop sind getrennt mit `max-[700px]:` und `min-[701px]:` geschrieben, nie als Grundwert plus Überschreibung: So hängt das Ergebnis
// nicht von der Reihenfolge der CSS-Regeln ab (in der handbearbeiteten Vorschau-Startseite stimmte sie nicht).
// Tailwind 4: translate und scale sind eigene CSS-Eigenschaften, `transition-[transform]` würde sie nicht animieren.
// Einblenden weich auslaufend und etwas länger, Ausblenden kürzer und gleichmäßig.
// Außenrahmen: unsichtbar, bis das Skript die Kopfzeilen-Position gemessen hat (`data-show`). `data-top` = Pille liegt in der Kopfzeile (Verschiebung
// um `--fm-dx`/`--fm-dy`), ohne `data-top` schwebt sie. `data-init` schaltet die Übergänge kurz ab (erstes Platzieren, Fenstergröße ändern).
// Verschiebung 700 ms weich auslaufend, Ein- und Ausblenden 450 ms. `data-open` bei geöffneten Kontaktwegen.
const wrap =
  'group/fm invisible fixed z-[45] opacity-0 transition-[translate,opacity,visibility] duration-[700ms,450ms,450ms] ease-[cubic-bezier(0.22,1,0.36,1)] data-[show]:visible data-[show]:opacity-100 data-[top]:translate-x-[var(--fm-dx,0px)] data-[top]:translate-y-[var(--fm-dy,0px)] data-[init]:transition-none max-[700px]:top-3.75 max-[700px]:right-5 min-[701px]:top-5 min-[701px]:right-7.5';
const pill = `relative flex items-stretch rounded-full border border-black/[0.08] bg-white text-ink ${shadow} max-[700px]:h-11 min-[701px]:h-12`;
// Felder der Pille: weicher Grund beim Überfahren und solange die Kontaktwege offen sind, kein Unterstrich
const seg =
  'group/ul my-1 flex cursor-pointer items-center rounded-full text-ink transition-colors duration-300 hover:bg-black/[0.055]';
const text =
  'font-display font-medium tracking-[0.07em] uppercase max-[700px]:text-[11px]/none min-[701px]:text-[11.5px]/none';
const bar = 'block h-px w-full bg-current';
// Kontaktwege: Handy unter der Pille als Liste, ab 701 px links neben der Pille als Reihe von Symbolen. Der Grund (Pille mit
// Rand und Schatten) wächst dort von der Kontakt-Taste nach links, die Symbole blenden nacheinander von der Pille aus ein.
const panel =
  'invisible absolute transition-[visibility] duration-[420ms] group-data-[open]/fm:visible group-data-[open]/fm:duration-0 max-[700px]:top-full max-[700px]:right-0 max-[700px]:pt-2.5 min-[701px]:-top-px min-[701px]:right-full min-[701px]:h-[calc(100%+2px)] min-[701px]:w-[calc(var(--w)+0.625rem)] min-[701px]:pr-2.5';
const ground = `pointer-events-none absolute top-0 right-0 bottom-0 origin-top-right border border-black/[0.08] bg-white opacity-0 ${shadow} transition-[width,scale,opacity] duration-[320ms] ease-[cubic-bezier(0.4,0,0.2,1)] group-data-[open]/fm:opacity-100 group-data-[open]/fm:duration-[720ms] group-data-[open]/fm:ease-[cubic-bezier(0.32,0.72,0,1)] max-[700px]:left-0 max-[700px]:scale-90 max-[700px]:rounded-[22px] max-[700px]:group-data-[open]/fm:scale-100 min-[701px]:w-9 min-[701px]:rounded-full min-[701px]:group-data-[open]/fm:w-full`;
const box =
  'relative flex max-[700px]:flex-col max-[700px]:gap-0.5 max-[700px]:p-2 min-[701px]:h-full min-[701px]:w-[var(--w)] min-[701px]:shrink-0 min-[701px]:items-center min-[701px]:gap-1.5 min-[701px]:px-3';
const item =
  'relative flex translate-x-3 opacity-0 blur-[2px] transition-[translate,opacity,filter] duration-[220ms] ease-out group-data-[open]/fm:translate-x-0 group-data-[open]/fm:opacity-100 group-data-[open]/fm:blur-none group-data-[open]/fm:duration-[640ms] group-data-[open]/fm:ease-[cubic-bezier(0.32,0.72,0,1)] group-data-[open]/fm:[transition-delay:var(--d)]';
const link =
  'group/it relative rounded-full text-ink transition-colors duration-300 hover:bg-black/[0.055] focus-visible:bg-black/[0.055] max-[700px]:flex max-[700px]:h-11 max-[700px]:w-full max-[700px]:items-center max-[700px]:gap-3 max-[700px]:pr-5 max-[700px]:pl-2.5 min-[701px]:grid min-[701px]:size-9 min-[701px]:place-items-center';
// Name: Handy neben dem Symbol, ab 701 px als Schild unter dem Symbol beim Überfahren oder Fokus
const label =
  'font-display uppercase max-[700px]:text-[11px]/none max-[700px]:tracking-[0.07em] min-[701px]:pointer-events-none min-[701px]:absolute min-[701px]:top-full min-[701px]:left-1/2 min-[701px]:mt-3.5 min-[701px]:-translate-x-1/2 min-[701px]:translate-y-1 min-[701px]:rounded-full min-[701px]:border min-[701px]:border-black/[0.08] min-[701px]:bg-white min-[701px]:px-3 min-[701px]:py-1.5 min-[701px]:text-[10px]/none min-[701px]:tracking-[0.08em] min-[701px]:whitespace-nowrap min-[701px]:text-ink min-[701px]:shadow-[0_1px_1px_rgb(21_24_27/0.04),0_6px_16px_-4px_rgb(21_24_27/0.1)] min-[701px]:opacity-0 min-[701px]:transition-[translate,opacity] min-[701px]:duration-300 min-[701px]:ease-out min-[701px]:group-hover/it:translate-y-0 min-[701px]:group-hover/it:opacity-100 min-[701px]:group-focus-visible/it:translate-y-0 min-[701px]:group-focus-visible/it:opacity-100';
---

<div data-fm-root class="contents">
  <div data-float-menu aria-hidden="true" inert class={wrap}>
    <div class={pill}>
      <div data-fm-seg class="flex h-full">
        <button
          type="button"
          data-fm-contact
          aria-expanded="false"
          aria-controls="fm-contact"
          class={`${seg} ml-1 max-[700px]:px-3.5 min-[701px]:px-4.5 group-data-[open]/fm:bg-black/[0.055]`}
        >
          <span class={text}>Kontakt</span>
        </button>
        <div id="fm-contact" role="group" aria-label="Schnellkontakt" class={panel} style={`--w:${rowWidth}`}>
          <ul class={box}>
            <li aria-hidden="true" class="contents"><span class={ground}></span></li>
            {
              items.map((it, i) => (
                <li class={item} style={`--d:${170 + (n - 1 - i) * 70}ms`}>
                  <a href={it.href} {...ext(it.ext)} aria-label={`${it.label}: ${it.sub}`} class={link}>
                    <span class="grid shrink-0 place-items-center max-[700px]:size-6">
                      <ContactIcon name={it.icon} class={it.icon === 'whatsapp' ? 'size-4' : 'size-4.5'} />
                    </span>
                    <span class={label}>{it.label}</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <span aria-hidden="true" class="my-auto h-3.5 w-px bg-black/[0.12]"></span>

      <button
        type="button"
        data-menu-open
        aria-haspopup="dialog"
        aria-expanded="false"
        aria-label="Menü öffnen"
        class={`${seg} mr-1 max-[700px]:gap-2.5 max-[700px]:pr-4 max-[700px]:pl-3.5 min-[701px]:gap-3.5 min-[701px]:pr-5 min-[701px]:pl-4.5`}
      >
        <span class={text}>Menü</span>
        <span aria-hidden="true" class="flex flex-col gap-1.5 max-[700px]:w-4 min-[701px]:w-5.5">
          <i class={bar}></i>
          <i class={`${bar} transition-[width] duration-300 group-hover/ul:w-[65%]`}></i>
        </span>
      </button>
    </div>
  </div>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-float-menu]');
  const seg = root?.querySelector<HTMLElement>('[data-fm-seg]');
  const contact = root?.querySelector<HTMLButtonElement>('[data-fm-contact]');
  if (root && seg && contact) {
    // Kontaktwege: Maus über dem Feld (kurze Schonfrist beim Verlassen), Antippen (Touch), Tastaturfokus. Esc oder Antippen daneben schließt.
    const hoverCapable = matchMedia('(hover: hover)').matches;
    let timer = 0;
    const open = (on: boolean) => {
      clearTimeout(timer);
      root.toggleAttribute('data-open', on);
      contact.setAttribute('aria-expanded', String(on));
    };
    seg.addEventListener('pointerenter', (e) => e.pointerType === 'mouse' && open(true));
    seg.addEventListener('pointerleave', (e) => {
      if (e.pointerType === 'mouse') timer = window.setTimeout(() => open(false), 200);
    });
    root.querySelector('[data-menu-open]')?.addEventListener('pointerenter', (e) => {
      if ((e as PointerEvent).pointerType === 'mouse') open(false);
    });
    contact.addEventListener('click', () => open(hoverCapable ? true : !root.hasAttribute('data-open')));
    seg.addEventListener('focusin', (e) => (e.target as Element).matches(':focus-visible') && open(true));
    seg.addEventListener('focusout', (e) => seg.contains(e.relatedTarget as Node) || open(false));
    document.addEventListener('pointerdown', (e) => {
      if (root.hasAttribute('data-open') && !seg.contains(e.target as Node)) open(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && root.hasAttribute('data-open')) {
        open(false);
        if (seg.contains(document.activeElement)) contact.focus();
      }
    });
    root.querySelector('[data-menu-open]')?.addEventListener('click', () => open(false));
    new MutationObserver(() => root.hasAttribute('data-show') || open(false)).observe(root, { attributeFilter: ['data-show'] });

    // Position: ganz oben in der Kopfzeile (rechts, mittig zum Logo), sonst schwebend. Die Verschiebung dorthin wird gemessen, solange man oben steht.
    const header = document.querySelector<HTMLElement>('[data-site-header]');
    const brand = header?.querySelector<HTMLElement>('a');
    let measured = false;
    const measure = () => {
      if (!header || !brand || window.scrollY > 8) return;
      const own = getComputedStyle(root);
      const floatRight = document.documentElement.clientWidth - parseFloat(own.right);
      const floatMid = parseFloat(own.top) + root.offsetHeight / 2;
      const bar = header.getBoundingClientRect();
      const logo = brand.getBoundingClientRect();
      const slotRight = bar.right - parseFloat(getComputedStyle(header).paddingRight);
      const slotMid = logo.top + window.scrollY + logo.height / 2;
      // Passt die Pille neben das Logo (Startseite auf dem Tablet: Kopfzeile nur in der linken Hälfte), sonst bleibt sie gleich schwebend
      const fits = slotRight - root.offsetWidth > logo.right + 16;
      root.style.setProperty('--fm-dx', fits ? `${(slotRight - floatRight).toFixed(2)}px` : '0px');
      root.style.setProperty('--fm-dy', fits ? `${(slotMid - floatMid).toFixed(2)}px` : '0px');
      measured = true;
    };
    const update = () => {
      const top = window.scrollY <= 8;
      if (top && !measured) measure();
      root.toggleAttribute('data-top', top && measured);
      const on = !document.querySelector('[data-gallery-lightbox]:not([hidden]), [data-lb]:not([hidden])');
      if (on !== root.hasAttribute('data-show')) {
        root.toggleAttribute('data-show', on);
        root.inert = !on;
        root.setAttribute('aria-hidden', String(!on));
      }
    };
    let queued = false;
    const later = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(() => {
        queued = false;
        update();
      });
    };
    // Erstes Platzieren und neues Messen bei geänderter Fenstergröße ohne Übergang
    const place = () => {
      root.setAttribute('data-init', '');
      measured = false;
      update();
      requestAnimationFrame(() => requestAnimationFrame(() => root.removeAttribute('data-init')));
    };
    addEventListener('scroll', later, { passive: true });
    addEventListener('resize', place);
    place();
    document.fonts?.ready.then(() => window.scrollY <= 8 && place());
  }
</script>
