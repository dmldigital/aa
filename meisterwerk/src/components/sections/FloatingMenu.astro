---
/**
 * Schwebende Menü-Schaltfläche oben rechts, genau dort, wo später der Menü-Knopf der Smart-Kopfzeile steht. Sie ersetzt den
 * früher geplanten Back-to-Top-Pfeil: Ein Klick lässt die Kopfzeile (Logo, Menü, Kontakt) von oben herunterfahren, auch dort,
 * wo sie beim Hochscrollen sonst wegbleibt (Szenen, Formulare). Wann sie erscheint, regelt das Skript in SmartHeader.astro
 * (nach dem Hero bzw. der Kopfzeile, solange die Kopfzeile nicht zu sehen ist, nicht kurz vor dem Seitenende).
 * Gestaltung: weiße Glas-Pille mit Haarlinie, „Menü“ und den zwei Haarlinien des Menü-Knopfs. Beim Überfahren: Unterstrich-
 * Animation der Seite (wie bei den Buttons), goldener Ring, zweite Linie verkürzt sich. Sie fährt von oben ein und wieder aus.
 */
const bar = 'block h-px w-full bg-current';
---

<button
  type="button"
  aria-label="Menü und Kopfzeile einblenden"
  aria-hidden="true"
  tabindex="-1"
  inert
  data-float-menu
  class="group/fm group/ul invisible fixed top-3.75 right-5 z-[45] flex h-11 -translate-y-5 cursor-pointer items-center gap-3.5 rounded-full border border-black/10 bg-white/90 pr-5 pl-5.5 text-ink opacity-0 shadow-[0_1px_2px_rgb(21_24_27/0.06),0_14px_32px_-10px_rgb(21_24_27/0.24)] backdrop-blur-xl backdrop-saturate-150 transition-[transform,opacity,visibility,box-shadow,border-color] duration-[420ms] ease-[cubic-bezier(0.22,1,0.36,1)] hover:border-gold hover:shadow-[0_1px_2px_rgb(21_24_27/0.06),0_16px_36px_-10px_rgb(165_147_113/0.5)] active:scale-[0.97] data-[show]:visible data-[show]:translate-y-0 data-[show]:opacity-100 min-[701px]:top-5 min-[701px]:right-7.5 min-[701px]:h-12 min-[701px]:pr-5.5 min-[701px]:pl-6.5"
>
  <span
    aria-hidden="true"
    class="pointer-events-none absolute -inset-1.5 scale-95 rounded-full border border-gold opacity-0 transition-[opacity,transform] duration-500 ease-out group-hover/fm:scale-100 group-hover/fm:opacity-100"
  ></span>
  <span class="underline-anim font-display text-[11px]/none font-medium tracking-[0.07em] uppercase [--underline-gap:5px]">
    Menü
  </span>
  <span aria-hidden="true" class="flex w-5.5 flex-col gap-1.5">
    <i class={bar}></i>
    <i class={`${bar} transition-[width] duration-200 group-hover/fm:w-[65%]`}></i>
  </span>
</button>
