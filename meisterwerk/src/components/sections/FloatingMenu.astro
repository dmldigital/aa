---
import Button from '../ui/Button.astro';
/**
 * Schwebende Menü-Schaltfläche unten rechts (Gegenstück zum Sticker „Projekt starten“ unten links). Sie ersetzt den früher
 * geplanten Back-to-Top-Pfeil: Ein Klick lässt die Kopfzeile (Logo, Menü, Kontakt) von oben herunterfahren, auch dort,
 * wo sie beim Hochscrollen sonst wegbleibt (Szenen, Formulare). Wann sie erscheint, regelt das Skript in SmartHeader.astro
 * (nach dem Hero bzw. der Kopfzeile, solange die Kopfzeile nicht zu sehen ist, nicht kurz vor dem Seitenende).
 * Drei Gestaltungen zur Auswahl (`variant`):
 *   1  Kreis: runde weiße Fläche mit dünnem Rand und den zwei Haarlinien des Menü-Knopfs, weicher Schatten
 *   2  Pille: derselbe Button wie der Sticker (Rahmen, Großbuchstaben, Unterstreichung) mit Haarlinien, Zwilling zum Sticker
 *   3  Lasche: schmale senkrechte Lasche am rechten Rand mit stehender Schrift „Menü“, schiebt sich beim Überfahren heraus
 */
interface Props {
  variant?: 1 | 2 | 3;
}
const { variant = 1 } = Astro.props;

const show =
  'invisible opacity-0 transition-[transform,opacity,visibility,padding,box-shadow,border-color] duration-[380ms] ease-[cubic-bezier(0.22,1,0.36,1)] data-[show]:visible data-[show]:opacity-100';
const bars = 'flex w-5 flex-col gap-1.5';
const bar = 'block h-px w-full bg-current';
---

{
  variant === 1 && (
    <button
      type="button"
      aria-label="Menü und Kopfzeile einblenden" aria-hidden="true" tabindex="-1" inert data-float-menu
      class={`group/fm fixed right-4 bottom-4 z-[45] flex size-12 translate-y-3 cursor-pointer items-center justify-center rounded-full border border-black/15 bg-white/95 text-ink shadow-[0_8px_28px_rgb(0_0_0/0.12)] backdrop-blur-md hover:border-gold hover:shadow-[0_10px_32px_rgb(165_147_113/0.3)] data-[show]:translate-y-0 min-[701px]:right-7.5 min-[701px]:bottom-7.5 min-[701px]:size-14 ${show}`}
    >
      <span aria-hidden="true" class="pointer-events-none absolute -inset-1.5 rounded-full border border-gold opacity-0 transition-[opacity,transform] duration-500 ease-out group-hover/fm:scale-100 group-hover/fm:opacity-100 scale-90" />
      <span aria-hidden="true" class={bars}>
        <i class={bar}></i>
        <i class={`${bar} transition-[width] duration-200 group-hover/fm:w-[65%]`}></i>
      </span>
    </button>
  )
}

{
  variant === 2 && (
    <Button
      size="sm"
      type="button"
      aria-label="Menü und Kopfzeile einblenden" aria-hidden="true" tabindex="-1" inert data-float-menu
      class={`fixed right-5 bottom-5 z-[45] translate-y-3 shadow-[0_2px_8px_rgb(0_0_0/0.1)] data-[show]:translate-y-0 min-[769px]:right-7.5 min-[769px]:bottom-7.5 ${show}`}
    >
      <span class="flex items-center gap-3">
        Menü
        <span aria-hidden="true" class="flex w-4 flex-col gap-1">
          <i class={bar}></i>
          <i class={bar}></i>
        </span>
      </span>
    </Button>
  )
}

{
  variant === 3 && (
    <button
      type="button"
      aria-label="Menü und Kopfzeile einblenden" aria-hidden="true" tabindex="-1" inert data-float-menu
      class={`group/fm fixed right-0 bottom-24 z-[45] flex translate-x-2 cursor-pointer flex-col items-center gap-3.5 border border-r-0 border-black/15 bg-white py-4 pr-3.5 pl-3 text-ink shadow-[-6px_0_24px_rgb(0_0_0/0.07)] before:absolute before:inset-y-0 before:-left-px before:w-px before:bg-gold hover:pr-5 data-[show]:translate-x-0 min-[701px]:bottom-32 ${show}`}
    >
      <span aria-hidden="true" class={bars}>
        <i class={bar}></i>
        <i class={`${bar} transition-[width] duration-200 group-hover/fm:w-[65%]`}></i>
      </span>
      <span class="font-display text-[11px]/none tracking-[0.2em] uppercase [writing-mode:vertical-rl] rotate-180">Menü</span>
    </button>
  )
}
