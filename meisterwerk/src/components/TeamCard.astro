---
import { Picture } from 'astro:assets';
import { href } from '../data/links';

/** Mitarbeiter-Karte: Graustufenbild (bei Hover farbig und größer), Name / Funktion. Verlinkt auf die Profilseite. */
interface Props {
  member: { name: string; role: string; href: string; img: ImageMetadata; alt: string };
  widths?: number[];
  sizes?: string;
  /** Schrift von Name und Funktion (Standard: Handy 14 px, ab Tablet Fließtext). */
  textClass?: string;
}
const {
  member,
  widths = [165, 229, 330, 660],
  sizes = '(min-width: 1025px) 330px, (min-width: 768px) 229px, 165px',
  textClass = 'text-body',
} = Astro.props;
---

<a href={href(member.href)} class="group/card flex flex-col gap-2.5 text-ink">
  <div class="overflow-hidden">
    <Picture
      formats={['avif']}
      fallbackFormat="webp"
      src={member.img}
      alt={member.alt}
      {widths}
      {sizes}
      class="block h-auto w-full grayscale transition-[scale,filter] duration-[450ms] ease-in-out group-hover/card:scale-110 group-hover/card:grayscale-0"
    />
  </div>
  <div class:list={['flex flex-wrap items-start gap-1.25 text-muted', textClass]}>
    <p class="font-semibold">{member.name}</p>
    <p aria-hidden="true">/</p>
    <p>{member.role}</p>
  </div>
</a>
