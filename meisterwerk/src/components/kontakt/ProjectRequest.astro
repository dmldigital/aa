---
/**
 * Projektanfrage (Seite /kontakt/): ein ruhiger Assistent mit einer Frage pro Schritt.
 * Desktop: links bleibt die Orientierung stehen (Schritte, „Frage x von 9“, Telefon), rechts steht die Frage mit weißen
 * Antwortkarten auf hellgrauem Grund. Handy: oben nur Fortschritt, Frage und Karten untereinander, unten klebt die Leiste mit
 * Zurück und Weiter. Gewählt = goldener Rahmen und goldener Haken. Einzelauswahl geht nach kurzer Pause von selbst weiter,
 * Mehrfachauswahl mit „Weiter“. Die Frage fährt wortweise aus einer Maske hoch. Fehler stehen als Zeile unter dem Feld.
 * Am Ende ein Überblick mit „Ändern“ je Block. Gleiche Feldnamen wie `ContactForm`. Ohne Skript stehen alle Fragen untereinander.
 * Das Absenden ist noch nicht angebunden: Am Ende die bekannte Meldung und eine vorbereitete E-Mail.
 * Abstände nur aus dem Abstandssystem (`--space-*`).
 */
import Button from '../ui/Button.astro';
import Icon from '../Icon.astro';
import { site } from '../../data/site';

interface Props {
  heading: string;
  intro: string[];
}
const { heading, intro } = Astro.props;

type Opt = { v: string; l?: string };
const art: Opt[] = [{ v: 'Privat' }, { v: 'Gewerbe' }];
const bereich: Opt[] = [{ v: 'Außenarbeiten' }, { v: 'Innenarbeiten' }];
const leistungen: Opt[] = ['Spachteltechnik', 'Streichen', 'Lackieren', 'Tapezieren', 'Verputzen'].map((v) => ({ v }));
const zeit: Opt[] = [
  { v: 'Sofort', l: 'Sofort' },
  { v: 'Innerhalb von 1 bis 3 Monaten', l: 'Innerhalb von 1 bis 3 Monaten' },
  { v: 'Innerhalb von 12 Monaten', l: 'Innerhalb von 12 Monaten' },
  { v: '-', l: 'Noch offen' },
];

const steps = [
  { l: 'Projekt', from: 1, to: 3 },
  { l: 'Umfang', from: 4, to: 5 },
  { l: 'Bilder', from: 6, to: 6 },
  { l: 'Kontakt', from: 7, to: 8 },
  { l: 'Nachricht', from: 9, to: 9 },
  { l: 'Überblick', from: 10, to: 10 },
];
const facts = ['9 kurze Fragen', 'Antwort innerhalb von 24 Stunden', 'Persönlich aus Freiberg am Neckar'];
const tick = 'M4 10.5l4 4 8-9';
---

<section class="pf" data-pf data-cta-off>
  <form data-pf-form data-pf-mail={site.email} name="Projektanfrage" aria-label="Projektanfrage" novalidate>
    <div class="pf-shell">
      <aside class="pf-aside" aria-label="Fortschritt">
        <div class="pf-aside-top">
          <p class="pf-eyebrow">Projektanfrage</p>
          <p class="pf-count" aria-live="polite" data-pf-count hidden></p>
        </div>
        <div class="pf-bar" aria-hidden="true"><span data-pf-fill></span></div>
        <ol class="pf-steps">
          {steps.map((st) => (
            <li class="pf-step" data-pf-step data-from={st.from} data-to={st.to}>
              <button type="button" tabindex="-1" data-pf-step-go disabled>{st.l}</button>
            </li>
          ))}
        </ol>
        <p class="pf-note-call">
          Lieber persönlich?
          <a href={`tel:${site.phoneHref}`}>{site.phone}</a>
        </p>
      </aside>

      <div class="pf-stage">
      <div class="pf-host" data-pf-host>
        <!-- Start -->
        <section class="pf-screen" data-pf-screen aria-labelledby="pf-h-start">
          <div class="pf-q">
            <h1 class="pf-h pf-h--start" id="pf-h-start" tabindex="-1" data-pf-q>{heading}</h1>
          </div>
          <div class="pf-a">
            <div class="pf-intro" data-pf-item>
              {intro.map((p) => <p>{p}</p>)}
            </div>
            <ul class="pf-facts" data-pf-item>
              {facts.map((f) => (
                <li>
                  <span class="pf-facts-mark" aria-hidden="true"><svg viewBox="0 0 20 20"><path d={tick} /></svg></span>
                  {f}
                </li>
              ))}
            </ul>
            <div class="pf-start" data-pf-item data-pf-startbox>
              <div data-pf-start><Button type="button" variant="dark">Anfrage starten</Button></div>
            </div>
          </div>
        </section>

        <!-- 1 Privat oder Gewerbe -->
        <section class="pf-screen" data-pf-screen data-pf-auto aria-labelledby="pf-h-art">
          <div class="pf-q"><h2 class="pf-h" id="pf-h-art" tabindex="-1" data-pf-q>Privat oder Gewerbetreibend?</h2></div>
          <div class="pf-a pf-list" role="radiogroup" aria-labelledby="pf-h-art">
            {art.map((o, i) => (
              <label class="pf-opt" data-pf-item>
                <input type="radio" name="privat_gewerbe" value={o.v} required={i === 0} />
                <span class="pf-opt-text">{o.l ?? o.v}</span>
                <span class="pf-ind" aria-hidden="true"><svg viewBox="0 0 20 20"><path d={tick} /></svg></span>
              </label>
            ))}
          </div>
        </section>

        <!-- 2 Art der Arbeiten (Mehrfachauswahl, mindestens eine) -->
        <section class="pf-screen" data-pf-screen aria-labelledby="pf-h-bereich">
          <div class="pf-q">
            <h2 class="pf-h" id="pf-h-bereich" tabindex="-1" data-pf-q>Art der Arbeiten</h2>
            <p class="pf-hint" data-pf-item>Sie können beides wählen.</p>
          </div>
          <div class="pf-a pf-list" role="group" aria-labelledby="pf-h-bereich" data-pf-atleast>
            {bereich.map((o) => (
              <label class="pf-opt pf-opt--check" data-pf-item>
                <input type="checkbox" name="art_der_arbeiten[]" value={o.v} />
                <span class="pf-opt-text">{o.v}</span>
                <span class="pf-ind" aria-hidden="true"><svg viewBox="0 0 20 20"><path d={tick} /></svg></span>
              </label>
            ))}
          </div>
        </section>

        <!-- 3 Leistungen -->
        <section class="pf-screen" data-pf-screen aria-labelledby="pf-h-leistung">
          <div class="pf-q">
            <h2 class="pf-h" id="pf-h-leistung" tabindex="-1" data-pf-q>Welche Leistung interessiert Sie?</h2>
            <p class="pf-hint" data-pf-item>Mehrfachauswahl möglich.</p>
          </div>
          <div class="pf-a pf-list" role="group" aria-labelledby="pf-h-leistung">
            {leistungen.map((o) => (
              <label class="pf-opt pf-opt--check" data-pf-item>
                <input type="checkbox" name="leistungen[]" value={o.v} />
                <span class="pf-opt-text">{o.v}</span>
                <span class="pf-ind" aria-hidden="true"><svg viewBox="0 0 20 20"><path d={tick} /></svg></span>
              </label>
            ))}
          </div>
        </section>

        <!-- 4 Fläche -->
        <section class="pf-screen" data-pf-screen aria-labelledby="pf-h-flaeche">
          <div class="pf-q">
            <h2 class="pf-h" id="pf-h-flaeche" tabindex="-1" data-pf-q>Wie groß ist die Fläche?</h2>
            <p class="pf-hint" data-pf-item>Ungefähr reicht, wir klären alles Weitere gemeinsam. Mehr als 500 m²? Tragen Sie die Zahl einfach ein.</p>
          </div>
          <div class="pf-a">
            <div class="pf-area" data-pf-item data-pf-group>
              <label class="pf-fl-label" for="pf-flaeche">ca. Fläche in m²</label>
              <div class="pf-area-row">
                <input
                  class="pf-big"
                  type="text"
                  inputmode="decimal"
                  id="pf-flaeche"
                  name="flaeche_qm"
                  placeholder="120"
                  pattern="[0-9]+([.,][0-9]+)?"
                  autocomplete="off"
                  required
                  data-pf-area
                />
                <span class="pf-unit" aria-hidden="true">m²</span>
              </div>
              <input class="pf-range" type="range" min="5" max="500" step="5" value="100" aria-label="Fläche per Regler wählen" data-pf-range />
              <div class="pf-scale" aria-hidden="true"><span>5 m²</span><span>500 m²</span></div>
            </div>
          </div>
        </section>

        <!-- 5 Zeitpunkt -->
        <section class="pf-screen" data-pf-screen data-pf-auto aria-labelledby="pf-h-zeit">
          <div class="pf-q"><h2 class="pf-h" id="pf-h-zeit" tabindex="-1" data-pf-q>Wann sollen wir starten?</h2></div>
          <div class="pf-a pf-list" role="radiogroup" aria-labelledby="pf-h-zeit">
            {zeit.map((o, i) => (
              <label class="pf-opt" data-pf-item>
                <input type="radio" name="zeitpunkt" value={o.v} required={i === 0} />
                <span class="pf-opt-text">{o.l ?? o.v}</span>
                <span class="pf-ind" aria-hidden="true"><svg viewBox="0 0 20 20"><path d={tick} /></svg></span>
              </label>
            ))}
          </div>
        </section>

        <!-- 6 Bilder -->
        <section class="pf-screen" data-pf-screen aria-labelledby="pf-h-bilder">
          <div class="pf-q">
            <h2 class="pf-h" id="pf-h-bilder" tabindex="-1" data-pf-q>Haben Sie Bilder?</h2>
            <p class="pf-hint" data-pf-item>Optional, Sie können diesen Schritt überspringen. Höchstens 12 Bilder, zusammen höchstens 60 MB.</p>
          </div>
          <div class="pf-a" data-pf-drop>
            <label class="pf-drop" data-pf-item>
              <input type="file" name="bilder[]" accept="image/*" multiple data-pf-files />
              <span class="pf-drop-plus" aria-hidden="true"><Icon name="plus" class="size-5" /></span>
              <span class="pf-drop-text">Bilder auswählen oder hierher ziehen</span>
            </label>
            <p class="pf-note" role="status" data-pf-files-msg hidden></p>
            <p class="pf-note" aria-live="polite" data-pf-files-count hidden></p>
            <ul class="pf-thumbs" data-pf-thumbs></ul>
          </div>
        </section>

        <!-- 7 Kontakt -->
        <section class="pf-screen" data-pf-screen aria-labelledby="pf-h-kontakt">
          <div class="pf-q"><h2 class="pf-h" id="pf-h-kontakt" tabindex="-1" data-pf-q>Wie erreichen wir Sie?</h2></div>
          <div class="pf-a pf-fields">
            <div class="pf-field" data-pf-item>
              <label for="pf-name">Name</label>
              <input type="text" id="pf-name" name="name" autocomplete="name" required />
            </div>
            <div class="pf-field" data-pf-item>
              <label for="pf-tel">Rufnummer, optional</label>
              <input type="tel" id="pf-tel" name="telefon" autocomplete="tel" />
            </div>
            <div class="pf-field" data-pf-item>
              <label for="pf-email">E-Mail</label>
              <input type="email" id="pf-email" name="email" autocomplete="email" required />
            </div>
          </div>
        </section>

        <!-- 8 Adressen -->
        <section class="pf-screen" data-pf-screen aria-labelledby="pf-h-adresse">
          <div class="pf-q"><h2 class="pf-h" id="pf-h-adresse" tabindex="-1" data-pf-q>Wo liegt das Projekt?</h2></div>
          <div class="pf-a pf-fields">
            <div class="pf-field" data-pf-item>
              <label for="pf-adresse">Ihre Adresse</label>
              <input type="text" id="pf-adresse" name="adresse" autocomplete="street-address" required />
            </div>
            <div class="pf-field" data-pf-item>
              <label for="pf-bauvorhaben">Adresse Bauvorhaben</label>
              <input type="text" id="pf-bauvorhaben" name="adresse_bauvorhaben" required data-pf-site />
              <label class="pf-same">
                <input type="checkbox" data-pf-same />
                <span class="pf-same-box" aria-hidden="true"><svg viewBox="0 0 20 20"><path d={tick} /></svg></span>
                <span>Das Bauvorhaben liegt an meiner Adresse</span>
              </label>
            </div>
          </div>
        </section>

        <!-- 9 Nachricht -->
        <section class="pf-screen" data-pf-screen aria-labelledby="pf-h-nachricht">
          <div class="pf-q">
            <h2 class="pf-h" id="pf-h-nachricht" tabindex="-1" data-pf-q>Was ist Ihnen besonders wichtig, auf was sollen wir achten?</h2>
            <p class="pf-hint" data-pf-item>Zum Beispiel Ausführungszeitpunkt, Flexibilität, keine Parkplätze vor der Tür oder nur ein Stellplatz, Wohnung im siebten Stock.</p>
          </div>
          <div class="pf-a pf-fields">
            <div class="pf-field" data-pf-item>
              <label for="pf-nachricht">Nachricht</label>
              <textarea id="pf-nachricht" name="nachricht" rows="5" required></textarea>
            </div>
          </div>
        </section>

        <!-- 10 Überblick -->
        <section class="pf-screen" data-pf-screen aria-labelledby="pf-h-ueberblick">
          <div class="pf-q">
            <h2 class="pf-h" id="pf-h-ueberblick" tabindex="-1" data-pf-q>Ihre Anfrage im Überblick</h2>
            <p class="pf-hint" data-pf-item>Bitte prüfen Sie Ihre Angaben.</p>
          </div>
          <div class="pf-a">
            <dl class="pf-sum" data-pf-summary></dl>
          </div>
        </section>

        <input type="hidden" name="berechneter_preis" />
        <input type="hidden" name="ausgewaehlte_leistungen" />
        <input type="hidden" name="preis_pro_qm" />
        <input type="hidden" name="berechnungsdetails" />

        <!-- Fertig -->
        <div class="pf-done" data-pf-done tabindex="-1" role="status" hidden>
          <svg class="pf-done-mark" viewBox="0 0 64 64" aria-hidden="true">
            <circle cx="32" cy="32" r="30" data-done-circle />
            <path d="M18 33l10 10 18-21" data-done-check />
          </svg>
          <h2 class="pf-h" data-done-in>Ihre Anfrage ist vorbereitet</h2>
          <p class="pf-done-text" data-done-in>
            Das Formular wird in Kürze freigeschaltet. Bis dahin erreichen Sie uns gern telefonisch oder per E-Mail.
          </p>
          <div class="pf-done-links" data-done-in>
            <Button href={`mailto:${site.email}`} data-pf-mail-link>E-Mail mit Ihren Angaben öffnen</Button>
            <Button href={`tel:${site.phoneHref}`} variant="ghost">{site.phone}</Button>
          </div>
        </div>
      </div>

      <div class="pf-nav" data-pf-nav>
        <div data-pf-back hidden>
          <button type="button" class="pf-back" aria-label="Zurück">
            <Icon name="arrow-left" class="size-4" />
            <span>Zurück</span>
          </button>
        </div>
        <div class="pf-nav-r">
          <div data-pf-next hidden><Button type="button" variant="dark">Weiter</Button></div>
          <div data-pf-send hidden><Button type="submit" variant="dark">Anfrage senden</Button></div>
        </div>
      </div>
      </div>
    </div>
  </form>
</section>

<script>
  import { gsap } from '../../scripts/motion';
  import {
    initFiles,
    mailto,
    playDone,
    splitWords,
    keepInView,
    reducedMotion,
  } from '../../scripts/anfrage';

  const root = document.querySelector<HTMLElement>('[data-pf]');
  const form = root?.querySelector<HTMLFormElement>('[data-pf-form]');
  if (root && form) {
    const reduced = reducedMotion();
    const screens = [...form.querySelectorAll<HTMLElement>('[data-pf-screen]')];
    const host = form.querySelector<HTMLElement>('[data-pf-host]')!;
    const fill = root.querySelector<HTMLElement>('[data-pf-fill]')!;
    const count = form.querySelector<HTMLElement>('[data-pf-count]')!;
    const back = form.querySelector<HTMLElement>('[data-pf-back]')!;
    const next = form.querySelector<HTMLElement>('[data-pf-next]')!;
    const send = form.querySelector<HTMLElement>('[data-pf-send]')!;
    const nav = form.querySelector<HTMLElement>('[data-pf-nav]')!;
    const done = form.querySelector<HTMLElement>('[data-pf-done]')!;
    const summary = form.querySelector<HTMLElement>('[data-pf-summary]')!;
    const nextBtn = next.querySelector('button')!;
    const stepEls = [...root.querySelectorAll<HTMLElement>('[data-pf-step]')];
    const last = screens.length - 1;
    const questions = last - 1; // ohne Start und Überblick
    let cur = 0;
    let busy = false; // nur während des Ausblendens
    let entering: gsap.core.Tween[] = [];
    let autoTimer: number | undefined;

    root.classList.add('is-focus');
    screens.forEach((s, i) => (s.hidden = i !== 0));
    // Fragen wortweise zerlegen (Maske)
    const words = new Map<HTMLElement, HTMLElement[]>();
    screens.forEach((s) => {
      const q = s.querySelector<HTMLElement>('[data-pf-q]');
      if (q) words.set(s, splitWords(q));
    });

    // ---------- Mehrfachauswahl mit mindestens einer Wahl ----------
    form.querySelectorAll<HTMLElement>('[data-pf-atleast]').forEach((group) => {
      const boxes = [...group.querySelectorAll<HTMLInputElement>('input[type="checkbox"]')];
      const sync = () => {
        const any = boxes.some((b) => b.checked);
        boxes.forEach((b) => b.setCustomValidity(any ? '' : 'Bitte wählen Sie mindestens eine Option.'));
      };
      boxes.forEach((b) => b.addEventListener('change', sync));
      sync();
    });

    // ---------- Fläche ----------
    const area = form.querySelector<HTMLInputElement>('[data-pf-area]')!;
    const range = form.querySelector<HTMLInputElement>('[data-pf-range]')!;
    const paint = () => {
      const p = ((Number(range.value) - Number(range.min)) / (Number(range.max) - Number(range.min))) * 100;
      range.style.setProperty('--p', `${p}%`);
    };
    range.addEventListener('input', () => {
      area.value = range.value;
      paint();
      state();
    });
    area.addEventListener('input', () => {
      const v = parseFloat(area.value.replace(',', '.'));
      if (!Number.isNaN(v)) {
        range.value = String(Math.min(Number(range.max), Math.max(Number(range.min), v)));
        paint();
      }
    });
    paint();

    // ---------- Adresse des Bauvorhabens ----------
    const addr = form.querySelector<HTMLInputElement>('#pf-adresse')!;
    const site = form.querySelector<HTMLInputElement>('[data-pf-site]')!;
    const same = form.querySelector<HTMLInputElement>('[data-pf-same]')!;
    const syncSite = () => {
      if (!same.checked) return;
      site.value = addr.value;
    };
    same.addEventListener('change', () => {
      site.readOnly = same.checked;
      site.classList.toggle('is-same', same.checked);
      syncSite();
      state();
    });
    addr.addEventListener('input', () => {
      syncSite();
      state();
    });

    // ---------- Bilder ----------
    const filesCount = form.querySelector<HTMLElement>('[data-pf-files-count]')!;
    const files = initFiles({
      input: form.querySelector<HTMLInputElement>('[data-pf-files]')!,
      zone: form.querySelector<HTMLElement>('[data-pf-drop]')!,
      thumbs: form.querySelector<HTMLElement>('[data-pf-thumbs]')!,
      msg: form.querySelector<HTMLElement>('[data-pf-files-msg]')!,
      onChange: (n) => {
        filesCount.hidden = n === 0;
        filesCount.textContent = `${n} ${n === 1 ? 'Bild' : 'Bilder'} gewählt`;
      },
    });

    // ---------- Angaben und Überblick ----------
    const val = (n: string) => (form.elements.namedItem(n) as HTMLInputElement | null)?.value.trim() ?? '';
    const picked = (n: string) =>
      [...form.querySelectorAll<HTMLInputElement>(`input[name="${n}"]:checked`)].map((i) => i.value);
    const beginn = () => (picked('zeitpunkt')[0] === '-' ? 'Noch offen' : picked('zeitpunkt')[0] ?? '');
    const bilder = () => (files.count() ? `${files.count()} ${files.count() === 1 ? 'Bild' : 'Bilder'}` : 'Keine');
    // Für die E-Mail: eine Zeile je Angabe
    const rows = () =>
      [
        { label: 'Privat oder Gewerbe', value: picked('privat_gewerbe')[0] },
        { label: 'Art der Arbeiten', value: picked('art_der_arbeiten[]').join(', ') },
        { label: 'Leistungen', value: picked('leistungen[]').join(', ') || 'Keine Auswahl' },
        { label: 'Fläche', value: area.value.trim() ? `${area.value.trim()} m²` : '' },
        { label: 'Beginn', value: beginn() },
        { label: 'Bilder', value: bilder() },
        { label: 'Name', value: val('name') },
        { label: 'Rufnummer', value: val('telefon') || 'Nicht angegeben' },
        { label: 'E-Mail', value: val('email') },
        { label: 'Adresse', value: val('adresse') },
        { label: 'Adresse Bauvorhaben', value: val('adresse_bauvorhaben') },
        { label: 'Nachricht', value: val('nachricht') },
      ].filter((r) => r.value) as { label: string; value: string }[];
    // Für den Überblick: zusammengehörige Angaben in einem Block
    const blocks = () => [
      { at: 1, label: 'Projekt', lines: [picked('privat_gewerbe')[0], picked('art_der_arbeiten[]').join(', ')] },
      { at: 3, label: 'Leistungen', lines: [picked('leistungen[]').join(', ') || 'Keine Auswahl'] },
      { at: 4, label: 'Umfang und Beginn', lines: [area.value.trim() ? `${area.value.trim()} m²` : '', `Beginn: ${beginn()}`] },
      { at: 6, label: 'Bilder', lines: [bilder()] },
      { at: 7, label: 'Kontakt', lines: [val('name'), val('telefon'), val('email')] },
      { at: 8, label: 'Adressen', lines: [`Adresse: ${val('adresse')}`, `Bauvorhaben: ${val('adresse_bauvorhaben')}`] },
      { at: 9, label: 'Nachricht', lines: [val('nachricht')] },
    ];
    const buildSummary = () => {
      summary.innerHTML = '';
      blocks().forEach((b) => {
        const row = document.createElement('div');
        row.className = 'pf-sum-row';
        row.setAttribute('data-pf-item', '');
        const dt = document.createElement('dt');
        dt.textContent = b.label;
        const dd = document.createElement('dd');
        dd.textContent = b.lines.filter(Boolean).join('\n');
        const edit = document.createElement('button');
        edit.type = 'button';
        edit.className = 'pf-edit';
        edit.setAttribute('aria-label', `${b.label} ändern`);
        edit.textContent = 'Ändern';
        edit.addEventListener('click', () => go(b.at));
        row.append(dt, dd, edit);
        summary.append(row);
      });
    };

    // ---------- Prüfen und Fehlerzeile ----------
    const fields = (i: number) =>
      [...screens[i].querySelectorAll<HTMLInputElement>('input, textarea')].filter(
        (e) => e.type !== 'hidden' && e.type !== 'range' && e.type !== 'file' && !e.hasAttribute('data-pf-same'),
      );
    const isValid = (i: number) => fields(i).every((e) => e.checkValidity());
    const clearErrors = () => {
      screens[cur].querySelectorAll('.pf-err').forEach((e) => e.remove());
      screens[cur].querySelectorAll('.is-invalid').forEach((e) => e.classList.remove('is-invalid'));
    };
    const message = (el: HTMLInputElement) => {
      if (el.validity.customError) return el.validationMessage;
      if (el.type === 'radio') return 'Bitte wählen Sie eine Option.';
      if (el.type === 'email' && !el.validity.valueMissing) return 'Bitte geben Sie eine gültige E-Mail-Adresse an.';
      if (el.name === 'flaeche_qm') return 'Bitte geben Sie eine Zahl an, zum Beispiel 120.';
      return 'Bitte füllen Sie dieses Feld aus.';
    };
    const report = (i: number) => {
      clearErrors();
      const bad = fields(i).find((e) => !e.checkValidity());
      if (!bad) return true;
      const holder = bad.closest<HTMLElement>('.pf-field, .pf-area, .pf-list') ?? bad.parentElement!;
      const err = document.createElement('p');
      err.className = 'pf-err';
      err.setAttribute('role', 'alert');
      err.textContent = message(bad);
      holder.classList.add('is-invalid');
      holder.after(err);
      if (!reduced) gsap.fromTo(err, { autoAlpha: 0, y: 6 }, { autoAlpha: 1, y: 0, duration: 0.5, ease: 'css' });
      if (bad.type !== 'radio' && bad.type !== 'checkbox') bad.focus({ preventScroll: true });
      return false;
    };

    // ---------- Zustand ----------
    function state() {
      next.classList.toggle('is-off', !isValid(cur));
    }
    const chrome = () => {
      count.hidden = cur === 0;
      count.textContent = cur === last ? 'Überblick' : `Frage ${cur} von ${questions}`;
      // Orientierung links: aktueller Schritt, erledigte Schritte sind anwählbar
      stepEls.forEach((el) => {
        const from = Number(el.dataset.from);
        const to = Number(el.dataset.to);
        const btn = el.querySelector<HTMLButtonElement>('button')!;
        const isDone = cur > to;
        el.classList.toggle('is-on', cur >= from && cur <= to);
        el.classList.toggle('is-done', isDone);
        btn.disabled = !isDone;
        btn.tabIndex = isDone ? 0 : -1;
      });
      back.hidden = cur === 0;
      next.hidden = cur === 0 || cur === last;
      send.hidden = cur !== last;
      const navWasHidden = nav.hidden;
      nav.hidden = cur === 0;
      if (navWasHidden && !nav.hidden && !reduced)
        gsap.fromTo(nav, { autoAlpha: 0 }, { autoAlpha: 1, duration: 0.9, delay: 0.6, ease: 'css', clearProps: 'opacity,visibility' });
      state();
      if (reduced) gsap.set(fill, { scaleX: cur / last });
      else gsap.to(fill, { scaleX: cur / last, duration: 1, ease: 'grow', overwrite: true });
    };

    const focusScreen = (i: number) => {
      const text = fields(i).find((e) => e.type !== 'radio' && e.type !== 'checkbox' && !e.readOnly);
      (text ?? screens[i].querySelector<HTMLElement>('[data-pf-q]'))?.focus({ preventScroll: true });
      keepInView(root);
    };

    function go(n: number) {
      if (busy || n === cur || n < 0 || n > last) return;
      window.clearTimeout(autoTimer);
      const dir = n > cur ? 1 : -1;
      const from = screens[cur];
      const to = screens[n];
      clearErrors();
      cur = n;
      if (n === last) buildSummary();
      chrome();
      if (reduced) {
        from.hidden = true;
        to.hidden = false;
        focusScreen(n);
        return;
      }
      // Eine noch laufende Einblendung wird abgelöst
      entering.forEach((t) => t.kill());
      entering = [];
      gsap.killTweensOf(host);
      gsap.set(host, { clearProps: 'height,overflow' });
      busy = true;
      const h0 = host.offsetHeight;
      gsap.to(from, {
        autoAlpha: 0,
        y: -26 * dir,
        duration: 0.4,
        ease: 'css',
        onComplete: () => {
          from.hidden = true;
          gsap.set(from, { clearProps: 'all' });
          busy = false;
          to.hidden = false;
          const ws = words.get(to) ?? [];
          const items = to.querySelectorAll('[data-pf-item]');
          gsap.set(ws, { yPercent: 115 });
          gsap.set(items, { autoAlpha: 0, y: 26 * dir });
          const h1 = host.offsetHeight;
          if (h1 !== h0)
            entering.push(
              gsap.fromTo(
                host,
                { height: h0, overflow: 'hidden' },
                { height: h1, duration: 0.8, ease: 'css', clearProps: 'height,overflow' },
              ),
            );
          entering.push(gsap.to(ws, { yPercent: 0, duration: 1, ease: 'css', stagger: 0.06 }));
          entering.push(
            gsap.to(items, {
              autoAlpha: 1,
              y: 0,
              duration: 0.8,
              ease: 'css',
              stagger: 0.07,
              delay: 0.25,
              clearProps: 'opacity,visibility,transform',
            }),
          );
          focusScreen(n);
        },
      });
    }

    const advance = () => {
      if (cur === 0) return go(1);
      if (report(cur)) go(cur + 1);
    };
    form.querySelector('[data-pf-start] button')!.addEventListener('click', () => go(1));
    stepEls.forEach((el) =>
      el.querySelector('button')!.addEventListener('click', () => go(Number(el.dataset.from))),
    );
    nextBtn.addEventListener('click', advance);
    back.querySelector('button')!.addEventListener('click', () => go(cur - 1));

    // Auswahl: Zustand nachführen, Einzelauswahl geht nach kurzer Pause weiter
    const touched = () => {
      clearErrors();
      state();
    };
    form.addEventListener('input', touched);
    form.addEventListener('change', (e) => {
      touched();
      const t = e.target as HTMLInputElement;
      if (t.type === 'radio' && screens[cur].hasAttribute('data-pf-auto')) {
        window.clearTimeout(autoTimer);
        autoTimer = window.setTimeout(() => {
          if (isValid(cur)) go(cur + 1);
        }, 750);
      }
    });
    // Enter geht weiter (außer im Nachrichtenfeld)
    form.addEventListener('keydown', (e) => {
      const t = e.target as HTMLElement;
      if (e.key !== 'Enter' || t.tagName === 'TEXTAREA' || t.tagName === 'BUTTON' || cur === last) return;
      if ((t as HTMLInputElement).type === 'file') return;
      e.preventDefault();
      advance();
    });

    // ---------- Absenden (noch nicht angebunden) ----------
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      if (cur !== last) return;
      form.querySelector<HTMLAnchorElement>('[data-pf-mail-link]')!.href = mailto(
        form.dataset.pfMail ?? '',
        'Projektanfrage',
        rows(),
      );
      const finish = () => {
        screens[cur].hidden = true;
        nav.hidden = true;
        count.hidden = true;
        done.hidden = false;
        gsap.set(fill, { scaleX: 1 });
        playDone(done);
        keepInView(root);
      };
      if (reduced) return finish();
      gsap.to([screens[cur], nav], {
        autoAlpha: 0,
        y: -20,
        duration: 0.4,
        ease: 'css',
        onComplete: () => {
          gsap.set([screens[cur], nav], { clearProps: 'all' });
          finish();
        },
      });
    });

    chrome();
  }
</script>

<style>
