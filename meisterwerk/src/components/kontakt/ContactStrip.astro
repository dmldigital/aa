---
/** Ruhige Kontaktzeile unter den Projektanfrage-Varianten: Telefon, E-Mail, Showroom mit Anfahrt. */
import Button from '../ui/Button.astro';
import { site } from '../../data/site';

const eyebrow = 'font-display text-label font-medium tracking-label text-ink uppercase';
const link = 'group/ul inline-block text-body text-black';
---

<section data-cta-off data-section="kontakt-zeile" class="bg-soft px-page py-section">
  <div class="mx-auto grid w-full max-w-page gap-8 md:grid-cols-3 lg:gap-x-[6vw]">
    <div class="flex flex-col gap-3.75">
      <p class={eyebrow}>Lieber persönlich?</p>
      <p class="text-body">Rufen Sie uns an oder schreiben Sie uns. Wir nehmen uns Zeit für Ihr Projekt.</p>
    </div>
    <div class="flex flex-col gap-3.75">
      <p class={eyebrow}>Kontakt</p>
      <a href={`tel:${site.phoneHref}`} class={link}><span class="underline-anim [--underline-gap:3px]">07 141 / 23982 90</span></a>
      <a href={`mailto:${site.email}`} class={link}><span class="underline-anim [--underline-gap:3px]">{site.email}</span></a>
    </div>
    <div class="flex flex-col items-start gap-3.75">
      <p class={eyebrow}>Studio di Stile / Showroom</p>
      <p class="text-body">{site.street}, {site.postalCode} {site.city}</p>
      <Button href="https://maps.app.goo.gl/TKguvHRLF81DRLoH6">Anfahrt</Button>
    </div>
  </div>
</section>
