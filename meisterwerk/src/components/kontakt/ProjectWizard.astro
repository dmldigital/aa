---
/**
 * Projektanfrage als Assistent in fünf Schritten (ersetzt auf /kontakt/ das lange Formular): Projekt, Leistungen,
 * Umfang, Kontakt, Überblick. Gleiche Felder und Feldnamen wie vorher (`ContactForm`, Variante `project`), damit der
 * spätere Versand nichts umstellen muss. Auswahlkarten sind echte Radio- und Checkbox-Felder, ohne Skript steht das
 * Formular als eine lange Seite. Mit Skript: Fortschritt aus fünf Linien, Schritte wechseln mit Einblenden und Verschieben,
 * die Höhe läuft weich mit, die Auswahlkarten füllen sich schwarz, Fläche mit Regler, Bilder mit Vorschau, Überblick
 * mit „Ändern“ je Zeile. Das Absenden ist noch nicht angebunden: Am Ende steht die bekannte Meldung und eine vorbereitete
 * E-Mail mit allen Angaben (kein Versand vortäuschen).
 */
import Button from '../ui/Button.astro';
import { site } from '../../data/site';

interface Props {
  intro?: { heading: string; text: string };
}
const { intro } = Astro.props;

const steps = [
  { label: 'Projekt', title: 'Ihr Projekt' },
  { label: 'Leistungen', title: 'Welche Leistung interessiert Sie?' },
  { label: 'Umfang', title: 'Umfang und Zeitpunkt' },
  { label: 'Kontakt', title: 'Ihre Kontaktdaten' },
  { label: 'Überblick', title: 'Ihre Anfrage im Überblick' },
];
const leistungen = ['Spachteltechnik', 'Streichen', 'Lackieren', 'Tapezieren', 'Verputzen'];
const zeitpunkte = [
  { value: 'Sofort', label: 'Sofort' },
  { value: 'Innerhalb von 1 bis 3 Monaten', label: 'Innerhalb von 1 bis 3 Monaten' },
  { value: 'Innerhalb von 12 Monaten', label: 'Innerhalb von 12 Monaten' },
  { value: '-', label: 'Noch offen' },
];
const field =
  'w-full min-h-10 border border-black/20 bg-white p-3.75 text-[15px]/[21px] text-ink focus:border-ink focus:outline-none';
const eyebrow = 'font-display text-label font-medium tracking-label text-ink uppercase';
---

<form
  method="post"
  data-wz
  data-wz-mail={site.email}
  data-wz-mail-subject="Projektanfrage"
  name="Projektanfrage"
  aria-label="Projektanfrage"
  novalidate
  class="wz"
>
  <div class="wz-panel" data-anim="fadeInUp" data-anim-dur="slow">
    <!-- Kopf: Überschrift und Fortschritt -->
    <div class="wz-head">
      {intro && <h2 class="wz-title">{intro.heading}</h2>}
      <p class={eyebrow + ' wz-count'} aria-live="polite" data-wz-count hidden>
        Schritt <span data-wz-now>1</span> von {steps.length}
      </p>
      <ol class="wz-progress" data-wz-progress hidden>
        {steps.map((s, i) => (
          <li>
            <button type="button" data-wz-go={i} aria-label={`Zu Schritt ${i + 1}: ${s.label}`}>
              <span class="wz-pline" aria-hidden="true"><span data-wz-fill></span></span>
              <span class="wz-plabel">{s.label}</span>
            </button>
          </li>
        ))}
      </ol>
    </div>

    <div class="wz-stage" data-wz-stage>
      <!-- 1 Projekt -->
      <fieldset class="wz-step" data-wz-step>
        <legend class="wz-h" tabindex="-1">{steps[0].title}</legend>
        {intro && <p class="wz-lead" data-wz-item>{intro.text}</p>}
        <div class="wz-group" role="radiogroup" aria-labelledby="wz-art" data-wz-item>
          <p class={eyebrow} id="wz-art">Privat oder Gewerbetreibend?</p>
          <div class="wz-choices wz-choices--2">
            {['Privat', 'Gewerbe'].map((v, i) => (
              <label class="wz-choice">
                <input type="radio" name="privat_gewerbe" value={v} required={i === 0} />
                <span class="wz-choice-body">
                  <span>{v}</span>
                  <svg class="wz-tick" viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10.5l4 4 8-9" /></svg>
                </span>
              </label>
            ))}
          </div>
        </div>
        <div class="wz-group" role="radiogroup" aria-labelledby="wz-bereich" data-wz-item>
          <p class={eyebrow} id="wz-bereich">Art der Arbeiten</p>
          <div class="wz-choices wz-choices--2">
            {['Außenarbeiten', 'Innenarbeiten'].map((v, i) => (
              <label class="wz-choice">
                <input type="radio" name="art_der_arbeiten" value={v} required={i === 0} />
                <span class="wz-choice-body">
                  <span>{v}</span>
                  <svg class="wz-tick" viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10.5l4 4 8-9" /></svg>
                </span>
              </label>
            ))}
          </div>
        </div>
      </fieldset>

      <!-- 2 Leistungen -->
      <fieldset class="wz-step" data-wz-step>
        <legend class="wz-h" tabindex="-1">{steps[1].title}</legend>
        <p class="wz-lead" data-wz-item>Mehrfachauswahl möglich.</p>
        <div class="wz-choices wz-choices--3" data-wz-item>
          {leistungen.map((v) => (
            <label class="wz-choice">
              <input type="checkbox" name="leistungen[]" value={v} />
              <span class="wz-choice-body">
                <span>{v}</span>
                <svg class="wz-tick" viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10.5l4 4 8-9" /></svg>
              </span>
            </label>
          ))}
        </div>
      </fieldset>

      <!-- 3 Umfang -->
      <fieldset class="wz-step" data-wz-step>
        <legend class="wz-h" tabindex="-1">{steps[2].title}</legend>
        <div class="wz-group" data-wz-item>
          <label class={eyebrow} for="wz-flaeche">ca. Fläche in m2</label>
          <div class="wz-area">
            <output class="wz-area-out" for="wz-flaeche" data-wz-area-out>–</output>
            <input
              class="wz-range"
              type="range"
              min="5"
              max="500"
              step="5"
              value="100"
              aria-label="Fläche per Regler wählen"
              data-wz-range
            />
            <input
              class={field + ' wz-area-in'}
              type="text"
              inputmode="decimal"
              id="wz-flaeche"
              name="flaeche_qm"
              pattern="[0-9]+([.,][0-9]+)?"
              title="Bitte eine Zahl angeben, zum Beispiel 120"
              required
              data-wz-area
            />
          </div>
        </div>
        <div class="wz-group" role="radiogroup" aria-labelledby="wz-zeit" data-wz-item>
          <p class={eyebrow} id="wz-zeit">Zeitpunkt der Ausführung</p>
          <div class="wz-choices wz-choices--2">
            {zeitpunkte.map((z, i) => (
              <label class="wz-choice">
                <input type="radio" name="zeitpunkt" value={z.value} required={i === 0} />
                <span class="wz-choice-body">
                  <span>{z.label}</span>
                  <svg class="wz-tick" viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10.5l4 4 8-9" /></svg>
                </span>
              </label>
            ))}
          </div>
        </div>
        <div class="wz-group" data-wz-item>
          <p class={eyebrow}>Bilder hochladen (max. 12 Bilder, max 60MB)</p>
          <label class="wz-drop" data-wz-drop>
            <input type="file" name="bilder[]" accept="image/*" multiple data-wz-files />
            <span class="wz-drop-text">Bilder hierher ziehen oder auswählen</span>
          </label>
          <p class="wz-note" role="status" data-wz-files-msg hidden></p>
          <ul class="wz-thumbs" data-wz-thumbs></ul>
        </div>
      </fieldset>

      <!-- 4 Kontakt -->
      <fieldset class="wz-step" data-wz-step>
        <legend class="wz-h" tabindex="-1">{steps[3].title}</legend>
        <div class="wz-grid">
          <div class="wz-group" data-wz-item>
            <label class={eyebrow} for="wz-name">Name</label>
            <input class={field} type="text" id="wz-name" name="name" autocomplete="name" required />
          </div>
          <div class="wz-group" data-wz-item>
            <label class={eyebrow} for="wz-tel">Rufnummer</label>
            <input class={field} type="tel" id="wz-tel" name="telefon" autocomplete="tel" />
          </div>
          <div class="wz-group" data-wz-item>
            <label class={eyebrow} for="wz-adresse">Adresse</label>
            <input class={field} type="text" id="wz-adresse" name="adresse" autocomplete="street-address" required />
          </div>
          <div class="wz-group" data-wz-item>
            <label class={eyebrow} for="wz-bauvorhaben">Adresse Bauvorhaben</label>
            <input class={field} type="text" id="wz-bauvorhaben" name="adresse_bauvorhaben" required />
          </div>
          <div class="wz-group wz-wide" data-wz-item>
            <label class={eyebrow} for="wz-email">E-Mail</label>
            <input class={field} type="email" id="wz-email" name="email" autocomplete="email" required />
          </div>
          <div class="wz-group wz-wide" data-wz-item>
            <label class={eyebrow} for="wz-nachricht">Nachricht</label>
            <textarea class={field + ' wz-text'} id="wz-nachricht" name="nachricht" rows="4" required></textarea>
          </div>
        </div>
      </fieldset>

      <!-- 5 Überblick -->
      <fieldset class="wz-step" data-wz-step>
        <legend class="wz-h" tabindex="-1">{steps[4].title}</legend>
        <dl class="wz-sum" data-wz-summary></dl>
      </fieldset>

      <input type="hidden" name="berechneter_preis" />
      <input type="hidden" name="ausgewaehlte_leistungen" />
      <input type="hidden" name="preis_pro_qm" />
      <input type="hidden" name="berechnungsdetails" />
    </div>

    <!-- Fertig (die Anfrage wird noch nicht versendet) -->
    <div class="wz-done" data-wz-done tabindex="-1" role="status" hidden>
      <svg class="wz-done-mark" viewBox="0 0 64 64" aria-hidden="true">
        <circle cx="32" cy="32" r="30" data-wz-circle />
        <path d="M18 33l10 10 18-21" data-wz-check />
      </svg>
      <h3 class="wz-h">Ihre Anfrage ist vorbereitet</h3>
      <p class="wz-lead">
        Das Formular wird in Kürze freigeschaltet. Bis dahin erreichen Sie uns gern telefonisch oder per E-Mail.
      </p>
      <div class="wz-done-actions">
        <a class="wz-mail" data-wz-mail-link href={`mailto:${site.email}`}>
          <span class="underline-anim relative [--underline-gap:3px]">E-Mail mit Ihren Angaben öffnen</span>
        </a>
        <a class="wz-mail" href={`tel:${site.phoneHref}`}>
          <span class="underline-anim relative [--underline-gap:3px]">{site.phone}</span>
        </a>
      </div>
    </div>

    <!-- Schaltflächen -->
    <div class="wz-actions" data-wz-actions>
      <div class="wz-back" data-wz-back hidden><Button type="button" variant="outline">Zurück</Button></div>
      <div class="wz-next" data-wz-next hidden><Button type="button" variant="solid">Weiter</Button></div>
      <div class="wz-send" data-wz-send><Button type="submit" variant="solid">Anfrage senden</Button></div>
    </div>
  </div>
</form>

<script>
  import { gsap, lenis } from '../../scripts/motion';

  const MAX_FILES = 12;
  const MAX_BYTES = 60 * 1024 * 1024;
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const form = document.querySelector<HTMLFormElement>('[data-wz]');
  if (form) {
    const steps = [...form.querySelectorAll<HTMLElement>('[data-wz-step]')];
    const stage = form.querySelector<HTMLElement>('[data-wz-stage]')!;
    const goBtns = [...form.querySelectorAll<HTMLButtonElement>('[data-wz-go]')];
    const fills = [...form.querySelectorAll<HTMLElement>('[data-wz-fill]')];
    const count = form.querySelector<HTMLElement>('[data-wz-count]')!;
    const now = form.querySelector<HTMLElement>('[data-wz-now]')!;
    const progress = form.querySelector<HTMLElement>('[data-wz-progress]')!;
    const backBox = form.querySelector<HTMLElement>('[data-wz-back]')!;
    const nextBox = form.querySelector<HTMLElement>('[data-wz-next]')!;
    const sendBox = form.querySelector<HTMLElement>('[data-wz-send]')!;
    const actions = form.querySelector<HTMLElement>('[data-wz-actions]')!;
    const done = form.querySelector<HTMLElement>('[data-wz-done]')!;
    const summary = form.querySelector<HTMLElement>('[data-wz-summary]')!;
    const last = steps.length - 1;
    let cur = 0;
    let reached = 0;
    let busy = false;

    form.classList.add('is-wizard');
    count.hidden = false;
    progress.hidden = false;
    steps.forEach((s, i) => (s.hidden = i !== 0));

    // ---------- Fläche: Regler und Eingabe ----------
    const area = form.querySelector<HTMLInputElement>('[data-wz-area]')!;
    const range = form.querySelector<HTMLInputElement>('[data-wz-range]')!;
    const areaOut = form.querySelector<HTMLElement>('[data-wz-area-out]')!;
    const paintRange = () => {
      const p = ((Number(range.value) - Number(range.min)) / (Number(range.max) - Number(range.min))) * 100;
      range.style.setProperty('--p', `${p}%`);
    };
    const showArea = () => {
      areaOut.textContent = area.value.trim() ? `${area.value.trim()} m²` : '–';
    };
    range.addEventListener('input', () => {
      area.value = range.value;
      showArea();
      paintRange();
    });
    area.addEventListener('input', () => {
      const v = parseFloat(area.value.replace(',', '.'));
      if (!Number.isNaN(v)) {
        range.value = String(Math.min(Number(range.max), Math.max(Number(range.min), v)));
        paintRange();
      }
      showArea();
    });
    paintRange();

    // ---------- Bilder: Auswahl, Vorschau, Grenzen ----------
    const fileInput = form.querySelector<HTMLInputElement>('[data-wz-files]')!;
    const drop = form.querySelector<HTMLElement>('[data-wz-drop]')!;
    const thumbs = form.querySelector<HTMLElement>('[data-wz-thumbs]')!;
    const filesMsg = form.querySelector<HTMLElement>('[data-wz-files-msg]')!;
    let files: File[] = [];
    const syncFiles = () => {
      const dt = new DataTransfer();
      files.forEach((f) => dt.items.add(f));
      fileInput.files = dt.files;
      thumbs.querySelectorAll('img').forEach((i) => URL.revokeObjectURL(i.src));
      thumbs.innerHTML = '';
      files.forEach((f, i) => {
        const li = document.createElement('li');
        const img = document.createElement('img');
        img.src = URL.createObjectURL(f);
        img.alt = f.name;
        const rm = document.createElement('button');
        rm.type = 'button';
        rm.setAttribute('aria-label', `${f.name} entfernen`);
        rm.textContent = '×';
        rm.addEventListener('click', () => {
          files.splice(i, 1);
          syncFiles();
        });
        li.append(img, rm);
        thumbs.append(li);
        if (!reduced) gsap.fromTo(li, { autoAlpha: 0, scale: 0.94 }, { autoAlpha: 1, scale: 1, duration: 0.5, ease: 'css' });
      });
    };
    const addFiles = (list: FileList | File[]) => {
      const incoming = [...list].filter((f) => f.type.startsWith('image/'));
      const next = [...files, ...incoming];
      const bytes = next.reduce((s, f) => s + f.size, 0);
      if (next.length > MAX_FILES || bytes > MAX_BYTES) {
        filesMsg.textContent = 'Bitte wählen Sie höchstens 12 Bilder mit zusammen höchstens 60 MB.';
        filesMsg.hidden = false;
        fileInput.value = '';
        return;
      }
      filesMsg.hidden = true;
      files = next;
      syncFiles();
    };
    fileInput.addEventListener('change', () => addFiles(fileInput.files ?? []));
    ['dragenter', 'dragover'].forEach((t) =>
      drop.addEventListener(t, (e) => {
        e.preventDefault();
        drop.classList.add('is-over');
      }),
    );
    ['dragleave', 'drop'].forEach((t) =>
      drop.addEventListener(t, (e) => {
        e.preventDefault();
        drop.classList.remove('is-over');
      }),
    );
    drop.addEventListener('drop', (e) => {
      const dt = (e as DragEvent).dataTransfer;
      if (dt?.files) addFiles(dt.files);
    });

    // ---------- Überblick ----------
    const val = (name: string) => (form.elements.namedItem(name) as HTMLInputElement | null)?.value.trim() ?? '';
    const checked = (name: string) =>
      [...form.querySelectorAll<HTMLInputElement>(`input[name="${name}"]:checked`)].map((i) => i.value);
    const labelOf = (v: string) => (v === '-' ? 'Noch offen' : v);
    const rows = () =>
      [
        { step: 0, label: 'Privat oder Gewerbe', value: val('privat_gewerbe') || checked('privat_gewerbe')[0] },
        { step: 0, label: 'Art der Arbeiten', value: checked('art_der_arbeiten')[0] },
        { step: 1, label: 'Leistungen', value: checked('leistungen[]').join(', ') || 'Keine Auswahl' },
        { step: 2, label: 'Fläche', value: area.value.trim() ? `${area.value.trim()} m²` : '' },
        { step: 2, label: 'Zeitpunkt', value: labelOf(checked('zeitpunkt')[0] ?? '') },
        { step: 2, label: 'Bilder', value: files.length ? `${files.length} ${files.length === 1 ? 'Bild' : 'Bilder'}` : 'Keine' },
        { step: 3, label: 'Name', value: val('name') },
        { step: 3, label: 'Rufnummer', value: val('telefon') || 'Nicht angegeben' },
        { step: 3, label: 'Adresse', value: val('adresse') },
        { step: 3, label: 'Adresse Bauvorhaben', value: val('adresse_bauvorhaben') },
        { step: 3, label: 'E-Mail', value: val('email') },
        { step: 3, label: 'Nachricht', value: val('nachricht') },
      ].filter((r) => r.value);
    const buildSummary = () => {
      summary.innerHTML = '';
      rows().forEach((r) => {
        const row = document.createElement('div');
        row.className = 'wz-sum-row';
        row.setAttribute('data-wz-item', '');
        const dt = document.createElement('dt');
        dt.textContent = r.label;
        const dd = document.createElement('dd');
        dd.textContent = r.value;
        const edit = document.createElement('button');
        edit.type = 'button';
        edit.className = 'wz-edit';
        edit.innerHTML = '<span class="underline-anim relative [--underline-gap:3px]">Ändern</span>';
        edit.setAttribute('aria-label', `${r.label} ändern`);
        edit.addEventListener('click', () => go(r.step));
        row.append(dt, dd, edit);
        summary.append(row);
      });
    };

    // ---------- Zustand und Wechsel ----------
    const update = () => {
      now.textContent = String(cur + 1);
      goBtns.forEach((b, i) => {
        b.disabled = i > reached;
        if (i === cur) b.setAttribute('aria-current', 'step');
        else b.removeAttribute('aria-current');
        b.classList.toggle('is-reached', i <= reached);
      });
      fills.forEach((f, i) => {
        const to = i <= cur ? 1 : 0;
        if (reduced) gsap.set(f, { scaleX: to });
        else gsap.to(f, { scaleX: to, duration: 0.9, ease: 'grow', overwrite: true });
      });
      backBox.hidden = cur === 0;
      nextBox.hidden = cur === last;
      sendBox.hidden = cur !== last;
    };

    const valid = (i: number) => {
      const els = [...steps[i].querySelectorAll<HTMLInputElement>('input, select, textarea')].filter((e) => e.type !== 'hidden' && e.type !== 'range' && e.type !== 'file');
      for (const el of els) {
        if (!el.checkValidity()) {
          el.reportValidity();
          return false;
        }
      }
      return true;
    };

    const focusStep = (i: number) => {
      const h = steps[i].querySelector<HTMLElement>('.wz-h');
      h?.focus({ preventScroll: true });
      const top = form.getBoundingClientRect().top;
      if (top < 0 || top > window.innerHeight * 0.6) {
        const y = form.getBoundingClientRect().top + window.scrollY - 100;
        if (lenis) lenis.scrollTo(y, { duration: 0.9 });
        else window.scrollTo({ top: y, behavior: reduced ? 'auto' : 'smooth' });
      }
    };

    const go = (n: number) => {
      if (busy || n === cur || n < 0 || n > last) return;
      const dir = n > cur ? 1 : -1;
      const from = steps[cur];
      const to = steps[n];
      cur = n;
      reached = Math.max(reached, n);
      if (n === last) buildSummary();
      update();
      if (reduced) {
        from.hidden = true;
        to.hidden = false;
        focusStep(n);
        return;
      }
      busy = true;
      const h0 = stage.offsetHeight;
      gsap.to(from, {
        autoAlpha: 0,
        x: -36 * dir,
        duration: 0.35,
        ease: 'css',
        onComplete: () => {
          from.hidden = true;
          gsap.set(from, { clearProps: 'all' });
          to.hidden = false;
          gsap.set(to, { autoAlpha: 0 });
          const h1 = stage.offsetHeight;
          gsap.fromTo(
            stage,
            { height: h0, overflow: 'hidden' },
            { height: h1, duration: 0.7, ease: 'css', clearProps: 'height,overflow' },
          );
          gsap.fromTo(to, { x: 36 * dir }, { autoAlpha: 1, x: 0, duration: 0.6, ease: 'css', clearProps: 'transform' });
          gsap.fromTo(
            to.querySelectorAll('[data-wz-item]'),
            { autoAlpha: 0, y: 22 },
            {
              autoAlpha: 1,
              y: 0,
              duration: 0.7,
              ease: 'css',
              stagger: 0.07,
              delay: 0.1,
              clearProps: 'opacity,visibility,transform',
              onComplete: () => {
                busy = false;
              },
            },
          );
          focusStep(n);
        },
      });
    };

    nextBox.querySelector('button')!.addEventListener('click', () => {
      if (valid(cur)) go(cur + 1);
    });
    backBox.querySelector('button')!.addEventListener('click', () => go(cur - 1));
    goBtns.forEach((b, i) =>
      b.addEventListener('click', () => {
        if (i < cur) go(i);
        else if (i > cur && i <= reached && valid(cur)) go(i);
      }),
    );
    // Enter in einem Feld geht weiter, statt das Formular abzusenden
    form.addEventListener('keydown', (e) => {
      const t = e.target as HTMLElement;
      if (e.key === 'Enter' && t.tagName === 'INPUT' && (t as HTMLInputElement).type !== 'file' && cur < last) {
        e.preventDefault();
        if (valid(cur)) go(cur + 1);
      }
    });

    // ---------- Absenden (noch nicht angebunden) ----------
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      if (cur !== last) return;
      const lines = rows().map((r) => `${r.label}: ${r.value}`);
      const link = form.querySelector<HTMLAnchorElement>('[data-wz-mail-link]')!;
      link.href = `mailto:${form.dataset.wzMail}?subject=${encodeURIComponent(form.dataset.wzMailSubject ?? '')}&body=${encodeURIComponent(lines.join('\n'))}`;
      const finish = () => {
        steps[cur].hidden = true;
        actions.hidden = true;
        done.hidden = false;
        count.hidden = true;
        fills.forEach((f) => gsap.set(f, { scaleX: 1 }));
        const circle = done.querySelector<SVGGeometryElement>('[data-wz-circle]')!;
        const check = done.querySelector<SVGGeometryElement>('[data-wz-check]')!;
        done.focus({ preventScroll: true });
        if (reduced) return;
        const cl = circle.getTotalLength();
        const kl = check.getTotalLength();
        gsap.set(circle, { strokeDasharray: cl, strokeDashoffset: cl });
        gsap.set(check, { strokeDasharray: kl, strokeDashoffset: kl });
        gsap.timeline()
          .to(circle, { strokeDashoffset: 0, duration: 0.9, ease: 'grow' })
          .to(check, { strokeDashoffset: 0, duration: 0.6, ease: 'css' }, '-=0.25')
          .fromTo(
            done.querySelectorAll('h3, p, .wz-done-actions'),
            { autoAlpha: 0, y: 20 },
            { autoAlpha: 1, y: 0, duration: 0.7, ease: 'css', stagger: 0.1, clearProps: 'opacity,visibility,transform' },
            '-=0.5',
          );
      };
      if (reduced) finish();
      else {
        gsap.to([steps[cur], actions], {
          autoAlpha: 0,
          y: -16,
          duration: 0.4,
          ease: 'css',
          onComplete: () => {
            gsap.set([steps[cur], actions], { clearProps: 'all' });
            finish();
          },
        });
      }
    });

    update();
  }
</script>

