---
/**
 * Projektanfrage, Variante „Satz“: Das Formular ist ein Satz. Alle Antworten stehen als Wörter im Text, man tippt die
 * passenden an (ungewählte Wörter sind blass, gewählte schwarz mit goldener Linie, die sich aufzieht). Nur zwei Schritte:
 * erst der Satz zum Projekt, dann der Satz zu Ihnen. Eine Linie je Schritt oben als Fortschritt. Der Satz ist zugleich der
 * Überblick, deshalb gibt es keinen eigenen Überblick. Gleiche Feldnamen wie `ContactForm`. Ohne Skript stehen beide Sätze
 * untereinander. Das Absenden ist noch nicht angebunden: Am Ende die bekannte Meldung und eine vorbereitete E-Mail.
 */
import LinkButton from '../ui/LinkButton.astro';
import Button from '../ui/Button.astro';
import { site } from '../../data/site';

const eyebrow = 'font-display text-label font-medium tracking-label text-ink uppercase';
const art = ['Privat', 'Gewerbe'];
const bereich = ['Außenarbeiten', 'Innenarbeiten'];
const leistungen = ['Spachteltechnik', 'Streichen', 'Lackieren', 'Tapezieren', 'Verputzen'];
const zeit = [
  { v: 'Sofort', l: 'sofort' },
  { v: 'Innerhalb von 1 bis 3 Monaten', l: 'in 1 bis 3 Monaten' },
  { v: 'Innerhalb von 12 Monaten', l: 'in 12 Monaten' },
  { v: '-', l: 'noch offen' },
];
---

<section class="ps ps-pend" data-ps>
  <form data-ps-form data-ps-mail={site.email} name="Projektanfrage" aria-label="Projektanfrage" novalidate>
    <div class="ps-inner">
      <div class="ps-bar" aria-hidden="true" data-ps-bar hidden>
        <span><i data-ps-fill></i></span>
        <span><i data-ps-fill></i></span>
      </div>
      <div class="ps-meta">
        <p class={eyebrow}>Projektanfrage</p>
        <p class={eyebrow} aria-live="polite" data-ps-count hidden>Teil <span data-ps-now>1</span> von 2</p>
      </div>

      <div class="ps-host" data-ps-host>
        <!-- Teil 1: das Projekt -->
        <div class="ps-view" data-ps-view>
          <p class="ps-sentence" data-ps-sentence>
            <span class="ps-c">Ich bin</span>{' '}
            <span class="ps-grp" role="radiogroup" aria-label="Privat oder Gewerbetreibend?">
              {art.map((v, i) => (
                <>
                  {i > 0 && <span class="ps-sep" aria-hidden="true"> / </span>}
                  <label class="ps-w"><input type="radio" name="privat_gewerbe" value={v} required={i === 0} /><span>{v}</span></label>
                </>
              ))}
            </span>{' '}
            <span class="ps-c">und plane</span>{' '}
            <span class="ps-grp" role="radiogroup" aria-label="Art der Arbeiten">
              {bereich.map((v, i) => (
                <>
                  {i > 0 && <span class="ps-sep" aria-hidden="true"> / </span>}
                  <label class="ps-w"><input type="radio" name="art_der_arbeiten" value={v} required={i === 0} /><span>{v}</span></label>
                </>
              ))}
            </span><span class="ps-c">.</span>{' '}
            <span class="ps-c">Mich interessieren</span>{' '}
            <span class="ps-grp" role="group" aria-label="Welche Leistung interessiert Sie? Mehrfachauswahl möglich.">
              {leistungen.map((v, i) => (
                <>
                  {i > 0 && <span class="ps-sep" aria-hidden="true">, </span>}
                  <label class="ps-w"><input type="checkbox" name="leistungen[]" value={v} /><span>{v}</span></label>
                </>
              ))}
            </span><span class="ps-c">.</span>{' '}
            <span class="ps-c">Die Fläche beträgt ca.</span>{' '}
            <input class="ps-in" type="text" inputmode="decimal" name="flaeche_qm" placeholder="120" aria-label="ca. Fläche in m2" pattern="[0-9]+([.,][0-9]+)?" title="Bitte eine Zahl angeben, zum Beispiel 120" autocomplete="off" required data-ps-area />{' '}
            <span class="ps-c">m². Der Beginn ist</span>{' '}
            <span class="ps-grp" role="radiogroup" aria-label="Zeitpunkt der Ausführung">
              {zeit.map((z, i) => (
                <>
                  {i > 0 && <span class="ps-sep" aria-hidden="true"> / </span>}
                  <label class="ps-w"><input type="radio" name="zeitpunkt" value={z.v} required={i === 0} /><span>{z.l}</span></label>
                </>
              ))}
            </span><span class="ps-c">.</span>
          </p>

          <div class="ps-files" data-ps-drop>
            <label class="ps-pick">
              <input type="file" name="bilder[]" accept="image/*" multiple data-ps-files />
              <span class="group/ul inline-flex gap-2.5 font-display text-button font-semibold tracking-button text-gold">
                <span class="underline-anim relative [--underline-gap:0px]">Bilder hinzufügen, optional</span>
              </span>
            </label>
            <p class="ps-note" data-ps-files-hint>Höchstens 12 Bilder, zusammen höchstens 60 MB.</p>
            <p class="ps-note ps-note--err" role="status" data-ps-files-msg hidden></p>
            <ul class="ps-thumbs" data-ps-thumbs></ul>
          </div>
        </div>

        <!-- Teil 2: Sie -->
        <div class="ps-view" data-ps-view>
          <p class="ps-sentence">
            <span class="ps-c">Mein Name ist</span>{' '}
            <input class="ps-in" type="text" name="name" placeholder="Ihr Name" aria-label="Name" autocomplete="name" required />
            <span class="ps-c">. Sie erreichen mich unter</span>{' '}
            <input class="ps-in" type="tel" name="telefon" placeholder="Rufnummer" aria-label="Rufnummer" autocomplete="tel" />{' '}
            <span class="ps-c">oder per E-Mail an</span>{' '}
            <input class="ps-in" type="email" name="email" placeholder="E-Mail" aria-label="E-Mail" autocomplete="email" required /><span class="ps-c">.</span>{' '}
            <span class="ps-c">Ich wohne in</span>{' '}
            <input class="ps-in" type="text" name="adresse" placeholder="Ihre Adresse" aria-label="Adresse" autocomplete="street-address" required />
            <span class="ps-c">, das Bauvorhaben liegt in</span>{' '}
            <input class="ps-in" type="text" name="adresse_bauvorhaben" placeholder="Adresse Bauvorhaben" aria-label="Adresse Bauvorhaben" required /><span class="ps-c">.</span>{' '}
            <span class="ps-c">Außerdem möchte ich noch sagen:</span>
          </p>
          <textarea class="ps-text" name="nachricht" rows="3" placeholder="Ihre Nachricht" aria-label="Nachricht" required></textarea>
        </div>

        <input type="hidden" name="berechneter_preis" />
        <input type="hidden" name="ausgewaehlte_leistungen" />
        <input type="hidden" name="preis_pro_qm" />
        <input type="hidden" name="berechnungsdetails" />

        <!-- Fertig -->
        <div class="ps-done" data-ps-done tabindex="-1" role="status" hidden>
          <svg class="ps-done-mark" viewBox="0 0 64 64" aria-hidden="true">
            <circle cx="32" cy="32" r="30" data-done-circle />
            <path d="M18 33l10 10 18-21" data-done-check />
          </svg>
          <h2 class="ps-done-h" data-done-in>Ihre Anfrage ist vorbereitet</h2>
          <p class="ps-done-p" data-done-in>
            Das Formular wird in Kürze freigeschaltet. Bis dahin erreichen Sie uns gern telefonisch oder per E-Mail.
          </p>
          <div class="ps-done-links" data-done-in>
            <a class="ps-mail" data-ps-mail-link href={`mailto:${site.email}`}>
              <span class="underline-anim relative [--underline-gap:3px]">E-Mail mit Ihren Angaben öffnen</span>
            </a>
            <a class="ps-mail" href={`tel:${site.phoneHref}`}>
              <span class="underline-anim relative [--underline-gap:3px]">{site.phone}</span>
            </a>
          </div>
        </div>
      </div>

      <div class="ps-nav" data-ps-nav>
        <div data-ps-back hidden><LinkButton tone="black" dir="back">Zurück</LinkButton></div>
        <div class="ps-nav-r">
          <div data-ps-next hidden><LinkButton tone="gold" dir="next">Weiter</LinkButton></div>
          <div data-ps-send hidden><Button type="submit" variant="solid">Anfrage senden</Button></div>
        </div>
      </div>
    </div>
  </form>
</section>

<script>
  import { gsap, ScrollTrigger } from '../../scripts/motion';
  import { initFiles, mailto, playDone, keepInView, reducedMotion } from '../../scripts/anfrage';

  const root = document.querySelector<HTMLElement>('[data-ps]');
  const form = root?.querySelector<HTMLFormElement>('[data-ps-form]');
  if (root && form) {
    const reduced = reducedMotion();
    const views = [...form.querySelectorAll<HTMLElement>('[data-ps-view]')];
    const host = form.querySelector<HTMLElement>('[data-ps-host]')!;
    const fills = [...root.querySelectorAll<HTMLElement>('[data-ps-fill]')];
    const bar = root.querySelector<HTMLElement>('[data-ps-bar]')!;
    const count = form.querySelector<HTMLElement>('[data-ps-count]')!;
    const now = form.querySelector<HTMLElement>('[data-ps-now]')!;
    const back = form.querySelector<HTMLElement>('[data-ps-back]')!;
    const next = form.querySelector<HTMLElement>('[data-ps-next]')!;
    const send = form.querySelector<HTMLElement>('[data-ps-send]')!;
    const nav = form.querySelector<HTMLElement>('[data-ps-nav]')!;
    const done = form.querySelector<HTMLElement>('[data-ps-done]')!;
    const last = views.length - 1;
    let cur = 0;
    let busy = false;
    let entering: gsap.core.Tween[] = [];

    root.classList.add('is-sentence');
    bar.hidden = false;
    count.hidden = false;
    views.forEach((v, i) => (v.hidden = i !== 0));

    // ---------- Felder im Satz: Breite folgt dem Inhalt ----------
    const inline = [...form.querySelectorAll<HTMLInputElement>('.ps-in')];
    const ruler = document.createElement('span');
    ruler.setAttribute('aria-hidden', 'true');
    ruler.style.cssText = 'position:absolute;left:-9999px;top:0;visibility:hidden;white-space:pre';
    const size = (el: HTMLInputElement) => {
      const cs = getComputedStyle(el);
      ruler.style.font = cs.font;
      ruler.style.letterSpacing = cs.letterSpacing;
      ruler.textContent = el.value || el.placeholder;
      form.append(ruler);
      el.style.width = `${Math.ceil(ruler.getBoundingClientRect().width) + 3}px`;
      ruler.remove();
    };
    inline.forEach((el) => {
      size(el);
      el.addEventListener('input', () => size(el));
    });
    document.fonts?.ready.then(() => inline.forEach(size));

    // ---------- Bilder ----------
    const hint = form.querySelector<HTMLElement>('[data-ps-files-hint]')!;
    initFiles({
      input: form.querySelector<HTMLInputElement>('[data-ps-files]')!,
      zone: form.querySelector<HTMLElement>('[data-ps-drop]')!,
      thumbs: form.querySelector<HTMLElement>('[data-ps-thumbs]')!,
      msg: form.querySelector<HTMLElement>('[data-ps-files-msg]')!,
      onChange: (n) => (hint.hidden = n > 0),
    });
    const count_files = () => form.querySelectorAll('[data-ps-thumbs] li').length;

    // ---------- Angaben ----------
    const val = (n: string) => (form.elements.namedItem(n) as HTMLInputElement | null)?.value.trim() ?? '';
    const picked = (n: string) =>
      [...form.querySelectorAll<HTMLInputElement>(`input[name="${n}"]:checked`)].map((i) => i.value);
    const rows = () =>
      [
        { label: 'Privat oder Gewerbe', value: picked('privat_gewerbe')[0] },
        { label: 'Art der Arbeiten', value: picked('art_der_arbeiten')[0] },
        { label: 'Leistungen', value: picked('leistungen[]').join(', ') || 'Keine Auswahl' },
        { label: 'Fläche', value: val('flaeche_qm') ? `${val('flaeche_qm')} m²` : '' },
        { label: 'Beginn', value: picked('zeitpunkt')[0] === '-' ? 'Noch offen' : picked('zeitpunkt')[0] },
        { label: 'Bilder', value: count_files() ? `${count_files()} ${count_files() === 1 ? 'Bild' : 'Bilder'}` : 'Keine' },
        { label: 'Name', value: val('name') },
        { label: 'Rufnummer', value: val('telefon') || 'Nicht angegeben' },
        { label: 'E-Mail', value: val('email') },
        { label: 'Adresse', value: val('adresse') },
        { label: 'Adresse Bauvorhaben', value: val('adresse_bauvorhaben') },
        { label: 'Nachricht', value: val('nachricht') },
      ].filter((r) => r.value) as { label: string; value: string }[];

    // ---------- Zustand ----------
    const fields = (i: number) =>
      [...views[i].querySelectorAll<HTMLInputElement>('input, textarea')].filter(
        (e) => e.type !== 'hidden' && e.type !== 'file',
      );
    const isValid = (i: number) => fields(i).every((e) => e.checkValidity());
    const report = (i: number) => {
      const bad = fields(i).find((e) => !e.checkValidity());
      bad?.reportValidity();
      return !bad;
    };
    const state = () => {
      next.classList.toggle('is-off', !isValid(cur));
      send.classList.toggle('is-off', !isValid(cur));
    };
    const chrome = () => {
      now.textContent = String(cur + 1);
      back.hidden = cur === 0;
      next.hidden = cur === last;
      send.hidden = cur !== last;
      state();
      fills.forEach((f, i) => {
        const to = i <= cur ? 1 : 0;
        if (reduced) gsap.set(f, { scaleX: to });
        else gsap.to(f, { scaleX: to, duration: 1, ease: 'grow', overwrite: true });
      });
    };

    const play = (view: HTMLElement) => {
      const chunks = view.querySelectorAll<HTMLElement>('.ps-c, .ps-grp, .ps-in, .ps-text, .ps-files');
      gsap.set(chunks, { opacity: 0 });
      return gsap.to(chunks, {
        opacity: 1,
        duration: 0.9,
        ease: 'css',
        stagger: 0.05,
        clearProps: 'opacity',
      });
    };

    const focusView = (i: number) => {
      const first = fields(i).find((e) => e.type !== 'radio' && e.type !== 'checkbox');
      first?.focus({ preventScroll: true });
      keepInView(root);
    };

    const go = (n: number) => {
      if (busy || n === cur || n < 0 || n > last) return;
      const dir = n > cur ? 1 : -1;
      const from = views[cur];
      const to = views[n];
      cur = n;
      chrome();
      if (reduced) {
        from.hidden = true;
        to.hidden = false;
        focusView(n);
        return;
      }
      entering.forEach((t) => t.kill());
      entering = [];
      busy = true;
      gsap.to(from, {
        autoAlpha: 0,
        y: -24 * dir,
        duration: 0.4,
        ease: 'css',
        onComplete: () => {
          from.hidden = true;
          gsap.set(from, { clearProps: 'all' });
          busy = false;
          to.hidden = false;
          entering.push(gsap.fromTo(to, { y: 24 * dir }, { y: 0, duration: 0.9, ease: 'css', clearProps: 'transform' }));
          entering.push(play(to));
          focusView(n);
        },
      });
    };

    const advance = () => {
      if (cur < last && report(cur)) go(cur + 1);
    };
    next.querySelector('button')!.addEventListener('click', advance);
    back.querySelector('button')!.addEventListener('click', () => go(cur - 1));
    form.addEventListener('input', state);
    form.addEventListener('change', state);
    form.addEventListener('keydown', (e) => {
      const t = e.target as HTMLElement;
      if (e.key !== 'Enter' || t.tagName === 'TEXTAREA' || t.tagName === 'BUTTON' || cur === last) return;
      if ((t as HTMLInputElement).type === 'file') return;
      e.preventDefault();
      advance();
    });

    // ---------- Absenden (noch nicht angebunden) ----------
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      if (cur !== last) return;
      if (!report(cur)) return;
      form.querySelector<HTMLAnchorElement>('[data-ps-mail-link]')!.href = mailto(
        form.dataset.psMail ?? '',
        'Projektanfrage',
        rows(),
      );
      const finish = () => {
        views[cur].hidden = true;
        nav.hidden = true;
        count.hidden = true;
        done.hidden = false;
        fills.forEach((f) => gsap.set(f, { scaleX: 1 }));
        playDone(done);
        keepInView(root);
      };
      if (reduced) return finish();
      gsap.to([views[cur], nav], {
        autoAlpha: 0,
        y: -20,
        duration: 0.4,
        ease: 'css',
        onComplete: () => {
          gsap.set([views[cur], nav], { clearProps: 'all' });
          finish();
        },
      });
    });

    chrome();

    // Auftritt: Der Satz schreibt sich beim Hereinscrollen
    if (reduced) root.classList.remove('ps-pend');
    else
      ScrollTrigger.create({
        trigger: root,
        start: 'top 85%',
        once: true,
        onEnter: () => {
          const chunks = views[0].querySelectorAll<HTMLElement>('.ps-c, .ps-grp, .ps-in, .ps-files');
          gsap.set(chunks, { opacity: 0 });
          root.classList.remove('ps-pend');
          entering.push(
            gsap.to(chunks, { opacity: 1, duration: 1, ease: 'css', stagger: 0.06, clearProps: 'opacity' }),
          );
        },
      });
  }
</script>

<style>
  .ps {
    --ink: #090402;
    --hair: rgb(0 0 0 / 0.2);
    margin: 0 20px;
    color: var(--ink);
  }
  .ps-inner {
    max-width: var(--container-page);
    margin: 0 auto;
    padding: 0 0 40px;
  }
  .ps-bar {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }
  .ps-bar[hidden] {
    display: none;
  }
  .ps-bar span {
    display: block;
    height: 1px;
    background: var(--hair);
  }
  .ps-bar i {
    display: block;
    height: 100%;
    background: var(--color-gold);
    transform: scaleX(0);
    transform-origin: left center;
  }
  .ps-meta {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    margin: 20px 0 36px;
  }
  .ps-meta p {
    margin: 0;
  }
  .ps:not(.is-sentence) .ps-meta p:last-child {
    display: none;
  }

  /* Der Satz */
  .ps-sentence {
    margin: 0;
    font-family: var(--font-urbanist), sans-serif;
    font-size: 23px;
    line-height: 34px;
    font-weight: 500;
    text-wrap: pretty;
  }
  .ps-w {
    position: relative;
    display: inline;
    color: rgb(9 4 2 / 0.42);
    cursor: pointer;
    background: linear-gradient(var(--color-gold), var(--color-gold)) no-repeat 0 100% / 0% 1px;
    padding-bottom: 2px;
    transition:
      color 0.45s var(--ease-css),
      background-size 0.7s var(--ease-grow);
  }
  .ps-w input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }
  .ps-w:hover {
    color: rgb(9 4 2 / 0.75);
  }
  .ps-w:has(input:checked) {
    color: var(--ink);
    background-size: 100% 1px;
  }
  .ps-w:has(input:focus-visible) {
    outline: 2px solid var(--color-gold);
    outline-offset: 3px;
  }
  .ps-sep {
    color: rgb(9 4 2 / 0.2);
  }
  .ps-in {
    display: inline-block;
    max-width: 100%;
    padding: 0 0 1px;
    border: 0;
    border-bottom: 1px solid rgb(165 147 113 / 0.55);
    border-radius: 0;
    background: transparent;
    color: var(--ink);
    font: inherit;
    letter-spacing: inherit;
    text-align: left;
    vertical-align: baseline;
    transition: border-color 0.4s var(--ease-css);
  }
  .ps-in::placeholder {
    color: rgb(9 4 2 / 0.3);
  }
  .ps-in:focus {
    border-bottom-color: var(--ink);
    outline: none;
  }
  .ps-text {
    display: block;
    width: 100%;
    max-width: 100%;
    min-height: 110px;
    margin-top: 6px;
    padding: 6px 0 10px;
    border: 0;
    border-bottom: 1px solid rgb(165 147 113 / 0.55);
    border-radius: 0;
    background: transparent;
    color: var(--ink);
    font-family: var(--font-urbanist), sans-serif;
    font-size: 23px;
    line-height: 34px;
    font-weight: 500;
    resize: vertical;
    transition: border-color 0.4s var(--ease-css);
  }
  .ps-text::placeholder {
    color: rgb(9 4 2 / 0.3);
  }
  .ps-text:focus {
    border-bottom-color: var(--ink);
    outline: none;
  }

  /* Bilder */
  .ps-files {
    margin-top: 40px;
  }
  .ps-pick {
    position: relative;
    display: inline-block;
    cursor: pointer;
  }
  .ps-pick input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    cursor: pointer;
  }
  .ps-note {
    margin: 10px 0 0;
    color: var(--color-muted);
    font-size: 14px;
    line-height: 1.4;
  }
  .ps-note[hidden] {
    display: none;
  }
  .ps-note--err {
    color: var(--ink);
  }
  .ps-thumbs {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    max-width: 420px;
    gap: 10px;
    margin: 16px 0 0;
    padding: 0;
    list-style: none;
  }
  .ps-thumbs :global(li) {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
  }
  .ps-thumbs :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .ps-thumbs :global(button) {
    position: absolute;
    top: 4px;
    right: 4px;
    width: 24px;
    height: 24px;
    border: 0;
    background: var(--ink);
    color: #fff;
    font-size: 16px;
    line-height: 1;
    cursor: pointer;
    transition: background-color 0.3s var(--ease-css);
  }
  .ps-thumbs :global(button:hover) {
    background: var(--color-gold);
  }
  .ps-files.is-over .ps-pick span {
    color: var(--ink);
  }

  /* Ohne Skript stehen die Sätze untereinander */
  .ps:not(.is-sentence) .ps-view + .ps-view {
    margin-top: 56px;
    padding-top: 32px;
    border-top: 1px solid var(--hair);
  }
  .ps-view[hidden] {
    display: none;
  }

  /* Warten auf den Auftritt (nur mit Skript und Bewegung) */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .ps-pend .ps-c,
    :global(.js) .ps-pend .ps-grp,
    :global(.js) .ps-pend .ps-in,
    :global(.js) .ps-pend .ps-files {
      opacity: 0;
    }
  }

  /* Navigation */
  .ps-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-top: 44px;
  }
  .ps-nav[hidden],
  .ps-nav [hidden] {
