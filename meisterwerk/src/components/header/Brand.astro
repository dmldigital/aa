---
import { Picture } from 'astro:assets';
import { href, routes } from '../../data/links';
import type { Site } from '../../data/nav';
import mainLogo from '../../assets/img/cropped-meisterwerk_malerbetrieb_logo.png';
import exklusiveLogo from '../../assets/img/logo_exklusive.png';
import heroLogo from '../../assets/img/logo_meisterwerk_hero.png';
/** Logo der Kopfzeile (Hauptseite: Meisterwerk Malermanufaktur, Teil-Website: Meisterwerke Exklusive). */
interface Props {
  site?: Site;
  class?: string;
  /** `light` = weißes Logo (über Fotos), `duo` = „MEISTERWERK“ in Gold, Zusatzzeilen weiß (Vollbild-Hero der Startseite) */
  tone?: 'dark' | 'light' | 'duo';
}
const { site = 'main', class: className = '', tone = 'dark' } = Astro.props;
const exk = site === 'exklusive';
---

<a
  href={href(exk ? '/meisterwerk-exklusive/' : routes.home)}
  class="block shrink-0"
  aria-label={
    exk ? 'Meisterwerke Exklusive, zur Startseite' : 'Meisterwerk Malermanufaktur, zur Startseite'
  }
>
  <Picture
    formats={['avif']}
    fallbackFormat="webp"
    src={exk ? exklusiveLogo : tone === 'duo' ? heroLogo : mainLogo}
    alt={exk ? 'Meisterwerke Exklusive' : 'Meisterwerk Malermanufaktur'}
    widths={[180, 360]}
    sizes="180px"
    loading="eager"
    class:list={['h-auto', tone === 'light' && 'brightness-0 invert', className]}
  />
</a>
