---
/**
 * „Mehr über Meisterwerk“ auf den Anzeigen-Zielseiten: Überzeile, Titel und eine Reihe Knöpfe zu den Hauptseiten der Website
 * (Wunsch des Nutzers vom 24.11.: mehr Wege zur Startseite, zu den Leistungen und zum Betrieb).
 */
import Button from '../ui/Button.astro';
import { href } from '../../data/links';

interface Props {
  tone?: 'white' | 'soft';
}
const { tone = 'white' } = Astro.props;

const links = [
  { label: 'Startseite', href: '/' },
  { label: 'Alle Leistungen', href: '/leistungen/' },
  { label: 'Über uns', href: '/studio/' },
  { label: 'Projekte', href: '/projekte/' },
  { label: 'Qualifikationen', href: '/qualifikationen/' },
  { label: 'Meisterwerk Exklusive', href: '/meisterwerk-exklusive/' },
];
---

<section data-section="mehr-entdecken" class:list={['px-page py-section', tone === 'soft' ? 'bg-soft' : 'bg-white']}>
  <div class="mx-auto flex w-full max-w-page flex-col gap-group">
    <div class="flex max-w-[65ch] flex-col gap-text" data-anim="fadeInUp" data-anim-dur="fast">
      <p class="font-display text-label font-medium tracking-label text-ink uppercase">Mehr über Meisterwerk</p>
      <h2 class="font-display text-h2 text-balance text-gold">Lernen Sie uns kennen</h2>
    </div>
    <nav aria-label="Mehr über Meisterwerk" class="flex flex-wrap gap-3" data-anim="fadeInUp" data-anim-dur="fast" data-anim-delay="100">
      {links.map((l) => <Button href={href(l.href)} variant="outline">{l.label}</Button>)}
    </nav>
  </div>
</section>
