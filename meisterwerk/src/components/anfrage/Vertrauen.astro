---
/**
 * Vertrauenszeile der Anzeigen-Zielseiten (/anfrage/…): vier kurze Aussagen in einer Zeile, am Handy zwei mal zwei.
 * Weißer Grund, die vier Aussagen stehen mittig in gleich breiten Feldern zwischen zwei feinen Linien (oben und unten gleicher Abstand), Schrift der Zwischenüberschriften. Ohne Symbole und ohne Nummern.
 */
interface Props {
  items: string[];
}
const { items } = Astro.props;
---

<section data-section="vertrauen" class="bg-white px-page py-group">
  <ul class="mx-auto grid w-full max-w-page grid-cols-2 border-y border-black/10 lg:grid-cols-4">
    {items.map((item, i) => (
      <li
        class="flex items-center justify-center px-text py-group text-center font-display text-h4 text-balance text-ink max-lg:nth-[n+3]:border-t max-lg:nth-[even]:border-l lg:not-first:border-l border-black/10"
        data-anim="fadeInUp"
        data-anim-dur="fast"
        data-anim-delay={i * 80}
      >
        {item}
      </li>
    ))}
  </ul>
</section>
