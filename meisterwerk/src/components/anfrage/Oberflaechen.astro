---
/**
 * Oberflächen der Zielseite /anfrage/spachteltechnik/ als Pin- und Scroll-Sektion wie „Unsere Leistungen“ auf der Startseite
 * (`sections/LeistungenScroll.astro`): Die Sektion bleibt stehen, die Karten ziehen beim Scrollen von rechts nach links durchs
 * Bild, die Bilder gleiten leicht gegenläufig. Gleicher Ablauf auf Handy und Desktop; bei reduzierter Bewegung oder sehr
 * flachen Fenstern kein Pin, die Reihe lässt sich wischen. Name, Bild und Text wörtlich aus der Collection `kollektionen`
 * (Eintrag `spachteltechnik-oberflaechen`), jede Karte führt auf die vollständige Seite der Oberflächen.
 */
import { getEntry } from 'astro:content';
import { Picture } from 'astro:assets';
import Button from '../ui/Button.astro';
import { href } from '../../data/links';

interface Props {
  /** Namen der gezeigten Karten in dieser Reihenfolge */
  pick: string[];
}
const { pick } = Astro.props;
const entry = (await getEntry('kollektionen', 'spachteltechnik-oberflaechen'))!.data;
const all = entry.collections.flatMap((c) => c.rows.flatMap((r) => r.cards.map((card) => ({ ...card, collection: c.title }))));
const cards = pick.map((name) => {
  const card = all.find((c) => c.title === name);
  if (!card) throw new Error(`Oberfläche „${name}“ nicht in spachteltechnik-oberflaechen.json`);
  return card;
});
const total = String(cards.length).padStart(2, '0');
const target = href('/meisterwerk-exklusive/spachteltechnik-oberflaechen/');

const card =
  'group/card flex h-full flex-col bg-white text-ink no-underline focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-ink';
const arrow =
  'grid size-11 shrink-0 self-end place-items-center rounded-full bg-soft text-ink transition-colors duration-300 group-hover/card:bg-gold group-hover/card:text-white';
---

<section data-ob data-no-autolink aria-labelledby="ob-title" class="bg-soft text-ink">
  <div class="mx-auto grid w-full max-w-page gap-text px-page pt-section pb-group lg:grid-cols-12 lg:items-end lg:gap-x-stack">
    <div class="flex flex-col gap-text lg:col-span-7">
      <p class="font-display text-label font-medium tracking-label text-ink uppercase">Oberflächen</p>
      <h2 id="ob-title" class="font-display text-h2 font-medium text-balance text-gold">Collezioni Calce, Pietra und Urban</h2>
    </div>
    <div class="lg:col-span-4 lg:col-start-9 lg:justify-self-end">
      <Button href={target}>Alle Oberflächen ansehen</Button>
    </div>
  </div>

  <div
    data-ob-stage
    class="flex flex-col pb-section lk-p:h-svh lk-p:overflow-clip lk-p:pt-[clamp(72px,10svh,104px)] lk-p:pb-[clamp(96px,13svh,120px)]"
  >
    <div
      aria-hidden="true"
      class="mx-auto mb-stack hidden w-full max-w-page shrink-0 items-baseline justify-between px-page font-display text-label tracking-label text-muted uppercase lk-p:flex"
    >
      <span>Oberflächen</span>
      <span><b data-ob-count class="font-medium text-ink">01</b> / {total}</span>
    </div>

    <div
      data-ob-window
      class="ob-win relative flex h-[36rem] snap-x snap-mandatory items-center overflow-x-auto overscroll-x-contain [scrollbar-width:none] lk-p:h-auto lk-p:min-h-0 lk-p:flex-1 lk-p:snap-none lk-p:overflow-clip [&::-webkit-scrollbar]:hidden"
    >
      <ul
        data-ob-track
        class="flex w-max items-stretch gap-stack px-[max(var(--space-gutter),calc((100vw-var(--container-page))/2+var(--space-gutter)))] will-change-transform"
      >
        {cards.map((c) => (
          <li data-ob-card class="ob-card shrink-0 snap-start">
            <a href={target} class={card}>
              <div class="ob-media relative overflow-hidden">
                <Picture
                  formats={['avif']}
                  fallbackFormat="webp"
                  src={c.image}
                  alt={`Oberflächenmuster ${c.title}, ${c.collection}`}
                  widths={[252, 350, 477, 700]}
                  sizes="(min-width: 1025px) 28vw, 80vw"
                  loading="lazy"
                  pictureAttributes={{ class: 'contents' }}
                  class="absolute inset-0 size-full scale-[1.12] object-cover transition-[scale] duration-700 ease-out group-hover/card:scale-[1.17]"
                  data-ob-img
                />
              </div>
              <div class="ob-text flex flex-none items-start justify-between gap-stack p-inner">
                <div>
                  <h3 class="font-display text-h3 font-medium">{c.title}</h3>
                  <p class="mt-text line-clamp-4 text-body text-muted" set:html={c.text} />
                </div>
                <span class={arrow} aria-hidden="true">
                  <svg class="size-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true" focusable="false"><path d="M2 8h11" /><path d="m9 4 4 4-4 4" /></svg>
                </span>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  @reference "../../styles/global.css";
  /* Maße wie die Karten in `LeistungenScroll.astro`, nur mit mehr Platz für den Text (die Beschreibungen der Oberflächen sind länger) */
  .ob-win {
    container-type: size;
  }
  .ob-card {
    --ob-tp: 15rem;
    --ob-w: min(80vw, 340px, max(200px, calc((100cqh - var(--ob-tp)) / 0.75)));
    width: var(--ob-w);
    height: min(100cqh, calc(var(--ob-w) * 1.25 + var(--ob-tp)));
  }
  .ob-media {
    flex: 1 1 0;
    min-height: 6rem;
  }
  .ob-text {
    min-height: var(--ob-tp);
  }
  @media (width >= theme(--breakpoint-md)) {
    .ob-card {
      --ob-tp: 15rem;
      --ob-w: min(clamp(300px, 28vw, 440px), max(220px, calc((100cqh - var(--ob-tp)) / 0.75)));
    }
  }
</style>

<script>
  import { gsap } from '../../scripts/motion';

  const sec = document.querySelector<HTMLElement>('[data-ob]');
  if (sec) {
    const stage = sec.querySelector<HTMLElement>('[data-ob-stage]')!;
    const win = sec.querySelector<HTMLElement>('[data-ob-window]')!;
    const track = sec.querySelector<HTMLElement>('[data-ob-track]')!;
    const count = sec.querySelector<HTMLElement>('[data-ob-count]');
    const imgs = [...track.querySelectorAll<HTMLElement>('[data-ob-img]')];
    const n = track.querySelectorAll('[data-ob-card]').length;
    const pad = (v: number) => String(v).padStart(2, '0');
    const mm = gsap.matchMedia();

    // Ablauf wie `LeistungenScroll.astro`: Pin, die Reihe wandert mit dem Scrollen nach links
    mm.add('(min-height: 560px) and (prefers-reduced-motion: no-preference)', () => {
      const travel = () => Math.max(0, track.scrollWidth - win.clientWidth);
      const ratio = () => (window.innerWidth < 768 ? 1.15 : 1.5);
      const tl = gsap.timeline({
        defaults: { ease: 'none' },
        scrollTrigger: {
          trigger: stage,
          start: 'top top',
          end: () => `+=${Math.round(travel() * ratio())}`,
          pin: stage,
          scrub: 0.8,
          anticipatePin: 1,
          invalidateOnRefresh: true,
          onUpdate: (self) => {
            if (count) count.textContent = pad(1 + Math.round(self.progress * (n - 1)));
          },
        },
      });
      tl.to(track, { x: () => -travel() }, 0);
      tl.fromTo(imgs, { xPercent: 4 }, { xPercent: -4 }, 0);
      return () => {
        tl.scrollTrigger?.kill();
        tl.kill();
        gsap.set([track, ...imgs], { clearProps: 'transform' });
        if (count) count.textContent = '01';
      };
    });
  }
</script>
