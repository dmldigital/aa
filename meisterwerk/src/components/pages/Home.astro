---
/** Startseite (Stand der Auswahl-Vorschau): Vollbild-Hero (Flug-Video), Willkommen-Szene, Leistungen, Fachsektion,
 * „Jede Oberfläche ist einzigartig“ mit Projekten, FAQ. */
import PageLayout from '../../layouts/PageLayout.astro';
import HeroFull from '../sections/HeroFull.astro';
import WelcomeScroll from '../sections/WelcomeScroll.astro';
import LeistungenScroll from '../sections/LeistungenScroll.astro';
import Fachsektion from '../home/Fachsektion.astro';
import OberflaecheProjekte from '../home/OberflaecheProjekte.astro';
import FaqTabs from '../home/FaqTabs.astro';
import { href } from '../../data/links';

// Willkommen-Text: Originaltext mit lokaler Optimierung (Freiberg a. N., Ludwigsburg, Marbach, Bietigheim-Bissingen)
// und internen Textlinks auf Leistung, Showroom und Anfrage
const link = (label: string, path: string) =>
  `<a href="${href(path)}" class="text-gold transition-colors duration-300 hover:text-ink">${label}</a>`;
const welcome = {
  heading: 'Ihr Malerbetrieb aus Freiberg am Neckar',
  paragraphs: [
    `Willkommen bei Meisterwerk, Ihrem Spezialisten für hochwertige ${link('Malerarbeiten', '/services/malerarbeiten/')} und individuelle Oberflächengestaltung. Mit über 24 Jahren Erfahrung verbinden wir traditionelles Handwerk mit modernem Design, vom Innen- und Außenanstrich bis zur Veredelung von Oberflächen.`,
    `Wir verwenden bevorzugt umweltfreundliche, zum Teil allergikerfreundliche Materialien für ein gesundes Raumklima. In unserem ${link('Showroom in Freiberg am Neckar', '/2025/05/03/unser-showroom/')} sehen Sie Oberflächen und Strukturen persönlich.`,
    `Von der Beratung bis zur sauberen Ausführung begleiten wir Sie in Freiberg, Ludwigsburg, Marbach und Bietigheim-Bissingen zuverlässig. Vereinbaren Sie Ihre ${link('persönliche Beratung', '/kontakt/')} bei uns.`,
  ],
};

---

<PageLayout
  hero
  title="Maler Ludwigsburg & Stuttgart"
  description="Meisterwerk Malermanufaktur aus Freiberg am Neckar: Malerarbeiten, Lackieren, Tapezieren, Verputzen und fugenlose Oberflächen in Ludwigsburg und Stuttgart."
>
  <HeroFull />
  <WelcomeScroll home heading={welcome.heading} paragraphs={welcome.paragraphs} />
  <LeistungenScroll />
  <Fachsektion />
  <OberflaecheProjekte />
  <FaqTabs />
</PageLayout>
