---
/**
 * Leistungsübersicht (/leistungen/): Titel, darunter die Leistungen als große Zeilen. Auf dem Desktop bleibt rechts eine
 * Bildbühne stehen, die zum Bild der angewählten Zeile überblendet; auf Handy und Tablet bringt jede Zeile ihr Bild mit.
 * Die Kurztexte sind die der Leistungs-Karten auf der Startseite (Vorschau Auswahl), die Reihenfolge wie dort.
 */
import { Picture } from 'astro:assets';
import { href } from '../../data/links';
import { cards } from '../../data/services';
import exklusive from '../../assets/img/Exklusive-Spachteltechnik-Kalkpresstechnik-Badedzimmer-Bianco-scaled.jpg';

const copy: Record<string, [string, string]> = {
  '/services/glatte-waende/': ['Glatte Wände & Q4-⁠Spachtelung', 'Perfekt glatte Oberflächen in Q3 und Q4, modern und sauber'],
  '/services/lackierarbeiten/': ['Lackierarbeiten', 'Türen, Fenster und Treppen, innen wie außen, mit dauerhaftem Schutz'],
  '/services/malerarbeiten/': ['Malerarbeiten', 'Innen- und Außenanstrich mit Farbberatung, präzise und sauber'],
  '/services/tapezieren/': ['Tapezierarbeiten', 'Tapeten an Wand und Decke, mit Fachberatung zur Auswahl'],
  '/services/verputzen/': ['Verputzarbeiten', 'Innen- und Außenputz und dekorative Oberflächen, langlebig ausgeführt'],
};
const items = [
  ...cards.map((c) => ({
    href: c.href,
    title: copy[c.href]?.[0] ?? c.title,
    sub: copy[c.href]?.[1] ?? c.subtitle ?? '',
    img: c.img,
    alt: c.alt,
    tag: '',
  })),
  {
    href: '/meisterwerk-exklusive/',
    title: 'Meisterwerke Exklusive',
    sub: 'Fugenlose Bäder und Böden, Spachteltechniken und Stuckleisten',
    img: exklusive,
    alt: 'Fugenlose Spachteltechnik im Bad, Meisterwerke Exklusive.',
    tag: 'Spezialleistungen',
  },
];
const heading = ['Planung, Gestaltung, Umsetzung', 'alles für Ihr Projekt.'];
---

<section data-ls class="ls">
  <div class="ls-wrap">
    <header class="ls-head">
      <div class="ls-eyebrow-row">
        <span class="ls-rule" aria-hidden="true"></span>
        <p class="ls-eyebrow">Unsere Leistungen</p>
      </div>
      <h1 class="ls-title" aria-label={heading.join(': ')}>
        {heading.map((line) => (
          <span class="ls-line" aria-hidden="true">
            {line.split(' ').map((w) => <span class="ls-wordbox"><span class="ls-word">{w}</span></span>)}
          </span>
        ))}
      </h1>
    </header>

    <div class="ls-body">
      <ul class="ls-list">
        {items.map((it) => (
          <li data-rv>
            <a href={href(it.href)} class="ls-row" data-ls-row>
              <span class="ls-hair" data-rv-line aria-hidden="true"></span>
              <span class="ls-media" data-grow="bottom">
                <Picture
                  formats={['avif']}
                  fallbackFormat="webp"
                  src={it.img}
                  alt={it.alt}
                  widths={[477, 700, 954]}
                  sizes="(min-width: 768px) 60vw, calc(100vw - 40px)"
                  loading="lazy"
                  class="ls-img"
                />
              </span>
              <span class="ls-text">
                {it.tag && <span class="ls-tag">{it.tag}</span>}
                <h2 class="ls-name">{it.title}</h2>
                <p class="ls-sub">{it.sub}</p>
              </span>
              <span class="ls-arrow" aria-hidden="true"><i>↗</i></span>
            </a>
          </li>
        ))}
      </ul>

      <div class="ls-stage" aria-hidden="true">
        <div class="ls-frame" data-grow="bottom" data-anim-delay="250">
          {items.map((it) => (
            <div class="ls-layer" data-ls-layer>
              <Picture
                formats={['avif']}
                fallbackFormat="webp"
                src={it.img}
                alt=""
                widths={[480, 700, 954]}
                sizes="(min-width: 1025px) 40vw, 0px"
                loading="lazy"
                class="ls-stage-img"
              />
              <span class="ls-layer-title">{it.title}</span>
            </div>
          ))}
          <span class="ls-shade"></span>
          <a data-ls-go href={href(items[0].href)} class="ls-go" tabindex="-1">Zum Leistungsbereich <i>↗</i></a>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { initLeistungen } from '../../scripts/leistungen';

  initLeistungen();
</script>

<style is:global>
  .ls {
    --ease: cubic-bezier(0.22, 1, 0.36, 1);
    padding: 32px 20px 72px;
  }
  .ls-wrap {
    max-width: var(--container-page);
    margin: 0 auto;
  }
  .ls-eyebrow-row {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .ls-rule {
    display: block;
    width: 44px;
    height: 1px;
    background: var(--color-gold);
    transform-origin: 0 50%;
  }
  .ls-eyebrow {
    margin: 0;
    color: var(--color-gold);
    font-family: var(--font-display);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .ls-title {
    margin: 22px 0 0;
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: clamp(38px, 10.4vw, 56px);
    line-height: 1.02;
    font-weight: 500;
    letter-spacing: -0.01em;
  }
  .ls-line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.08em;
  }
  .ls-wordbox {
    display: inline-block;
    margin-right: 0.26em;
  }
  .ls-word {
    display: inline-block;
  }
  @media (prefers-reduced-motion: no-preference) {
    .js .ls-title:not(.is-go) .ls-word {
      visibility: hidden;
    }
    .js .ls-rule {
      transform: scaleX(0);
    }
  }

  /* Zeilen */
  .ls-body {
    margin-top: 44px;
  }
  .ls-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .ls-row {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 14px 20px;
    padding: 26px 0 30px;
    color: var(--color-ink);
    text-decoration: none;
  }
  .ls-hair {
    position: absolute;
    top: 0;
    right: 0;
    left: 0;
    height: 1px;
    background: rgb(0 0 0 / 0.14);
    transform-origin: 0 50%;
  }
  .ls-list li:last-child .ls-row {
    border-bottom: 1px solid rgb(0 0 0 / 0.14);
  }
  .ls-media {
    grid-column: 1 / -1;
    display: block;
    overflow: hidden;
    aspect-ratio: 4 / 3;
  }
  .ls-media .ls-img {
    display: block;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
  }
  .ls-text {
    display: block;
    min-width: 0;
  }
  .ls-tag {
    display: block;
    margin-bottom: 10px;
    color: var(--color-gold);
    font-family: var(--font-display);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .ls-name {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(28px, 7.4vw, 40px);
    line-height: 1.08;
    font-weight: 500;
    letter-spacing: -0.005em;
    transition: color 0.5s ease;
  }
  .ls-sub {
    max-width: 30em;
    margin: 10px 0 0;
    color: var(--color-muted);
    font-size: 16px;
    line-height: 25px;
  }
  .ls-arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    align-self: start;
    width: 44px;
    height: 44px;
    border: 1px solid rgb(0 0 0 / 0.25);
    font-size: 17px;
    transition:
      background-color 0.5s ease,
      border-color 0.5s ease,
      color 0.5s ease;
  }
  .ls-arrow i {
    font-style: normal;
    transition: transform 0.6s var(--ease);
  }
  .ls-row:hover .ls-arrow,
  .ls-row:focus-visible .ls-arrow,
  .ls-row.is-active .ls-arrow {
    border-color: var(--color-ink);
    background: var(--color-ink);
    color: #fff;
  }
  .ls-row:hover .ls-arrow i,
  .ls-row:focus-visible .ls-arrow i {
    transform: translate(2px, -2px);
  }
  .ls-row:focus-visible {
    outline: 2px solid var(--color-gold);
    outline-offset: 4px;
  }
  .ls-stage {
    display: none;
  }

  @media (min-width: 768px) {
    .ls {
      padding: 48px 20px 96px;
    }
    .ls-title {
      font-size: clamp(52px, 8vw, 84px);
    }
    .ls-media {
      aspect-ratio: 16 / 9;
    }
    .ls-name {
      font-size: clamp(34px, 5vw, 48px);
    }
  }

  /* Desktop: Zeilen links, Bildbühne rechts bleibt stehen */
  @media (min-width: 1025px) {
    .ls {
      padding: 72px 30px 120px;
    }
    .ls-title {
      font-size: clamp(64px, 6.6vw, 104px);
    }
    .ls-body {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.62fr);
      gap: 0 96px;
      align-items: start;
      margin-top: 72px;
    }
    .ls-row {
      padding: 40px 0 44px;
    }
    .ls-media {
      display: none;
    }
    .ls-name {
      font-size: clamp(38px, 3.6vw, 56px);
    }
    .ls-sub {
      font-size: 17px;
    }
    .ls-arrow {
      width: 52px;
      height: 52px;
    }
    /* Hat eine Zeile den Fokus, treten die übrigen zurück */
    .ls.has-active .ls-row:not(.is-active) .ls-name {
      color: rgb(9 4 2 / 0.32);
    }
    .ls.has-active .ls-row:not(.is-active) .ls-sub {
      color: rgb(0 0 0 / 0.38);
    }
    .ls-sub {
      transition: color 0.5s ease;
    }

    .ls-stage {
      position: sticky;
      top: 110px;
      display: block;
    }
    .ls-frame {
      position: relative;
      overflow: hidden;
      height: min(calc(100svh - 150px), 760px);
      background: #1b1a18;
    }
    .ls-layer {
      position: absolute;
      inset: 0;
      opacity: 0;
      transition: opacity 1s ease;
    }
    .ls-layer.is-active {
      opacity: 1;
    }
    .ls-stage-img {
      display: block;
      width: 100%;
      height: 100%;
      max-width: none;
      object-fit: cover;
    }
    .ls-shade {
      position: absolute;
      inset: 0;
      background: linear-gradient(to top, rgb(9 4 2 / 0.7) 0%, rgb(9 4 2 / 0) 45%);
      pointer-events: none;
    }
    .ls-layer-title {
      position: absolute;
      right: 28px;
      bottom: 74px;
      left: 28px;
      color: #fff;
      font-family: var(--font-display);
      font-size: 26px;
      line-height: 31px;
      font-weight: 500;
    }
    .ls-go {
      position: absolute;
      bottom: 28px;
      left: 28px;
      padding-bottom: 4px;
      border-bottom: 1px solid var(--color-gold);
      color: #fff;
      font-family: var(--font-display);
      font-size: 13px;
      font-weight: 600;
      letter-spacing: 0.06em;
      text-decoration: none;
      text-transform: uppercase;
    }
    .ls-go i {
      font-style: normal;
    }
  }
</style>
