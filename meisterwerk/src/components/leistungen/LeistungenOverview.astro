---
/**
 * Leistungsübersicht (/leistungen/). Gestaltung und Maße wie die Leistungs-Sektion der Startseite (graue Fläche, Label,
 * goldene Überschrift, weiße Karten mit Rand, Bild, Titel, Kurztext und Symbol), nur als ruhiges Raster statt als Stapel:
 * Links bleibt der Text stehen, rechts laufen die Karten durch. Bilder wachsen wie auf der alten Seite von links herein,
 * die Linie unter dem Text füllt sich beim Scrollen wie auf der Startseite. Texte und Reihenfolge wie auf der Startseite.
 */
import { Picture } from 'astro:assets';
import { href } from '../../data/links';
import { cards } from '../../data/services';
import Button from '../ui/Button.astro';
import logo from '../../assets/img/logo_exklusive.png';
import fugenloseBaeder from '../../assets/img/Fugenlose-Dusche-Nero-Fine-scaled.jpg';
import fugenloseBoeden from '../../assets/img/324-mw-20241125-Bearbeitet-scaled.jpg';
import spachtel from '../../assets/img/Exklusive-Spachteltechnik-Kalkpresstechnik-Badedzimmer-Bianco-scaled.jpg';
import stuck from '../../assets/img/285-mw-20241125-HDR-1-scaled.jpg';

const copy: Record<string, [string, string]> = {
  '/services/glatte-waende/': ['Glatte Wände & Q4-⁠Spachtelung', 'Perfekt glatte Oberflächen in Q3 und Q4, modern und sauber'],
  '/services/lackierarbeiten/': ['Lackierarbeiten', 'Türen, Fenster und Treppen, innen wie außen, mit dauerhaftem Schutz'],
  '/services/malerarbeiten/': ['Malerarbeiten', 'Innen- und Außenanstrich mit Farbberatung, präzise und sauber'],
  '/services/tapezieren/': ['Tapezierarbeiten', 'Tapeten an Wand und Decke, mit Fachberatung zur Auswahl'],
  '/services/verputzen/': ['Verputzarbeiten', 'Innen- und Außenputz und dekorative Oberflächen, langlebig ausgeführt'],
};
const items = cards.map((c) => ({
  href: c.href,
  title: copy[c.href]?.[0] ?? c.title,
  sub: copy[c.href]?.[1] ?? c.subtitle ?? '',
  img: c.img,
  alt: c.alt,
}));
// Die Kurztexte fassen die Texte der jeweiligen Leistungsseite zusammen
const exklusivLinks = [
  {
    label: 'Fugenlose Bäder',
    text: 'Nahtlose, glatte Oberflächen, die modern wirken und besonders pflegeleicht und hygienisch sind.',
    href: '/meisterwerk-exklusive/fugenlose-baeder/',
    img: fugenloseBaeder,
    alt: 'Fugenlose Dusche in dunklem Ton, Meisterwerke Exklusive.',
  },
  {
    label: 'Fugenlose Böden',
    text: 'Eine durchgehende Fläche ohne Fugen, in denen sich Schmutz absetzt. Räume wirken größer und ruhiger.',
    href: '/meisterwerk-exklusive/fugenloser-boden/',
    img: fugenloseBoeden,
    alt: 'Fugenloser Boden in einem Wohnraum, Meisterwerke Exklusive.',
  },
  {
    label: 'Spachteltechniken',
    text: 'Wände und Decken mit einzigartiger, individueller Optik, wie sie kein klassischer Anstrich erreicht.',
    href: '/meisterwerk-exklusive/spachteltechniken/',
    img: spachtel,
    alt: 'Fugenlose Spachteltechnik im Bad, Meisterwerke Exklusive.',
  },
  {
    label: 'Stuckleisten',
    text: 'Architektonische Akzente mit raffinierten Lösungen für indirektes und direktes Licht.',
    href: '/meisterwerk-exklusive/stuckleisten/',
    img: stuck,
    alt: 'Stuckleisten mit indirekter Beleuchtung, Meisterwerke Exklusive.',
  },
];
---

<section data-ls class="ls">
  <div class="ls-inner">
    <div class="ls-heading">
      <p class="ls-eyebrow" data-anim="fadeIn">Unsere Leistungen</p>
      <h1 data-anim="fadeIn" data-anim-delay="100">Ihr Malerbetrieb für Ludwigsburg, Marbach und Bietigheim-Bissingen</h1>
      <p class="ls-sub" data-anim="fadeIn" data-anim-delay="200">
        Meisterbetrieb aus Freiberg am Neckar für Ludwigsburg, Marbach, Bietigheim-Bissingen und Stuttgart.
      </p>
      <p class="ls-sub ls-sub--more" data-anim="fadeIn" data-anim-delay="300">
        Ob Malerarbeiten, Tapeten, Lack oder Putz: Wir beraten Sie im Showroom, planen gemeinsam mit Ihnen und setzen Ihr Projekt sauber und termingerecht um. Für besondere Wünsche gibt es unsere Spezialleistungen als Meisterwerke Exklusive.
      </p>
      <span class="ls-progress" aria-hidden="true"><i data-ls-fill></i></span>
    </div>

    <div class="ls-grid" data-ls-grid>
      {items.map((it, i) => (
        <a href={href(it.href)} class:list={['ls-card', i === items.length - 1 && items.length % 2 === 1 && 'ls-card--row']} data-ls-card data-pend>
          <div class="ls-img">
            <Picture
              formats={['avif']}
              fallbackFormat="webp"
              src={it.img}
              alt={it.alt}
              widths={[350, 477, 700, 954]}
              sizes="(min-width: 1025px) 38vw, (min-width: 768px) 45vw, calc(100vw - 40px)"
              loading="lazy"
            />
            <span class="ls-zoom" aria-hidden="true">
              <svg class="ls-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="miter" aria-hidden="true" focusable="false"><path d="M20 13.5V21H3V4h7.5"/><path d="M14 3h7v7"/><path d="M21 3 11 13"/></svg>
            </span>
          </div>
          <div class="ls-text">
            <h2>{it.title}<span>{it.sub}</span></h2>
            <svg class="ls-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="miter" aria-hidden="true" focusable="false"><path d="M20 13.5V21H3V4h7.5"/><path d="M14 3h7v7"/><path d="M21 3 11 13"/></svg>
          </div>
        </a>
      ))}

      <div class="ls-card ls-card--wide" data-ls-card data-pend data-ls-wide>
        <div class="ls-wide-img" aria-hidden="true">
          {exklusivLinks.map((l, i) => (
            <div class:list={['ls-swap', i === 0 && 'is-active']} data-ls-swap>
              <Picture
                formats={['avif']}
                fallbackFormat="webp"
                src={l.img}
                alt=""
                widths={[477, 700, 954]}
                sizes="(min-width: 1025px) 38vw, (min-width: 768px) 45vw, calc(100vw - 40px)"
                loading="lazy"
              />
            </div>
          ))}
        </div>
        <div class="ls-wide-body">
          <Picture formats={['avif']} fallbackFormat="webp" src={logo} alt="Meisterwerke Exklusive by Baldassarre Fortino" widths={[228, 456]} sizes="240px" loading="lazy" class="ls-logo" />
          <div class="ls-body">
            <h2>Fugenlose Bäder und Böden, Spachteltechniken und Stuckleisten</h2>
            <p>Unsere Spezialleistungen als Meisterbetrieb. Im Showroom in Freiberg am Neckar sehen Sie die Oberflächen persönlich.</p>
          </div>
          <ul class="ls-links" data-ls-links>
            {exklusivLinks.map((l, i) => (
              <li class:list={[i === 0 && 'is-on']} data-ls-link>
                <a href={href(l.href)}>
                  <span class="ls-link-title">{l.label}</span>
                  <span class="ls-link-text">{l.text}</span>
                  <span class="ls-link-more underline-anim relative [--underline-gap:3px]">Mehr erfahren</span>
                </a>
              </li>
            ))}
          </ul>
          <Button href={href('/meisterwerk-exklusive/')}>Zu Meisterwerk Exklusive ↗</Button>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap, ScrollTrigger } from '../../scripts/motion';

  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Die Linie unter dem Text füllt sich, während die Karten durchlaufen (wie auf der Startseite)
  const grid = document.querySelector<HTMLElement>('[data-ls-grid]');
  const fill = document.querySelector<HTMLElement>('[data-ls-fill]');
  if (grid && fill && !reduced) {
    gsap.fromTo(
      fill,
      { scaleX: 0.1 },
      {
        scaleX: 1,
        ease: 'none',
        scrollTrigger: { trigger: grid, start: 'top 60%', end: 'bottom 75%', scrub: 0.6 },
      },
    );
  }

  // Exklusive-Box: Beim Überfahren (oder Fokussieren) einer Leistung blendet das Bild zum passenden Bild über
  const swaps = [...document.querySelectorAll<HTMLElement>('[data-ls-swap]')];
  const links = [...document.querySelectorAll<HTMLElement>('[data-ls-link]')];
  const linkList = document.querySelector<HTMLElement>('[data-ls-links]');
  if (swaps.length && links.length === swaps.length) {
    const select = (i: number) => {
      links.forEach((l, k) => l.classList.toggle('is-on', k === i));
      swaps.forEach((w, k) => w.classList.toggle('is-active', k === i));
    };
    links.forEach((l, i) => {
      l.addEventListener('pointerenter', (e) => e.pointerType === 'mouse' && select(i));
      l.addEventListener('focusin', () => select(i));
    });
    linkList?.classList.add('has-active');
  }

  // Auftritt der Karten: Die ganze Box steigt auf und öffnet sich von unten nach oben, das Bild darin bleibt ruhig.
  // Mehrere Karten gleichzeitig im Bild kommen nacheinander.
  const cards = [...document.querySelectorAll<HTMLElement>('[data-ls-card]')];
  if (reduced) {
    cards.forEach((c) => c.removeAttribute('data-pend'));
  } else if (cards.length) {
    ScrollTrigger.batch(cards, {
      start: 'top 90%',
      once: true,
      onEnter: (batch) => {
        batch.forEach((c) => c.removeAttribute('data-pend'));
        gsap.fromTo(
          batch,
          { clipPath: 'inset(100% 0% 0% 0%)', y: 48 },
          {
            clipPath: 'inset(0% 0% 0% 0%)',
            y: 0,
            duration: 1.3,
            ease: 'power3.out',
            stagger: 0.16,
            clearProps: 'clipPath,transform',
          },
        );
      },
    });
  }
</script>

<style>
  .ls {
    --ink: #090402;
    --hair: #0904021f;
    padding: 56px 20px 64px;
    background: var(--color-soft);
    color: var(--ink);
  }
  .ls-inner {
    display: grid;
    gap: 32px;
    max-width: var(--container-page);
    margin: 0 auto;
  }
  .ls-eyebrow {
    margin: 0;
    font-family: var(--font-urbanist), sans-serif;
    font-size: 12px;
    line-height: 1.5;
    font-weight: 500;
    letter-spacing: 2px;
    text-transform: uppercase;
  }
  .ls-heading h1 {
    margin: 36px 0 24px;
    color: var(--color-gold);
    font-family: var(--font-urbanist), sans-serif;
    font-size: clamp(28px, 3.2vw, 40px);
    line-height: 1.25;
    font-weight: 500;
    text-wrap: balance;
  }
  .ls-sub {
    margin: 0;
    color: var(--color-muted);
    font-size: 15px;
    line-height: 1.5;
  }
  .ls-sub--more {
    margin-top: 14px;
  }
  .ls-progress {
    display: block;
    width: 100px;
    height: 2px;
    margin-top: 40px;
    background: #09040226;
  }
  .ls-progress i {
    display: block;
    width: 100%;
    height: 100%;
    background: var(--color-gold);
    transform-origin: 0 50%;
    transform: scaleX(0.1);
  }

  .ls-grid {
    display: grid;
    gap: 20px;
  }
  .ls-card {
    position: relative;
    display: flex;
    flex-direction: column;
    border: 1px solid var(--hair);
    background: #fff;
    color: var(--ink);
    text-decoration: none;
  }
  .ls-img {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 3;
  }
  .ls-img :global(picture),
  .ls-img :global(img),
  .ls-img > div {
    display: block;
    width: 100%;
    height: 100%;
  }
  .ls-img :global(img) {
    object-fit: cover;
    transition:
      transform 0.45s ease-in-out,
      opacity 0.45s ease-in-out;
  }
  .ls-img:hover :global(img) {
    transform: scale(1.05);
    opacity: 0.8;
  }
  .ls-zoom {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 70px;
    height: 70px;
    border-radius: 50%;
    background: #000000b3;
    color: #fff;
    opacity: 0;
    transform: translate(-50%, -50%);
    pointer-events: none;
    transition: opacity 0.3s ease;
  }
  .ls-img:hover .ls-zoom {
    opacity: 1;
  }
  .ls-zoom .ls-icon {
    width: 28px;
    height: 28px;
    margin: 0;
  }
  .ls-text {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 20px;
    padding: 22px 24px 26px;
  }
  .ls-text h2,
  .ls-card--wide h2 {
    margin: 0;
    font-family: var(--font-urbanist), sans-serif;
    font-size: 20px;
    line-height: 1.3;
    font-weight: 500;
  }
  .ls-text h2 span {
    display: block;
    min-height: 2.8em;
    margin-top: 4px;
    color: #090402b3;
    font-size: 15px;
    line-height: 1.4;
    font-weight: 400;
  }
  .ls-icon {
    display: block;
    flex: none;
    width: 20px;
    height: 20px;
    margin-top: 5px;
  }
  .ls-card--wide {
    display: grid;
  }
  .ls-wide-img {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 3;
  }
  .ls-swap {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.9s ease;
  }
  .ls-swap.is-active {
    opacity: 1;
  }
  .ls-swap :global(picture),
  .ls-swap :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
  }
  .ls-wide-body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 22px;
    padding: 24px 20px 26px;
  }
  .ls-wide-body :global(.ls-logo) {
    display: block;
    width: 240px;
    max-width: 100%;
    height: auto;
  }
  .ls-wide-body > :global(a) {
    margin-top: auto;
  }
  /* Leistungen der Exklusive-Seite: Liste wie die Tabs der Fachsektion (goldene Linie, aktive Zeile golden, übrige blass) */
  .ls-links {
    width: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .ls-links li {
    position: relative;
    padding: 12px 0 14px;
    transition:
      opacity 0.6s ease,
      padding-left 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .ls-links li::before {
    content: '';
    position: absolute;
    top: 26px;
    left: 0;
    width: 0;
    height: 1px;
    background: var(--color-gold);
    transition: width 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .ls-links.has-active li {
    opacity: 0.45;
  }
  .ls-links.has-active li.is-on {
    padding-left: 36px;
    opacity: 1;
  }
  .ls-links li.is-on::before {
    width: 22px;
  }
  .ls-links a {
    display: block;
    color: var(--ink);
    text-decoration: none;
  }
  .ls-link-title {
    display: block;
    font-family: var(--font-urbanist), sans-serif;
    font-size: 20px;
    line-height: 1.3;
    font-weight: 500;
    transition: color 0.6s ease;
  }
  .ls-links li.is-on .ls-link-title {
    color: var(--color-gold);
  }
  .ls-link-text {
    display: block;
    max-width: 30em;
    margin-top: 4px;
    color: var(--color-muted);
    font-size: 15px;
    line-height: 1.5;
  }
  .ls-link-more {
    display: block;
    width: fit-content;
    max-height: 0;
    margin-top: 0;
    overflow: hidden;
    opacity: 0;
    font-family: var(--font-urbanist), sans-serif;
    font-size: 14px;
    line-height: 15.4px;
    font-weight: 600;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    transition:
      max-height 0.6s cubic-bezier(0.4, 0, 0.2, 1),
      margin-top 0.6s cubic-bezier(0.4, 0, 0.2, 1),
      opacity 0.5s ease;
  }
  .ls-links li.is-on .ls-link-more {
    max-height: 30px;
    margin-top: 12px;
    padding-bottom: 6px;
    opacity: 1;
  }
  .ls-body p {
    margin: 10px 0 0;
    color: var(--color-muted);
    font-size: 15px;
    line-height: 1.5;
  }

  @media (min-width: 768px) {
    .ls {
      padding: 72px 20px 80px;
    }
    .ls-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .ls-text h2,
    .ls-card--wide h2 {
      font-size: 24px;
    }
    .ls-card--wide,
    .ls-card--row {
      grid-column: 1 / -1;
    }
    /* Das Bild ist genau so breit wie die Bilder der Boxen darüber (eine Spalte ohne Rahmen), der Text füllt den Rest */
    .ls-card--row {
      display: grid;
      grid-template-columns: calc((100% - 22px) / 2) 1fr;
    }
    .ls-card--row .ls-text {
      align-items: center;
      padding: 35px;
    }
    .ls-card--wide {
      grid-template-columns: 1fr calc((100% - 22px) / 2);
    }
    .ls-card--wide .ls-wide-img {
      order: 2;
      aspect-ratio: auto;
    }
    .ls-wide-body {
      padding: 35px;
    }
    .ls-link-title {
      font-size: 24px;
    }
    .ls-links li::before {
      top: 31px;
    }
  }
  @media (min-width: 1025px) {
    .ls {
      padding: 12vh 30px;
    }
    .ls-inner {
      grid-template-columns: minmax(0, 0.34fr) minmax(0, 0.66fr);
      gap: 0 6vw;
      align-items: start;
    }
    .ls-heading {
      position: sticky;
      top: 22vh;
    }
  }
</style>
