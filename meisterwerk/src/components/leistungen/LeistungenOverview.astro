---
/**
 * Leistungsübersicht (/leistungen/). Gestaltung und Maße wie die Leistungs-Sektion der Startseite (graue Fläche, Label,
 * goldene Überschrift, weiße Karten mit Rand, Bild, Titel, Kurztext und Symbol), nur als ruhiges Raster statt als Stapel:
 * Links bleibt der Text stehen, rechts laufen die Karten durch. Bilder wachsen wie auf der alten Seite von links herein,
 * die Linie unter dem Text füllt sich beim Scrollen wie auf der Startseite. Texte und Reihenfolge wie auf der Startseite.
 */
import { Picture } from 'astro:assets';
import { href } from '../../data/links';
import { cards } from '../../data/services';
import Button from '../ui/Button.astro';
import logo from '../../assets/img/logo_exklusive.png';

const copy: Record<string, [string, string]> = {
  '/services/glatte-waende/': ['Glatte Wände & Q4-⁠Spachtelung', 'Perfekt glatte Oberflächen in Q3 und Q4, modern und sauber'],
  '/services/lackierarbeiten/': ['Lackierarbeiten', 'Türen, Fenster und Treppen, innen wie außen, mit dauerhaftem Schutz'],
  '/services/malerarbeiten/': ['Malerarbeiten', 'Innen- und Außenanstrich mit Farbberatung, präzise und sauber'],
  '/services/tapezieren/': ['Tapezierarbeiten', 'Tapeten an Wand und Decke, mit Fachberatung zur Auswahl'],
  '/services/verputzen/': ['Verputzarbeiten', 'Innen- und Außenputz und dekorative Oberflächen, langlebig ausgeführt'],
};
const items = cards.map((c) => ({
  href: c.href,
  title: copy[c.href]?.[0] ?? c.title,
  sub: copy[c.href]?.[1] ?? c.subtitle ?? '',
  img: c.img,
  alt: c.alt,
}));
---

<section data-ls class="ls">
  <div class="ls-inner">
    <div class="ls-heading">
      <p class="ls-eyebrow" data-anim="fadeIn">Unsere Leistungen</p>
      <h1 data-anim="fadeIn" data-anim-delay="100">Ihr Malerbetrieb für Ludwigsburg, Marbach und Bietigheim-Bissingen</h1>
      <p class="ls-sub" data-anim="fadeIn" data-anim-delay="200">
        Meisterbetrieb aus Freiberg am Neckar für Ludwigsburg, Marbach, Bietigheim-Bissingen und Stuttgart.
      </p>
      <span class="ls-progress" aria-hidden="true"><i data-ls-fill></i></span>
    </div>

    <div class="ls-grid" data-ls-grid>
      {items.map((it, i) => (
        <a href={href(it.href)} class="ls-card" data-anim="fadeIn" data-anim-delay={100 + (i % 2) * 150}>
          <div class="ls-img">
            <div data-grow="left" data-anim-delay={350 + (i % 2) * 150}>
              <Picture
                formats={['avif']}
                fallbackFormat="webp"
                src={it.img}
                alt={it.alt}
                widths={[350, 477, 700, 954]}
                sizes="(min-width: 1025px) 38vw, (min-width: 768px) 45vw, calc(100vw - 40px)"
                loading="lazy"
              />
            </div>
            <span class="ls-zoom" aria-hidden="true">
              <svg class="ls-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="miter" aria-hidden="true" focusable="false"><path d="M20 13.5V21H3V4h7.5"/><path d="M14 3h7v7"/><path d="M21 3 11 13"/></svg>
            </span>
          </div>
          <div class="ls-text">
            <h2>{it.title}<span>{it.sub}</span></h2>
            <svg class="ls-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="miter" aria-hidden="true" focusable="false"><path d="M20 13.5V21H3V4h7.5"/><path d="M14 3h7v7"/><path d="M21 3 11 13"/></svg>
          </div>
        </a>
      ))}

      <div class="ls-card ls-card--logo" data-anim="fadeIn" data-anim-delay="250">
        <Picture formats={['avif']} fallbackFormat="webp" src={logo} alt="Meisterwerke Exklusive by Baldassarre Fortino" widths={[228, 456]} sizes="240px" loading="lazy" />
        <div class="ls-body">
          <h2>Fugenlose Bäder und Böden, Spachteltechniken und Stuckleisten</h2>
          <p>Unsere Spezialleistungen als Meisterbetrieb. Im Showroom in Freiberg am Neckar sehen Sie die Oberflächen persönlich.</p>
        </div>
        <Button href={href('/meisterwerk-exklusive/')}>Zu Meisterwerk Exklusive ↗</Button>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from '../../scripts/motion';

  // Die Linie unter dem Text füllt sich, während die Karten durchlaufen (wie auf der Startseite)
  const grid = document.querySelector<HTMLElement>('[data-ls-grid]');
  const fill = document.querySelector<HTMLElement>('[data-ls-fill]');
  if (grid && fill && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    gsap.fromTo(
      fill,
      { scaleX: 0.1 },
      {
        scaleX: 1,
        ease: 'none',
        scrollTrigger: { trigger: grid, start: 'top 60%', end: 'bottom 75%', scrub: 0.6 },
      },
    );
  }
</script>

<style>
  .ls {
    --ink: #090402;
    --hair: #0904021f;
    padding: 56px 20px 64px;
    background: var(--color-soft);
    color: var(--ink);
  }
  .ls-inner {
    display: grid;
    gap: 32px;
    max-width: var(--container-page);
    margin: 0 auto;
  }
  .ls-eyebrow {
    margin: 0;
    font-family: var(--font-urbanist), sans-serif;
    font-size: 12px;
    line-height: 1.5;
    font-weight: 500;
    letter-spacing: 2px;
    text-transform: uppercase;
  }
  .ls-heading h1 {
    margin: 36px 0 24px;
    color: var(--color-gold);
    font-family: var(--font-urbanist), sans-serif;
    font-size: clamp(28px, 3.2vw, 40px);
    line-height: 1.25;
    font-weight: 500;
    text-wrap: balance;
  }
  .ls-sub {
    margin: 0;
    color: var(--color-muted);
    font-size: 15px;
    line-height: 1.5;
  }
  .ls-progress {
    display: block;
    width: 100px;
    height: 2px;
    margin-top: 40px;
    background: #09040226;
  }
  .ls-progress i {
    display: block;
    width: 100%;
    height: 100%;
    background: var(--color-gold);
    transform-origin: 0 50%;
    transform: scaleX(0.1);
  }

  .ls-grid {
    display: grid;
    gap: 20px;
  }
  .ls-card {
    position: relative;
    display: flex;
    flex-direction: column;
    border: 1px solid var(--hair);
    background: #fff;
    color: var(--ink);
    text-decoration: none;
  }
  .ls-img {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 3;
  }
  .ls-img :global(picture),
  .ls-img :global(img),
  .ls-img > div {
    display: block;
    width: 100%;
    height: 100%;
  }
  .ls-img :global(img) {
    object-fit: cover;
    transition:
      transform 0.45s ease-in-out,
      opacity 0.45s ease-in-out;
  }
  .ls-img:hover :global(img) {
    transform: scale(1.05);
    opacity: 0.8;
  }
  .ls-zoom {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 70px;
    height: 70px;
    border-radius: 50%;
    background: #000000b3;
    color: #fff;
    opacity: 0;
    transform: translate(-50%, -50%);
    pointer-events: none;
    transition: opacity 0.3s ease;
  }
  .ls-img:hover .ls-zoom {
    opacity: 1;
  }
  .ls-zoom .ls-icon {
    width: 28px;
    height: 28px;
    margin: 0;
  }
  .ls-text {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 20px;
    padding: 22px 24px 26px;
  }
  .ls-text h2,
  .ls-card--logo h2 {
    margin: 0;
    font-family: var(--font-urbanist), sans-serif;
    font-size: 20px;
    line-height: 1.3;
    font-weight: 500;
  }
  .ls-text h2 span {
    display: block;
    min-height: 2.8em;
    margin-top: 4px;
    color: #090402b3;
    font-size: 15px;
    line-height: 1.4;
    font-weight: 400;
  }
  .ls-icon {
    display: block;
    flex: none;
    width: 20px;
    height: 20px;
    margin-top: 5px;
  }
  .ls-card--logo {
    justify-content: space-between;
    gap: 22px;
    padding: 24px 20px;
  }
  .ls-card--logo :global(img) {
    display: block;
    width: 240px;
    max-width: 100%;
    height: auto;
  }
  .ls-body p {
    margin: 10px 0 0;
    color: var(--color-muted);
    font-size: 15px;
    line-height: 1.5;
  }

  @media (min-width: 768px) {
    .ls {
      padding: 72px 20px 80px;
    }
    .ls-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .ls-text h2,
    .ls-card--logo h2 {
      font-size: 24px;
    }
    .ls-text h2 span {
      font-size: 16px;
    }
  }
  @media (min-width: 1025px) {
    .ls {
      padding: 12vh 30px;
    }
    .ls-inner {
      grid-template-columns: minmax(0, 0.34fr) minmax(0, 0.66fr);
      gap: 0 6vw;
      align-items: start;
    }
    .ls-heading {
      position: sticky;
      top: 22vh;
    }
    .ls-card--logo {
      padding: 35px;
    }
  }
</style>
