---
import { href } from '../../data/links';
import { items, exklusiveItems, type Item, type Site } from '../../data/nav';
/**
 * Menü-Variante 1 „Liste“ (Vorlage: Menü der Referenzseite „Kaisergärten“): Vollbild, fährt von oben herein,
 * die Einträge blenden gestaffelt ein. Schrift deutlich kleiner als in der Vorlage, keine Nummerierung. Einträge mit Untermenü klappen
 * als Akkordeon auf (Unterpunkte einzeilig, Unterebene mit Zwischenüberschrift). Skript unten.
 */
interface Props {
  site?: Site;
  /** Pfad der aktuellen Seite, markiert den aktiven Eintrag */
  current?: string;
}
const { site = 'main', current = '/' } = Astro.props;
const exk = site === 'exklusive';
const menu: Item[] = exk ? exklusiveItems : items;

const row =
  'flex w-full cursor-pointer items-center justify-center gap-3 border-b border-black/10 px-10 py-3.5 font-display text-[26px]/[1.15] font-normal tracking-[-0.02em] text-ink transition-colors duration-300 hover:text-gold aria-[current=page]:text-gold min-[701px]:py-4 min-[701px]:text-[clamp(28px,2.6vw,38px)]';
const sub =
  'font-display text-[16px]/[1.3] tracking-[-0.01em] text-ink transition-colors duration-300 hover:text-gold aria-[current=page]:text-gold min-[701px]:text-[18px]';
---

<dialog
  data-menu-dialog
  data-variant="1"
  data-menu-from="top"
  id="main-menu-1"
  aria-label="Hauptmenü"
  class="m-0 hidden h-[calc(100dvh-20px)] max-h-none w-[calc(100%-20px)] max-w-none overflow-y-auto border-0 bg-soft p-4.5 text-ink open:block min-[701px]:h-[calc(100dvh-48px)] min-[701px]:w-[calc(100%-48px)] min-[701px]:px-10 min-[701px]:py-7 fixed inset-2.5 min-[701px]:inset-6 backdrop:bg-ink/50 backdrop:backdrop-blur-xs"
>
  <div class="flex items-center justify-between gap-6 font-display text-[10px] tracking-[0.09em] uppercase">
    <span>
      {exk ? 'Meisterwerke Exklusive' : 'Meisterwerk Malermanufaktur'}
      <span class="hidden min-[701px]:inline"> / Menü</span>
    </span>
    <button
      type="button"
      data-menu-close
      class="group/close flex cursor-pointer items-center gap-4 uppercase"
    >
      Schließen
      <span
        aria-hidden="true"
        class="text-[30px] leading-none font-light transition-transform duration-300 group-hover/close:rotate-90"
      >
        ×
      </span>
    </button>
  </div>

  <nav aria-label="Hauptmenü" class="mx-auto my-8 max-w-[960px] min-[701px]:my-10">
    <ul
      data-accordion
      data-accordion-exclusive
      data-accordion-ease="power1.inOut"
      class="border-t border-black/10"
    >
      {menu.map((item, i) => {
        const flat = (item.children ?? []).filter((c) => !c.children);
        const groups = (item.children ?? []).filter((c) => c.children);
        return (
          <li data-menu-item>
            {item.children ? (
              <>
                <button
                  type="button"
                  aria-expanded="false"
                  aria-controls={`menu-sub-${i}`}
                  aria-current={
                    current.startsWith(item.href) && item.href !== '/' ? 'page' : undefined
                  }
                  class={`group/acc ${row}`}
                >
                  {item.label}
                  <svg
                    viewBox="0 0 12 8"
                    aria-hidden="true"
                    class="size-3 shrink-0 transition-transform duration-300 group-aria-expanded/acc:rotate-180"
                  >
                    <path
                      d="M1 1.5 6 6.5l5-5"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.2"
                    />
                  </svg>
                </button>
                <div id={`menu-sub-${i}`} hidden class="border-b border-black/10 px-10 py-5">
                  <ul class="flex flex-wrap justify-center gap-x-8 gap-y-3">
                    <li>
                      <a href={href(item.href)} class={sub}>
                        Übersicht
                      </a>
                    </li>
                    {flat.map((child) => (
                      <li>
                        <a
                          href={href(child.href)}
                          aria-current={current === child.href ? 'page' : undefined}
                          class={sub}
                        >
                          {child.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                  {groups.map((group) => (
                    <div class="mt-5 border-t border-black/10 pt-4 text-center">
                      <a
                        href={href(group.href)}
                        class="font-display text-[11px] tracking-[0.12em] text-gold uppercase transition-colors duration-300 hover:text-ink"
                      >
                        {group.label}
                      </a>
                      <ul class="mt-3 flex flex-wrap justify-center gap-x-8 gap-y-3">
                        {group.children!.map((child) => (
                          <li>
                            <a
                              href={href(child.href)}
                              aria-current={current === child.href ? 'page' : undefined}
                              class={sub}
                            >
                              {child.label}
                            </a>
                          </li>
                        ))}
                      </ul>
                    </div>
                  ))}
                </div>
              </>
            ) : (
              <a
                href={href(item.href)}
                aria-current={current === item.href ? 'page' : undefined}
                class={row}
              >
                {item.label}
              </a>
            )}
          </li>
        );
      })}
    </ul>
  </nav>

  <div class="flex flex-col justify-between gap-3 font-display text-[10px] tracking-[0.06em] uppercase min-[701px]:flex-row">
    <span>Freiberg a. N. / Ludwigsburg</span>
    <span>Maler seit über 22 Jahren.</span>
  </div>
</dialog>
