---
import { href } from '../../data/links';
import { items, exklusiveItems, type Item, type Site } from '../../data/nav';
import Kontakt from './Kontakt.astro';
/**
 * Menü-Variante 2 „Geteilt“: Vollbild, links die Hauptpunkte linksbündig, rechts erscheint beim Überfahren oder
 * Anwählen eines Punkts sein Untermenü, sonst der Kontaktblock. Am Handy ersetzt das Untermenü die Liste
 * (mit „Zurück“). Skript in Menu.astro.
 */
interface Props {
  site?: Site;
  current?: string;
}
const { site = 'main', current = '/' } = Astro.props;
const exk = site === 'exklusive';
const menu: Item[] = exk ? exklusiveItems : items;

const row =
  'group/row flex w-full cursor-pointer items-center justify-between gap-4 border-b border-black/10 py-3.5 text-left font-display text-[26px]/[1.15] font-normal tracking-[-0.02em] text-ink transition-[color,padding] duration-300 hover:pl-2 hover:text-gold aria-[current=page]:text-gold data-[active]:pl-2 data-[active]:text-gold min-[701px]:py-4 min-[701px]:text-[clamp(28px,2.6vw,38px)]';
const arrow =
  'text-[18px] opacity-0 transition-[opacity,transform] duration-300 group-hover/row:translate-x-1 group-hover/row:opacity-100 group-data-[active]/row:opacity-100 max-[700px]:opacity-100';
const sub =
  'font-display text-[18px]/[1.3] tracking-[-0.01em] text-ink transition-colors duration-300 hover:text-gold aria-[current=page]:text-gold min-[701px]:text-[20px]';
---

<dialog
  data-menu-dialog
  data-variant="2"
  data-menu-from="top"
  id="main-menu-2"
  aria-label="Hauptmenü"
  class="group/dlg fixed inset-2.5 m-0 hidden h-[calc(100dvh-20px)] max-h-none w-[calc(100%-20px)] max-w-none overflow-y-auto border-0 bg-soft p-4.5 text-ink backdrop:bg-ink/50 backdrop:backdrop-blur-xs open:block min-[701px]:inset-6 min-[701px]:h-[calc(100dvh-48px)] min-[701px]:w-[calc(100%-48px)] min-[701px]:px-10 min-[701px]:py-7"
>
  <div class="flex items-center justify-between gap-6 font-display text-[10px] tracking-[0.09em] uppercase">
    <span>{exk ? 'Meisterwerke Exklusive' : 'Meisterwerk Malermanufaktur'}</span>
    <button
      type="button"
      data-menu-close
      class="group/close flex cursor-pointer items-center gap-4 uppercase"
    >
      Schließen
      <span
        aria-hidden="true"
        class="text-[30px] leading-none font-light transition-transform duration-300 group-hover/close:rotate-90"
      >
        ×
      </span>
    </button>
  </div>

  <div
    data-split
    class="mx-auto mt-8 grid max-w-[1200px] gap-10 min-[701px]:mt-14 min-[701px]:grid-cols-[1.1fr_1fr] min-[701px]:gap-20"
  >
    <nav aria-label="Hauptmenü" data-split-list class="group-data-[drill]/dlg:max-[700px]:hidden">
      <ul class="border-t border-black/10">
        {menu.map((item, i) => (
          <li data-menu-item>
            {item.children ? (
              <button
                type="button"
                data-split-target={`sub-${i}`}
                aria-current={
                  current.startsWith(item.href) && item.href !== '/' ? 'page' : undefined
                }
                class={row}
              >
                {item.label}
                <span aria-hidden="true" class={arrow}>
                  →
                </span>
              </button>
            ) : (
              <a
                href={href(item.href)}
                data-split-target="contact"
                aria-current={current === item.href ? 'page' : undefined}
                class={row}
              >
                {item.label}
                <span aria-hidden="true" class={arrow}>
                  ↗
                </span>
              </a>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <div class="relative min-[701px]:border-l min-[701px]:border-black/10 min-[701px]:pl-20">
      <div data-split-panel="contact" class="group-data-[drill]/dlg:max-[700px]:hidden">
        <Kontakt {site} />
      </div>
      {menu.map(
        (item, i) =>
          item.children && (
            <div data-split-panel={`sub-${i}`} hidden>
              <button
                type="button"
                data-split-back
                class="mb-6 flex cursor-pointer items-center gap-2 font-display text-[11px] tracking-[0.1em] uppercase min-[701px]:hidden"
              >
                ← Zurück
              </button>
              <p class="mb-5 font-display text-[11px] tracking-[0.12em] text-gold uppercase">
                {item.label}
              </p>
              <ul class="flex flex-col gap-3.5">
                <li>
                  <a href={href(item.href)} class={sub}>
                    Übersicht
                  </a>
                </li>
                {item.children
                  .filter((c) => !c.children)
                  .map((child) => (
                    <li>
                      <a
                        href={href(child.href)}
                        aria-current={current === child.href ? 'page' : undefined}
                        class={sub}
                      >
                        {child.label}
                      </a>
                    </li>
                  ))}
              </ul>
              {item.children
                .filter((c) => c.children)
                .map((group) => (
                  <div class="mt-7 border-t border-black/10 pt-5">
                    <a
                      href={href(group.href)}
                      class="font-display text-[11px] tracking-[0.12em] text-gold uppercase transition-colors duration-300 hover:text-ink"
                    >
                      {group.label}
                    </a>
                    <ul class="mt-4 flex flex-col gap-3.5">
                      {group.children!.map((child) => (
                        <li>
                          <a
                            href={href(child.href)}
                            aria-current={current === child.href ? 'page' : undefined}
                            class={sub}
                          >
                            {child.label}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                ))}
            </div>
          ),
      )}
    </div>
  </div>
</dialog>
