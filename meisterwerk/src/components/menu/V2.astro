---
import { href } from '../../data/links';
import { items, exklusiveItems, type Item, type Site } from '../../data/nav';
import KontaktPanel from './KontaktPanel.astro';
import Badge from '../footer/Badge.astro';
/**
 * Menü für Tablet und Desktop (ab 701 px) „Geteilt“: Fenster mit der Rundung der Buttons (28 px), links die Hauptpunkte linksbündig ohne Trennlinien
 * und senkrecht mittig im Fenster (`pb-[78px]` gleicht die Kopfzeile des Fensters aus)
 * (daneben, ab 1100 px, bzw. darunter das Bewertungs-Badge aus dem Fuß, nur Hauptseite),
 * rechts stehen Kontaktmöglichkeiten mit kurzem Formular; nur bei Punkten mit Untermenü (Leistungen) blendet dessen
 * Liste dort ein und beim Verlassen wieder aus. Skript in Menu.astro.
 */
interface Props {
  site?: Site;
  current?: string;
}
const { site = 'main', current = '/' } = Astro.props;
const exk = site === 'exklusive';
const menu: Item[] = exk ? exklusiveItems : items;
// Panel-Kennung je Menüpunkt: Untermenü bei Leistungen und Oberflächen, sonst der Kontaktbereich
const panelOf = (item: Item, i: number) => (item.children ? `sub-${i}` : 'contact');

const row =
  'flex w-full cursor-pointer items-center justify-between gap-4 py-2 text-left font-display text-h3 font-normal tracking-[-0.02em] text-ink transition-colors duration-300 hover:text-gold aria-[current=page]:text-gold data-[active]:text-gold';
// Rechte Seite: alle Flächen liegen übereinander (die Höhe bleibt gleich), die gewählte blendet ein, die vorige gleichzeitig aus. Nur Deckkraft, keine Bewegung
const panel =
  'pointer-events-none invisible col-start-1 row-start-1 opacity-0 transition-[opacity,visibility] duration-500 ease-in-out data-[show]:pointer-events-auto data-[show]:visible data-[show]:opacity-100';
const sub =
  'font-display text-h4 tracking-[-0.01em] text-ink transition-colors duration-300 hover:text-gold aria-[current=page]:text-gold';
---

<dialog
  data-menu-dialog
  data-variant="2"
  data-menu-from="top"
  id="main-menu-2"
  aria-label="Hauptmenü"
  class="fixed inset-2.5 m-0 hidden h-[calc(100dvh-20px)] max-h-none w-[calc(100%-20px)] max-w-none overflow-y-auto overscroll-contain rounded-[24px] border-0 bg-soft p-4.5 text-ink backdrop:bg-ink/50 backdrop:opacity-[var(--bd,1)] backdrop:backdrop-blur-xs open:flex open:flex-col min-[701px]:inset-6 min-[701px]:h-[calc(100dvh-48px)] min-[701px]:w-[calc(100%-48px)] min-[701px]:px-10 min-[701px]:py-7"
>
  <div class="flex items-center justify-between gap-6 font-display text-label tracking-[0.09em] uppercase">
    <span>{exk ? 'Meisterwerke Exklusive' : 'Meisterwerk Malermanufaktur'}</span>
    <button
      type="button"
      data-menu-close
      class="group/close flex cursor-pointer items-center gap-4 uppercase"
    >
      Schließen
      <span
        aria-hidden="true"
        class="text-[30px] leading-none font-light transition-transform duration-300 group-hover/close:rotate-90"
      >
        ×
      </span>
    </button>
  </div>

  <div data-split class="mt-8 grid grow items-stretch min-[701px]:mt-12 min-[701px]:grid-cols-2">
    <nav
      aria-label="Hauptmenü"
      data-split-list
      class="flex flex-col justify-center gap-8 min-[701px]:pr-[clamp(32px,5vw,96px)] min-[701px]:pb-[78px] min-[1100px]:flex-row min-[1100px]:items-center"
    >
      <ul class="flex min-w-0 flex-col gap-1 min-[1100px]:flex-1">
        {menu.map((item, i) => (
          <li data-menu-item>
            {item.children ? (
              <button
                type="button"
                data-split-target={panelOf(item, i)}
                aria-current={
                  current.startsWith(item.href) && item.href !== '/' ? 'page' : undefined
                }
                class={row}
              >
                {item.label}
              </button>
            ) : (
              <a
                href={href(item.href)}
                data-split-target={panelOf(item, i)}
                aria-current={current === item.href ? 'page' : undefined}
                class={row}
              >
                {item.label}
              </a>
            )}
          </li>
        ))}
      </ul>
      {!exk && <Badge class="shrink-0 self-start min-[1100px]:self-center" />}
    </nav>

    <div class="grid content-start items-start min-[701px]:border-l min-[701px]:border-black/10 min-[701px]:pb-6 min-[701px]:pl-[clamp(32px,5vw,96px)]">
      <div data-split-panel="contact" data-show class={panel}>
        <KontaktPanel {site} />
      </div>
      {menu.map((item, i) =>
        item.children ? (
          <div data-split-panel={`sub-${i}`} class={panel}>
            <p class="mb-5 font-display text-label tracking-[0.12em] text-gold uppercase">
              {item.label}
            </p>
            <ul class="flex flex-col gap-3.5">
              {item.href !== '#' && (
                <li>
                  <a href={href(item.href)} class={sub}>
                    Übersicht
                  </a>
                </li>
              )}
              {item.children
                .filter((c) => !c.children)
                .map((child) => (
                  <li>
                    <a
                      href={href(child.href)}
                      aria-current={current === child.href ? 'page' : undefined}
                      class={sub}
                    >
                      {child.label}
                    </a>
                  </li>
                ))}
            </ul>
            {item.children
              .filter((c) => c.children)
              .map((group) => (
                <div class="mt-9">
                  <a
                    href={href(group.href)}
                    class="font-display text-label tracking-[0.12em] text-gold uppercase transition-colors duration-300 hover:text-ink"
                  >
                    {group.label}
                  </a>
                  <ul class="mt-4 flex flex-col gap-3.5">
                    {group.children!.map((child) => (
                      <li>
                        <a
                          href={href(child.href)}
                          aria-current={current === child.href ? 'page' : undefined}
                          class={sub}
                        >
                          {child.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
          </div>
        ) : null,
      )}
    </div>
  </div>
</dialog>
