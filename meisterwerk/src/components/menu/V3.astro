---
import { href } from '../../data/links';
import { items, exklusiveItems, type Item, type Site } from '../../data/nav';
import Kontakt from './Kontakt.astro';
import Badge from '../footer/Badge.astro';
/**
 * Menü-Variante 3 „Seitenfläche“: schmale Fläche mit der Rundung der Buttons (24 px) und 10 px Rand, die von rechts hereinfährt (die Seite dahinter bleibt sichtbar,
 * abgedunkelt). Linksbündige Liste, Untermenüs als Akkordeon mit goldener Linie, darunter das Bewertungs-Badge aus dem Fuß
 * (nur Hauptseite), unten der Kontaktblock.
 */
interface Props {
  site?: Site;
  current?: string;
}
const { site = 'main', current = '/' } = Astro.props;
const exk = site === 'exklusive';
const menu: Item[] = exk ? exklusiveItems : items;

const row =
  'group/acc flex w-full cursor-pointer items-center justify-between gap-4 py-3 text-left font-display text-h3 font-normal max-[700px]:py-[clamp(4px,calc(1.8dvh-4px),14px)] max-[700px]:text-[clamp(17px,2.8dvh,22px)]/[1.2] tracking-[-0.02em] text-ink transition-colors duration-300 hover:text-gold aria-[current=page]:text-gold';
// Hauptliste und Untermenü-Ansichten liegen übereinander, die gewählte blendet ein, die andere aus
const view =
  'col-start-1 row-start-1 transition-[opacity,translate,visibility] duration-500 ease-in-out motion-reduce:transition-none data-[off]:pointer-events-none data-[off]:invisible data-[off]:opacity-0';
// Untermenü: große Zeilen wie die Hauptpunkte, Platz ist da, weil nur diese Ansicht sichtbar ist
const subRow =
  'block py-[clamp(7px,1.5dvh,12px)] font-display text-[clamp(19px,3dvh,24px)] leading-[1.2] font-normal tracking-[-0.01em] text-ink transition-colors duration-300 hover:text-gold aria-[current=page]:text-gold';
const sub =
  'block font-display text-body tracking-[-0.01em] max-[700px]:text-[clamp(12.5px,1.8dvh,14px)] max-[700px]:leading-[1.25] text-ink transition-colors duration-300 hover:text-gold aria-[current=page]:text-gold';
---

<dialog
  data-menu-dialog
  data-variant="3"
  data-menu-from="right"
  id="main-menu-3"
  aria-label="Hauptmenü"
  class="fixed inset-y-2.5 right-2.5 left-auto m-0 hidden h-[calc(100dvh-20px)] max-h-none w-[min(460px,calc(100%-20px))] max-w-none overflow-y-auto overscroll-contain rounded-[24px] border-0 bg-soft px-6 py-[clamp(12px,2.2dvh,20px)] text-ink shadow-[-12px_0_40px_rgb(0_0_0/0.12)] backdrop:bg-ink/50 backdrop:opacity-[var(--bd,1)] backdrop:backdrop-blur-xs group/m open:grid open:grid-cols-[auto_minmax(0,1fr)] open:grid-rows-[auto_minmax(0,1fr)_auto] open:gap-x-3.5 min-[701px]:px-9 min-[701px]:py-7"
>
  <div class="col-span-2 flex items-center justify-between gap-6 font-display text-label tracking-[0.09em] uppercase">
    <span>Menü</span>
    <button
      type="button"
      data-menu-close
      class="group/close flex cursor-pointer items-center gap-4 uppercase"
    >
      Schließen
      <span
        aria-hidden="true"
        class="text-[30px] leading-none font-light transition-transform duration-300 group-hover/close:rotate-90"
      >
        ×
      </span>
    </button>
  </div>

  <nav
    aria-label="Hauptmenü"
    data-drill
    class="col-span-2 my-[clamp(6px,1.6dvh,16px)] grid min-h-0 grow grid-cols-1 content-start"
  >
    <!-- Hauptliste: Ein Punkt mit Untermenü öffnet dessen Ansicht (Hauptliste, Siegel und Kontakt treten zurück), „Zurück“ führt wieder hierher -->
    <ul data-drill-main class={`${view} data-[off]:-translate-x-6`}>
      {menu.map((item, i) => (
        <li data-menu-item>
          {item.children ? (
            <button
              type="button"
              data-drill-open={i}
              aria-expanded="false"
              aria-controls={`menu3-sub-${i}`}
              aria-current={
                current.startsWith(item.href) && item.href !== '/' ? 'page' : undefined
              }
              class={row}
            >
              {item.label}
              <svg viewBox="0 0 8 12" aria-hidden="true" class="size-3 shrink-0 opacity-60">
                <path d="m1.5 1 5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.2" />
              </svg>
            </button>
          ) : (
            <a
              href={href(item.href)}
              aria-current={current === item.href ? 'page' : undefined}
              class={row}
            >
              {item.back && (
                <svg viewBox="0 0 12 8" aria-hidden="true" class="mr-3 size-3 shrink-0 rotate-90 opacity-60">
                  <path d="M1 1.5 6 6.5l5-5" fill="none" stroke="currentColor" stroke-width="1.2" />
                </svg>
              )}
              <span class="grow">{item.label}</span>
            </a>
          )}
        </li>
      ))}
    </ul>

    {menu.map((item, i) =>
      item.children ? (
        <div id={`menu3-sub-${i}`} data-drill-panel={i} data-off inert class={`${view} data-[off]:translate-x-6`}>
          <button
            type="button"
            data-drill-back
            class="group/back flex cursor-pointer items-center gap-3 py-2 font-display text-label tracking-[0.09em] uppercase"
          >
            <span class="grid size-9 place-items-center rounded-full bg-white transition-colors duration-300 group-hover/back:bg-gold group-hover/back:text-white">
              <svg viewBox="0 0 16 16" aria-hidden="true" class="size-4" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M14 8H3" /><path d="m7 4-4 4 4 4" /></svg>
            </span>
            Zurück
          </button>
          <p class="mt-[clamp(10px,2.4dvh,22px)] font-display text-label tracking-[0.12em] text-gold uppercase">{item.label}</p>
          <ul class="mt-[clamp(4px,1dvh,10px)]">
            <li>
              <a href={href(item.href)} class={subRow}>Übersicht</a>
            </li>
            {item.children
              .filter((c) => !c.children)
              .map((child) => (
                <li>
                  <a href={href(child.href)} aria-current={current === child.href ? 'page' : undefined} class={subRow}>
                    {child.label}
                  </a>
                </li>
              ))}
          </ul>
          {item.children
            .filter((c) => c.children)
            .map((group) => (
              <div class="mt-[clamp(10px,2.4dvh,22px)]">
                <a
                  href={href(group.href)}
                  class="font-display text-label tracking-[0.12em] text-gold uppercase transition-colors duration-300 hover:text-ink"
                >
                  {group.label}
                </a>
                <ul class="mt-[clamp(2px,0.8dvh,8px)]">
                  {group.children!.map((child) => (
                    <li>
                      <a href={href(child.href)} aria-current={current === child.href ? 'page' : undefined} class={subRow}>
                        {child.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
        </div>
      ) : null,
    )}
  </nav>

  {!exk && <Badge class="col-start-1 row-start-3 [zoom:.62] max-[700px]:self-end group-has-[nav_button[aria-expanded=true]]/m:hidden [@media(max-height:640px)]:hidden" />}

  <Kontakt {site} class="col-start-2 row-start-3 min-w-0 self-end group-has-[nav_button[aria-expanded=true]]/m:hidden [@media(max-height:640px)]:col-span-2 [@media(max-height:640px)]:col-start-1" />
</dialog>
