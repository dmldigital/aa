---
import Button from '../ui/Button.astro';
import { site as company } from '../../data/site';
/**
 * Rechte Seite des Desktop-Menüs (Standard): Überschrift, Kontaktdaten und ein kurzes Formular auf weißer Fläche.
 * Das Absenden ist wie beim Kontaktformular noch nicht angebunden (Meldung, Skript in Menu.astro).
 */
const label = 'font-display text-label tracking-[0.12em] text-gold uppercase';
const value = 'group/ul inline-block font-display text-body tracking-[0.01em] text-ink';
const soc = 'group/soc inline-flex items-center gap-2.5 transition-colors duration-300 hover:text-gold';
const socIcon =
  'grid size-9 shrink-0 place-items-center rounded-full bg-white text-ink transition-colors duration-300 group-hover/soc:bg-gold group-hover/soc:text-white';
const field =
  'field w-full py-2.5 font-display text-body text-ink placeholder:text-black/40';
---

<div class="flex flex-col gap-9">
  <div class="flex flex-col gap-3">
    <p class={label}>Kontakt</p>
    <p class="font-display text-h3 font-normal text-ink">
      Wie können wir Ihnen helfen?
    </p>
  </div>

  <dl class="grid gap-y-5 lg:grid-cols-2 lg:gap-x-8">
    <div class="flex flex-col gap-1.5">
      <dt class="font-display text-small text-muted">Telefon</dt>
      <dd>
        <a href={`tel:${company.phoneHref}`} class={value}>
          {company.phone}
        </a>
      </dd>
      <dd>
        <a href={company.whatsappHref} target="_blank" rel="noopener noreferrer" class={value}>
          WhatsApp schreiben
        </a>
      </dd>
    </div>
    <div class="flex flex-col gap-1.5">
      <dt class="font-display text-small text-muted">E-Mail</dt>
      <dd>
        <a href={`mailto:${company.email}`} class={value}>
          {company.email}
        </a>
      </dd>
    </div>
    <div class="flex flex-col gap-1.5">
      <dt class="font-display text-small text-muted">Showroom</dt>
      <dd>
        <a
          href={company.mapsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="font-display text-body text-ink transition-colors duration-300 hover:text-gold"
        >
          {company.street}, {company.postalCode} {company.city}
        </a>
      </dd>
    </div>
    {/* Social: rundes Symbol plus Name, auf Hauptseite und Exklusive (Kundenwunsch vom 10.11.: Symbole, damit man die Profile sofort findet) */}
    <div class="flex flex-col gap-1.5">
      <dt class="font-display text-small text-muted">Folgen Sie uns</dt>
      <dd class="flex flex-wrap gap-x-6 gap-y-2 font-display text-body text-ink">
        <a href={company.social.instagram} target="_blank" rel="noopener noreferrer" class={soc}>
          <span class={socIcon}>
            <svg viewBox="0 0 448 512" fill="currentColor" aria-hidden="true" class="block h-4 w-3.5"><path d="M224.1 141c-63.6 0-114.9 51.3-114.9 114.9s51.3 114.9 114.9 114.9S339 319.5 339 255.9 287.7 141 224.1 141zm0 189.6c-41.1 0-74.7-33.5-74.7-74.7s33.5-74.7 74.7-74.7 74.7 33.5 74.7 74.7-33.6 74.7-74.7 74.7zm146.4-194.3c0 14.9-12 26.8-26.8 26.8-14.9 0-26.8-12-26.8-26.8s12-26.8 26.8-26.8 26.8 12 26.8 26.8zm76.1 27.2c-1.7-35.9-9.9-67.7-36.2-93.9-26.2-26.2-58-34.4-93.9-36.2-37-2.1-147.9-2.1-184.9 0-35.8 1.7-67.6 9.9-93.9 36.1s-34.4 58-36.2 93.9c-2.1 37-2.1 147.9 0 184.9 1.7 35.9 9.9 67.7 36.2 93.9s58 34.4 93.9 36.2c37 2.1 147.9 2.1 184.9 0 35.9-1.7 67.7-9.9 93.9-36.2 26.2-26.2 34.4-58 36.2-93.9 2.1-37 2.1-147.8 0-184.8zM398.8 388c-7.8 19.6-22.9 34.7-42.6 42.6-29.5 11.7-99.5 9-132.1 9s-102.7 2.6-132.1-9c-19.6-7.8-34.7-22.9-42.6-42.6-11.7-29.5-9-99.5-9-132.1s-2.6-102.7 9-132.1c7.8-19.6 22.9-34.7 42.6-42.6 29.5-11.7 99.5-9 132.1-9s102.7-2.6 132.1 9c19.6 7.8 34.7 22.9 42.6 42.6 11.7 29.5 9 99.5 9 132.1s2.7 102.7-9 132.1z" /></svg>
          </span>
          Instagram
        </a>
        <a href={company.social.facebook} target="_blank" rel="noopener noreferrer" class={soc}>
          <span class={socIcon}>
            <svg viewBox="0 0 320 512" fill="currentColor" aria-hidden="true" class="block h-4 w-2.5"><path d="M279.14 288l14.22-92.66h-88.91v-60.13c0-25.35 12.42-50.06 52.24-50.06h40.42V6.26S260.43 0 225.36 0c-73.22 0-121.08 44.38-121.08 124.72v70.62H22.89V288h81.39v224h100.17V288z" /></svg>
          </span>
          Facebook
        </a>
      </dd>
    </div>
  </dl>

  <form data-menu-form class="flex flex-col gap-5 bg-white p-7" aria-label="Kurze Nachricht">
    <p class="font-display text-h4 tracking-[-0.01em] text-ink">
      Oder schreiben Sie uns kurz
    </p>
    <div class="grid gap-x-6 lg:grid-cols-2">
      <input
        class={field}
        type="text"
        name="name"
        placeholder="Name"
        autocomplete="name"
        required
      />
      <input
        class={field}
        type="text"
        name="kontakt"
        placeholder="Telefon oder E-Mail"
        autocomplete="email"
        required
      />
    </div>
    <textarea
      class={`${field} min-h-16 resize-none`}
      name="nachricht"
      rows="2"
      placeholder="Ihre Nachricht"
      required
    ></textarea>
    <div class="flex items-center gap-5">
      <Button>
        Nachricht senden
      </Button>
      <p
        class="font-display text-small text-muted"
        role="status"
        aria-live="polite"
        data-form-message
        hidden
      >
        Das Formular wird in Kürze freigeschaltet. Bis dahin erreichen Sie uns gern telefonisch oder
        per E-Mail.
      </p>
    </div>
  </form>
</div>
