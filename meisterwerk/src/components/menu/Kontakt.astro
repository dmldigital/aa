---
import Button from '../ui/Button.astro';
import { href } from '../../data/links';
import { site as company } from '../../data/site';
import type { Site } from '../../data/nav';
/** Kontaktblock im Menü: Telefon, E-Mail, Adresse und Button „Projekt anfragen“. */
interface Props {
  site?: Site;
  class?: string;
}
const { site = 'main', class: className = '' } = Astro.props;
const link = 'group/ul inline-block font-display text-[15px]/[1.4] tracking-[0.02em] text-ink';
---

<div class:list={['flex flex-col items-start gap-3', className]}>
  <p class="font-display text-[11px] tracking-[0.12em] text-gold uppercase">Direkt anfragen</p>
  <a href={`tel:${company.phoneHref}`} class={link}>
    <span class="underline-anim [--underline-gap:3px]">{company.phone}</span>
  </a>
  <a href={`mailto:${company.email}`} class={link}>
    <span class="underline-anim [--underline-gap:3px]">{company.email}</span>
  </a>
  <p class="font-display text-[13px]/[1.4] tracking-[0.04em] text-muted uppercase">
    {company.street}, {company.postalCode} {company.city}
  </p>
  <div class="mt-2">
    <Button
      href={href(site === 'exklusive' ? '/meisterwerk-exklusive/kontakt/' : '/kontakt/')}
      size="sm"
    >
      PROJEKT ANFRAGEN
    </Button>
  </div>
</div>
