---
import Button from '../ui/Button.astro';
import { href } from '../../data/links';
import { site as company } from '../../data/site';
import type { Site } from '../../data/nav';
/** Kontaktblock im Menü: Telefon, WhatsApp, E-Mail, Adresse und Button „Projekt anfragen“. */
interface Props {
  site?: Site;
  class?: string;
}
const { site = 'main', class: className = '' } = Astro.props;
const link =
  'inline-block font-display text-body tracking-[0.02em] text-ink transition-colors duration-300 hover:text-gold max-sm:text-[14px]';
---

<div class:list={['flex flex-col items-start gap-3 max-sm:gap-1', className]}>
  <p class="font-display text-label tracking-[0.12em] text-gold uppercase">Direkt anfragen</p>
  <a href={`tel:${company.phoneHref}`} class={link}>
    {company.phone}
  </a>
  <a href={company.whatsappHref} target="_blank" rel="noopener noreferrer" class={link}>
    WhatsApp schreiben
  </a>
  <a href={`mailto:${company.email}`} class={link}>
    {company.email}
  </a>
  <p class="font-display text-label tracking-[0.04em] text-muted uppercase max-sm:text-[11px]/[1.35]">
    {company.street}, {company.postalCode} {company.city}
  </p>
  <div class="mt-2 max-sm:mt-1">
    <Button
      href={href(site === 'exklusive' ? '/meisterwerk-exklusive/kontakt/' : '/kontakt/')}
    >
      Projekt anfragen
    </Button>
  </div>
</div>
