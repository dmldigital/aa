---
/**
 * Zeitleiste für Handy und Tablet (bis 1024 px), auf „Über uns“ und den Teammitglieder-Seiten.
 * Ruhige Liste ohne Pin: jedes Jahr groß in Gold, der Text darunter, viel Luft dazwischen, keine Linien.
 * Beim Hereinscrollen steigen die Jahre nacheinander weich auf (scripts/timeline.ts, `initTimelinePin`).
 * Reduzierte Bewegung: alles steht sofort.
 */
interface Props {
  items: { date: string; text: string }[];
  title: string;
  class?: string;
}
const { items, title, class: className = '' } = Astro.props;
---

<div data-tlm class:list={['tlm', className]}>
  <h2 data-tlm-step class="m-0 font-display text-h3 font-medium text-ink" set:html={title} />
  <ol class="mt-8 flex list-none flex-col gap-9 p-0 md:mt-10 md:gap-11">
    {items.map((item) => (
      <li data-tlm-step>
        <span class="block font-display text-h2 font-medium text-gold">{item.date}</span>
        <p class="mt-2.5 mb-0 max-w-[36rem] text-body text-ink">{item.text}</p>
      </li>
    ))}
  </ol>
</div>

<script>
  import { initTimelinePin } from '../scripts/timeline';

  initTimelinePin();
</script>
