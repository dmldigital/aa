---
/**
 * Ablauf des Urlaubsservice: Überzeile und Überschrift, darunter die Schritte als gleich große Karten ohne Rahmen
 * (weiß auf hellgrauem Grund), nebeneinander ab Desktop, sonst untereinander. Keine Linie zwischen den Schritten und keine
 * Nummerierung. Die Schritte stehen als `<strong>Titel</strong><br />Text`.
 */
interface Props {
  label: string;
  heading: string;
  steps: string[];
}
const { label, heading, steps } = Astro.props;

const items = steps.map((s) => {
  const m = s.match(/^<strong>([\s\S]*?)<\/strong>\s*<br\s*\/?>\s*([\s\S]*)$/);
  return m ? { title: m[1].trim(), text: m[2].trim() } : { title: '', text: s };
});
---

<section data-section="ablauf" class="bg-soft px-page py-section">
  <div class="mx-auto flex w-full max-w-page flex-col gap-12">
    <div class="flex max-w-[65ch] flex-col gap-3">
      <p class="font-display text-label font-medium tracking-label text-ink uppercase" data-anim="fadeIn">{label}</p>
      <h2 class="font-display text-h2 text-balance text-gold" data-anim="fadeIn" data-anim-delay="100">{heading}</h2>
    </div>
    <ul class="grid gap-5 md:grid-cols-2 lg:grid-cols-4">
      {items.map((it, i) => (
        <li class="flex flex-col gap-4 bg-white p-6 md:p-8" data-anim="fadeInUp" data-anim-dur="fast" data-anim-delay={i * 100}>
          {it.title && <h3 class="font-display text-h4 text-ink" set:html={it.title} />}
          <p class="text-body text-muted" set:html={it.text} />
        </li>
      ))}
    </ul>
  </div>
</section>
