---
/**
 * Bilder einer Leistung als Karussell wie „Unsere Exklusive Projekte“ auf der Startseite: goldene Überschrift mit
 * „Unser Portfolio“, drei Bilder nebeneinander (Handy eins), goldene Pfeile außen, Punkte auf dem Handy, Endlosschleife,
 * Ziehen und Wischen. Bild beim Darüberfahren wie die Projektkarten (größer, heller, runder Kreis mit Plus). Ein Klick
 * öffnet das Bild groß, mit Pfeilen, Tastatur (Pfeiltasten, Esc) und Wischen als Galerie. Das Karussell steigt beim
 * Hereinscrollen als ganze Box auf.
 */
import { Picture, getImage } from 'astro:assets';
import ArrowLink from '../ui/ArrowLink.astro';
import Icon from '../Icon.astro';
import { href, routes } from '../../data/links';

interface Props {
  images: ImageMetadata[];
  alt: string;
  heading?: string;
}
const { images, alt, heading = 'Einblicke in unsere Arbeit' } = Astro.props;

const full = await Promise.all(images.map((src) => getImage({ src, width: 1800, format: 'webp' })));
// Endlosschleife: je ein Klon-Satz davor und dahinter, die echten Bilder stehen in der Mitte
const slides = [0, 1, 2].flatMap((set) =>
  images.map((src, i) => ({ src, i, full: full[i].src, clone: set !== 1 })),
);
---

{images.length > 0 && (
  <section
    data-sg
    class="flex flex-col overflow-x-clip px-5 mt-[10vh] mb-[12vh] md:mt-[8vh] md:mb-[10vh] lg:mt-[14vh] lg:mb-[20vh] lg:px-7.5"
  >
    <div class="mx-auto flex w-full max-w-page grow flex-col gap-3.75 lg:gap-5">
      <!-- Kopfzeile -->
      <div class="mb-1.25 flex items-center md:gap-5 lg:mb-5" data-anim="fadeIn">
        <div class="w-full md:mb-1.25 md:w-1/2 lg:mb-0">
          <h2 class="font-display text-[21px]/[26.25px] text-gold md:text-[24px]/[30px] lg:text-h3">{heading}</h2>
        </div>
        <div class="hidden justify-end md:flex md:w-1/2">
          <div>
            <ArrowLink href={href(routes.projects)} tone="gold">
              Unser Portfolio
            </ArrowLink>
          </div>
        </div>
      </div>

      <!-- Karussell -->
      <div class="relative" data-carousel aria-roledescription="carousel" aria-label={heading}>
        <div class="@container touch-pan-y overflow-hidden pb-1.25 md:pb-0" data-viewport data-box data-pend>
          <div
            class="flex gap-(--gap) [--gap:20px] [--n:1] [--step:calc((100cqw-(var(--n)-1)*var(--gap))/var(--n)+var(--gap))] md:[--n:3] lg:[--gap:30px]"
            style={`transform:translateX(calc(var(--step) * -${images.length}))`}
            data-track
          >
            {slides.map((s) => (
              <button
                type="button"
                class="group/card relative block aspect-[3/2] w-[calc(var(--step)-var(--gap))] shrink-0 cursor-pointer overflow-hidden"
                aria-roledescription="slide"
                aria-label={`${alt}, Bild ${s.i + 1} vergrößern`}
                aria-hidden={s.clone ? 'true' : undefined}
                tabindex={s.clone ? -1 : undefined}
                data-sg-item
                data-i={s.i}
                data-full={s.full}
                data-clone={s.clone ? '' : undefined}
              >
                <Picture
                  formats={['avif']}
                  fallbackFormat="webp"
                  src={s.src}
                  alt={alt}
                  widths={[350, 440, 880]}
                  sizes="(min-width: 1025px) 440px, (min-width: 768px) 315px, 350px"
                  loading="lazy"
                  draggable="false"
                  class="block size-full object-cover transition-transform duration-[450ms] ease-in-out group-hover/card:scale-110 group-hover/card:opacity-80"
                />
                <span
                  aria-hidden="true"
                  class="pointer-events-none absolute top-1/2 left-1/2 z-10 flex size-17.5 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full bg-black/70 text-[40px]/[22.5px] text-white opacity-0 transition-opacity duration-300 group-hover/card:opacity-100"
                >
                  +
                </span>
              </button>
            ))}
          </div>
        </div>

        <button
          type="button"
          aria-label="Voriges Bild"
          data-prev
          class="absolute top-[100.8px] left-[-60px] hidden size-11 cursor-pointer text-gold transition-colors duration-[250ms] hover:text-black/20 lg:block"
        >
          <Icon name="arrow-left" class="block shrink-0 size-11" />
        </button>
        <button
          type="button"
          aria-label="Nächstes Bild"
          data-next
          class="absolute top-[100.8px] right-[-60px] hidden size-11 cursor-pointer text-gold transition-colors duration-[250ms] hover:text-black/20 lg:block"
        >
          <Icon name="arrow-right" class="block shrink-0 size-11" />
        </button>
      </div>

      <!-- Nur Handy: Link unter dem Karussell mit Punkten -->
      <div class="relative md:hidden">
        <div class="text-[16px]/[24px]">
          <ArrowLink href={href(routes.projects)} tone="black">
            Unser Portfolio
          </ArrowLink>
        </div>
        <div class="absolute top-1/2 right-0 flex -translate-y-1/2" data-dots>
          {images.map((_, i) => (
            <button
              type="button"
              aria-label={`Bild ${i + 1}`}
              class="mx-1.25 size-1.25 cursor-pointer rounded-full bg-black opacity-20 data-[active]:opacity-100"
            />
          ))}
        </div>
      </div>
    </div>

    <div class="sg-lb" data-sg-lb hidden role="dialog" aria-modal="true" aria-label="Bildansicht">
      <button type="button" class="sg-lb-btn sg-lb-close" data-sg-close aria-label="Schließen">
        <Icon name="plus" class="size-5 rotate-45" />
      </button>
      <button type="button" class="sg-lb-btn sg-lb-prev" data-sg-prev aria-label="Voriges Bild">
        <Icon name="arrow-left" class="size-4" />
      </button>
      <button type="button" class="sg-lb-btn sg-lb-next" data-sg-next aria-label="Nächstes Bild">
        <Icon name="arrow-right" class="size-4" />
      </button>
      <figure class="sg-lb-fig"><img data-sg-img alt="" /></figure>
    </div>
  </section>
)}

<script>
  import { lenis } from '../../scripts/motion';
  import { initBoxReveal } from '../../scripts/reveal';
  import { initCarousel } from '../../scripts/carousel';

  const root = document.querySelector<HTMLElement>('[data-sg]');
  if (root) {
    initCarousel(root);
    initBoxReveal([...root.querySelectorAll<HTMLElement>('[data-box]')]);

    // Die Großansicht blättert nur durch die echten Bilder, die Klone der Schleife öffnen das Bild mit gleicher Nummer
    const items = [...root.querySelectorAll<HTMLElement>('[data-sg-item]:not([data-clone])')];
    const lb = root.querySelector<HTMLElement>('[data-sg-lb]')!;
    const img = lb.querySelector<HTMLImageElement>('[data-sg-img]')!;
    const closeBtn = lb.querySelector<HTMLElement>('[data-sg-close]')!;
    const prevBtn = lb.querySelector<HTMLElement>('[data-sg-prev]')!;
    const nextBtn = lb.querySelector<HTMLElement>('[data-sg-next]')!;
    let current = 0;
    let opener: HTMLElement | null = null;
    let closing: number | undefined;

    const show = (i: number) => {
      current = (i + items.length) % items.length;
      img.classList.remove('is-in');
      const next = new Image();
      next.onload = () => {
        img.src = next.src;
        requestAnimationFrame(() => img.classList.add('is-in'));
      };
      next.src = items[current].dataset.full!;
    };
    const open = (i: number) => {
      opener = document.activeElement as HTMLElement;
      window.clearTimeout(closing);
      lb.hidden = false;
      show(i);
      requestAnimationFrame(() => lb.classList.add('is-open'));
      lenis?.stop();
      document.documentElement.style.overflow = 'hidden';
      closeBtn.focus();
    };
    const close = () => {
      lb.classList.remove('is-open');
      closing = window.setTimeout(() => {
        lb.hidden = true;
        img.removeAttribute('src');
      }, 350);
      lenis?.start();
      document.documentElement.style.overflow = '';
      opener?.focus();
    };

    root.querySelectorAll<HTMLElement>('[data-sg-item]').forEach((it) =>
      it.addEventListener('click', () => open(Number(it.dataset.i))),
    );
    closeBtn.addEventListener('click', close);
    prevBtn.addEventListener('click', () => show(current - 1));
    nextBtn.addEventListener('click', () => show(current + 1));
    lb.addEventListener('click', (e) => {
      if (e.target === lb || (e.target as HTMLElement).classList.contains('sg-lb-fig')) close();
    });
    document.addEventListener('keydown', (e) => {
      if (lb.hidden) return;
      if (e.key === 'Escape') close();
      else if (e.key === 'ArrowLeft') show(current - 1);
      else if (e.key === 'ArrowRight') show(current + 1);
      else if (e.key === 'Tab') {
        const f = [closeBtn, prevBtn, nextBtn];
        const idx = f.indexOf(document.activeElement as HTMLElement);
        e.preventDefault();
        f[(idx + (e.shiftKey ? -1 : 1) + f.length) % f.length].focus();
      }
    });
    // Wischen
    let x0 = 0;
    lb.addEventListener('pointerdown', (e) => (x0 = e.clientX));
    lb.addEventListener('pointerup', (e) => {
      const dx = e.clientX - x0;
      if (Math.abs(dx) > 60) show(current + (dx < 0 ? 1 : -1));
    });
  }
</script>

<style>
  /* Großansicht */
  .sg-lb {
    position: fixed;
    inset: 0;
    z-index: 120;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgb(9 4 2 / 0.94);
    opacity: 0;
    transition: opacity 0.35s ease;
  }
  .sg-lb[hidden] {
    display: none;
  }
  .sg-lb.is-open {
    opacity: 1;
  }
  .sg-lb-fig {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 72px 20px;
  }
  .sg-lb-fig img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .sg-lb-fig img.is-in {
    opacity: 1;
  }
  .sg-lb-btn {
    position: absolute;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border: 1px solid #fff;
    background: transparent;
    color: #fff;
    cursor: pointer;
    transition:
      background-color 0.3s ease,
      color 0.3s ease;
  }
  .sg-lb-btn:hover,
  .sg-lb-btn:focus-visible {
    background: #fff;
    color: var(--color-ink);
  }
  .sg-lb-close {
    top: 20px;
    right: 20px;
  }
  .sg-lb-prev,
  .sg-lb-next {
    top: 50%;
    margin-top: -24px;
  }
  .sg-lb-prev {
    left: 20px;
  }
  .sg-lb-next {
    right: 20px;
  }

  @media (min-width: 768px) {
    .sg-lb-fig {
      padding: 80px 90px;
    }
  }
  @media (min-width: 1025px) {
    .sg-lb-fig {
      padding: 60px 120px;
    }
  }
</style>
