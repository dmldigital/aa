---
/**
 * Bilder einer Leistung als ruhiges Raster: alle Kacheln einer Reihe sind gleich hoch, abwechselnd breit und schmal.
 * Die Kacheln steigen beim Hereinscrollen als ganze Box auf (das Bild darin bleibt ruhig). Hover wie bei den Karten der
 * Seite (Bild etwas größer und heller, runder Kreis mit Plus). Ein Klick öffnet das Bild groß, mit Pfeilen, Tastatur
 * (Pfeiltasten, Esc) und Wischen als Galerie.
 */
import { Picture, getImage } from 'astro:assets';
import Icon from '../Icon.astro';

interface Props {
  images: ImageMetadata[];
  alt: string;
}
const { images, alt } = Astro.props;

// Spannen je Kachel (von 3 Spalten): Paare abwechselnd breit/schmal und schmal/breit, ein einzelnes Bild über die ganze Breite
const spans: number[] = [];
for (let i = 0, row = 0; i < images.length; row++) {
  if (images.length - i >= 2) {
    spans.push(...(row % 2 === 0 ? [2, 1] : [1, 2]));
    i += 2;
  } else {
    spans.push(3);
    i += 1;
  }
}
const full = await Promise.all(images.map((src) => getImage({ src, width: 1800, format: 'webp' })));
---

{images.length > 0 && (
  <section data-sg class="sg">
    <ul class="sg-grid">
      {images.map((src, i) => (
        <li class="sg-item" style={`--sp:${spans[i]}`} data-box data-pend>
          <button type="button" class="sg-btn" data-sg-item data-full={full[i].src} aria-label={`${alt}, Bild vergrößern`}>
            <Picture
              formats={['avif']}
              fallbackFormat="webp"
              src={src}
              alt={alt}
              widths={[350, 640, 920, 1380]}
              sizes={`(min-width: 1025px) ${spans[i] === 1 ? 460 : spans[i] === 2 ? 920 : 1380}px, (min-width: 768px) 50vw, calc(100vw - 40px)`}
              loading="lazy"
            />
            <span class="sg-zoom" aria-hidden="true">
              <Icon name="plus" class="size-9" />
            </span>
          </button>
        </li>
      ))}
    </ul>

    <div class="sg-lb" data-sg-lb hidden role="dialog" aria-modal="true" aria-label="Bildansicht">
      <button type="button" class="sg-lb-btn sg-lb-close" data-sg-close aria-label="Schließen">
        <Icon name="plus" class="size-5 rotate-45" />
      </button>
      <button type="button" class="sg-lb-btn sg-lb-prev" data-sg-prev aria-label="Voriges Bild">
        <Icon name="arrow-left" class="size-4" />
      </button>
      <button type="button" class="sg-lb-btn sg-lb-next" data-sg-next aria-label="Nächstes Bild">
        <Icon name="arrow-right" class="size-4" />
      </button>
      <figure class="sg-lb-fig"><img data-sg-img alt="" /></figure>
    </div>
  </section>
)}

<script>
  import { lenis } from '../../scripts/motion';
  import { initBoxReveal } from '../../scripts/reveal';

  const root = document.querySelector<HTMLElement>('[data-sg]');
  if (root) {
    initBoxReveal([...root.querySelectorAll<HTMLElement>('[data-box]')]);

    const items = [...root.querySelectorAll<HTMLElement>('[data-sg-item]')];
    const lb = root.querySelector<HTMLElement>('[data-sg-lb]')!;
    const img = lb.querySelector<HTMLImageElement>('[data-sg-img]')!;
    const closeBtn = lb.querySelector<HTMLElement>('[data-sg-close]')!;
    const prevBtn = lb.querySelector<HTMLElement>('[data-sg-prev]')!;
    const nextBtn = lb.querySelector<HTMLElement>('[data-sg-next]')!;
    let current = 0;
    let opener: HTMLElement | null = null;
    let closing: number | undefined;

    const show = (i: number) => {
      current = (i + items.length) % items.length;
      img.classList.remove('is-in');
      const next = new Image();
      next.onload = () => {
        img.src = next.src;
        requestAnimationFrame(() => img.classList.add('is-in'));
      };
      next.src = items[current].dataset.full!;
    };
    const open = (i: number) => {
      opener = document.activeElement as HTMLElement;
      window.clearTimeout(closing);
      lb.hidden = false;
      show(i);
      requestAnimationFrame(() => lb.classList.add('is-open'));
      lenis?.stop();
      document.documentElement.style.overflow = 'hidden';
      closeBtn.focus();
    };
    const close = () => {
      lb.classList.remove('is-open');
      closing = window.setTimeout(() => {
        lb.hidden = true;
        img.removeAttribute('src');
      }, 350);
      lenis?.start();
      document.documentElement.style.overflow = '';
      opener?.focus();
    };

    items.forEach((it, i) => it.addEventListener('click', () => open(i)));
    closeBtn.addEventListener('click', close);
    prevBtn.addEventListener('click', () => show(current - 1));
    nextBtn.addEventListener('click', () => show(current + 1));
    lb.addEventListener('click', (e) => {
      if (e.target === lb || (e.target as HTMLElement).classList.contains('sg-lb-fig')) close();
    });
    document.addEventListener('keydown', (e) => {
      if (lb.hidden) return;
      if (e.key === 'Escape') close();
      else if (e.key === 'ArrowLeft') show(current - 1);
      else if (e.key === 'ArrowRight') show(current + 1);
      else if (e.key === 'Tab') {
        const f = [closeBtn, prevBtn, nextBtn];
        const idx = f.indexOf(document.activeElement as HTMLElement);
        e.preventDefault();
        f[(idx + (e.shiftKey ? -1 : 1) + f.length) % f.length].focus();
      }
    });
    // Wischen
    let x0 = 0;
    lb.addEventListener('pointerdown', (e) => (x0 = e.clientX));
    lb.addEventListener('pointerup', (e) => {
      const dx = e.clientX - x0;
      if (Math.abs(dx) > 60) show(current + (dx < 0 ? 1 : -1));
    });
  }
</script>

<style>
  .sg {
    padding: 0 20px;
    margin: 40px 0;
  }
  .sg-grid {
    display: grid;
    gap: 20px;
    max-width: var(--container-page);
    margin: 0 auto;
    padding: 0;
    list-style: none;
  }
  .sg-item {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 3;
  }
  .sg-btn {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    overflow: hidden;
  }
  .sg-btn :global(picture),
  .sg-btn :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .sg-btn :global(img) {
    transition:
      transform 0.45s ease-in-out,
      opacity 0.45s ease-in-out;
  }
  .sg-btn:hover :global(img),
  .sg-btn:focus-visible :global(img) {
    transform: scale(1.05);
    opacity: 0.8;
  }
  .sg-zoom {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 70px;
    height: 70px;
    border-radius: 50%;
    background: #000000b3;
    color: #fff;
    opacity: 0;
    transform: translate(-50%, -50%);
    pointer-events: none;
    transition: opacity 0.3s ease;
  }
  .sg-btn:hover .sg-zoom,
  .sg-btn:focus-visible .sg-zoom {
    opacity: 1;
  }
  .sg-btn:focus-visible {
    outline: 2px solid var(--color-gold);
    outline-offset: -4px;
  }

  /* Großansicht */
  .sg-lb {
    position: fixed;
    inset: 0;
    z-index: 120;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgb(9 4 2 / 0.94);
    opacity: 0;
    transition: opacity 0.35s ease;
  }
  .sg-lb[hidden] {
    display: none;
  }
  .sg-lb.is-open {
    opacity: 1;
  }
  .sg-lb-fig {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 72px 20px;
  }
  .sg-lb-fig img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .sg-lb-fig img.is-in {
    opacity: 1;
  }
  .sg-lb-btn {
    position: absolute;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border: 1px solid #fff;
    background: transparent;
    color: #fff;
    cursor: pointer;
    transition:
      background-color 0.3s ease,
      color 0.3s ease;
  }
  .sg-lb-btn:hover,
  .sg-lb-btn:focus-visible {
    background: #fff;
    color: var(--color-ink);
  }
  .sg-lb-close {
    top: 20px;
    right: 20px;
  }
  .sg-lb-prev,
  .sg-lb-next {
    top: 50%;
    margin-top: -24px;
  }
  .sg-lb-prev {
    left: 20px;
  }
  .sg-lb-next {
    right: 20px;
  }

  @media (min-width: 768px) {
    .sg {
      margin: 60px 0;
    }
    .sg-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .sg-item {
      aspect-ratio: 4 / 3;
    }
    .sg-item:last-child:nth-child(odd) {
      grid-column: 1 / -1;
      aspect-ratio: 16 / 9;
    }
    .sg-lb-fig {
      padding: 80px 90px;
    }
  }
  @media (min-width: 1025px) {
    .sg {
      padding: 0 30px;
      margin: 108px 0;
    }
    .sg-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      grid-auto-rows: clamp(240px, 26vw, 420px);
      gap: 30px;
    }
    .sg-item,
    .sg-item:last-child:nth-child(odd) {
      grid-column: span var(--sp);
      aspect-ratio: auto;
    }
    .sg-lb-fig {
      padding: 60px 120px;
    }
  }
</style>
