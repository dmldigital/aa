---
/**
 * Bilder einer Leistung in der Aufteilung der Vorteile und der Exzellenz-Karten (neues Design): links bleiben das kleine
 * Label und die goldene Überschrift stehen, rechts liegen die Bilder in gleich großen Boxen (zwei Spalten). Hover wie bei den Projektkarten der
 * Startseite (Bild größer und heller, runder Kreis mit Plus). Ein Klick öffnet das Bild groß, mit Pfeilen, Tastatur
 * (Pfeiltasten, Esc) und Wischen als Galerie. Es bleibt immer eine volle Reihe (gerade Zahl, bei mehr als acht Bildern drei Spalten und ein Vielfaches von sechs).
 */
import { Picture, getImage } from 'astro:assets';
import Lightbox from '../ui/Lightbox.astro';

interface Props {
  images: ImageMetadata[];
  alt: string;
  label?: string;
  heading?: string;
  /** Auf volle Reihen kürzen (Standard). Projektseiten zeigen alle Bilder, die letzte Reihe darf kürzer sein. */
  trim?: boolean;
  /** Hintergrund der Sektion (Weiß und Hellgrau wechseln sich ab) */
  tone?: 'white' | 'soft';
  /** Zählung der Bilder im Alt-Text beginnt bei diesem Wert (Projektseiten: nach den Kapitelbildern) */
  start?: number;
}
const { alt, label = 'Galerie', heading = 'Einblicke in unsere Arbeit', trim = true, tone = 'white', start = 1 } = Astro.props;
// Bis acht Bilder zwei Spalten, darüber drei (ab 1025 px). Es bleibt immer eine volle Reihe: gerade Zahl bzw. Vielfaches von 6
const cols = Astro.props.images.length > 8 ? 3 : 2;
const step = cols === 3 ? 6 : 2;
const images = trim
  ? Astro.props.images.slice(0, Astro.props.images.length - (Astro.props.images.length % step))
  : Astro.props.images;
const full = await Promise.all(images.map((src) => getImage({ src, width: 1800, format: 'webp' })));
---

{images.length > 0 && (
  <section data-sg class:list={['sg', tone === 'soft' && 'sg--soft']}>
    <div class="sg-inner">
      <div class="sg-heading">
        <p class="sg-eyebrow" data-anim="fadeIn">{label}</p>
        <h2 data-anim="fadeIn" data-anim-delay="100">{heading}</h2>
      </div>
      <ul class="sg-grid" style={`--cols:${cols}`}>
        {images.map((src, i) => (
          <li class="sg-item">
            <button type="button" class="sg-btn" data-sg-item data-full={full[i].src} aria-label={`${alt}, Bild ${start + i} vergrößern`}>
              <Picture
                formats={['avif']}
                fallbackFormat="webp"
                src={src}
                alt={`${alt}, Bild ${start + i}`}
                widths={[170, 340, 460, 920]}
                sizes={`(min-width: 1025px) ${cols === 3 ? 265 : 400}px, (min-width: 768px) 360px, 170px`}
                loading="lazy"
                draggable="false"
              />
              <span class="sg-zoom" aria-hidden="true">+</span>
            </button>
          </li>
        ))}
      </ul>
    </div>

    <Lightbox />
  </section>
)}

<script>
  import { initLightbox } from '../../scripts/lightbox';

  const root = document.querySelector<HTMLElement>('[data-sg]');
  if (root) initLightbox(root, [...root.querySelectorAll<HTMLElement>('[data-sg-item]')]);
</script>

<style>
  .sg {
    --ink: #090402;
    padding: 64px 20px;
    color: var(--ink);
  }
  .sg--soft {
    background: var(--color-soft);
  }
  .sg-inner {
    display: grid;
    gap: 32px;
    max-width: var(--container-page);
    margin: 0 auto;
  }
  .sg-eyebrow {
    margin: 0;
    font-family: var(--font-urbanist), sans-serif;
    font-size: var(--text-label);
    line-height: var(--text-label--line-height);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }
  .sg-heading h2 {
    margin: 12px 0 0;
    color: var(--color-gold);
    font-family: var(--font-urbanist), sans-serif;
    font-size: var(--text-h2);
    line-height: var(--text-h2--line-height);
    letter-spacing: var(--text-h2--letter-spacing);
    font-weight: 500;
    text-wrap: balance;
  }
  .sg-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .sg-item {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 3;
  }
  .sg-btn {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    overflow: hidden;
  }
  .sg-btn :global(picture),
  .sg-btn :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .sg-btn :global(img) {
    transition:
      transform 0.45s ease-in-out,
      opacity 0.45s ease-in-out;
  }
  .sg-btn:hover :global(img),
  .sg-btn:focus-visible :global(img) {
    transform: scale(1.1);
    opacity: 0.8;
  }
  .sg-zoom {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 70px;
    height: 70px;
    border-radius: 50%;
    background: #000000b3;
    color: #fff;
    font-size: 40px;
    line-height: 22.5px;
    opacity: 0;
    transform: translate(-50%, -50%);
    pointer-events: none;
    transition: opacity 0.3s ease;
  }
  .sg-btn:hover .sg-zoom,
  .sg-btn:focus-visible .sg-zoom {
    opacity: 1;
  }
  .sg-btn:focus-visible {
    outline: 2px solid var(--color-gold);
    outline-offset: -4px;
  }

  @media (min-width: 768px) {
    .sg {
      padding: 96px 32px;
    }
  }
  @media (min-width: 1025px) {
    .sg {
      padding: 128px 32px;
    }
    .sg-inner {
      grid-template-columns: minmax(0, 0.34fr) minmax(0, 0.66fr);
      gap: 0 6vw;
      align-items: start;
    }
    .sg-heading {
      position: sticky;
      top: 22vh;
    }
    .sg-grid {
      grid-template-columns: repeat(var(--cols, 2), minmax(0, 1fr));
      gap: 20px;
    }
  }
</style>
