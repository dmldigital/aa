---
/**
 * Bilder einer Leistung in der Aufteilung der Vorteile und der Exzellenz-Karten (neues Design): links bleiben das kleine
 * Label und die goldene Überschrift stehen, rechts liegen die Bilder in gleich großen Boxen (zwei Spalten). Die Boxen
 * steigen beim Hereinscrollen als ganze Box auf, das Bild darin bleibt ruhig. Hover wie bei den Projektkarten der
 * Startseite (Bild größer und heller, runder Kreis mit Plus). Ein Klick öffnet das Bild groß, mit Pfeilen, Tastatur
 * (Pfeiltasten, Esc) und Wischen als Galerie. Es werden immer eine gerade Zahl Bilder gezeigt (keine halbleere Reihe).
 */
import { Picture, getImage } from 'astro:assets';
import Icon from '../Icon.astro';

interface Props {
  images: ImageMetadata[];
  alt: string;
  label?: string;
  heading?: string;
}
const { alt, label = 'Galerie', heading = 'Einblicke in unsere Arbeit' } = Astro.props;
const images = Astro.props.images.slice(0, Astro.props.images.length - (Astro.props.images.length % 2));
const full = await Promise.all(images.map((src) => getImage({ src, width: 1800, format: 'webp' })));
---

{images.length > 0 && (
  <section data-sg class="sg">
    <div class="sg-inner">
      <div class="sg-heading">
        <p class="sg-eyebrow" data-anim="fadeIn">{label}</p>
        <h2 data-anim="fadeIn" data-anim-delay="100">{heading}</h2>
      </div>
      <ul class="sg-grid">
        {images.map((src, i) => (
          <li class="sg-item" data-box data-pend>
            <button type="button" class="sg-btn" data-sg-item data-full={full[i].src} aria-label={`${alt}, Bild ${i + 1} vergrößern`}>
              <Picture
                formats={['avif']}
                fallbackFormat="webp"
                src={src}
                alt={alt}
                widths={[170, 340, 460, 920]}
                sizes="(min-width: 1025px) 400px, (min-width: 768px) 360px, 170px"
                loading="lazy"
                draggable="false"
              />
              <span class="sg-zoom" aria-hidden="true">+</span>
            </button>
          </li>
        ))}
      </ul>
    </div>

    <div class="sg-lb" data-sg-lb hidden role="dialog" aria-modal="true" aria-label="Bildansicht">
      <button type="button" class="sg-lb-btn sg-lb-close" data-sg-close aria-label="Schließen">
        <Icon name="plus" class="size-5 rotate-45" />
      </button>
      <button type="button" class="sg-lb-btn sg-lb-prev" data-sg-prev aria-label="Voriges Bild">
        <Icon name="arrow-left" class="size-4" />
      </button>
      <button type="button" class="sg-lb-btn sg-lb-next" data-sg-next aria-label="Nächstes Bild">
        <Icon name="arrow-right" class="size-4" />
      </button>
      <figure class="sg-lb-fig"><img data-sg-img alt="" /></figure>
    </div>
  </section>
)}

<script>
  import { lenis } from '../../scripts/motion';
  import { initBoxReveal } from '../../scripts/reveal';

  const root = document.querySelector<HTMLElement>('[data-sg]');
  if (root) {
    initBoxReveal([...root.querySelectorAll<HTMLElement>('[data-box]')]);

    const items = [...root.querySelectorAll<HTMLElement>('[data-sg-item]')];
    const lb = root.querySelector<HTMLElement>('[data-sg-lb]')!;
    const img = lb.querySelector<HTMLImageElement>('[data-sg-img]')!;
    const closeBtn = lb.querySelector<HTMLElement>('[data-sg-close]')!;
    const prevBtn = lb.querySelector<HTMLElement>('[data-sg-prev]')!;
    const nextBtn = lb.querySelector<HTMLElement>('[data-sg-next]')!;
    let current = 0;
    let opener: HTMLElement | null = null;
    let closing: number | undefined;

    const show = (i: number) => {
      current = (i + items.length) % items.length;
      img.classList.remove('is-in');
      const next = new Image();
      next.onload = () => {
        img.src = next.src;
        requestAnimationFrame(() => img.classList.add('is-in'));
      };
      next.src = items[current].dataset.full!;
    };
    const open = (i: number) => {
      opener = document.activeElement as HTMLElement;
      window.clearTimeout(closing);
      lb.hidden = false;
      show(i);
      requestAnimationFrame(() => lb.classList.add('is-open'));
      lenis?.stop();
      document.documentElement.style.overflow = 'hidden';
      closeBtn.focus();
    };
    const close = () => {
      lb.classList.remove('is-open');
      closing = window.setTimeout(() => {
        lb.hidden = true;
        img.removeAttribute('src');
      }, 350);
      lenis?.start();
      document.documentElement.style.overflow = '';
      opener?.focus();
    };

    items.forEach((it, i) => it.addEventListener('click', () => open(i)));
    closeBtn.addEventListener('click', close);
    prevBtn.addEventListener('click', () => show(current - 1));
    nextBtn.addEventListener('click', () => show(current + 1));
    lb.addEventListener('click', (e) => {
      if (e.target === lb || (e.target as HTMLElement).classList.contains('sg-lb-fig')) close();
    });
    document.addEventListener('keydown', (e) => {
      if (lb.hidden) return;
      if (e.key === 'Escape') close();
      else if (e.key === 'ArrowLeft') show(current - 1);
      else if (e.key === 'ArrowRight') show(current + 1);
      else if (e.key === 'Tab') {
        const f = [closeBtn, prevBtn, nextBtn];
        const idx = f.indexOf(document.activeElement as HTMLElement);
        e.preventDefault();
        f[(idx + (e.shiftKey ? -1 : 1) + f.length) % f.length].focus();
      }
    });
    // Wischen
    let x0 = 0;
    lb.addEventListener('pointerdown', (e) => (x0 = e.clientX));
    lb.addEventListener('pointerup', (e) => {
      const dx = e.clientX - x0;
      if (Math.abs(dx) > 60) show(current + (dx < 0 ? 1 : -1));
    });
  }
</script>

<style>
  .sg {
    --ink: #090402;
    margin: 56px 20px 64px;
    color: var(--ink);
  }
  .sg-inner {
    display: grid;
    gap: 32px;
    max-width: var(--container-page);
    margin: 0 auto;
  }
  .sg-eyebrow {
    margin: 0;
    font-family: var(--font-urbanist), sans-serif;
    font-size: 12px;
    line-height: 1.5;
    font-weight: 500;
    letter-spacing: 2px;
    text-transform: uppercase;
  }
  .sg-heading h2 {
    margin: 36px 0 0;
    color: var(--color-gold);
    font-family: var(--font-urbanist), sans-serif;
    font-size: clamp(28px, 3.2vw, 40px);
    line-height: 1.25;
    font-weight: 500;
    text-wrap: balance;
  }
  .sg-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .sg-item {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 3;
  }
  .sg-btn {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    overflow: hidden;
  }
  .sg-btn :global(picture),
  .sg-btn :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .sg-btn :global(img) {
    transition:
      transform 0.45s ease-in-out,
      opacity 0.45s ease-in-out;
  }
  .sg-btn:hover :global(img),
  .sg-btn:focus-visible :global(img) {
    transform: scale(1.1);
    opacity: 0.8;
  }
  .sg-zoom {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 70px;
    height: 70px;
    border-radius: 50%;
    background: #000000b3;
    color: #fff;
    font-size: 40px;
    line-height: 22.5px;
    opacity: 0;
    transform: translate(-50%, -50%);
    pointer-events: none;
    transition: opacity 0.3s ease;
  }
  .sg-btn:hover .sg-zoom,
  .sg-btn:focus-visible .sg-zoom {
    opacity: 1;
  }
  .sg-btn:focus-visible {
    outline: 2px solid var(--color-gold);
    outline-offset: -4px;
  }

  /* Großansicht */
  .sg-lb {
    position: fixed;
    inset: 0;
    z-index: 120;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgb(9 4 2 / 0.94);
    opacity: 0;
    transition: opacity 0.35s ease;
  }
  .sg-lb[hidden] {
    display: none;
  }
  .sg-lb.is-open {
    opacity: 1;
  }
  .sg-lb-fig {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 72px 20px;
  }
  .sg-lb-fig img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .sg-lb-fig img.is-in {
    opacity: 1;
  }
  .sg-lb-btn {
    position: absolute;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border: 1px solid #fff;
    background: transparent;
    color: #fff;
    cursor: pointer;
    transition:
      background-color 0.3s ease,
      color 0.3s ease;
  }
  .sg-lb-btn:hover,
  .sg-lb-btn:focus-visible {
    background: #fff;
    color: var(--color-ink);
  }
  .sg-lb-close {
    top: 20px;
    right: 20px;
  }
  .sg-lb-prev,
  .sg-lb-next {
    top: 50%;
    margin-top: -24px;
  }
  .sg-lb-prev {
    left: 20px;
  }
  .sg-lb-next {
    right: 20px;
  }

  @media (min-width: 768px) {
    .sg-lb-fig {
      padding: 80px 90px;
    }
  }
  @media (min-width: 1025px) {
    .sg-lb-fig {
      padding: 60px 120px;
    }
  }

  @media (min-width: 768px) {
    .sg {
      margin: 72px 20px 80px;
    }
    .sg-lb-fig {
      padding: 80px 90px;
    }
  }
  @media (min-width: 1025px) {
    .sg {
      margin: 12vh 30px;
    }
    .sg-inner {
      grid-template-columns: minmax(0, 0.34fr) minmax(0, 0.66fr);
      gap: 0 6vw;
      align-items: start;
    }
    .sg-heading {
      position: sticky;
      top: 22vh;
    }
    .sg-grid {
      gap: 30px;
    }
    .sg-lb-fig {
      padding: 60px 120px;
    }
  }
</style>
