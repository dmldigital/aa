---
/**
 * „Exzellenz ist unser Maßstab“: gleiche Aufteilung wie die Vorteile darüber (graue Fläche, links bleibt die goldene
 * Überschrift stehen, rechts die Säulen als weiße Karten mit Rand untereinander). Jede Karte hat ihre natürliche Höhe,
 * weil die Texte verschieden lang sind (bei nebeneinander stehenden, gleich hohen Karten blieben große leere Flächen).
 */
import { cleanHtml } from '../../lib/cleanHtml';

interface Props {
  title: string;
  items: { title: string; html: string; bullets?: string[] }[];
}
const { title, items } = Astro.props;
---

<section class="se">
  <div class="se-inner">
    <div class="se-heading">
      <h2 data-anim="fadeIn">{title}</h2>
    </div>
    <div class="se-grid">
      {items.map((it) => (
        <article class="se-card">
          <h3 set:html={it.title} />
          <div class="se-text" set:html={cleanHtml(it.html)} />
          {it.bullets && it.bullets.length > 0 && (
            <div class="se-text">
              <ul>{it.bullets.map((b) => <li set:html={b} />)}</ul>
            </div>
          )}
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .se {
    --ink: #090402;
    --hair: #0904021f;
    padding: 56px 20px 64px;
    background: var(--color-soft);
    color: var(--ink);
  }
  .se-inner {
    display: grid;
    gap: 32px;
    max-width: var(--container-page);
    margin: 0 auto;
  }
  .se h2 {
    margin: 0;
    color: var(--color-gold);
    font-family: var(--font-urbanist), sans-serif;
    font-size: clamp(28px, 3.2vw, 40px);
    line-height: 1.25;
    font-weight: 500;
    text-wrap: balance;
  }
  .se-grid {
    display: grid;
    gap: 20px;
  }
  .se-card {
    padding: 28px 24px 30px;
    border: 1px solid var(--hair);
    background: #fff;
  }
  .se-card h3 {
    margin: 0 0 14px;
    font-family: var(--font-urbanist), sans-serif;
    font-size: 20px;
    line-height: 1.3;
    font-weight: 500;
  }
  .se-text {
    color: var(--color-muted);
    font-size: 15px;
    line-height: 1.5;
  }
  .se-text :global(p) {
    margin: 0 0 12px;
  }
  .se-text :global(p:last-child),
  .se-text :global(li:last-child) {
    margin-bottom: 0;
  }
  .se-text :global(strong) {
    color: var(--ink);
    font-weight: 600;
  }
  .se-text :global(ul) {
    margin: 12px 0 0;
    padding-left: 1.2em;
    list-style: disc;
  }
  .se-text :global(li) {
    margin-bottom: 8px;
  }
  .se-text :global(li::marker) {
    color: var(--color-gold);
  }
  .se-text :global(li p) {
    margin: 0;
  }
  @media (min-width: 768px) {
    .se {
      padding: 72px 20px 80px;
    }
    .se-card h3 {
      font-size: 24px;
    }
    .se-text {
      font-size: 16px;
    }
  }
  @media (min-width: 1025px) {
    .se {
      padding: 12vh 30px;
    }
    .se-inner {
      grid-template-columns: minmax(0, 0.34fr) minmax(0, 0.66fr);
      gap: 0 6vw;
      align-items: start;
    }
    .se-heading {
      position: sticky;
      top: 22vh;
    }
    .se-grid {
      gap: 30px;
    }
    .se-card {
      padding: 36px 32px 40px;
    }
  }
</style>
