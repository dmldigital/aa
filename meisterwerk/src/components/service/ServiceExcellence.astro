---
/**
 * „Exzellenz ist unser Maßstab“: graue Fläche, goldene Überschrift und die Säulen als weiße Karten mit Rand
 * (Maße und Schriften der Karten der Startseite), die als ganze Box aufsteigen.
 */
interface Props {
  title: string;
  items: { title: string; html: string; bullets?: string[] }[];
}
const { title, items } = Astro.props;
---

<section class="se">
  <div class="se-inner">
    <h2 data-anim="fadeIn">{title}</h2>
    <div class="se-grid" style={`--n:${items.length}`}>
      {items.map((it) => (
        <article class="se-card" data-box data-pend>
          <h3 set:html={it.title} />
          <div class="se-text" set:html={it.html} />
          {it.bullets && it.bullets.length > 0 && (
            <ul class="se-text">{it.bullets.map((b) => <li set:html={b} />)}</ul>
          )}
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  import { initBoxReveal } from '../../scripts/reveal';

  initBoxReveal([...document.querySelectorAll<HTMLElement>('.se [data-box]')]);
</script>

<style>
  .se {
    --ink: #090402;
    --hair: #0904021f;
    padding: 56px 20px 64px;
    background: var(--color-soft);
    color: var(--ink);
  }
  .se-inner {
    max-width: var(--container-page);
    margin: 0 auto;
  }
  .se h2 {
    margin: 0 0 32px;
    color: var(--color-gold);
    font-family: var(--font-urbanist), sans-serif;
    font-size: clamp(28px, 3.2vw, 40px);
    line-height: 1.25;
    font-weight: 500;
    text-wrap: balance;
  }
  .se-grid {
    display: grid;
    gap: 20px;
  }
  .se-card {
    padding: 28px 24px 30px;
    border: 1px solid var(--hair);
    background: #fff;
  }
  .se-card h3 {
    margin: 0 0 14px;
    font-family: var(--font-urbanist), sans-serif;
    font-size: 20px;
    line-height: 1.3;
    font-weight: 500;
  }
  .se-text {
    color: var(--color-muted);
    font-size: 15px;
    line-height: 1.5;
  }
  .se-text :global(p) {
    margin: 0 0 12px;
  }
  .se-text :global(strong) {
    color: var(--ink);
    font-weight: 600;
  }
  .se-text :global(ul) {
    margin: 12px 0 0;
    padding-left: 1.2em;
    list-style: disc;
  }
  .se-text :global(li) {
    margin-bottom: 8px;
  }
  .se-text :global(li::marker) {
    color: var(--color-gold);
  }
  .se-text :global(li p) {
    margin: 0;
  }
  @media (min-width: 768px) {
    .se {
      padding: 72px 20px 80px;
    }
    .se-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .se-card h3 {
      font-size: 24px;
    }
    .se-text {
      font-size: 16px;
    }
  }
  @media (min-width: 1025px) {
    .se {
      padding: 12vh 30px;
    }
    .se h2 {
      margin-bottom: 56px;
    }
    .se-grid {
      grid-template-columns: repeat(var(--n, 3), minmax(0, 1fr));
      gap: 30px;
    }
    .se-card {
      padding: 36px 32px 40px;
    }
  }
</style>
