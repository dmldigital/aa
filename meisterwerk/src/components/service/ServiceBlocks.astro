---
/**
 * Die beiden Textblöcke einer Leistung („Materialien & Techniken“, „Technische Vorteile & Innovationen“): zwei Spalten
 * mit goldener Überschrift in der Größe der Titel auf der Startseite und dem Text der Seite.
 */
import { rich } from '../../lib/rich';
import { cleanHtml } from '../../lib/cleanHtml';
import Button from '../ui/Button.astro';

interface Props {
  blocks: { title: string; html: string }[];
  /** Link unter den Blöcken (Exklusive-Seiten: „Lassen Sie sich inspirieren“) */
  cta?: { label: string; href: string };
}
const { blocks, cta } = Astro.props;
---

<section class="mx-auto w-full max-w-page px-page py-section">
  <div class="grid gap-12 md:grid-cols-2 md:gap-x-12 lg:gap-x-[6vw]">
    {blocks.map((b) => (
      <div data-anim="fadeIn" class="flex flex-col gap-4">
        <h3 class="font-display text-h2 font-medium text-gold">
          {b.title}
        </h3>
        <div class:list={['max-w-[65ch] text-body', rich]} set:html={cleanHtml(b.html)} />
      </div>
    ))}
  </div>
  {cta && (
    <div class="mt-8" data-anim="fadeIn">
      <Button href={cta.href}>
        {cta.label}
      </Button>
    </div>
  )}
</section>
