---
/**
 * „Meisterliche Malerarbeiten“ der Startseite (aus der Auswahl-Vorschau übertragen, Markup 1:1).
 * Desktop (ab 1200 px Breite, 600 px Höhe): gepinnte Bühne, Tab-Texte gleiten unter dem Trennstrich durch;
 * darunter aufklappbare Tabs. Verhalten: scripts/home/tabs.js, Gestaltung: styles/home/tabs.css.
 */
import { Picture } from 'astro:assets';
import { href } from '../../data/links';
import cssUrl from '../../styles/home/tabs.css?url';
import img1 from '../../assets/img/2025-meisterwerk-20230524-HDR-scaled.jpg';
---
<link rel="stylesheet" href={cssUrl} />
<section data-no-autolink data-tb data-header-lock class="tb" aria-labelledby="tb-title"><div class="tb-sticky"><div class="tb-grid"><div class="tb-left"><span class="tb-eyebrow">Meisterwerk Maler Manufaktur</span><h2 id="tb-title">Meisterliche Malerarbeiten vom Meisterbetrieb in Freiberg am Neckar</h2><p class="tb-lead">Für Wohnträume und Lebensräume in Freiberg am Neckar, Ludwigsburg, Marbach und Bietigheim-Bissingen: Meisterbetrieb mit eigener Werkstatt, Showroom und einem Team, das Malerarbeiten, Lackierungen und Spachteltechniken auf höchstem Niveau ausführt.</p><ol class="tb-tabs" data-tb-tabs aria-hidden="true"><li data-tb-tab><button type="button" class="tb-tab" id="tb-t1" aria-controls="tb-p1" tabindex="-1">Unsere Firmenskills</button></li><li data-tb-tab><button type="button" class="tb-tab" id="tb-t2" aria-controls="tb-p2" tabindex="-1">Unsere Mitarbeiter &amp; Team-Skills</button></li><li data-tb-tab><button type="button" class="tb-tab" id="tb-t3" aria-controls="tb-p3" tabindex="-1">Ihr Mehrwert als Kunde</button></li></ol></div><div class="tb-right"><div class="tb-view"><div class="tb-media" data-tb-media><div data-grow="bottom" data-anim-delay="340"><Picture src={img1} formats={['avif']} fallbackFormat="webp" alt="Helles Treppenhaus mit Holzstufen, frisch gestrichene Wände und Wandleuchte" widths={[350, 700, 1360]} sizes="(min-width: 1025px) 680px, (min-width: 768px) 477px, 350px" loading="lazy" /></div></div><article class="tb-panel" id="tb-p1" data-tb-panel aria-labelledby="tb-h1"><div class="tb-inner"><h3 class="tb-h3" id="tb-h1">Unsere Firmenskills</h3><p class="tb-lede">Eigene Werkstatt, eigener <a href={href('/2025/05/03/unser-showroom/')}>Showroom</a>, moderne Technik: So setzen wir <a href={href('/services/malerarbeiten/')}>Malerarbeiten</a> und fugenlose <a href={href('/meisterwerk-exklusive/spachteltechniken/')}>Spachteltechniken</a> in der Region Ludwigsburg schnell und zuverlässig um.</p><dl class="tb-facts"><div><dt>250 m²</dt><dd>Werkstatt</dd></div><div><dt>100 m²</dt><dd>Showroom mit echten Mustern</dd></div><div><dt>4</dt><dd>voll ausgestattete Firmenfahrzeuge</dd></div><div><dt>60+</dt><dd>Maschinen und Geräte</dd></div></dl><div class="tb-grp tb-list"><ul><li>Eigene Büros für Planung und Beratung</li><li>Lackierraum, Maschinenraum und Materiallager</li><li>Gerätewaschplatz mit Filteranlage</li></ul></div></div></article><article class="tb-panel" id="tb-p2" data-tb-panel aria-labelledby="tb-h2"><div class="tb-inner"><h3 class="tb-h3" id="tb-h2">Unsere Mitarbeiter &amp; Team-Skills</h3><p class="tb-lede">Meister, Projektleiter, Vorarbeiter, Geselle und Auszubildende arbeiten Hand in Hand, damit Ihr Projekt termingerecht und sauber fertig wird. Mehr unter <a href={href('/qualifikationen/')}>Qualifikationen</a>.</p><dl class="tb-facts"><div><dt>3</dt><dd>Schulungen pro Jahr für alle</dd></div><div><dt>2</dt><dd>Firmenausflüge im Jahr</dd></div><div><dt>2</dt><dd>Auszubildende im Team</dd></div></dl><div class="tb-grp tb-list"><ul><li>Arbeitskleidung von Schöffel Pro</li><li>Eigene Firmen-App für eine digitale Organisation</li><li>Ausbildungsbetrieb für den Nachwuchs im Malerhandwerk</li></ul></div></div></article><article class="tb-panel" id="tb-p3" data-tb-panel aria-labelledby="tb-h3"><div class="tb-inner"><h3 class="tb-h3" id="tb-h3">Ihr Mehrwert als Kunde</h3><p class="tb-lede">Was unser Aufwand Ihnen bringt: kürzere Bauzeiten, eine saubere Baustelle und Beratung mit echten Mustern im <a href={href('/2025/05/03/unser-showroom/')}>Showroom</a>.</p><dl class="tb-facts"><div><dt>bis 70 %</dt><dd>kürzere Baustellendauer dank neuester Technik</dd></div></dl><table class="tb-cmp"><colgroup><col style="width:23%"><col style="width:45%"><col style="width:32%"></colgroup><thead><tr><td></td><th scope="col" class="is-m">Meisterwerk</th><th scope="col" class="is-s">Standard-Malerbetrieb</th></tr></thead><tbody><tr><th scope="row">Ausstattung</th><td data-label="Meisterwerk">Über 60 moderne Maschinen und Geräte</td><td data-label="Standard-Malerbetrieb">Oft ältere Geräte</td></tr><tr><th scope="row">Fahrzeuge</th><td data-label="Meisterwerk">Alles an Bord, keine Extrafahrten</td><td data-label="Standard-Malerbetrieb">Material wird nachgeholt</td></tr><tr><th scope="row">Beratung</th><td data-label="Meisterwerk">Showroom mit echten Mustern</td><td data-label="Standard-Malerbetrieb">Beratung nur vor Ort</td></tr><tr><th scope="row">Baustelle</th><td data-label="Meisterwerk">Sauber, sicher und umweltbewusst</td><td data-label="Standard-Malerbetrieb">Eher einfach gehalten</td></tr><tr><th scope="row">Service</th><td data-label="Meisterwerk">Kundenparkplätze und italienischer Espresso</td><td data-label="Standard-Malerbetrieb">Selten Extras</td></tr></tbody></table></div></article></div></div></div></div></section>

<script>
  import '../../scripts/home/tabs.js';
</script>
