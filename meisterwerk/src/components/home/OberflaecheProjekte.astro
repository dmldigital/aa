---
/**
 * „Jede Oberfläche ist einzigartig“ (Bild, CTA-Box, Kontaktbox) und „Unsere Exklusive Projekte“, die sich darüber
 * schieben; danach schiebt sich das FAQ über die Projekte (aus der Auswahl-Vorschau übertragen, Markup 1:1).
 * Verhalten: scripts/home/cta.js und scripts/home/faq-cover.js, Gestaltung: styles/home/cta.css.
 */
import { Picture } from 'astro:assets';
import { getImage } from 'astro:assets';
import { href } from '../../data/links';
import '../../styles/home/cta.css';
import img1 from '../../assets/img/199-meisterwerk-20230120-Bearbeitet-2-scaled.jpg';
import img2 from '../../assets/img/2124-meisterwerk-20230524-Bearbeitet-1-scaled.jpg';
import img3 from '../../assets/img/2079-meisterwerk-20230524-Bearbeitet-scaled.jpg';
import bgSrc from '../../assets/img/249-mw-20241125-scaled.jpg';
const bg = await getImage({ src: bgSrc, format: 'webp', width: 1920 });
---
<div data-no-autolink class="mz" data-mz><div class="mz-lockzone" data-header-lock aria-hidden="true"></div><section data-section="882761a" class="mz-stage flex flex-col"><div class="mz-bg" style={`background-image:url(${bg.src})`} aria-hidden="true"></div><!-- Oberer Linienstreifen --><div class="mz-row flex min-h-5 flex-col pl-[5%] md:min-h-15 md:pl-[10%] lg:min-h-[10vh]"><div class="mx-auto flex w-full max-w-page grow"><div class="mz-col w-[65%] md:w-85 lg:w-105"></div></div></div><!-- Mittlerer Bereich mit Text --><div class="mz-row mz-row--mid flex min-h-[100vw] flex-col pl-[5%] md:min-h-100 md:pl-[10%] lg:min-h-[clamp(500px,80vh,600px)]"><div class="mz-mid mx-auto flex w-full max-w-page grow"><div class="mz-col flex w-[65%] flex-col justify-between gap-5 px-5 py-7.5 backdrop-blur-[40px] backdrop-saturate-[1.8] md:w-85 lg:w-105 lg:px-7.5 lg:py-10"><div class="flex flex-col gap-3.75 lg:gap-5"><div class="mb-2.5 w-full max-w-[280px]" data-anim="slideInUp" data-anim-delay="50"><span class="text-body text-white">Lassen Sie uns gemeinsam etwas Einzigartiges schaffen.</span></div><div data-anim="slideInUp" data-anim-delay="100"><a href={href('/kontakt/')} class="group/ul inline-flex cursor-pointer items-center justify-center rounded-full border px-7 text-center font-display text-button font-semibold tracking-button uppercase max-sm:min-h-11 sm:min-h-12 py-2 md:px-8.5 lg:px-10 border-white text-white hover:bg-white/15 transition-colors duration-300 whitespace-nowrap max-sm:h-11 sm:h-12"><span class="flex justify-center gap-1.25"><span class="">Projekt Starten</span></span></a></div></div><div data-anim="slideInUp"><h2 class="font-display text-h2 font-medium text-white">Jede Oberfläche ist einzigartig. <br /> Genauso wie unser Ansatz.</h2></div></div><div class="mz-contact" data-mz-contact><form class="mz-form" data-menu-form aria-label="Kontaktformular"><h3 class="mz-form-title">Wie können wir Ihnen helfen?</h3><div class="mz-fields"><label class="mz-field"><span>Name</span><input type="text" name="name" autocomplete="name" required></label><label class="mz-field"><span>Telefon oder E-Mail</span><input type="text" name="kontakt" autocomplete="email" required></label><label class="mz-field"><span>Leistung</span><select name="leistung"><option value="">Bitte wählen</option><option>Malerarbeiten</option><option>Tapezierarbeiten</option><option>Lackierarbeiten</option><option>Verputzarbeiten</option><option>Glatte Oberflächen</option><option>Fugenlose Bäder</option><option>Fugenlose Böden</option><option>Spachteltechniken</option><option>Stuckleisten</option><option>Etwas anderes</option></select></label><label class="mz-field"><span>Ort</span><input type="text" name="ort" autocomplete="address-level2"></label><label class="mz-field mz-field--wide"><span>Ihre Nachricht</span><textarea name="nachricht" rows="2" required></textarea></label></div><div class="mz-actions"><button type="submit" class="group/ul inline-flex cursor-pointer items-center justify-center rounded-full border px-7 text-center font-display text-button font-semibold tracking-button uppercase max-sm:min-h-11 sm:min-h-12 py-2 md:px-8.5 lg:px-10 border-black/10 bg-white text-black shadow-[0_1px_2px_rgb(21_24_27/0.06),0_8px_20px_-8px_rgb(21_24_27/0.22)] hover:bg-fog transition-colors duration-300 whitespace-nowrap max-sm:h-11 sm:h-12"><span class="flex justify-center gap-1.25"><span class="">Nachricht senden</span></span></button><p class="mz-msg" role="status" aria-live="polite" data-form-message hidden>Das Formular wird in Kürze freigeschaltet. Bis dahin erreichen Sie uns gern telefonisch oder per E-Mail.</p></div><p class="mz-direct">Direkt erreichen Sie uns unter <a href="tel:+4971412398290">07141 / 23982 90</a> oder <a href="mailto:info@meisterwerk-lb.de">info@meisterwerk-lb.de</a></p></form></div></div></div><!-- Unterer Linienstreifen --><div class="mz-row flex min-h-5 flex-col pl-[5%] md:min-h-15 md:pl-[10%] lg:min-h-[10vh]"><div class="mx-auto flex w-full max-w-page grow"><div class="mz-col w-[65%] md:w-85 lg:w-105"></div></div></div></section></div><div class="mz-cover" data-mz-cover><div class="ep" data-ep><div class="ep-lockzone" data-header-lock aria-hidden="true"></div><div class="ep-sheet" data-ep-sheet><section data-section="3472c30" class="flex flex-col overflow-x-clip px-page py-section"><div class="mx-auto flex w-full max-w-page grow flex-col gap-group"><div><h2 class="font-display text-h2 font-medium text-gold">Unsere Exklusive Projekte</h2></div><div class="grid grid-cols-1 gap-x-stack gap-y-group md:grid-cols-3"><a href={href('/2025/09/18/traumhaus/')} class="group/card flex flex-col gap-5 text-ink"><div class="relative overflow-hidden"><div class="[clip-path:none]" data-grow="bottom"><Picture src={img1} formats={['avif']} fallbackFormat="webp" alt="Helles Wohnzimmer mit Holztreppe, Projekt Traumhaus" widths={[350, 440, 880]} sizes="(min-width: 1025px) 440px, (min-width: 768px) 315px, 350px" loading="lazy" draggable="false" class="block h-auto w-full transition-transform duration-[450ms] ease-in-out group-hover/card:scale-110 group-hover/card:opacity-80" /></div><span aria-hidden="true" class="pointer-events-none absolute top-1/2 left-1/2 z-10 flex size-17.5 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full bg-black/70 text-[40px]/[22.5px] text-white opacity-0 transition-opacity duration-300 group-hover/card:opacity-100">+</span></div><div class="flex flex-wrap items-start justify-between gap-5"><h3 class="w-[calc(100%-40px)] font-display text-h3 font-medium">Traumhaus</h3><span class="text-body text-black transition-opacity duration-300 ease-in-out group-hover/card:opacity-100 [@media(hover:hover)]:opacity-0" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 -960 1024 1024" fill="currentColor" aria-hidden="true" focusable="false" class="block shrink-0 size-4"><path transform="scale(1 -1)" d="M477.867 960v-477.867h-477.867v-68.267h477.867v-477.867h68.267v477.867h477.867v68.267h-477.867v477.867z"></path></svg></span></div></a><a href={href('/2025/09/18/frisch-gestrichen/')} class="group/card flex flex-col gap-5 text-ink"><div class="relative overflow-hidden"><div class="[clip-path:none]" data-grow="bottom"><Picture src={img2} formats={['avif']} fallbackFormat="webp" alt="Frisch gestrichene Fassade mit Haustür, Projekt Frisch Gestrichen" widths={[350, 440, 880]} sizes="(min-width: 1025px) 440px, (min-width: 768px) 315px, 350px" loading="lazy" draggable="false" class="block h-auto w-full transition-transform duration-[450ms] ease-in-out group-hover/card:scale-110 group-hover/card:opacity-80" /></div><span aria-hidden="true" class="pointer-events-none absolute top-1/2 left-1/2 z-10 flex size-17.5 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full bg-black/70 text-[40px]/[22.5px] text-white opacity-0 transition-opacity duration-300 group-hover/card:opacity-100">+</span></div><div class="flex flex-wrap items-start justify-between gap-5"><h3 class="w-[calc(100%-40px)] font-display text-h3 font-medium">Frisch Gestrichen</h3><span class="text-body text-black transition-opacity duration-300 ease-in-out group-hover/card:opacity-100 [@media(hover:hover)]:opacity-0" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 -960 1024 1024" fill="currentColor" aria-hidden="true" focusable="false" class="block shrink-0 size-4"><path transform="scale(1 -1)" d="M477.867 960v-477.867h-477.867v-68.267h477.867v-477.867h68.267v477.867h477.867v68.267h-477.867v477.867z"></path></svg></span></div></a><a href={href('/2025/05/22/altbau-wdvs/')} class="group/card flex flex-col gap-5 text-ink"><div class="relative overflow-hidden"><div class="[clip-path:none]" data-grow="bottom"><Picture src={img3} formats={['avif']} fallbackFormat="webp" alt="Grau verputztes Einfamilienhaus mit Terrasse, Projekt Altbau WDVS" widths={[350, 440, 880]} sizes="(min-width: 1025px) 440px, (min-width: 768px) 315px, 350px" loading="lazy" draggable="false" class="block h-auto w-full transition-transform duration-[450ms] ease-in-out group-hover/card:scale-110 group-hover/card:opacity-80" /></div><span aria-hidden="true" class="pointer-events-none absolute top-1/2 left-1/2 z-10 flex size-17.5 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full bg-black/70 text-[40px]/[22.5px] text-white opacity-0 transition-opacity duration-300 group-hover/card:opacity-100">+</span></div><div class="flex flex-wrap items-start justify-between gap-5"><h3 class="w-[calc(100%-40px)] font-display text-h3 font-medium">Altbau WDVS</h3><span class="text-body text-black transition-opacity duration-300 ease-in-out group-hover/card:opacity-100 [@media(hover:hover)]:opacity-0" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 -960 1024 1024" fill="currentColor" aria-hidden="true" focusable="false" class="block shrink-0 size-4"><path transform="scale(1 -1)" d="M477.867 960v-477.867h-477.867v-68.267h477.867v-477.867h68.267v477.867h477.867v68.267h-477.867v477.867z"></path></svg></span></div></a></div><div><div><a href={href('/projekte/')} class="group/ul inline-flex cursor-pointer items-center justify-center rounded-full border px-7 text-center font-display text-button font-semibold tracking-button uppercase max-sm:min-h-11 sm:min-h-12 py-2 md:px-8.5 lg:px-10 border-black/10 bg-white text-black shadow-[0_1px_2px_rgb(21_24_27/0.06),0_8px_20px_-8px_rgb(21_24_27/0.22)] hover:bg-fog transition-colors duration-300 whitespace-nowrap max-sm:h-11 sm:h-12">Weitere Projekte</a></div></div></div></section></div></div></div>

<script>
  import '../../scripts/home/cta.js';
</script>

