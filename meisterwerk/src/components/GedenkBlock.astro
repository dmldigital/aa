---
import { Picture } from 'astro:assets';
import { href } from '../data/links';
import Button from './ui/Button.astro';

/**
 * Gedenk-Block für den Gründer auf „Über uns“ (Handy und Tablet, eigener Abschnitt vor „Unsere Geschichte“):
 * großes Foto in Schwarz-Weiß, darunter „In Gedenken an“, Name, Lebensdaten, Leitsatz und der Weg zur Gedenkseite.
 * Auftritt: das Foto wächst von unten auf (`data-grow`), die Texte steigen nacheinander auf (`data-anim`).
 */
interface Props {
  member: { name: string; role: string; href: string; img: ImageMetadata; alt: string };
  label: string;
  dates: string;
  line: string;
  cta: string;
  class?: string;
  /** Bis 1024 px stehen „In Gedenken an“, Name und Lebensdaten in der festgehaltenen Bühne des Zeitstrahls davor (nicht doppelt zeigen) */
  headInStage?: boolean;
}
const { member, label, dates, line, cta, class: className = '', headInStage = false } = Astro.props;
const hide = headInStage ? 'max-lg:hidden' : '';
---

<section
  aria-label={`${label.replace(/:\s*$/, '')} ${member.name}`}
  class:list={['grid gap-group md:grid-cols-12 md:items-center md:gap-x-stack', className]}
>
  <div data-grow="bottom" class="overflow-hidden md:col-span-5">
    <Picture
      formats={['avif']}
      fallbackFormat="webp"
      src={member.img}
      alt={member.alt}
      widths={[390, 700, 1024]}
      sizes="(min-width: 1025px) 40vw, (min-width: 768px) 42vw, 100vw"
      loading="lazy"
      class="block aspect-[4/5] w-full object-cover object-[50%_15%] grayscale"
    />
  </div>
  <div class="flex flex-col md:col-span-6 md:col-start-7">
    <p data-anim="fadeIn" class:list={['font-display text-label tracking-label text-gold uppercase', hide]}>
      {label.replace(/:\s*$/, '')}
    </p>
    <h2 data-anim="fadeIn" data-anim-delay="100" class:list={['mt-text font-display text-h1 font-medium text-ink', hide]}>
      {member.name}
    </h2>
    <p data-anim="fadeIn" data-anim-delay="200" class:list={['mt-text font-display text-body tracking-[0.12em] text-muted', hide]}>
      {dates}
    </p>
    <p data-anim="fadeIn" data-anim-delay="300" class="mt-group font-display text-lead text-ink italic">{line}</p>
    <div data-anim="fadeIn" data-anim-delay="400" class="mt-group">
      <Button href={href(member.href)}>{cta}</Button>
    </div>
  </div>
</section>
