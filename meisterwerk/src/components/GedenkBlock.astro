---
import { Picture } from 'astro:assets';

/**
 * Gedenk-Abschnitt für den Gründer auf „Über uns“ (eigene Gedenkseite entfällt, der Text steht hier): links das Foto in
 * Schwarz-Weiß (am Desktop mitlaufend), rechts „In Gedenken an“, Name, Lebensdaten, die Einleitung und das Motto von Vincenzo
 * Fortino. `intro` und `motto` sind der unveränderte HTML-Text der früheren Gedenkseite. Auftritt: das Foto wächst von unten auf
 * (`data-grow`), die Texte steigen nacheinander auf (`data-anim`).
 */
interface Props {
  member: { name: string; role: string; href: string; img: ImageMetadata; alt: string };
  label: string;
  dates: string;
  intro: string;
  motto: string;
  class?: string;
  /** Bis 1024 px stehen „In Gedenken an“, Name und Lebensdaten in der festgehaltenen Bühne des Zeitstrahls davor (nicht doppelt zeigen) */
  headInStage?: boolean;
}
const { member, label, dates, intro, motto, class: className = '', headInStage = false } = Astro.props;
const hide = headInStage ? 'max-lg:hidden' : '';
const prose =
  'flex flex-col gap-text text-body [&_strong]:font-medium [&_strong]:text-ink';
---

<section
  id="gedenken"
  aria-label={`${label.replace(/:\s*$/, '')} ${member.name}`}
  class:list={['grid gap-group md:grid-cols-12 md:items-start md:gap-x-stack', className]}
>
  <div class="md:col-span-5 md:sticky md:top-[14vh]">
    <div data-grow="bottom" class="overflow-hidden">
      <Picture
        formats={['avif']}
        fallbackFormat="webp"
        src={member.img}
        alt={member.alt}
        widths={[390, 700, 1024]}
        sizes="(min-width: 1025px) 40vw, (min-width: 768px) 42vw, 100vw"
        loading="lazy"
        class="block aspect-[4/5] w-full object-cover object-[50%_15%] grayscale"
      />
    </div>
  </div>
  <div class="flex flex-col md:col-span-6 md:col-start-7">
    <p data-anim="fadeIn" class:list={['font-display text-label tracking-label text-gold uppercase', hide]}>
      {label.replace(/:\s*$/, '')}
    </p>
    <h2 data-anim="fadeIn" data-anim-delay="100" class:list={['mt-text font-display text-h1 font-medium text-ink', hide]}>
      {member.name}
    </h2>
    <p data-anim="fadeIn" data-anim-delay="200" class:list={['mt-text font-display text-body tracking-[0.12em] text-muted', hide]}>
      {dates}
    </p>
    <div
      data-anim="fadeIn"
      data-anim-delay="300"
      class:list={[
        prose,
        'mt-group [&>p:first-child]:font-display [&>p:first-child]:text-lead [&>p:first-child]:text-ink [&>p:first-child]:italic',
      ]}
      set:html={intro}
    />
    <div
      data-anim="fadeIn"
      class:list={[prose, 'mt-group border-t border-ink/15 pt-group [&>p:first-child]:font-display [&>p:first-child]:text-h3 [&>p:first-child]:text-ink']}
      set:html={motto}
    />
  </div>
</section>
