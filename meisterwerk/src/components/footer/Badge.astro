---
/** Bewertungs-Badge (statischer Nachbau des Trustindex-Widgets, ohne Fremd-Skript). */
import GoogleLogo from './GoogleLogo.astro';
import Stars from '../ui/Stars.astro';

interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<div class:list={['relative inline-block self-start', className]}>
  <div class="text-center text-[14px]/[19.6px] text-black">
    <div class="inline-block border border-[#cecece] grayscale-[.84]">
      <div class="p-2.5 text-[16.5px]/[23.1px] font-semibold">
        Bestbewerteter
        <br />
        Anbieter 2026
      </div>
      <div class="flex grow basis-0 flex-col items-center justify-center border-y border-[#cecece] p-2.5 text-left whitespace-nowrap">
        <div class="flex flex-wrap">
          <div class="max-w-full grow basis-0 self-center text-center">
            <GoogleLogo class="w-21.5" />
          </div>
        </div>
        <span class="my-0.75 text-[20px]/[28px] font-semibold">5.0</span>
        <Stars size={18} />
      </div>
      <div class="inline-block px-2.5 pt-2.75 pb-2.25 text-[9px]/[12.6px]">
        verifiziert von: Trustindex{' '}
        <svg
          viewBox="0 0 512 512"
          aria-hidden="true"
          class="relative -top-[1.5px] inline-block size-2.25 fill-black"
        >
          <path d="M256 32a224 224 0 1 1 0 448 224 224 0 1 1 0-448zm0 480A256 256 0 1 0 256 0a256 256 0 1 0 0 512zM208 352c-8.8 0-16 7.2-16 16s7.2 16 16 16h96c8.8 0 16-7.2 16-16s-7.2-16-16-16H272V240c0-8.8-7.2-16-16-16H216c-8.8 0-16 7.2-16 16s7.2 16 16 16h24v96H208zm48-168a24 24 0 1 0 0-48 24 24 0 1 0 0 48z" />
        </svg>
      </div>
    </div>
  </div>
  <a
    href="https://share.google/DnitNH9jIeNPjNxgP"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Google-Bewertungen ansehen"
    class="absolute inset-0 z-[5]"
  ></a>
</div>
