---
import { footers } from '../../data/footer';
import type { Site } from '../../data/nav';
import Badge from './Badge.astro';
import Contact from './Contact.astro';
import Copyright from './Copyright.astro';
import Frage from './Frage.astro';
import Legal from './Legal.astro';
import Logos from './Logos.astro';
import Social from './Social.astro';
import ToTop from './ToTop.astro';
/** Variante 1 „Spalten“: eine Zeile mit vier Spalten, darunter eine schmale Leiste. Spalten steigen gestaffelt auf. */
interface Props {
  site?: Site;
}
const { site = 'main' } = Astro.props;
const f = footers[site];
---

<div class="px-5 pt-8 pb-5 lg:px-7.5">
  <div class="mx-auto grid w-full max-w-[min(100%,767px)] gap-x-5 gap-y-8 md:max-w-[min(100%,1024px)] md:grid-cols-6 lg:max-w-[min(100%,1700px)] lg:grid-cols-12">
    <div data-anim="fadeInUp" class="md:col-span-3 lg:col-span-5">
      <Frage {site} />
    </div>
    <div
      data-anim="fadeInUp"
      data-anim-delay="120"
      class="flex items-start gap-5 md:col-span-3 lg:col-span-2"
    >
      {f.badge && <Badge />}
      <Logos {site} which="main" class="w-30 md:hidden" />
    </div>
    <div
      data-anim="fadeInUp"
      data-anim-delay="240"
      class="flex flex-col gap-3 md:col-span-3 lg:col-span-3"
    >
      <Logos {site} which="main" class="hidden w-44.5 md:block" />
      <Contact {site} class="gap-1.5" />
      <Social class="-ml-2.5" />
    </div>
    <div data-anim="fadeInUp" data-anim-delay="360" class="md:col-span-3 lg:col-span-2">
      <Legal {site} copyright={false} class="flex-wrap gap-x-5 gap-y-2 lg:flex-col lg:gap-2.5" />
    </div>
  </div>
  <div class="mx-auto mt-6 flex w-full max-w-[min(100%,767px)] items-center justify-between gap-4 border-t border-black/20 pt-4 md:max-w-[min(100%,1024px)] lg:max-w-[min(100%,1700px)]">
    <Logos {site} which="other" class="w-24" />
    <Copyright class="hidden md:block" />
    <ToTop />
  </div>
</div>
