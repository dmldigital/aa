---
/** Copyright-Zeile als reiner Text (im Original ein Link auf `#`, der nirgends hinführte). */
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<p
  class:list={[
    'font-display text-label font-medium tracking-label text-ink uppercase max-md:text-small max-md:font-normal max-md:tracking-normal max-md:normal-case max-md:text-ink/70',
    className,
  ]}
>
  © 2026 Meisterwerke
</p>
