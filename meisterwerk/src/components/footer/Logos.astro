---
import { Picture } from 'astro:assets';
import { href } from '../../data/links';
import { footers } from '../../data/footer';
import type { Site } from '../../data/nav';
import logo from '../../assets/img/cropped-meisterwerk_malerbetrieb_logo.png';
import exklusive from '../../assets/img/logo_exklusive.png';
import malermanufaktur from '../../assets/img/Malermanufaktur_neu.png';
/**
 * Die beiden Logos des Fußes. `main`: Logo der aktuellen Seite (Link zur Startseite),
 * `other`: das jeweils andere Logo (Hauptseite: Meisterwerke Exklusive, Exklusiv-Seite: Malermanufaktur).
 */
interface Props {
  site?: Site;
  which: 'main' | 'other';
  /** Klassen für das Hüllelement (Reihenfolge, Abstände); `class` gilt für das Bild */
  wrapperClass?: string;
  class?: string;
}
const { site: siteKey = 'main', which, wrapperClass = '', class: className = '' } = Astro.props;
const exk = siteKey === 'exklusive';
const f = footers[siteKey];
// Das schwarze Exklusive-Logo wird als Maske gezeichnet: Die Farbe kommt von `bg-ink` und passt sich damit der Anzeige an,
// auch wenn ein Handy die Seite abdunkelt (ein Bild bliebe schwarz auf dunklem Grund).
const mask = `-webkit-mask:url(${exklusive.src}) center/contain no-repeat;mask:url(${exklusive.src}) center/contain no-repeat`;
---

<div class={wrapperClass}>
  {which === 'main' ? (
    <a
      href={href(f.logoHref)}
      class="block"
      aria-label={
        exk
          ? 'Meisterwerke Exklusive, zur Startseite'
          : 'Meisterwerk Malermanufaktur, zur Startseite'
      }
    >
      {exk ? (
        <span role="img" aria-label="Meisterwerke Exklusive" class:list={['block aspect-[831/325] bg-ink', className]} style={mask}></span>
      ) : (
        <Picture
          formats={['avif']}
          fallbackFormat="webp"
          src={logo}
          alt="Meisterwerk Malermanufaktur"
          widths={[228, 456]}
          sizes="178px"
          class:list={['h-auto', className]}
        />
      )}
    </a>
  ) : exk ? (
    <a href={href('/')} class="block" aria-label="Zur Hauptseite Meisterwerk Malermanufaktur">
      <Picture
        formats={['avif']}
        fallbackFormat="webp"
        src={malermanufaktur}
        alt="Meisterwerk Malermanufaktur"
        widths={[189, 378]}
        sizes="131px"
        class:list={['h-auto', className]}
      />
    </a>
  ) : (
    <a href="https://meisterwerk-exklusive.de/" class="block" aria-label="Meisterwerk Exklusive">
      <span role="img" aria-label="Meisterwerke Exklusive" class:list={['block aspect-[831/325] bg-ink', className]} style={mask}></span>
    </a>
  )}
</div>
