---
/**
 * Der Button der Website: ein einziger, überall gleich großer Button. Pille (rund wie die Menü-Pille), Höhe 48 px (Handy 44 px,
 * wie die Menü-Pille, bei sehr langem Text umbricht er und wächst nur dann), Rahmen 1 px, Schrift Urbanist 14 px halbfett in Großbuchstaben, seitlich großzügig gepolstert, kein
 * Unterstrich. Beim Überfahren bekommt er den weichen grauen Grund wie die Felder der Menü-Pille. Es gibt ihn nur in zwei Farben
 * nach Untergrund: `outline` (weiß mit heller Haarlinie und weichem Schatten) auf hellen Flächen, `light` (durchsichtig mit weißem
 * Rand und weißer Schrift) auf Fotos. Auch Sticker, Footer, Menü und frühere Pfeil-Links („Projekt starten“, „Unser Portfolio“, …)
 * sind dieser Button. Labels ohne Pfeil-Zeichen, die Großschreibung übernimmt der Button. Weitere Attribute (z. B. `data-…`) und
 * `class` gehen an das Element (Position, Animation); eigene `transition-…`-Klassen ersetzen die Farbüberblendung des Buttons.
 */
interface Props extends astroHTML.JSX.HTMLAttributes {
  /** Ohne `href` entsteht ein `<button>` (z. B. Senden-Button im Formular). */
  href?: string;
  variant?: 'light' | 'outline';
  type?: 'submit' | 'button';
}
const { href, variant = 'outline', type = 'submit', class: className, ...rest } = Astro.props;
const Tag = href ? 'a' : 'button';
const variants = {
  light: 'border-white text-white hover:bg-white/15',
  outline:
    'border-black/10 bg-white text-black shadow-[0_1px_2px_rgb(21_24_27/0.06),0_8px_20px_-8px_rgb(21_24_27/0.22)] hover:bg-[#f1f1f1]',
};
// Höhe wie die Menü-Pille (Mindesthöhe, damit ein sehr langer Text umbrechen kann statt über den Rand zu laufen): Handy und Desktop
// getrennt geschrieben (nie Grundwert plus Überschreibung)
const base =
  'group/ul inline-flex cursor-pointer items-center justify-center rounded-full border px-7 text-center font-display text-button font-semibold tracking-button uppercase max-[700px]:min-h-11 min-[701px]:min-h-12 py-2 md:px-8.5 lg:px-10';
const own = String(className ?? '').includes('transition-');
---

<Tag
  {...rest}
  {...(href ? { href } : { type })}
  class:list={[base, !own && 'transition-colors duration-300', variants[variant], className]}
>
  <slot />
</Tag>
