---
/**
 * Rechteckiger Button mit Unterstrich-Animation (Original: Elementor-Button 14px/15,4px).
 * `light` = weiß auf Bild (Rand weiß), `outline` = weiß mit schwarzem Rand.
 */
interface Props {
  /** Ohne `href` entsteht ein `<button>` (z. B. Senden-Button im Formular). */
  href?: string;
  variant?: 'light' | 'outline';
  type?: 'submit' | 'button';
}
const { href, variant = 'outline', type = 'submit' } = Astro.props;
const Tag = href ? 'a' : 'button';
const variants = {
  light: { link: 'border-white', text: 'relative [--underline-gap:0px]' },
  outline: { link: 'border-black', text: '[--underline-gap:3px]' },
};
---

<Tag
  {...(href ? { href } : { type })}
  class:list={[
    'group/ul inline-block cursor-pointer border bg-white px-5 py-3.25 text-center font-display text-button font-semibold tracking-button text-black md:px-6.25 lg:px-7.5 lg:py-3.75',
    variants[variant].link,
  ]}
>
  <span class="flex justify-center gap-1.25">
    <span class:list={['underline-anim', variants[variant].text]}>
      <slot />
    </span>
  </span>
</Tag>
