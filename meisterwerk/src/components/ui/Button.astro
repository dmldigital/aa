---
/**
 * Der Button der Website: ein einziger, überall gleich großer Button. Pille (rund wie die Menü-Pille), Höhe 48 px (Handy 44 px,
 * wie die Menü-Pille, bei sehr langem Text umbricht er und wächst nur dann), Rahmen 1 px, Schrift Urbanist 14 px halbfett in Großbuchstaben, seitlich großzügig gepolstert, kein
 * Unterstrich. Beim Überfahren bekommt er den weichen grauen Grund wie die Felder der Menü-Pille. Es gibt ihn nur in zwei Farben
 * nach Untergrund: `outline` (weiß mit weichem Schatten, ohne Rahmen) auf hellen Flächen, `ghost` (ohne Fläche, für zweite Wege neben einem Hauptbutton), `light` (durchsichtig mit weißem
 * Rand und weißer Schrift) auf Fotos. Auch Sticker, Footer, Menü und frühere Pfeil-Links („Projekt starten“, „Unser Portfolio“, …)
 * sind dieser Button. Labels ohne Pfeil-Zeichen, die Großschreibung übernimmt der Button. Weitere Attribute (z. B. `data-…`) und
 * `class` gehen an das Element (Position, Animation); eigene `transition-…`-Klassen ersetzen die Farbüberblendung des Buttons.
 *
 * Lange Beschriftungen (ein ganzer Satz, ab sechs Wörtern) und `href` ergeben keinen Button, sondern einen Textlink: goldene Schrift in
 * normaler Schreibweise mit kleinem Pfeil, beim Überfahren dunkel (auf Fotos: weiß). So wirken ganze Sätze nicht wie eine Schaltfläche.
 */
interface Props extends astroHTML.JSX.HTMLAttributes {
  /** Ohne `href` entsteht ein `<button>` (z. B. Senden-Button im Formular). */
  href?: string;
  variant?: 'light' | 'outline' | 'ghost' | 'dark';
  type?: 'submit' | 'button';
  /** Nur mit `href` (Link): z. B. `_blank` mit `rel="noopener noreferrer"`. */
  target?: '_blank' | '_self' | '_parent' | '_top';
  rel?: string;
}
const { href, variant = 'outline', type = 'submit', class: className, ...rest } = Astro.props;
const Tag = href ? 'a' : 'button';
const variants = {
  light: 'border-white text-white hover:bg-white/15',
  outline:
    'border-transparent bg-white text-black shadow-[0_1px_2px_rgb(21_24_27/0.06),0_8px_20px_-8px_rgb(21_24_27/0.22)] hover:bg-[#f1f1f1]',
  ghost: 'border-transparent bg-transparent text-black hover:bg-black/5',
  // Hauptweg in Abläufen auf hellgrauem Grund (Projektanfrage: Weiter, Senden): dunkle Fläche, gut erkennbar auch für Brillenträger
  dark: 'border-transparent bg-ink text-white hover:bg-gold',
};
// Höhe wie die Menü-Pille (Mindesthöhe, damit ein sehr langer Text umbrechen kann statt über den Rand zu laufen): Handy und Desktop
// getrennt geschrieben (nie Grundwert plus Überschreibung)
const base =
  'group/ul inline-flex cursor-pointer items-center justify-center rounded-full border px-7 text-center font-display text-button font-semibold tracking-button uppercase max-[700px]:min-h-11 min-[701px]:min-h-12 py-2 md:px-8.5 lg:px-10';
const own = String(className ?? '').includes('transition-');
// Beschriftung als Text lesen: Bei einem ganzen Satz wird aus dem Button ein Link
const content = await Astro.slots.render('default');
const words = content.replace(/<[^>]+>/g, ' ').replace(/&nbsp;/g, ' ').trim().split(/\s+/).filter(Boolean).length;
const asLink = Boolean(href) && words >= 6;
const linkBase =
  'group/lk inline-flex max-w-[36rem] items-start gap-2.5 text-left font-display text-body font-medium transition-colors duration-300';
const linkTone = variant === 'light' ? 'text-white hover:text-white/70' : 'text-gold hover:text-ink';
---

{asLink ? (
  <a {...rest} href={href} class:list={[linkBase, linkTone, className]}>
    <span set:html={content} />
    <svg class="mt-[0.45em] size-4 shrink-0 transition-transform duration-300 group-hover/lk:translate-x-1" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true" focusable="false"><path d="M2 8h11" /><path d="m9 4 4 4-4 4" /></svg>
  </a>
) : (
  <Tag
    {...rest}
    {...(href ? { href } : { type })}
    class:list={[base, !own && 'transition-colors duration-300', variants[variant], className]}
  >
    <Fragment set:html={content} />
  </Tag>
)}
