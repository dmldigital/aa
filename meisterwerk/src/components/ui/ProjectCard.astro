---
import { Picture } from 'astro:assets';
import { href } from '../../data/links';
import Icon from '../Icon.astro';

/**
 * Projektkarte (Original: Karussell auf der Startseite und Raster auf /projekte/).
 * Bild mit Zoom beim Darüberfahren, "+" im Kreis, Titel und Plus-Symbol.
 * Weitere Attribute (z. B. `data-anim`, `aria-hidden`) gehen an den Link.
 */
interface Props extends astroHTML.JSX.AnchorHTMLAttributes {
  project: { title: string; href: string; img: ImageMetadata; alt: string };
  /** Bild fährt beim Erscheinen von unten auf (Original: imageGrowWithScaleBottom). */
  reveal?: boolean;
  /** Reveal-Wrapper ohne Ausgangs-Clip (Karussell: Karten stehen sofort sichtbar). */
  instant?: boolean;
  lazy?: boolean;
  /** Größe des Plus-Symbols neben dem Titel (Standard 16 px). */
  iconClass?: string;
}
const {
  project: p,
  reveal = false,
  instant = false,
  lazy = false,
  iconClass = 'size-4',
  class: className,
  ...rest
} = Astro.props;
const picture = {
  formats: ['avif'] as ['avif'],
  fallbackFormat: 'webp' as const,
  src: p.img,
  alt: p.alt,
  widths: [350, 440, 880],
  sizes: '(min-width: 1025px) 440px, (min-width: 768px) 315px, 350px',
  class:
    'block h-auto w-full transition-transform duration-[450ms] ease-in-out group-hover/card:scale-110 group-hover/card:opacity-80',
};
---

<a
  {...rest}
  href={href(p.href)}
  class:list={['group/card flex flex-col gap-5 text-ink', className]}
>
  <div class="relative overflow-hidden">
    {reveal ? (
      <div class:list={[instant && '[clip-path:none]']} data-grow="bottom">
        <Picture {...picture} loading={lazy ? 'lazy' : undefined} draggable="false" />
      </div>
    ) : (
      <Picture {...picture} loading={lazy ? 'lazy' : undefined} draggable="false" />
    )}
    <span
      aria-hidden="true"
      class="pointer-events-none absolute top-1/2 left-1/2 z-10 flex size-17.5 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full bg-black/70 text-[40px]/[22.5px] text-white opacity-0 transition-opacity duration-300 group-hover/card:opacity-100"
    >
      +
    </span>
  </div>
  <div class="flex flex-wrap items-start justify-between gap-5">
    <h4 class="w-[calc(100%-40px)] font-display text-h3 font-medium">
      {p.title}
    </h4>
    <span
      class="text-body text-black transition-opacity duration-300 ease-in-out group-hover/card:opacity-100 [@media(hover:hover)]:opacity-0"
      aria-hidden="true"
    >
      <Icon name="plus" class:list={['block shrink-0', iconClass]} />
    </span>
  </div>
</a>
