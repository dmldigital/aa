---
/**
 * Fünf Sterne als Reihe: unten graue Sterne, darüber goldene, die von links gezeigt werden. Wie weit, bestimmt die
 * CSS-Variable `--p` (0 bis 1) am Element oder an einem Elternelement, Standard 1 = alle fünf voll. So lässt sich die
 * Füllung beim Hochzählen der Bewertung weich von links nach rechts ziehen (`data-rating-fill` ist der Griff dafür).
 */
interface Props {
  /** Kantenlänge eines Sterns in px */
  size?: number;
  class?: string;
}
const { size = 18, class: className = '' } = Astro.props;
const row = [0, 1, 2, 3, 4];
---

<span class:list={['relative inline-block leading-[0]', className]} role="img" aria-label="5 von 5 Sternen">
  <span class="flex gap-px" aria-hidden="true">
    {row.map(() => (
      <svg viewBox="0 0 16 15" class="shrink-0" style={`width:${size}px;height:${size}px`}>
        <g transform="matrix(1,0,0,1,-427.432,-259.996)">
          <g transform="matrix(1.01647,0,0,1.01647,-14.9846,-123.719)">
            <path
                    fill="#DEDEDE"
