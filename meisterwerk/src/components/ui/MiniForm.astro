---
/**
 * Mini-Kontaktformular (wie auf der Startseite in „Jede Oberfläche ist einzigartig“): Name, Telefon oder E-Mail, Leistung,
 * Ort, Nachricht, Linienfelder ohne Kasten. Versand über `scripts/senden.ts` (Skript in `Menu.astro` für alle
 * `form[data-menu-form]`, Cloudflare Pages Function mit Turnstile und Resend). `service` wählt die Leistung vor
 * (z. B. auf einer Leistungsseite), `exklusive` tauscht die Leistungsliste gegen die Exklusiv-Leistungen.
 * Variante `anfrage` (Zielseiten der Anzeigen unter /anfrage/): „PLZ oder Ort“ ist Pflicht, die Nachricht ist freiwillig, der Knopf
 * heißt „Anfrage senden“, der Titel entfällt (die Sektion hat ihn). `danke` ist die Adresse, auf die nach dem Absenden weitergeleitet
 * wird (Attribut `data-danke`, ausgewertet im Skript von `sections/Menu.astro`).
 */
import Button from './Button.astro';
import Falle from './Falle.astro';
import { site } from '../../data/site';
import { href } from '../../data/links';

interface Props {
  title?: string;
  /** Vorgewählte Leistung (muss in der Liste stehen) */
  service?: string;
  exklusive?: boolean;
  variant?: 'standard' | 'anfrage';
  /** Weiterleitung nach erfolgreichem Absenden (nur mit Skript aus `sections/Menu.astro`) */
  danke?: string;
  class?: string;
}
const { variant = 'standard', service = '', exklusive = false, danke, class: className = '' } = Astro.props;
const anfrage = variant === 'anfrage';
const { title = anfrage ? '' : 'Wie können wir Ihnen helfen?' } = Astro.props;

const main = ['Malerarbeiten', 'Tapezierarbeiten', 'Lackierarbeiten', 'Verputzarbeiten', 'Glatte Oberflächen'];
const exk = ['Fugenlose Bäder', 'Fugenlose Böden', 'Spachteltechniken', 'Stuckleisten'];
const options = [...(exklusive ? exk : [...main, ...exk]), 'Etwas anderes'];

const field = 'flex min-w-0 flex-col gap-0.5';
const label = 'font-display text-label tracking-label text-muted uppercase';
const input =
  'field w-full py-3 font-display text-body text-ink';
---

<form data-menu-form data-danke={danke} aria-label={anfrage ? 'Anfrage' : 'Kurze Nachricht'} class:list={['flex w-full flex-col gap-5', className]}>
  {title && <h3 class="font-display text-h3 text-ink">{title}</h3>}
  <Falle />
  <div class="grid gap-x-8 gap-y-4 md:grid-cols-2">
    <label class={field}>
      <span class={label}>Name</span>
      <input type="text" name="name" autocomplete="name" required class={input} />
    </label>
    <label class={field}>
      <span class={label}>Telefon oder E-Mail</span>
      <input type="text" name="kontakt" autocomplete="email" required class={input} />
    </label>
    <label class={field}>
      <span class={label}>Leistung</span>
      <select name="leistung" class={`${input} appearance-none bg-[url("data:image/svg+xml,%3Csvg%20xmlns=%27http://www.w3.org/2000/svg%27%20viewBox=%270%200%2012%208%27%20fill=%27none%27%20stroke=%27%23090402%27%20stroke-width=%271.3%27%3E%3Cpath%20d=%27M1%201.5l5%205%205-5%27/%3E%3C/svg%3E")] bg-[length:12px] bg-[right_2px_center] bg-no-repeat pr-6`}>
        <option value="">Bitte wählen</option>
        {options.map((o) => <option selected={o === service}>{o}</option>)}
      </select>
    </label>
    <label class={field}>
      <span class={label}>{anfrage ? 'PLZ oder Ort' : 'Ort'}</span>
      {anfrage
        ? <input type="text" name="ort" autocomplete="address-level2" required data-label="PLZ oder Ort" class={input} />
        : <input type="text" name="ort" autocomplete="address-level2" class={input} />}
    </label>
    <label class={`${field} md:col-span-2`}>
      <span class={label}>{anfrage ? 'Was soll gemacht werden? (optional)' : 'Ihre Nachricht'}</span>
      <textarea name="nachricht" rows="2" required={!anfrage} class={`${input} min-h-12 resize-none`}></textarea>
    </label>
  </div>
  <div class="flex flex-wrap items-center gap-x-5 gap-y-3">
    <Button type="submit">{anfrage ? 'Anfrage senden' : 'Nachricht senden'}</Button>
    <p role="status" aria-live="polite" data-form-message hidden class="min-w-55 flex-1 text-small text-muted"></p>
  </div>
  <div data-turnstile-slot></div>
  <p class="text-small text-muted">
    Ihre Angaben verwenden wir nur zur Bearbeitung Ihrer Anfrage. Mehr dazu in der{' '}
    <a href={href(exklusive ? '/meisterwerk-exklusive/datenschutzerklaerung/' : '/datenschutzerklaerung/')} class="text-gold transition-colors duration-300 hover:text-ink">Datenschutzerklärung</a>.
  </p>
  <p class="text-small text-muted">
    Direkt erreichen Sie uns unter{' '}
    <a href={`tel:${site.phoneHref}`} class="text-gold transition-colors duration-300 hover:text-ink">{site.phone}</a>
    {' '}oder{' '}
    <a href={`mailto:${site.email}`} class="text-gold transition-colors duration-300 hover:text-ink">{site.email}</a>
  </p>
</form>
