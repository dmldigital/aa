---
/**
 * Großansicht für Bilder (Leistungsgalerie, Qualifikationen): dunkle Fläche, Pfeile, Schließen-Knopf. Die Bedienung
 * (Klick, Pfeiltasten, Esc, Wischen, Fokus-Falle, Lenis angehalten) steckt in `scripts/lightbox.ts` (`initLightbox`).
 */
import Icon from '../Icon.astro';
---

<div class="lb" data-lb hidden role="dialog" aria-modal="true" aria-label="Bildansicht">
  <button type="button" class="lb-btn lb-close" data-lb-close aria-label="Schließen">
    <Icon name="plus" class="size-5 rotate-45" />
  </button>
  <button type="button" class="lb-btn lb-prev" data-lb-prev aria-label="Voriges Bild">
    <Icon name="arrow-left" class="size-4" />
  </button>
  <button type="button" class="lb-btn lb-next" data-lb-next aria-label="Nächstes Bild">
    <Icon name="arrow-right" class="size-4" />
  </button>
  <figure class="lb-fig"><img data-lb-img alt="" /></figure>
</div>

<style>
  .lb {
    position: fixed;
    inset: 0;
    z-index: 120;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgb(9 4 2 / 0.94);
    opacity: 0;
    transition: opacity 0.35s ease;
  }
  .lb[hidden] {
    display: none;
  }
  .lb.is-open {
    opacity: 1;
  }
  .lb-fig {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 72px 20px;
  }
  .lb-fig img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .lb-fig img.is-in {
    opacity: 1;
  }
  .lb-btn {
    position: absolute;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border: 1px solid #fff;
    background: transparent;
    color: #fff;
    cursor: pointer;
    transition:
      background-color 0.3s ease,
      color 0.3s ease;
  }
  .lb-btn:hover,
  .lb-btn:focus-visible {
    background: #fff;
    color: var(--color-ink);
  }
  .lb-close {
    top: 20px;
    right: 20px;
  }
  .lb-prev,
  .lb-next {
    top: 50%;
    margin-top: -24px;
  }
  .lb-prev {
    left: 20px;
  }
  .lb-next {
    right: 20px;
  }
  @media (min-width: 768px) {
    .lb-fig {
      padding: 80px 90px;
    }
  }
  @media (min-width: 1025px) {
    .lb-fig {
      padding: 60px 120px;
    }
  }
</style>
