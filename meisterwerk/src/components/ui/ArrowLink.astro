---
import Icon from '../Icon.astro';

/** Text-Link in Gold oder Schwarz mit Pfeil rechts und Unterstrich-Animation (Original: "Projekt starten", "Unser Portfolio"). */
interface Props {
  href: string;
  tone?: 'gold' | 'black';
  gap?: '0px' | '3px';
}
const { href, tone = 'gold', gap = '0px' } = Astro.props;
---

<a
  {href}
  class:list={[
    'group/ul inline-flex flex-row-reverse gap-2.5 font-display text-button font-semibold tracking-button',
    tone === 'gold' ? 'text-gold' : 'text-black',
  ]}
>
  <span class="flex w-3.75 items-center">
    <Icon name="arrow-right" class="block size-3.5 shrink-0" />
  </span>
  <span
    class:list={[
      'underline-anim relative',
      gap === '3px' ? '[--underline-gap:3px]' : '[--underline-gap:0px]',
    ]}
  >
    <slot />
  </span>
</a>
