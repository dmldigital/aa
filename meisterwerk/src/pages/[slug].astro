---
/** Mitarbeiterprofile: eine Route für alle Einträge der Collection `profile`, dargestellt mit der Profil-Vorlage. */
import { getCollection } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';
import ProfileTemplate from '../components/profile/ProfileTemplate.astro';

export async function getStaticPaths() {
  const profiles = await getCollection('profile');
  return profiles.map(({ data }) => ({ params: { slug: data.slug }, props: { profile: data } }));
}

const { profile } = Astro.props;
---

<PageLayout title={profile.title} description={profile.description} current={`/${profile.slug}/`}>
  <ProfileTemplate {profile} />
</PageLayout>
