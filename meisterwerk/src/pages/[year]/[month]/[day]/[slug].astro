---
/** Projektbeiträge: eine Route für alle Einträge der Collection `beitraege`. */
import { getCollection } from 'astro:content';
import PageLayout from '../../../../layouts/PageLayout.astro';
import ProjectPage from '../../../../components/projekte/ProjectPage.astro';
import { placeTitle } from '../../../../lib/seo';

export async function getStaticPaths() {
  const posts = await getCollection('beitraege');
  return posts.map(({ data }) => ({
    params: { year: data.year, month: data.month, day: data.day, slug: data.slug },
    props: { post: data },
  }));
}

const { post } = Astro.props;
---

<PageLayout
  title={placeTitle(post.title, post.info.place, 30)}
  description={post.description}
  current={`/${post.year}/${post.month}/${post.day}/${post.slug}/`}
>
  <ProjectPage {post} />
</PageLayout>
