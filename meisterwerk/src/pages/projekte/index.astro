---
import PageLayout from '../../layouts/PageLayout.astro';
import PageHeader from '../../components/sections/PageHeader.astro';
import ProjectRows from '../../components/projekte/ProjectRows.astro';
import MiniFormSection from '../../components/sections/MiniFormSection.astro';
import Surface from '../../components/sections/Surface.astro';
import { meta, intro } from '../../data/pages/projekte';
---

<PageLayout title={meta.title} description={meta.description} current="/projekte/">
  <PageHeader
    label="Referenzen"
    title={intro.heading}
    paragraphs={intro.paragraphs}
    image={intro.image}
    imageAlt="Dunkles Gäste-WC mit mineralisch gespachtelter Wand und indirekter LED-Beleuchtung"
  />
  <ProjectRows />
  <MiniFormSection
    title="Ihr Projekt in Ludwigsburg besprechen"
    text="Ein Vorhaben wie diese Projekte im Kopf? Schreiben Sie uns kurz, worum es geht. Wir melden uns persönlich bei Ihnen und besprechen alles Weitere, auf Wunsch im Showroom in Freiberg am Neckar."
  />
  <Surface rootClass="mt-0" />
</PageLayout>
