---
import PageLayout from '../../../layouts/PageLayout.astro';
import PageIntro from '../../../components/sections/PageIntro.astro';
import ProjectGrid from '../../../components/sections/ProjectGrid.astro';
import MiniFormSection from '../../../components/sections/MiniFormSection.astro';
import { projekte } from '../../../data/pages/exklusive-start';
import { exklusiveMeta, exklusiveIntro } from '../../../data/pages/projekte';
---

<PageLayout
  site="exklusive"
  title={exklusiveMeta.title}
  description={exklusiveMeta.description}
  current="/meisterwerk-exklusive/projekte/"
>
  <PageIntro
    id="b9d36c5"
    label="Meisterwerke Exklusive"
    heading={exklusiveIntro.heading}
    paragraphs={exklusiveIntro.paragraphs}
    image={exklusiveIntro.image}
    imageAlt="Dunkles Gäste-WC mit mineralisch gespachtelter Wand und indirekter LED-Beleuchtung"
    textClass="lg:pr-2.5"
    bodyClass="[&>p]:mb-4 md:[&>p]:mb-3.75 lg:[&>p]:mb-para"
  />
  <ProjectGrid id="6dc4e82" projects={projekte.items} iconClass="size-2.5 mt-1.5" />
  <MiniFormSection
    exklusive
    title="Ihr Projekt in Ludwigsburg besprechen"
    text="Ein Vorhaben wie diese Projekte im Kopf? Schreiben Sie uns kurz, worum es geht. Wir melden uns persönlich bei Ihnen und besprechen alles Weitere, auf Wunsch im Showroom in Freiberg am Neckar."
  />
</PageLayout>
