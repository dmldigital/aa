---
/** Projektbeiträge der Teil-Website /meisterwerk-exklusive/: eine Route für alle Einträge der Collection `exklusiv-beitraege`. */
import { getCollection } from 'astro:content';
import PageLayout from '../../../../../layouts/PageLayout.astro';
import PostHead from '../../../../../components/sections/PostHead.astro';
import PostArticle from '../../../../../components/sections/PostArticle.astro';
import MiniFormSection from '../../../../../components/sections/MiniFormSection.astro';
import PostRelated from '../../../../../components/sections/PostRelated.astro';
import { related } from '../../../../../data/pages/exklusive-posts';
import { projectHeading } from '../../../../../lib/seo';

export async function getStaticPaths() {
  const posts = await getCollection('exklusiv-beitraege');
  return posts.map(({ data }) => ({
    params: { year: data.year, month: data.month, day: data.day, slug: data.slug },
    props: { post: data },
  }));
}

const { post } = Astro.props;
// Mini-Formular: die erste passende Exklusiv-Leistung des Projekts vorwählen
const exkServices: [RegExp, string][] = [
  [/^Fugenlose[sn]? Bad|^Fugenlose Bäder/, 'Fugenlose Bäder'],
  [/^Fugenlose[rn]? Bo|^Fugenlose Böden/, 'Fugenlose Böden'],
  [/^Spachteltechnik/, 'Spachteltechniken'],
  [/^Stuck/, 'Stuckleisten'],
];
const formService = post.services.map((n) => exkServices.find(([re]) => re.test(n))?.[1]).find(Boolean);
---

<PageLayout
  title={post.pageTitle}
  description={post.description}
  site="exklusive"
  current={`/meisterwerk-exklusive/${post.year}/${post.month}/${post.day}/${post.slug}/`}
>
  <PostHead
    title={projectHeading(post.title, post.services, post.info.place)}
    category={post.category}
    categoryHref={post.categoryHref}
    date={post.date}
  />
  <PostArticle
    {post}
    imageAlt={post.imageAlt}
    columns={post.galleryColumns}
    galleryLayout="grid"
    labelClass="text-label"
    servicesClass="md:ml-0"
    tone="soft"
  />
  <PostRelated items={related} tone="white" />
  <MiniFormSection
    exklusive
    service={formService}
    title="Ihr Projekt in Ludwigsburg besprechen"
    text="Sie planen etwas Ähnliches? Schreiben Sie uns kurz, worum es geht. Wir melden uns persönlich bei Ihnen und besprechen Ihr Vorhaben, auf Wunsch im Showroom in Freiberg am Neckar."
  />
</PageLayout>
