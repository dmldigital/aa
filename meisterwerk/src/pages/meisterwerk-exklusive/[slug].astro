---
import PageLayout from '../../layouts/PageLayout.astro';
import Intro from '../../components/sections/Intro.astro';
import SectionHeading from '../../components/sections/SectionHeading.astro';
import Pillars from '../../components/sections/Pillars.astro';
import Feature from '../../components/sections/Feature.astro';
import Gallery from '../../components/sections/Gallery.astro';
import Projects from '../../components/sections/Projects.astro';
import { img } from '../../lib/img';
import { pages, EXCELLENCE, projects } from '../../data/pages/exklusive';

export function getStaticPaths() {
  return pages.map((page) => ({ params: { slug: page.slug }, props: { page } }));
}
const { page } = Astro.props;
// Die Seite „Fugenlose Bäder“ hat im Original andere Abstände als die übrigen drei
const old = page.slug === 'fugenlose-baeder';
---

<PageLayout title={page.title} current={`/meisterwerk-exklusive/${page.slug}/`}>
  <Intro
    id="aeb8cf0"
    img={img(page.intro.img)}
    parts={page.intro.parts}
    rootClass="bg-white"
    innerClass="lg:pb-0"
    leftClass="md:w-[46%] md:flex-none"
    rightClass="md:w-1/2 md:flex-none lg:px-[8%]"
  />
  <SectionHeading
    id="4ef4fcc"
    title={EXCELLENCE}
    widthClass="lg:max-w-[534px]"
    rootClass={old ? 'mb-5 md:mb-6.25 lg:mb-0' : undefined}
  />
  <Pillars
    id="ef1acb3"
    items={page.pillars}
    titleClass="text-[19px]/[24.7px] md:text-[18px]/[23.4px] lg:text-h5"
    rootClass={old ? 'mb-0' : undefined}
  />
  <Feature
    items={page.feature.accordion}
    button={page.feature.button}
    img={img(page.feature.img)}
    rootClass={old ? 'mt-[12vh]' : undefined}
  />
  <Gallery
    id={page.gallery.id}
    items={page.gallery.items}
    columns={page.gallery.columns}
    gap={[20, 10, 10]}
    rootClass={old ? 'mt-[12vh] mb-0' : 'mb-0'}
    innerClass={
      old ? 'pt-10 pb-7.5 md:pt-15 lg:pt-0 lg:pb-25' : 'pt-10 pb-7.5 md:pt-15 lg:pt-27 lg:pb-10'
    }
  />
  <Projects
    id={page.projectsId}
    heading={projects.heading}
    link={projects.link}
    projects={projects.items}
  />
</PageLayout>
