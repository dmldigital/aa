---
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import WelcomeScroll from '../../components/sections/WelcomeScroll.astro';
import ServiceBenefits from '../../components/service/ServiceBenefits.astro';
import ServiceBlocks from '../../components/service/ServiceBlocks.astro';
import ServiceGallery from '../../components/service/ServiceGallery.astro';
import ServiceExcellence from '../../components/service/ServiceExcellence.astro';
import Projects from '../../components/sections/Projects.astro';
import MoreServices from '../../components/service/MoreServices.astro';
import MiniFormSection from '../../components/sections/MiniFormSection.astro';
import { href } from '../../data/links';
import { EXCELLENCE, projects } from '../../data/pages/exklusive';

export async function getStaticPaths() {
  const pages = await getCollection('exklusiv-leistungen');
  return pages.map(({ data }) => ({ params: { slug: data.slug }, props: { page: data } }));
}
const { page } = Astro.props;

/**
 * Schema wie die Leistungsseiten der Hauptseite (`pages/services/[slug].astro`): Willkommen-Szene mit laufenden Bildern,
 * Vorteile als Karten (wenn der erste Block eine Vorteile-Liste ist), die übrigen Blöcke samt den Punkten des früheren
 * Akkordeons als Textblöcke, Galerie, „Exzellenz ist unser Maßstab“ als Karten, darunter die Projekte.
 * Die Nummern der Blöcke („01“) entfallen.
 */
const parts = page.intro.parts;
const name = page.title.split(' - ')[0];
const alt = `${name} von Meisterwerke Exklusive`;

// Einleitung: Überschrift und Absätze (im Original in verschachtelten Containern)
const lead = parts.find((p) => p.t === 'html');
const leadHtml = lead && lead.t === 'html' ? lead.html : '';
// Ortsbezug (Ludwigsburg, Freiberg am Neckar): Überschrift, ein Satz im Text, Galerie-Überschrift
const local: Record<string, { h1: string; sentence: string; gallery: string }> = {
  'fugenlose-baeder': {
    h1: 'Fugenlose Bäder in Ludwigsburg: Was macht sie besonders?',
    sentence:
      'Fugenlose Bäder planen und gestalten wir für Kunden in Ludwigsburg, Marbach, Bietigheim-Bissingen und Stuttgart, als Betrieb aus Freiberg am Neckar.',
    gallery: 'Einblicke: Fugenlose Bäder aus Ludwigsburg und Umgebung',
  },
  'fugenloser-boden': {
    h1: 'Fugenlose Böden in Ludwigsburg: Was macht sie besonders?',
    sentence:
      'Fugenlose Böden führen wir in Ludwigsburg und Umgebung aus. Muster sehen Sie im Showroom in Freiberg am Neckar.',
    gallery: 'Einblicke: Fugenlose Böden aus Ludwigsburg und Umgebung',
  },
  spachteltechniken: {
    h1: 'Das Besondere an Spachteltechniken in Ludwigsburg',
    sentence:
      'Spachteltechniken für Wände und Decken setzen wir in Ludwigsburg, Marbach, Bietigheim-Bissingen und Stuttgart um.',
    gallery: 'Einblicke: Spachteltechniken aus Ludwigsburg und Umgebung',
  },
  stuckleisten: {
    h1: 'Das Besondere an Stuckleisten in Ludwigsburg',
    sentence: 'Stuckleisten für indirektes und direktes Licht montieren wir in Ludwigsburg und Umgebung.',
    gallery: 'Einblicke: Stuckleisten aus Ludwigsburg und Umgebung',
  },
};
const loc = local[page.slug];
const heading = loc?.h1 ?? leadHtml.match(/<h2[^>]*>([\s\S]*?)<\/h2>/)?.[1].trim() ?? name;
const paragraphs = [
  ...[...leadHtml.matchAll(/<p[^>]*>([\s\S]*?)<\/p>/g)].map((m) => m[1].replace(/^(?:&nbsp;|\s)+/, '').trim()).filter(Boolean),
  ...(loc ? [loc.sentence] : []),
];

const buttons = parts.flatMap((p) => (p.t === 'button' ? [p] : []));
const blocks = parts.flatMap((p) => (p.t === 'block' ? [{ title: p.title, html: p.html }] : []));
const label = parts.flatMap((p) => (p.t === 'label' ? [p.text] : []))[0] ?? 'Die Vorteile auf einen Blick';

// Erster Block „Vorteile …“ mit einer Liste aus „Titel: Text“ wird zu Karten
const first = blocks[0];
const strongItems = first?.html.match(/<li>\s*(?:<p>)?\s*<strong>/g)?.length ?? 0;
const benefits = first && /^Vorteile/.test(first.title) && strongItems >= 3 ? first : null;
const benefitsList = benefits?.html.match(/<ul[\s\S]*<\/ul>/)?.[0] ?? '';
const benefitsIntro = benefits?.html.split('<ul')[0].replace(/<[^>]+>/g, '').trim() ?? '';
const textBlocks = [
  ...(benefits ? blocks.slice(1) : blocks),
  ...page.feature.accordion.map((a) => ({ title: a.title, html: a.html })),
];

// Bilder: drei laufen in der Szene, die Galerie zeigt zuerst die übrigen, danach die der Szene
const pool = [page.intro.img, page.feature.img, ...page.gallery.items];
const seen = new Set<string>();
const unique = pool.filter((i) => !seen.has(i.src) && seen.add(i.src));
const sceneImages = unique.slice(0, 3).map((src, n) => ({ src, alt: `${alt}, Bild ${n + 1}` }));
const gallery = [...unique.slice(3), ...unique.slice(0, 3)];

// Mini-Formular: passende Leistung vorwählen
const formService: Record<string, string> = {
  'fugenlose-baeder': 'Fugenlose Bäder',
  'fugenloser-boden': 'Fugenlose Böden',
  spachteltechniken: 'Spachteltechniken',
  stuckleisten: 'Stuckleisten',
};
const cta = buttons[0];
const closing = buttons[1];
---

<PageLayout site="exklusive" title={page.title} description={page.description} current={`/meisterwerk-exklusive/${page.slug}/`}>
  <WelcomeScroll
    heading={heading}
    paragraphs={paragraphs}
    images={sceneImages}
    closing={null}
    headingTag="h1"
    cta={cta ? { label: cta.label, href: href(cta.href) } : undefined}
    rootClass="mt-6 mb-[10vh] md:mt-8 md:mb-15 lg:mt-10 lg:mb-[20vh]"
  />
  {benefits && <ServiceBenefits label={label} title={`${benefits.title} in Ludwigsburg`} list={benefitsList} intro={benefitsIntro} />}
  <ServiceBlocks
    class="pb-0!"
    blocks={textBlocks}
    cta={closing ? { label: closing.label, href: href(closing.href) } : undefined}
  />
  <ServiceGallery images={gallery} alt={alt} heading={loc?.gallery} start={4} />
  <ServiceExcellence title={EXCELLENCE} items={page.pillars} />
  <Projects
    id={page.projectsId}
    heading={projects.heading}
    link={projects.link}
    projects={projects.items}
  />
  <MoreServices exklusive current={`/meisterwerk-exklusive/${page.slug}/`} tone="soft" />
  <MiniFormSection
    exklusive
    service={formService[page.slug]}
    class="bg-white!"
    title={`Ihr Projekt zu ${name} besprechen`}
    text="Schreiben Sie uns kurz, worum es geht. Wir melden uns persönlich bei Ihnen und besprechen Ihr Vorhaben, auf Wunsch im Showroom in Freiberg am Neckar."
  />
</PageLayout>
