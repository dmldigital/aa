---
import PageLayout from '../../../layouts/PageLayout.astro';
import PageHeader from '../../../components/sections/PageHeader.astro';
import MiniFormSection from '../../../components/sections/MiniFormSection.astro';
import HolidaySteps from '../../../components/sections/HolidaySteps.astro';
import {
  exklusiveMeta,
  exklusiveIntro,
  background,
  columns,
} from '../../../data/pages/urlaubsservice';
---

<PageLayout
  site="exklusive"
  title={exklusiveMeta.title}
  description={exklusiveMeta.description}
  current="/meisterwerk-exklusive/urlaub/"
>
  <PageHeader
    label={exklusiveIntro.eyebrow}
    title={exklusiveIntro.heading}
    paragraphs={[exklusiveIntro.text]}
    image={exklusiveIntro.image}
    imageAlt="Drei Palmen in Schwarzweiß am Strand, Sinnbild für den Urlaub"
  />
  <HolidaySteps {background} {columns} boxed tone="soft" />
  <MiniFormSection
    exklusive
    class="bg-white!"
    title="Ihren Urlaubsservice in Ludwigsburg besprechen"
    text="Schreiben Sie uns kurz, wann Sie verreisen und was in der Zeit gemacht werden soll. Wir melden uns persönlich bei Ihnen und klären gemeinsam den Ablauf."
  />
</PageLayout>
