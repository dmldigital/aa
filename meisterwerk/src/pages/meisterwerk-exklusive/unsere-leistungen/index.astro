---
import PageLayout from '../../../layouts/PageLayout.astro';
import Services from '../../../components/sections/Services.astro';
import Projects from '../../../components/sections/Projects.astro';
import { leistungen, projekte } from '../../../data/pages/exklusive-start';
---

<PageLayout
  site="exklusive"
  title="Unsere Leistungen - Meisterwerke Exklusive"
  current="/meisterwerk-exklusive/unsere-leistungen/"
>
  <Services
    id="7031ea3"
    eyebrow={leistungen.eyebrow}
    heading={leistungen.heading}
    cards={leistungen.cards}
    rootClass="mt-[10vh] md:mt-0 md:mb-15 lg:mt-0 lg:mb-[10vh]"
    headingTag="h2"
    headingClass="text-h2 text-ink"
    gridClass="lg:grid-cols-4"
    titleClass="text-h4 lg:text-h3"
    titleBoxClass="w-[calc(100%-40px)]"
  />
  <Projects
    id="45bbbaf"
    heading={projekte.heading}
    link={projekte.link}
    projects={projekte.items}
    headingTag="h2"
    headingClass="text-h2 font-medium text-ink"
    linkTone="black"
  />
</PageLayout>
