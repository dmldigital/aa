---
/**
 * Seiten der Teil-Website /meisterwerk-exklusive/, die nicht zu `[slug].astro` (Leistungsseiten) gehören:
 * die zwei Kollektionsseiten (Collection `kollektionen`). Über uns und die Mitarbeiterprofile gibt es nur auf der
 * Hauptseite (Nutzerentscheidung), die alten Adressen leitet `public/_redirects` dorthin. Die Catch-all-Route gilt
 * nur, wo `[slug].astro` keinen Treffer hat, die Adressen überschneiden sich nicht.
 */
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import Collection from '../../components/sections/Collection.astro';
import PageHeader from '../../components/sections/PageHeader.astro';
import MiniFormSection from '../../components/sections/MiniFormSection.astro';

export async function getStaticPaths() {
  const kollektionenSeiten = await getCollection('kollektionen');
  return [
    ...kollektionenSeiten.map(({ data }) => ({
      params: { seite: data.slug },
      props: { kollektionen: data },
    })),
  ];
}

const { kollektionen } = Astro.props;
// Mini-Formular: Leistung vorwählen, wo sie eindeutig ist
const formService: Record<string, string> = { 'spachteltechnik-oberflaechen': 'Spachteltechniken' };
const path = `/meisterwerk-exklusive/${kollektionen.slug}/`;
---

<PageLayout
  title={kollektionen.title}
  description={kollektionen.description}
  current={path}
  site="exklusive"
>
  {kollektionen && (
    <>
      <PageHeader label="Meisterwerke Exklusive" title={kollektionen.headline} />
      {kollektionen.collections.map((collection, i) => (
        <Collection {collection} columns={kollektionen.columns} tone={i % 2 === 0 ? 'soft' : 'white'} />
      ))}
      <MiniFormSection
        exklusive
        service={formService[kollektionen.slug]}
        class={kollektionen.collections.length % 2 === 1 ? 'bg-white!' : ''}
        title="Ihr Projekt in Ludwigsburg besprechen"
        text="Schreiben Sie uns kurz, worum es geht. Wir melden uns persönlich bei Ihnen und besprechen Ihr Vorhaben, auf Wunsch im Showroom in Freiberg am Neckar."
      />
    </>
  )}
</PageLayout>
