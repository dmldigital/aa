---
/**
 * Seiten der Teil-Website /meisterwerk-exklusive/, die nicht zu `[slug].astro` (Leistungsseiten) gehören:
 * die sechs Mitarbeiterprofile (Collection `profile`, wie die Hauptprofile) und die zwei Kollektionsseiten
 * (Collection `kollektionen`). Die Catch-all-Route gilt nur, wo `[slug].astro` keinen Treffer hat, die Adressen
 * überschneiden sich nicht.
 */
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import ProfileHero from '../../components/sections/ProfileHero.astro';
import ProfileTimeline from '../../components/sections/ProfileTimeline.astro';
import ProfileBio from '../../components/sections/ProfileBio.astro';
import Collection from '../../components/sections/Collection.astro';
import PageHeader from '../../components/sections/PageHeader.astro';
import MiniFormSection from '../../components/sections/MiniFormSection.astro';
import { exklusivProfile } from '../../data/pages/profiles';

export async function getStaticPaths() {
  const profiles = await getCollection('profile');
  const kollektionenSeiten = await getCollection('kollektionen');
  return [
    ...profiles.map(({ data }) => ({
      params: { seite: data.slug },
      props: { profile: exklusivProfile(data) },
    })),
    ...kollektionenSeiten.map(({ data }) => ({
      params: { seite: data.slug },
      props: { kollektionen: data },
    })),
  ];
}

const { profile, kollektionen } = Astro.props;
// Elementor-Kennungen der Steckbrief-Sektionen im Original
const bioIds: Record<string, string> = {
  'baldassarre-fortino': '3a18279d',
  'fabio-fortino': '76976f7a',
  'lorenzo-fortino': '14d6e0c0',
  'samet-erenuglu': 'e579377',
  'stefano-pulia': '644bd090',
  'vincenzo-fortino': '4cc74a75',
};
// Mini-Formular: Leistung vorwählen, wo sie eindeutig ist
const formService: Record<string, string> = { 'spachteltechnik-oberflaechen': 'Spachteltechniken' };
const path = `/meisterwerk-exklusive/${(profile ?? kollektionen).slug}/`;
---

<PageLayout
  title={(profile ?? kollektionen).title}
  description={(profile ?? kollektionen).description}
  current={path}
  site="exklusive"
>
  {profile && (
    <>
      <ProfileHero name={profile.name} photo={profile.photo} />
      {profile.timeline && (
        <ProfileTimeline
          id="0411fde"
          heading={profile.timeline.heading}
          items={profile.timeline.items}
        />
      )}
      <ProfileBio id={bioIds[profile.slug]} {profile} exklusive />
    </>
  )}
  {kollektionen && (
    <>
      <PageHeader label="Meisterwerke Exklusive" title={kollektionen.headline} />
      {kollektionen.collections.map((collection, i) => (
        <Collection {collection} columns={kollektionen.columns} tone={i % 2 === 0 ? 'soft' : 'white'} />
      ))}
      <MiniFormSection
        exklusive
        service={formService[kollektionen.slug]}
        class={kollektionen.collections.length % 2 === 1 ? 'bg-white!' : ''}
        title="Ihr Projekt in Ludwigsburg besprechen"
        text="Schreiben Sie uns kurz, worum es geht. Wir melden uns persönlich bei Ihnen und besprechen Ihr Vorhaben, auf Wunsch im Showroom in Freiberg am Neckar."
      />
    </>
  )}
</PageLayout>
