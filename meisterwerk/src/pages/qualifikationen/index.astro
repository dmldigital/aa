---
import PageLayout from '../../layouts/PageLayout.astro';
import SectionHeading from '../../components/sections/SectionHeading.astro';
import Pillars from '../../components/sections/Pillars.astro';
import Gallery from '../../components/sections/Gallery.astro';
import { meta, heading, pillars, gallery } from '../../data/pages/qualifikationen';
---

<PageLayout title={meta.title} description={meta.description} current="/qualifikationen/">
  <SectionHeading id="dd2507a" title={heading} rootClass="mt-[10vh] md:mt-0 md:mb-15 lg:my-18" />
  <Pillars id="214893f" items={pillars} smallText rootClass="mb-10 md:mb-15 lg:mb-0" />
  <Gallery
    id="a1e26a2"
    items={gallery}
    layout="justified"
    gap={[10, 10, 10]}
    rowHeight={[344, 344, 150]}
    rootClass="mb-10 md:mb-15 lg:mt-6.75 lg:mb-18"
  />
</PageLayout>
