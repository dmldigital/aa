---
/**
 * Bewertungen: Auf der alten Seite besteht /reviews/ aus zwei leeren Elementor-Karussells ("nichts gefunden").
 * Die Bewertungen selbst (Trustindex) stehen im Footer. Die Seite zeigt deshalb den Seitenkopf (nur Text) und
 * verweist auf die Bewertungen im Fuß der Seite und auf die Projekte.
 */
import PageLayout from '../../layouts/PageLayout.astro';
import PageHeader from '../../components/sections/PageHeader.astro';
import { href, routes } from '../../data/links';
---

<PageLayout
  title="Kundenbewertungen"
  description="Kundenbewertungen zur Meisterwerk Malermanufaktur in Freiberg am Neckar, tätig in Ludwigsburg, Stuttgart und der gesamten Umgebung."
  current="/reviews/"
>
  <PageHeader
    label="Bewertungen"
    title="Bewertungen unserer Kunden"
    paragraphs={[
      `Die Bewertungen unserer Kunden finden Sie unten im Fuß dieser Seite. Einen Eindruck unserer Arbeit geben Ihnen außerdem unsere <a href="${href(routes.projects)}" class="inline-link">Projekte</a>.`,
    ]}
  />
</PageLayout>
