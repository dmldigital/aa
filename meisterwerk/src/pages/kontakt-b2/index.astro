---
/** Projektanfrage, Variante B2 „Kacheln“ (Vorschau zum Vergleichen mit /kontakt-b/ und /kontakt-b3/). */
import PageLayout from '../../layouts/PageLayout.astro';
import ProjectFocus from '../../components/kontakt/ProjectFocus.astro';
import ContactStrip from '../../components/kontakt/ContactStrip.astro';
import { contactPages } from '../../data/pages/contact';

const page = contactPages.kontakt;
const intro = page.intro.slice(0, 2).map((lines) => lines.join(' '));
---

<PageLayout title={page.title} description={page.description} current="/kontakt/">
  <ProjectFocus heading={page.heading} {intro} variant="tiles" />
  <ContactStrip />
</PageLayout>
