---
/**
 * Stil-Referenz (Vorschlag): Schriftgrößen, Zeilenhöhen und Abstände der Seite als feste Regeln. Bisher nutzt die Seite rund
 * 45 verschiedene Schriftgrößen und viele Einzelabstände; hier steht der Vorschlag für eine kleine, feste Skala.
 * Nach der Abnahme wandern die Werte als Tokens in `global.css` (@theme) und alle Komponenten werden darauf umgestellt.
 * Größen gleiten zwischen 390 px (Handy) und 1440 px (Desktop) stufenlos mit (clamp).
 */
import PageLayout from '../../layouts/PageLayout.astro';
import Button from '../../components/ui/Button.astro';

const fluid = (min: number, max: number) =>
  min === max ? `${min}px` : `clamp(${min}px, calc(${min}px + ${max - min} * (100vw - 390px) / 1050), ${max}px)`;

const type = [
  {
    name: 'Display',
    use: 'Nur Hero der Startseite',
    min: 44, max: 96, lh: 0.95, track: '-0.04em', weight: 600, font: 'display',
    sample: 'Malerarbeiten in Ludwigsburg',
    was: 'text-[12.5vw], text-[11.5vw], clamp(44–118px), 100px, 50px, 46px',
  },
  {
    name: 'H1',
    use: 'Seitentitel (eine pro Seite)',
    min: 36, max: 60, lh: 1.05, track: '-0.03em', weight: 500, font: 'display',
    sample: 'Unser Urlaubsservice für Sie',
    was: 'text-h1 (60), 38, 34, 32 px',
  },
  {
    name: 'H2',
    use: 'Sektionstitel',
    min: 28, max: 40, lh: 1.15, track: '-0.02em', weight: 500, font: 'display',
    sample: 'Ihr Malerbetrieb für Ludwigsburg',
    was: 'text-h2, text-h3 (40), 30, 29, 28, 26 px',
  },
  {
    name: 'H3',
    use: 'Karten, Untertitel, Projektnamen',
    min: 21, max: 24, lh: 1.25, track: '-0.01em', weight: 500, font: 'display',
    sample: 'Glatte Wände und Q4-Spachtelung',
    was: 'text-h4 (24), 23, 21, 20, 19.2 px',
  },
  {
    name: 'H4',
    use: 'Kleine Überschriften, Akkordeon, Listen-Titel',
    min: 17, max: 18, lh: 1.35, track: '0', weight: 500, font: 'display',
    sample: 'Welche Leistungen bieten Sie an?',
    was: 'text-h5 (20), 19, 18, 17.6, 17 px',
  },
  {
    name: 'Einleitung',
    use: 'Erster Absatz unter einem Titel',
    min: 17, max: 19, lh: 1.5, track: '-0.01em', weight: 400, font: 'display',
    sample: 'Ihr Meisterbetrieb für Streichen, Lackieren, Tapezieren und glatte Oberflächen.',
    was: '18, 17, 16.5 px (verstreut)',
  },
  {
    name: 'Text',
    use: 'Fließtext, Formulare',
    min: 16, max: 16, lh: 1.6, track: '0', weight: 400, font: 'body',
    sample:
      'Mit über 22 Jahren Erfahrung vereinen wir traditionelles Handwerk mit modernem Design. Wir setzen Ihre Wünsche mit höchster Präzision und Leidenschaft um.',
    was: 'text-body (15), 16, 15 px',
  },
  {
    name: 'Klein',
    use: 'Bildunterschriften, Hinweise, Daten',
    min: 13, max: 14, lh: 1.45, track: '0', weight: 400, font: 'body',
    sample: 'Jahr 2019 · Ludwigsburg · 6 Monate · 150 m²',
    was: '14, 13.6, 13.3, 13 px',
  },
  {
    name: 'Überzeile',
    use: 'Kleine Zeile über Titeln, Großbuchstaben',
    min: 11, max: 12, lh: 1.3, track: '0.16em', weight: 500, font: 'display', upper: true,
    sample: 'Unsere Leistungen',
    was: 'text-label (12), 11.5, 11, 10.4, 10, 9, 8 px',
  },
  {
    name: 'Button',
    use: 'Nur im Button (fest)',
    min: 14, max: 14, lh: 1.1, track: '0.5px', weight: 600, font: 'display', upper: true,
    sample: 'Projekt starten',
    was: 'unverändert',
  },
];

const space = [
  { px: 4, use: 'Haarfein: Symbol zu Text' },
  { px: 8, use: 'Eng: Zeilen in Listen, Schild zu Symbol' },
  { px: 12, use: 'Überzeile → Titel' },
  { px: 16, use: 'Absatz → Absatz, Titel H3/H4 → Text' },
  { px: 20, use: 'Seitenrand Handy, Abstand im Kartenraster' },
  { px: 24, use: 'Titel H1/H2 → Text' },
  { px: 32, use: 'Text → Button, Seitenrand Desktop (30 → 32)' },
  { px: 48, use: 'Block → Block innerhalb einer Sektion' },
  { px: 64, use: 'Sektion → Sektion (Handy)' },
  { px: 96, use: 'Sektion → Sektion (Tablet)' },
  { px: 128, use: 'Sektion → Sektion (Desktop)' },
];

const rules = [
  'Nur die Größen dieser Skala. Keine Einzelwerte in Pixeln (text-[23px] usw.) mehr in Komponenten.',
  'Eine H1 pro Seite. Überschriften-Stufen nicht überspringen, die Optik folgt der Stufe.',
  'Urbanist für Titel, Einleitung, Überzeilen und Buttons, Systemschrift für Fließtext und Kleines.',
  'Fließtext höchstens 65 Zeichen breit (max-w-[65ch]).',
  'Größen gleiten stufenlos zwischen Handy und Desktop, keine Sprünge an Breakpoints.',
  'Abstände nur aus der Abstands-Skala. Vertikaler Rhythmus: Überzeile 12 → Titel 24 → Text 32 → Button.',
  'Jede Sektion hat oben und unten denselben Abstand: 64 / 96 / 128 px.',
  'Seitenrand: 20 px Handy, 32 px ab Tablet. Inhaltsbreite höchstens 1700 px.',
  'Kartenraster: 20 px Abstand auf allen Größen.',
  'Farben bleiben, wie sie sind (Schwarz, Gold für Akzente, Grau für Nebentexte).',
];
---

<PageLayout title="Stil-Referenz - Meisterwerk Malermanufaktur" current="/stil/">
  <div data-no-autolink class="px-5 pt-16 pb-32 md:px-8">
    <div class="mx-auto max-w-[1100px]">
      <p class="font-display text-[12px] font-medium tracking-[0.16em] text-ink uppercase">Vorschlag zur Abnahme</p>
      <h1 class="mt-3 font-display font-medium text-ink" style={`font-size:${fluid(36, 60)};line-height:1.05;letter-spacing:-0.03em`}>
        Stil-Referenz
      </h1>
      <p class="mt-6 max-w-[65ch] text-[16px]/[1.6] text-muted">
        Bisher nutzt die Seite rund 45 verschiedene Schriftgrößen und viele Einzelabstände. Hier stehen zehn Schriftstufen,
        elf Abstände und zehn Regeln. Nach der Abnahme stelle ich alle Seiten darauf um. Die Größen gleiten zwischen Handy
        (390 px) und Desktop (1440 px) stufenlos mit, zum Vergleich einfach das Fenster schmaler ziehen.
      </p>

      <h2 class="mt-24 font-display font-medium text-ink" style={`font-size:${fluid(28, 40)};line-height:1.15;letter-spacing:-0.02em`}>
        Schrift
      </h2>
      <div class="mt-8 border-t border-black/10">
        {
          type.map((t) => (
            <div class="grid gap-4 border-b border-black/10 py-8 md:grid-cols-[220px_1fr] md:gap-8">
              <div class="flex flex-col gap-1.5 text-[13px]/[1.45] text-muted">
                <span class="font-display text-[17px] font-medium text-ink">{t.name}</span>
                <span>{t.use}</span>
                <span>
                  {t.min === t.max ? `${t.min} px` : `${t.min} → ${t.max} px`} · Zeile {t.lh} · {t.weight}
                </span>
                <span>Bisher: {t.was}</span>
              </div>
              <p
                class:list={['text-ink', t.font === 'display' ? 'font-display' : 'font-body', t.upper && 'uppercase']}
                style={`font-size:${fluid(t.min, t.max)};line-height:${t.lh};letter-spacing:${t.track};font-weight:${t.weight}`}
              >
                {t.sample}
              </p>
            </div>
          ))
        }
      </div>

      <h2 class="mt-24 font-display font-medium text-ink" style={`font-size:${fluid(28, 40)};line-height:1.15;letter-spacing:-0.02em`}>
        Abstände
      </h2>
      <div class="mt-8 flex flex-col gap-3">
        {
          space.map((s) => (
            <div class="grid grid-cols-[56px_1fr] items-center gap-4 md:grid-cols-[56px_140px_1fr]">
              <span class="font-display text-[14px] font-medium text-ink">{s.px} px</span>
              <span class="block h-3 rounded-full bg-gold/70" style={`width:${s.px}px`} />
              <span class="col-span-2 text-[13px]/[1.45] text-muted md:col-span-1">{s.use}</span>
            </div>
          ))
        }
      </div>

      <h2 class="mt-24 font-display font-medium text-ink" style={`font-size:${fluid(28, 40)};line-height:1.15;letter-spacing:-0.02em`}>
        Beispiel einer Sektion
      </h2>
      <div class="mt-8 rounded-[24px] bg-soft px-5 py-16 md:px-8">
        <p class="font-display text-[12px] font-medium tracking-[0.16em] text-ink uppercase">Unsere Leistungen</p>
        <h3 class="mt-3 font-display font-medium text-ink" style={`font-size:${fluid(28, 40)};line-height:1.15;letter-spacing:-0.02em`}>
          Ihr Malerbetrieb für Ludwigsburg
        </h3>
        <p class="mt-6 max-w-[65ch] font-display text-ink" style={`font-size:${fluid(17, 19)};line-height:1.5;letter-spacing:-0.01em`}>
          Ihr Meisterbetrieb für Streichen, Lackieren, Tapezieren und glatte Oberflächen.
        </p>
        <p class="mt-4 max-w-[65ch] text-[16px]/[1.6] text-muted">
          Ob Malerarbeiten, Tapeten, Lack oder Putz: Wir beraten Sie im Showroom, planen gemeinsam mit Ihnen und setzen Ihr
          Projekt sauber und termingerecht um.
        </p>
        <div class="mt-8"><Button href="#">Projekt starten</Button></div>
        <p class="mt-6 text-[13px]/[1.45] text-muted">Abstände: Überzeile 12 · Titel 24 · Einleitung 16 · Text 32 · Button</p>
      </div>

      <h2 class="mt-24 font-display font-medium text-ink" style={`font-size:${fluid(28, 40)};line-height:1.15;letter-spacing:-0.02em`}>
        Regeln
      </h2>
      <ol class="mt-8 flex max-w-[75ch] list-decimal flex-col gap-3 pl-5 text-[16px]/[1.6] text-ink">
        {rules.map((r) => <li>{r}</li>)}
      </ol>
    </div>
  </div>
</PageLayout>
