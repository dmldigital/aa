---
/** Projektanfrage, Variante C „Satz“ (Vorschau zum Vergleichen mit /kontakt/ und /kontakt-b/). */
import PageLayout from '../../layouts/PageLayout.astro';
import ProjectSentence from '../../components/kontakt/ProjectSentence.astro';
import ContactStrip from '../../components/kontakt/ContactStrip.astro';
import { contactPages } from '../../data/pages/contact';

const page = contactPages.kontakt;
const eyebrow = 'font-display text-label font-medium tracking-label text-ink uppercase';
---

<PageLayout title={page.title} description={page.description} current="/kontakt/">
  <section class="px-5 mt-10 mb-12 md:mt-15 md:mb-15 lg:mt-[10vh] lg:mb-[9vh] lg:px-7.5">
    <div class="mx-auto flex w-full max-w-page flex-col gap-3.75 lg:gap-5">
      <h1
        class="font-display text-[26px]/[28.6px] font-medium text-ink md:text-[34px]/[37.4px] lg:text-h1"
        data-anim="fadeInUp"
        data-anim-delay="100"
      >
        {page.heading}
      </h1>
      <p class="text-[16px]/[24px] md:text-body lg:max-w-[620px]" data-anim="fadeIn" data-anim-delay="250">
        {page.intro[0].join(' ')}
      </p>
    </div>
  </section>
  <ProjectSentence />
  <ContactStrip />
</PageLayout>
