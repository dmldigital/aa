---
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import WelcomeScroll from '../../components/sections/WelcomeScroll.astro';
import ServiceBenefits from '../../components/service/ServiceBenefits.astro';
import ServiceBlocks from '../../components/service/ServiceBlocks.astro';
import ServiceGallery from '../../components/service/ServiceGallery.astro';
import ServiceExcellence from '../../components/service/ServiceExcellence.astro';
import MoreServices from '../../components/service/MoreServices.astro';
import MiniFormSection from '../../components/sections/MiniFormSection.astro';
import { EXCELLENCE } from '../../data/pages/services';
import { href } from '../../data/links';

export async function getStaticPaths() {
  const services = await getCollection('leistungen');
  return services.map(({ data }) => ({ params: { slug: data.slug }, props: { page: data } }));
}
const { page } = Astro.props;

/**
 * Schema aller Leistungsseiten: Willkommen-Szene wie auf der Startseite (Text steht rechts, die Bilder der Seite laufen
 * links vorbei, kleiner Abstand zur Kopfzeile, am Ende Luft wie auf der Startseite), Vorteile als
 * Karten, die beiden Textblöcke, alle Bilder als Karussell wie „Unsere Exklusive Projekte“ mit Großansicht und
 * „Exzellenz ist unser Maßstab“ als Karten.
 */
const name = page.hero.title.split(': ')[0].split(' – ')[0];
// Leistung ohne Ortszusatz für die Überschrift der Galerie
const short = name.replace(/ in Ludwigsburg$/, '');
const pool = [
  { src: page.hero.img, alt: page.hero.alt },
  { src: page.intro.img, alt: page.intro.alt },
  ...(page.showcase ?? []).flatMap((c) => c.images).map((src) => ({ src, alt: '' })),
  ...(page.gallery ?? []).map((src) => ({ src, alt: '' })),
];
const seen = new Set<string>();
const unique = pool.filter((i) => !seen.has(i.src.src) && seen.add(i.src.src));
// Bilder ohne eigene Beschreibung: Leistung und Nummer, damit kein Alt-Text doppelt vorkommt
const images = unique.slice(0, 3).map((i, n) => ({ src: i.src, alt: i.alt || `${name} bei Meisterwerk, Bild ${n + 1}` }));
// Karussell: erst die Bilder, die nicht in der Szene laufen, danach die der Szene (so gibt es auch bei wenigen Bildern eine Schleife)
const gallery = [...unique.slice(3), ...unique.slice(0, 3)].map((i) => i.src);

// Mini-Formular: Leistung vorwählen und Titel anpassen
const form: Record<string, { service: string; title: string }> = {
  malerarbeiten: { service: 'Malerarbeiten', title: 'Ihre Malerarbeiten in Ludwigsburg besprechen' },
  tapezieren: { service: 'Tapezierarbeiten', title: 'Ihre Tapezierarbeiten in Ludwigsburg besprechen' },
  lackierarbeiten: { service: 'Lackierarbeiten', title: 'Ihre Lackierarbeiten in Ludwigsburg besprechen' },
  verputzen: { service: 'Verputzarbeiten', title: 'Ihre Verputzarbeiten in Ludwigsburg besprechen' },
  'glatte-waende': { service: 'Glatte Oberflächen', title: 'Ihre glatten Wände in Ludwigsburg besprechen' },
};
const f = form[page.slug];
// Querverweise im Text: andere Leistungen mit Ortsanker und ein passendes Projekt (alle Projekte stehen laut Eckdaten in Ludwigsburg)
const a = (to: string, text: string) => `<a href="${href(to)}" class="inline-link">${text}</a>`;
const related: Record<string, string> = {
  malerarbeiten: `Dazu passen ${a('/services/tapezieren/', 'Tapezierarbeiten in Ludwigsburg')}, ${a('/services/lackierarbeiten/', 'Lackierarbeiten in Ludwigsburg')} und ${a('/services/glatte-waende/', 'glatte Wände')}. Ein Beispiel ist unser ${a('/2025/09/18/frisch-gestrichen/', 'Fassadenanstrich mit Silikatfarbe in Ludwigsburg')}.`,
  tapezieren: `Auf Wunsch verbinden wir Tapeten mit ${a('/services/malerarbeiten/', 'Malerarbeiten in Ludwigsburg')} oder ${a('/services/glatte-waende/', 'glatten Wänden und Oberflächen')}. Die Vorarbeit mit Spachtelarbeiten und Malervlies zeigt unsere ${a('/2021/05/01/kernsanierung/', 'Kernsanierung eines Altbaus in Ludwigsburg')}.`,
  lackierarbeiten: `Zum Lackieren gehört oft der passende Anstrich: Mehr dazu unter ${a('/services/malerarbeiten/', 'Malerarbeiten in Ludwigsburg')} und ${a('/services/tapezieren/', 'Tapezierarbeiten in Ludwigsburg')}. Eine restaurierte Holztreppe sehen Sie bei unserer ${a('/2021/05/01/kernsanierung/', 'Kernsanierung eines Altbaus in Ludwigsburg')}.`,
  verputzen: `Nach dem Putz folgen oft ${a('/services/malerarbeiten/', 'Malerarbeiten in Ludwigsburg')} oder ${a('/services/glatte-waende/', 'glatte Wände')}. Ein Beispiel mit Kratzputz ist unsere ${a('/2025/05/22/altbau-wdvs/', 'Fassadendämmung eines Altbaus in Ludwigsburg')}.`,
  'glatte-waende': `Für besondere Oberflächen setzen wir ${a('/meisterwerk-exklusive/spachteltechniken/', 'Spachteltechniken in Ludwigsburg')} ein, für den Untergrund ${a('/services/verputzen/', 'Verputzarbeiten in Ludwigsburg')}. Gespachtelte Oberflächen zeigt unsere ${a('/2025/09/18/traumhaus/', 'Kernsanierung eines Zweifamilienhauses in Ludwigsburg')}.`,
};
const intro2 =
  'Wir beraten Sie im Showroom in Freiberg am Neckar, zeigen Ihnen Muster zum Anfassen und setzen Ihr Projekt sauber und termingerecht um.';
---

<PageLayout title={page.title} description={page.description} current={`/services/${page.slug}/`}>
  <WelcomeScroll
    heading={page.hero.title}
    paragraphs={[page.hero.text, ...(page.hero.local ? [page.hero.local] : []), intro2, ...(related[page.slug] ? [related[page.slug]] : [])]}
    images={images}
    closing={null}
    headingTag="h1"
    rootClass="pt-group pb-section"
  />
  <ServiceBenefits label={page.intro.label} title={page.intro.title} list={page.intro.list} />
  <ServiceBlocks blocks={page.intro.blocks} class="pb-0!" />
  <ServiceGallery images={gallery} alt={`${name} bei Meisterwerk`} heading={`Einblicke: ${short} aus Ludwigsburg und Umgebung`} start={4} />
  <ServiceExcellence title={EXCELLENCE} items={page.pillars} />
  <MoreServices current={`/services/${page.slug}/`} />
  <MiniFormSection
    service={f?.service}
    title={f?.title}
    text="Schreiben Sie uns kurz, worum es geht. Wir melden uns persönlich bei Ihnen und besprechen Ihr Vorhaben, auf Wunsch im Showroom in Freiberg am Neckar."
  />
</PageLayout>
