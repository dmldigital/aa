---
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import WelcomeScroll from '../../components/sections/WelcomeScroll.astro';
import ServiceBenefits from '../../components/service/ServiceBenefits.astro';
import ServiceBlocks from '../../components/service/ServiceBlocks.astro';
import Showcase from '../../components/sections/Showcase.astro';
import Gallery from '../../components/sections/Gallery.astro';
import SectionHeading from '../../components/sections/SectionHeading.astro';
import Pillars from '../../components/sections/Pillars.astro';
import { EXCELLENCE } from '../../data/pages/services';

export async function getStaticPaths() {
  const services = await getCollection('leistungen');
  return services.map(({ data }) => ({ params: { slug: data.slug }, props: { page: data } }));
}
const { page } = Astro.props;

/**
 * Schema aller Leistungsseiten: Willkommen-Szene wie auf der Startseite (Text steht rechts, die Bilder der Seite laufen
 * links vorbei), Vorteile als Karten, die beiden Textblöcke, dann wie bisher Bildreihen, Galerie und „Exzellenz“.
 */
const name = page.hero.title.split(' – ')[0];
const pool = [
  { src: page.hero.img, alt: page.hero.alt },
  { src: page.intro.img, alt: page.intro.alt || `${name} bei Meisterwerk` },
  ...(page.showcase ?? []).flatMap((c) => c.images).map((src) => ({ src, alt: `${name} bei Meisterwerk` })),
  ...(page.gallery ?? []).map((src) => ({ src, alt: `${name} bei Meisterwerk` })),
];
const seen = new Set<string>();
const images = pool.filter((i) => !seen.has(i.src.src) && seen.add(i.src.src)).slice(0, 3);
---

<PageLayout title={page.title} description={page.description} current={`/services/${page.slug}/`}>
  <WelcomeScroll
    heading={page.hero.title}
    paragraphs={[page.hero.text]}
    images={images}
    closing={null}
    headingTag="h1"
  />
  <ServiceBenefits label={page.intro.label} title={page.intro.title} list={page.intro.list} />
  <ServiceBlocks blocks={page.intro.blocks} />
  {page.showcase && <Showcase columns={page.showcase} />}
  {page.gallery && (
    <Gallery
      id="aa57ee6"
      items={page.gallery}
      gap={[30, 10, 10]}
      innerClass="md:w-[75.7%] lg:w-full"
    />
  )}
  <SectionHeading id="7d071c8" title={EXCELLENCE} />
  <Pillars id="8afce89" items={page.pillars} smallText />
  <div data-section="43d17bb" class="mb-10 h-107.5 md:mb-15 md:h-130 lg:mb-27 lg:h-195"></div>
  <div data-section="8d59bd8" class="h-5 lg:h-10"></div>
</PageLayout>
