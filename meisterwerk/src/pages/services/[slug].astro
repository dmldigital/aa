---
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import WelcomeScroll from '../../components/sections/WelcomeScroll.astro';
import ServiceBenefits from '../../components/service/ServiceBenefits.astro';
import ServiceBlocks from '../../components/service/ServiceBlocks.astro';
import ServiceGallery from '../../components/service/ServiceGallery.astro';
import ServiceExcellence from '../../components/service/ServiceExcellence.astro';
import { EXCELLENCE } from '../../data/pages/services';

export async function getStaticPaths() {
  const services = await getCollection('leistungen');
  return services.map(({ data }) => ({ params: { slug: data.slug }, props: { page: data } }));
}
const { page } = Astro.props;

/**
 * Schema aller Leistungsseiten: Willkommen-Szene wie auf der Startseite (Text steht rechts, die Bilder der Seite laufen
 * links vorbei, kleiner Abstand zur Kopfzeile, am Ende Luft wie auf der Startseite), Vorteile als
 * Karten, die beiden Textblöcke, alle Bilder als Karussell wie „Unsere Exklusive Projekte“ mit Großansicht und
 * „Exzellenz ist unser Maßstab“ als Karten.
 */
const name = page.hero.title.split(' – ')[0];
const pool = [
  { src: page.hero.img, alt: page.hero.alt },
  { src: page.intro.img, alt: page.intro.alt || `${name} bei Meisterwerk` },
  ...(page.showcase ?? []).flatMap((c) => c.images).map((src) => ({ src, alt: `${name} bei Meisterwerk` })),
  ...(page.gallery ?? []).map((src) => ({ src, alt: `${name} bei Meisterwerk` })),
];
const seen = new Set<string>();
const unique = pool.filter((i) => !seen.has(i.src.src) && seen.add(i.src.src));
const images = unique.slice(0, 3);
// Karussell: erst die Bilder, die nicht in der Szene laufen, danach die der Szene (so gibt es auch bei wenigen Bildern eine Schleife)
const gallery = [...unique.slice(3), ...unique.slice(0, 3)].map((i) => i.src);
const intro2 =
  'Wir beraten Sie im Showroom in Freiberg am Neckar, zeigen Ihnen Muster zum Anfassen und setzen Ihr Projekt sauber und termingerecht um.';
---

<PageLayout title={page.title} description={page.description} current={`/services/${page.slug}/`}>
  <WelcomeScroll
    heading={page.hero.title}
    paragraphs={[page.hero.text, intro2]}
    images={images}
    closing={null}
    headingTag="h1"
    rootClass="mt-6 mb-[10vh] md:mt-8 md:mb-15 lg:mt-10 lg:mb-[20vh]"
  />
  <ServiceBenefits label={page.intro.label} title={page.intro.title} list={page.intro.list} />
  <ServiceBlocks blocks={page.intro.blocks} />
  <ServiceGallery images={gallery} alt={`${name} bei Meisterwerk`} />
  <ServiceExcellence title={EXCELLENCE} items={page.pillars} />
</PageLayout>
