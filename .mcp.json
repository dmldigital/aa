{
  "mcpServers": {
    "playwright": {
      "command": "bash",
      "args": [
        ".claude/mcp/playwright.sh"
      ]
    },
    "chrome-devtools": {
      "command": "bash",
      "args": [
        ".claude/mcp/chrome-devtools.sh"
      ]
    },
    "21st": {
      "type": "http",
      "url": "https://21st.dev/api/mcp",
      "headers": {
        "x-api-key": "${API_KEY_21ST:-}"
      }
    }
  }
}
