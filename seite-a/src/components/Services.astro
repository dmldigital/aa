---
// Desktop: an oversized index; a preview image follows the cursor (21st.dev "Kinetic Team Hybrid" / hover reveal).
// Phone: the services stack as cards, one swipe per card.
import { services } from '../data/content';
---
<section class="services grain" id="leistungen" aria-labelledby="services-title">
  <div class="wrap section-head">
    <p class="label" data-reveal>Unsere Leistungen</p>
    <h2 id="services-title" class="h2" data-lines>Meisterhafte Bauleistungen &amp; Fachkompetenz</h2>
  </div>
  <ol class="wrap service-list">
    {services.map((s, i) => (
      <li class="service" style={`--i:${i}`}>
        <a href="#kontakt" class="service-row">
          <span class="service-media"><img src={s.image} alt={s.title} width="440" height="425" loading="lazy" /><span class="service-badge">{s.badge}</span></span>
          <span class="service-badge service-badge-inline">{s.badge}</span>
          <span class="service-index">{String(i + 1).padStart(2, '0')} / {String(services.length).padStart(2, '0')}</span>
          <span class="service-title">{s.title}</span>
          <span class="service-text">{s.text}</span>
          <span class="service-go" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M7 17 17 7M8 7h9v9" /></svg></span>
        </a>
      </li>
    ))}
  </ol>
  <div class="service-follow" aria-hidden="true">
    {services.map(s => <img src={s.image} alt="" width="440" height="425" loading="lazy" />)}
  </div>
</section>
