---
// Desktop: zoom parallax (21st.dev "Zoom Parallax"): short video loops from their own footage fly past at different
// speeds while the panorama video in the centre fills the screen. Phone: a swipeable strip with back/forward buttons, no pin.
// The loops are tiny (about 200-400 KB), muted, need no play button and are requested only after the first interaction and only
// while a tile is on (or right next to) the screen (main.ts); until then the first-frame poster stands in.
import { impressions } from '../data/content';
import StepNav from './StepNav.astro';
---
<section class="impressions" id="impressionen" aria-labelledby="impressions-title">
  <div class="wrap section-head impressions-head">
    <p class="label" data-reveal>Impressionen</p>
    <h2 id="impressions-title" class="h2" data-lines>Kein Weg zu weit, kein Platz zu klein.</h2>
  </div>
  <div class="zoom">
    <div class="zoom-stage">
      <div class="zoom-layer zoom-center">
        <figure class="zoom-item">
          <video muted playsinline loop preload="none" data-poster="/media/video/DJI_0145.webp" data-autoplay aria-label="Großbaustellen-Panorama aus der Luft">
            <source src="/media/video/DJI_0145.mp4" type="video/mp4" />
          </video>
          <figcaption class="media-badge"><i></i>Großbaustellen-Panorama</figcaption>
        </figure>
      </div>
      {impressions.map((p, i) => (
        <div class={`zoom-layer zoom-${i + 1}`}>
          <figure class="zoom-item">
            <video muted playsinline loop preload="none" data-poster={`${p.src}.webp`} data-autoplay data-clip aria-label={p.alt}>
              <source src={`${p.src}.mp4`} type="video/mp4" />
            </video>
          </figure>
        </div>
      ))}
    </div>
    <StepNav label="Bilder" />
  </div>
</section>

<script>
  import { stepper } from '../scripts/stepper';
  const zoom = document.querySelector<HTMLElement>('#impressionen .zoom')!;
  stepper(zoom.querySelector('.zoom-stage')!, '.zoom-layer', zoom.querySelector('[data-step="prev"]')!, zoom.querySelector('[data-step="next"]')!);
</script>
