---
// Team: ab 1100 px ein Bild-Akkordeon in voller Breite. Die Personen sind freigestellt (public/media/team-cut) und stehen auf dunklem
// Grund; ein schmaler Streifen zeigt sie wie durch einen Spalt, der gewählte öffnet sich langsam und zeigt Text und Person.
// (Muster nach 21st.dev "image accordion", eigene Umsetzung.) Darunter: Wischreihe mit Zurück/Weiter-Knöpfen und Text darunter.
import { team } from '../data/content';
import TeamInfo from './TeamInfo.astro';
import StepNav from './StepNav.astro';
const cut = (m: { image: string }) => `/media/team-cut/${m.image}.webp`;
---
<section class="team grain" id="team" aria-labelledby="team-title">
  <div class="wrap team-head">
    <p class="label" data-reveal>Ihr Projekt, unser Team</p>
    <h2 id="team-title" class="team-title" data-lines>Meisterhafte Kompetenz am Bau</h2>
  </div>

  <!-- Desktop: Akkordeon -->
  <div class="team-acc">
    <ul class="tm-list" role="list">
      {team.map((m, i) => (
        <li class={`tm${i === 0 ? ' on' : ''}`} data-i={i} tabindex="0" aria-label={`${m.name}, ${m.role}`}>
          <div class="tm-media">
            <img class="tm-img" src={cut(m)} alt={m.name} width="956" height="1100" loading={i < 3 ? 'eager' : 'lazy'} decoding="async" />
          </div>
          <div class="tm-strip" aria-hidden="true"><span class="tm-strip-name">{m.name}</span></div>
          <div class="tm-panel"><TeamInfo m={m} /></div>
        </li>
      ))}
    </ul>
  </div>

  <!-- Handy/Tablet: Wischreihe, Text darunter -->
  <div class="team-swipe">
    <div class="sw-stage">
      <ul class="sw-row" role="list" data-sw-row>
        {team.map((m, i) => (
          <li class={`sw-item${i === 0 ? ' on' : ''}`} data-i={i} tabindex="0" aria-label={`${m.name}, ${m.role}`}>
            <img src={cut(m)} alt={m.name} width="956" height="1100" loading={i < 2 ? 'eager' : 'lazy'} decoding="async" />
          </li>
        ))}
      </ul>
      <StepNav label="Team" />
    </div>
    <div class="wrap sw-caption">
      {team.map((m, i) => <div class={`sw-cap${i === 0 ? ' on' : ''}`} data-i={i}><TeamInfo m={m} /></div>)}
    </div>
  </div>
</section>

<script>
  import { stepper } from '../scripts/stepper';
  const sec = document.getElementById('team')!;
  const set = (i: number) => sec.querySelectorAll<HTMLElement>('[data-i]').forEach((el) => el.classList.toggle('on', Number(el.dataset.i) === i));

  // Hover (Maus, mit Verzögerung), Fokus (Tastatur), Klick/Tippen; der zuletzt gewählte bleibt offen
  let timer = 0;
  sec.querySelectorAll<HTMLElement>('.tm, .sw-item').forEach((el) => {
    const i = Number(el.dataset.i);
    el.addEventListener('pointerenter', (e) => {
      if (e.pointerType === 'touch') return;
      window.clearTimeout(timer);
      timer = window.setTimeout(() => set(i), 140);
    });
    el.addEventListener('pointerleave', () => window.clearTimeout(timer));
    el.addEventListener('focus', () => set(i));
    el.addEventListener('click', () => set(i));
  });

  // Wischreihe: die Person in der Mitte ist die gewählte
  const row = sec.querySelector<HTMLElement>('[data-sw-row]');
  if (row) stepper(row, '.sw-item', sec.querySelector('.team-swipe [data-step="prev"]')!, sec.querySelector('.team-swipe [data-step="next"]')!);
  let raf = 0;
  row?.addEventListener('scroll', () => {
    if (raf) return;
    raf = requestAnimationFrame(() => {
      raf = 0;
      const mid = row.getBoundingClientRect().left + row.clientWidth / 2;
      let best = 0, bestD = Infinity;
      row.querySelectorAll<HTMLElement>('.sw-item').forEach((el, i) => {
        const r = el.getBoundingClientRect();
        const d = Math.abs(r.left + r.width / 2 - mid);
        if (d < bestD) { bestD = d; best = i; }
      });
      set(best);
    });
  }, { passive: true });
</script>
