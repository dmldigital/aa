---
import { nav, phone, mail, footer } from '../data/content';
// Header "Zentriert" am Desktop: Logo in der Mitte, Menü links und rechts.
// Handy/Tablet: Logo links, Telefon und Menü-Knopf als runde Knöpfe rechts; das Menü blendet ruhig als Vollbild ein, Einträge mittig.
const navL = nav.slice(0, 3);
const navR = nav.slice(3);
const phoneIcon = '<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg>';
---
<header class="site-header" id="site-header">
  <button class="menu-toggle" type="button" aria-label="Menü öffnen" aria-expanded="false" aria-controls="drawer"><span></span><span></span></button>
  <nav class="main-nav main-nav-l" aria-label="Hauptnavigation">
    {navL.map(([label, href]) => <a href={href}><span class="roll-text" data-text={label}>{label}</span></a>)}
  </nav>
  <a href="#start" class="brand" aria-label="Manfred Weber Bauunternehmen, zum Seitenanfang">
    <img src="/media/img/schriftzug.png" alt="" width="250" height="90" />
    <span class="brand-text"><strong>Manfred Weber</strong><small>Bauunternehmen</small></span>
  </a>
  <div class="header-r">
    <nav class="main-nav main-nav-r" aria-label="Weitere Navigation">
      {navR.map(([label, href]) => <a href={href}><span class="roll-text" data-text={label}>{label}</span></a>)}
    </nav>
    <a href="#kontakt" class="btn btn-red header-cta" data-magnetic><span>Angebot anfragen</span></a>
    <a href={phone.href} class="header-phone" aria-label={`Anrufen: ${phone.label}`} set:html={phoneIcon}></a>
  </div>
</header>

<div class="drawer" id="drawer" inert>
  <div class="drawer-panel">
    <nav class="drawer-nav" aria-label="Mobile Navigation">
      {nav.map(([label, href]) => <a href={href} class="drawer-link"><span class="drawer-label">{label}</span></a>)}
    </nav>
    <div class="drawer-bottom">
      <a href="#kontakt" class="btn btn-red drawer-cta"><span>Angebot anfragen</span></a>
      <div class="drawer-foot">
        <div><small>Direktkontakt</small><a href={phone.href}>{phone.label}</a><a href={`mailto:${mail}`}>{mail}</a></div>
        <div><small>Standort</small><p>{footer.address.slice(1, 3).join(', ')}</p></div>
      </div>
    </div>
  </div>
</div>
