---
// Two round buttons (back / forward) laid over a swipe row; wired up by scripts/stepper.ts.
const { label } = Astro.props as { label: string };
---
<div class="step-nav">
  <button type="button" class="step-btn" data-step="prev" aria-label={`${label}: zurück`}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14.5 6 8.5 12l6 6" /></svg></button>
  <button type="button" class="step-btn" data-step="next" aria-label={`${label}: weiter`}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9.5 6 6 6-6 6" /></svg></button>
</div>
